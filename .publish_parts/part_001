\n     p.g.position.add(err);p.bodyVy=0;\n     if(cycle\u003e=Math.PI*1.45)p.planted=false\n   }else{\n     const baseSupport=payloadSupportY(p.g.position.x,p.g.position.z);\n     if(p.g.position.y\u003cbaseSupport){p.g.position.y=baseSupport;p.bodyVy=0}\n   }\n }else if(p.type==='TENDON'){\n   // Bearings are no longer this specimen's acceptance test. Contraction changes articulated geometry.\n   const contract=.5-.5*Math.cos(age*1.25),angle=-.12-contract*.92;\n   p.shoulder.rotation.z=angle;\n   const aw=probeWorldPoint(p.anchor),bw=p.shoulder.localToWorld(new THREE.Vector3(-2.55,0,0));\n   const mid=aw.clone().add(bw).multiplyScalar(.5),len=aw.distanceTo(bw);\n   p.tendon.position.copy(p.g.worldToLocal(mid.clone()));\n   p.tendon.scale.set(1,len,1);\n   const d=bw.clone().sub(aw);\n   p.tendon.rotation.set(0,0,-Math.atan2(d.x,d.y))\n }\n}\n\nconst payloadSupportRay=new THREE.Raycaster();\nconst payloadSupportOrigin=new THREE.Vector3(),payloadSupportDown=new THREE.Vector3(0,-1,0);\nfunction payloadTerrainHeight(x,z){\n // Live machinery needs the actual rendered terrain surface, not the coarse bearing height cache.\n // A handful of payloads can afford an exact vertical query; this also makes support agree with\n // the cookie-cut terrain mesh after arbitrary deformation.\n payloadSupportOrigin.set(x,MAX.y+4,z);\n payloadSupportRay.set(payloadSupportOrigin,payloadSupportDown);\n payloadSupportRay.near=0;payloadSupportRay.far=(MAX.y-MIN.y)+12;\n const hit=payloadSupportRay.intersectObject(terrain,false)[0];\n return hit?hit.point.y:-Infinity\n}\nfunction payloadSupportY(x,z){\n // Terrain is provisional support. The immutable octagonal plinth top is the absolute bottom of WORKS.\n const terrainY=payloadTerrainHeight(x,z);\n return worksInsideApparatus(x,z)?Math.max(terrainY,WORKS_APPARATUS_TOP):terrainY\n}\n\n/* T0.9 \u2014 FIRST EARNED ECS PROMOTION\n   WORKS did not begin with ECS. Payload-local update code was deliberately cheaper while the toy\n   vocabulary wa