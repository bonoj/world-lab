t type=\"module\"\u003e\ntry {\nconst THREE=await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');\nconst $=id=\u003edocument.getElementById(id),clamp=(n,a,b)=\u003eMath.max(a,Math.min(b,n));\nconst presets=[\n {name:'Weathered dwelling',seed:41,ground:'island',nodes:[\n ['plinth','mass',[7,.8,5],[-1,.6,0],'stone',.7],\n ['hall','stack',[5,3.5,3.6],'plinth','timber',.8],\n ['roof','cap',[6,2.2,4.6],'hall','copper',.8],\n ['annex','attach',[2.4,2.4,2.8],['hall',1],'stone',.7],\n ['hood','cap',[3,1.3,3.3],'annex','timber',.7],\n ['flue','stack',[.7,2,.8],'roof','stone',.8]]},\n {name:'Broken crossing',seed:73,ground:'channel',nodes:[\n ['west','mass',[3.4,3.4,4],[-5,1.6,0],'stone',.8],\n ['east','mass',[3.4,3.4,4],[5,1.6,0],'stone',.65],\n ['crossing','span',[0,1.6,2.5],['west','east'],'stone',.85],\n ['watch','stack',[2.5,3,2.9],'west','stone',.9],\n ['shelter','stack',[2.2,1.9,2.7],'east','timber',.6],\n ['cover','cap',[2.8,1.2,3.4],'shelter','copper',.7]]},\n {name:'Suspended court',seed:109,ground:'island',nodes:[\n ['needle','mass',[2.8,7,3],[-4,3.7,0],'stone',.65],\n ['counter','mass',[2,4.4,2.6],[4,2.4,0],'copper',.5],\n ['gallery','span',[0,1.2,2.6],['needle','counter'],'timber',.6],\n ['chamber','attach',[2.8,2.3,2.5],['needle',-1],'copper',.6],\n ['crown','cap',[3.5,2.5,3.7],'needle','timber',.65],\n ['pod','stack',[2.5,1.8,2.2],'counter','timber',.5],\n ['sail','cap',[3.2,2.4,2.8],'pod','copper',.65]]}\n];\nlet state,full=true,selected='',root,batches,owned,records,instances=0,buildMS=0,signature='',outline;\nconst hash=s=\u003e{let h=2166136261;for(const c of String(s))h=Math.imul(h^c.charCodeAt(0),16777619);return h\u003e\u003e\u003e0};\nfunction rng(seed){let a=seed\u003e\u003e\u003e0;return()=\u003e{a+=0x6D2B79F5;let t=a;t=Math.imul(t^t\u003e\u003e\u003e15,t|1);t^=t+Math.imul(t^t\u003e\u003e\u003e7,t|61);return((t^t\u003e\u003e\u003e14)\u003e\u003e\u003e0)/4294967296}}\nconst renderer=new THREE.WebGLRenderer({canvas:$('c'),ant