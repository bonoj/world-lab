hness:.58,metalness:.12});\n pbox(g,3.8,.35,2.1,0,.18,0,frameMat);\n for(const [px,pz] of [[-1.55,-.72],[-1.55,.72],[1.55,-.72],[1.55,.72]])pbox(g,.32,1.55,.32,px,.95,pz,frameMat);\n const carriage=new THREE.Group();carriage.position.set(0,.72,0);g.add(carriage);\n pbox(carriage,.65,.65,1.1,0,0,0,hotMat);pbox(carriage,.34,.34,2.5,0,0,1.55,frameMat);\n const face=pbox(carriage,2.05,1.45,.28,0,0,2.86,hotMat);\n const e={id:'probe-'+nextEntityId++,type:'LINEAR ACTUATOR',g,carriage,face,phase:0,stroke:2.8,born:performance.now(),forwardLocal:new THREE.Vector3(0,0,1)};\n mechanicalProbes.push(e);return e\n}\nfunction pushBearingsWithActuator(probe,prevZ,nextZ,dt){\n const wp=new THREE.Vector3();probe.face.getWorldPosition(wp);const dz=nextZ-prevZ;if(dz\u003c=0)return;\n for(let i=0;i\u003cMAX_BALLS;i++)if(balive[i]){\n   const dx=bx[i]-wp.x,dy=by[i]-wp.y,dzb=bz[i]-wp.z;\n   if(Math.abs(dx)\u003c1.47\u0026\u0026Math.abs(dy)\u003c1.22\u0026\u0026Math.abs(dzb)\u003c.87){\n     bz[i]=Math.max(bz[i],wp.z+.87);bvz[i]=Math.max(bvz[i],Math.min(12,2.5+dz/Math.max(.001,dt)*.72));bvy[i]+=dz*.18\n   }\n }\n}\nfunction updateMechanicalProbes(now,dt){\n for(const p of mechanicalProbes){\n   const age=(now-p.born)*.001;\n   if(p.type==='LINEAR ACTUATOR'){\n     const u=.5-.5*Math.cos(age*1.45),z=u*p.stroke,prev=p.carriage.position.z;\n     p.carriage.position.z=z;pushBearingsWithActuator(p,prev,z,dt)\n   }else updatePhase2Probe(p,age,dt)\n }\n}\nfunction clearMechanicalProbes(){for(const p of mechanicalProbes)scene.remove(p.g);mechanicalProbes.length=0}\n\n\n/* E1 PHASE 2 \u2014 MECHANICAL FAN-OUT\n   Phase 1 passed in play: moving geometry can do persistent work on ordinary WORKS bearings.\n   This batch stresses that truth through different arrangements. Each specimen remains local and\n   intentionally crude. Shared architecture is NOT inferred merely because several things move.\n\n   FLIPPER  \u2014 angular impulse.\n   JAWS     \u2014 opposed contact / temporary containment.\n   T