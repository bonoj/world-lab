;\nconst pole=new THREE.Mesh(new THREE.CylinderGeometry(2.2,3.4,76,8),metal);pole.position.y=38;station.add(pole);\nconst cross=new THREE.Mesh(new THREE.BoxGeometry(44,2,2),metal);cross.position.y=69;station.add(cross);\nconst vane=new THREE.Mesh(new THREE.ConeGeometry(5,22,5),new THREE.MeshStandardMaterial({color:0xb54d35}));vane.rotation.z=-Math.PI/2;vane.position.set(18,73,0);station.add(vane);\n\n// Distance witnesses make station visibility measurable rather than a fog knob.\nconst landmarks=[];const lmMat=new THREE.MeshStandardMaterial({color:0x59625c,roughness:.95});\nfor(let i=0;i\u003c56;i++){const a=i/56*Math.PI*2,r=260+(i%10)*145,h=25+(i*41%125);const q=new THREE.Mesh(new THREE.BoxGeometry(15+(i%4)*8,h,15+(i%3)*9),lmMat);q.position.set(Math.cos(a)*r,h/2,Math.sin(a)*r);q.userData.range=r;scene.add(q);landmarks.push(q);}\n\n// Generic latent atmosphere: moving parcels. Names intentionally avoid meteorological ontology.\n// Renderer reads ONLY parcel state in T1.\nconst N=72,parcels=[];\nfor(let i=0;i\u003cN;i++){const a=i*2.399,r=130+(i%13)*105;parcels.push({\n x:Math.cos(a)*r,z:Math.sin(a)*r,y:90+(i%9)*48,\n mass:.15+((i*37)%100)/100*.5, drift:.25+((i*61)%100)/100*.5,\n fall:.05+((i*29)%100)/100*.3, span:120+(i%7)*38\n});}\nconst cloudGroup=new THREE.Group();scene.add(cloudGroup);const cloudMeshes=[];\nfor(let i=0;i\u003cN;i++){const m=new THREE.Mesh(new THREE.SphereGeometry(1,10,7),new THREE.MeshLambertMaterial({color:0xd8dcdd,transparent:true,depthWrite:false,opacity:.12}));m.scale.set(parcels[i].span,34+(i%5)*9,parcels[i].span*.62);cloudGroup.add(m);cloudMeshes.push(m);}\n\nconst rainN=700,rainPos=new Float32Array(rainN*3),rainGeom=new THREE.BufferGeometry();rainGeom.setAttribute('position',new THREE.BufferAttribute(rainPos,3));\nconst rainMat=new THREE.PointsMaterial({color:0xc7e0e5,size:2.1,transparent:true,opacity:.5,depthWrite:false});const rain=new THREE.Points(rainGeom,rainMat);scene.add(rain);\nconst reeds=[];const reedGeo=new THREE.BoxGeometry(1.7,31,1.7),reedMat=new THREE.MeshStandardMaterial({color:0x9a9a70});\nfor(let i=0;i\u003c90;i++){const r=new THREE.Mesh(reedGeo,reedMat),a=i*2.399,rad=100+(i%18)*35;r.position.set(Math.cos(a)*rad,15.5,Math.sin(a)*rad);scene.add(r);reeds.push(r);}\n\n// Target evidence is accessible ONLY to the reconstructor + comparison strip.\nfunction lerpAngle(a,b,t){let d=((b-a+540)%360)-180;return(a+d*t+360)%360}\nfunction targetAt(min){let i=0;while(i\u003cOBS.length-2\u0026\u0026OBS[i+1].m\u003cmin)i++;const A=OBS[i],B=OBS[Math.min(i+1,OBS.length-1)],u=Math.max(0,Math.min(1,(min-A.m)/(B.m-A.m||1)));return{m:min,wd:lerpAngle(A.wd,B.wd,u),w:A.w+(B.w-A.w)*u,g:A.g+(B.g-A.g)*u,v:A.v+(B.v-A.v)*u,r:A.r+(B.r-A.r)*u,ceil:A.ceil+(B.ceil-A.ceil)*u,wx:u\u003c.5?A.wx:B.wx}}\n\n// Latent controller: target evidence may adjust generic parcel state, but renderer cannot read target.\n// This is deliberately a tiny inverse model, not a weather simulator.\nlet latent={flowX:0,flowZ:0,energy:.18,loading:.12,scatter:.08,lift:.42};\nfunction reconstruct(t,dt){\n const dir=t.wd*Math.PI/180,targetFX=Math.sin(dir)*(t.g/65),targetFZ=Math.cos(dir)*(t.g/65);\n const desiredEnergy=Math.min(1,t.g/65),desiredLoading=Math.min(1,t.r/1.15),desiredScatter=Math.min(1,1-t.v/10);\n latent.flowX+=((targetFX-latent.flowX)*.85)*dt;latent.flowZ+=((targetFZ-latent.flowZ)*.85)*dt;\n latent.energy+=(desiredEnergy-latent.energy)*.7*dt;latent.loading+=(desiredLoading-latent.loading)*.8*dt;latent.scatter+=(desiredScatter-latent.scatter)*.7*dt;\n // Ceiling evidence pressures parcel vertical distribution, but does not directly position visible cloud geometry.\n const desiredLift=Math.max(.08,Math.min(.85,t.ceil/7000));latent.lift+=(desiredLift-latent.lift)*.45*dt;\n}\n\n// Virtual station derives observations from latent world state.\nfunction sensor(){\n const speed=Math.hypot(latent.flowX,latent.flowZ),gust=Math.min(70,speed*65*(.72+.28*latent.energy));\n const wd=(Math.atan2(latent.flowX,latent.flowZ)*180/Math.PI+360)%360;\n const rainRate=Math.max(0,(latent.loading-.12))*1.34;\n const visibility=10*Math.exp(-latent.scatter*2.05-latent.loading*.62);\n let weightedY=0,w=0;for(const p of parcels){const near=Math.exp(-(p.x*p.x+p.z*p.z)/(2*520*520))*p.mass;weightedY+=p.y*near;w+=near;}\n const ceil=Math.max(500,(weightedY/(w||1))*7.5);\n return{wd,w:speed*42,g:gust,v:Math.max(.3,Math.min(10,visibility)),r:rainRate,ceil};\n}\nfunction renderLatent(s,dt){\n scene.fog=new THREE.FogExp2(0x75818a,.00010+latent.scatter*.0011+latent.loading*.00035);scene.background=new THREE.Color(0x75818a);\n hemi.intensity=.45+(1-latent.loading)*.8;sun.intensity=.3+(1-latent.loading)*1.0;\n for(let i=0;i\u003cN;i++){const p=parcels[i];p.x+=latent.flowX*(12+p.drift*15)*dt;p.z+=latent.flowZ*(12+p.drift*15)*dt;\n   p.y+=((70+latent.lift*620)-p.y)*(.06+p.drift*.035)*dt;\n   if(p.x\u003e1500)p.x=-1500;if(p.x\u003c-1500)p.x=1500;if(p.z\u003e1100)p.z=-1100;if(p.z\u003c-1100)p.z=1100;\n   const m=cloudMeshes[i];m.position.set(p.x,p.y,p.z);m.material.opacity=.05+latent.loading*.34+p.mass*.14;m.material.color.setHex(latent.loading\u003e.58?0x858b90:0xd8dcdd);\n }\n vane.rotation.y=-Math.atan2(latent.flowX,latent.flowZ);reeds.forEach(r=\u003e{r.rotation.z=latent.flowX*.52;r.rotation.x=latent.flowZ*.52;});\n const active=Math.floor(rainN*Math.min(1,Math.max(0,latent.loading-.1)*1.18));rain.visible=active\u003e0;\n for(let i=0;i\u003crainN;i++){const j=i*3;if(i\u003e=active){rainPos[j+1]=-100;continue}const q=((i*73)%997)/997,q2=((i*193)%991)/991,phase=(elapsed*(135+latent.energy*155)+q2*900)%900;rainPos[j]=(q-.5)*1200+latent.flowX*phase*.5;rainPos[j+1]=900-phase;rainPos[j+2]=(q2-.5)*1000+latent.flowZ*phase*.5;}rainGeom.attributes.position.needsUpdate=true;\n return s;\n}\n\n// Preserved negative control: direct evidence -\u003e presentation mapping.\nfunction renderLiteral(t,dt){\n const vis=Math.max(.1,Math.min(1,t.v/10)),dir=t.wd*Math.PI/180;\n scene.background=new THREE.Color(0x66737c);scene.fog=new THREE.FogExp2(0x66737c,.00012+(1-vis)*.0024);\n hemi.intensity=.45;sun.intensity=.45;\n cloudMeshes.forEach((m,i)=\u003e{m.position.x=parcels[i].x;m.position.z=parcels[i].z;m.position.y=Math.max(75,Math.min(800,t.ceil*.075))+(i%5)*18;m.material.opacity=.12+Math.min(1,t.r+t.g/100)*.35;});\n vane.rotation.y=-dir;reeds.forEach(r=\u003e{r.rotation.z=Math.sin(dir)*Math.min(.7,t.g/65);r.rotation.x=Math.cos(dir)*Math.min(.7,t.g/65);});\n const active=Math.floor(rainN*Math.min(1,t.r));rain.visible=active\u003e0;for(let i=0;i\u003crainN;i++){const j=i*3;if(i\u003e=active){rainPos[j+1]=-100;continue}const q=((i*73)%997)/997,q2=((i*193)%991)/991,phase=(elapsed*240+q2*900)%900;rainPos[j]=(q-.5)*1200;rainPos[j+1]=900-phase;rainPos[j+2]=(q2-.5)*1000;}rainGeom.attributes.position.needsUpdate=true;\n}\n\nlet mode='t1',elapsed=0,paused=false,last=performance.now();\nfunction evidenceStrip(t,s){\n const dpr=Math.min(devicePixelRatio,2),w=ev.clientWidth,h=ev.clientHeight;if(ev.width!==w*dpr||ev.height!==h*dpr){ev.width=w*dpr;ev.height=h*dpr}const c=ev.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,w,h);\n c.font='9px ui-monospace,monospace';c.fillStyle='#e8e0ccb0';c.fillText('TARGET  \u2500\u2500\u2500    VIRTUAL SENSOR  \u00b7\u00b7\u00b7',9,13);\n const rows=[['VIS',t.v,s.v,0,10],['GUST',t.g,s.g,0,70],['RAIN',t.r,s.r,0,1.2]];\n rows.forEach((r,k)=\u003e{const y=28+k*17;c.fillStyle='#e8e0cc55';c.fillText(r[0],9,y+3);const x0=55,x1=w-12,tx=x0+(x1-x0)*(r[1]-r[3])/(r[4]-r[3]),sx=x0+(x1-x0)*(r[2]-r[3])/(r[4]-r[3]);c.strokeStyle='#e8e0cc88';c.beginPath();c.moveTo(x0,y);c.lineTo(Math.max(x0,Math.min(x1,tx)),y);c.stroke();c.fillStyle='#e8e0cc';c.fillRect(tx-2,y-2,4,4);c.fillStyle='#8fc5d0';c.fillRect(sx-2,y-2,4,4);});\n}\nfunction resize(){renderer.setSize(innerWidth,innerHeight,false);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix()}addEventListener('resize',resize);resize();\nlet target=new THREE.Vector3(0,110,0),yaw=.72,pitch=.36,dist=1120,drag=null;\nfunction placeCamera(){camera.position.set(target.x+Math.sin(yaw)*Math.cos(pitch)*dist,target.y+Math.sin(pitch)*dist,target.z+Math.cos(yaw)*Math.cos(pitch)*dist);camera.lookAt(target)}placeCamera();\ncanvas.addEventListener('pointerdown',e=\u003e{drag={id:e.pointerId,x:e.clientX,y:e.clientY};canvas.setPointerCapture?.(e.pointerId)});\ncanvas.addEventListener('pointermove',e=\u003e{if(!drag||drag.id!==e.pointerId)return;yaw-=(e.clientX-drag.x)*.006;pitch=Math.max(.08,Math.min(1.15,pitch+(e.clientY-drag.y)*.005));drag.x=e.clientX;drag.y=e.clientY;placeCamera()});\ncanvas.addEventListener('pointerup',()=\u003edrag=null);canvas.addEventListener('pointercancel',()=\u003edrag=null);\ncanvas.addEventListener('wheel',e=\u003e{e.preventDefault();dist=Math.max(420,Math.min(2600,dist*Math.exp(e.deltaY*.001)));placeCamera()},{passive:false});\nfunction setMode(m){mode=m;document.getElementById('t1').classList.toggle('on',m==='t1');document.getElementById('t0').classList.toggle('on',m==='t0');elapsed=0;latent={flowX:0,flowZ:0,energy:.18,loading:.12,scatter:.08,lift:.42}}\ndocument.getElementById('t1').onclick=()=\u003esetMode('t1');document.getElementById('t0').onclick=()=\u003esetMode('t0');document.getElementById('restart').onclick=()=\u003esetMode(mode);\ndocument.getElementById('pause').onclick=()=\u003e{paused=!paused;document.getElementById('pause').textContent=paused?'RESUME':'PAUSE'};\nfunction frame(now){const dt=Math.min(.05,(now-last)/1000);last=now;if(!paused)elapsed=(elapsed+dt)%PLAY_SECONDS;const min=WINDOW0+(elapsed/PLAY_SECONDS)*(WINDOW1-WINDOW0),t=targetAt(min);\n let s;if(mode==='t1'){reconstruct(t,dt);s=sensor();renderLatent(s,dt)}else{renderLiteral(t,dt);s={wd:t.wd,w:t.w,g:t.g,v:t.v,r:t.r,ceil:t.ceil}}\n evidenceStrip(t,s);readout.textContent=`${String(Math.floor(min/60)).padStart(2,'0')}:${String(Math.floor(min%60)).padStart(2,'0')} \u00b7 target vis ${t.v.toFixed(1)}mi gust ${t.g.toFixed(0)}kt rain ${t.r.toFixed(2)} \u00b7 sensor vis ${s.v.toFixed(1)} gust ${s.g.toFixed(0)} rain ${s.r.toFixed(2)}`;\n renderer.render(scene,camera);requestAnimationFrame(frame)}requestAnimationFrame(frame);\n} catch(e) {window.__RW_FAIL__('module startup',e)}\n\u003c/script\u003e\n\u003cscript type=\"text/plain\" id=\"reality-weather-semantics\"\u003e\nREALITY \u2192 WEATHER \u2014 T1 / WORLD \u2192 SENSOR\n\nT0 IS PRESERVED AS NEGATIVE CONTROL\nThe first pass mapped observations directly into presentation: reported ceiling moved visible\ncloud geometry, visibility controlled fog, precipitation controlled rain, and wind controlled\nsusceptible objects. It produced a coherent animated weather chart and exposed the category\nerror: situated observations were mistaken for world state.\n\nT1 QUESTION\nCan a hidden world be adjusted so that a virtual situated sensor reproduces real evidence,\nwithout allowing the renderer to read that evidence directly?\n\nSHORT PROBE\nUse the already-established KORD 15 Jul 2024 severe passage, 19:30\u201322:00 local, compressed\nto a 45-second loop. Start with visibility, gust/wind, and precipitation as reconstruction\npressure. Ceiling is allowed to pressure the latent vertical distribution but is not rendered\nas cloud-Y.\n\nOWNERSHIP / AUTHORITY\nREAL RECORD: target evidence only.\nRECONSTRUCTOR: may read target evidence and alter generic latent state.\nLATENT WORLD: generic moving parcels + flow/loading/scatter/lift/energy; these names are\nworking capacities, not claims of recovered meteorological ontology.\nRENDERER: T1 may read latent world only. It may not read ASOS observations.\nVIRTUAL STATION: reads latent world and emits synthetic visibility, wind/gust, rain, ceiling.\nCAMERA: independent inspector; never the station.\n\nVISIBLE COMPARISON\nThe lower strip is intentionally diagnostic: target evidence versus virtual-station evidence.\nIt is not world state. Once reconstruction becomes credible it can be hidden for observation.\n\nSUCCESS CRITERION\nNot visual prettiness and not exact numerical fit. The probe succeeds if representational\nmachinery becomes reusable: freeze it, change the real day, and reconstruct by changing\nlatent state rather than rewriting the renderer.\n\nMETHOD CHANGE\nThis is reconstruction-before-invention made operational:\nREAL EVIDENCE \u2192 INVERSE PRESSURE \u2192 LATENT WORLD \u2192 VIRTUAL SENSOR \u2192 COMPARISON.\nThe latent machinery, if it generalizes, is the candidate source of semantically earned knobs\nfor later impossible/fantasy regimes.\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e"},{"id":"visual-machinery","title":"3D \u00b7 VISUAL MACHINERY","kind":"Distant Miniature / Semantic Expansion","source":"\u003c!doctype html\u003e\u003chtml lang=\"en\"\u003e\u003chead\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"\u003e\u003ctitle\u003eVisual Machinery \u00b7 T1\u003c/title\u003e\n\u003cstyle\u003e\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#202c31;color:#eee5d1;font:11px/1.5 ui-monospace,monospace}#c{display:block;width:100%;height:100%;touch-action:none}button,select,input{font:inherit;color:inherit;background:#243138;border:1px solid #a6b5ac55;border-radius:6px;min-height:38px;padding:6px 9px}button{cursor:pointer}button:hover,button.on{background:#b7b59b;color:#17282d}button:disabled{opacity:.4}select{max-width:100%}.row{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:7px}#top{position:absolute;top:10px;left:10px;right:10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;pointer-events:none}#top\u003e*{pointer-events:auto}#title{padding:6px 9px;background:#15232cdd;border-radius:6px;font-size:10px;letter-spacing:.1em}#panel{display:none;position:absolute;top:60px;left:10px;width:340px;max-width:calc(100% - 20px);max-height:calc(100% - 125px);overflow:auto;padding:12px;background:#13222af5;border:1px solid #a6b5ac44;border-radius:9px;touch-action:pan-y}#panel.op