ment.getElementById('homeLocus').onclick=()=\u003eflyToLocus(locus.point,locus.name);\nattractorMesh.userData.locusName='GRAVITY';\ndocument.getElementById('meteor').onclick=()=\u003e{meteorArmed=!meteorArmed;meteorHold=null;document.getElementById('meteor').classList.toggle('on',meteorArmed);if(meteorArmed){mode='meteor';document.querySelectorAll('[data-mode]').forEach(q=\u003eq.classList.remove('on'));}else selectMode('orbit')};\ndocument.getElementById('reset').onclick=()=\u003e{meteorArmed=false;meteorHold=null;document.getElementById('meteor').classList.remove('on');for(const f of impactFx)retireFx(f);impactFx.length=0;for(const f of meteorFx){scene.remove(f.head,f.trail);f.head.geometry?.dispose?.();f.head.material?.dispose?.();f.trail.geometry?.dispose?.();f.trail.material?.dispose?.()}meteorFx.length=0;mode='orbit';document.querySelectorAll('[data-mode]').forEach(q=\u003eq.classList.toggle('on',q.dataset.mode==='orbit'));field.set(initial);rebuild();setAttractor(false);locus.point.set(0,1,0);locus.name='CENTER';document.getElementById('homeLocus').textContent='LOCUS \u00b7 CENTER';cameraFlight=null;resetChamber()};function resize(){renderer.setPixelRatio(Math.min(devicePixelRatio,1.15));renderer.setSize(innerWidth,innerHeight,false);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();applyView()}addEventListener('resize',resize,{passive:true});\ndocument.getElementById('recover').onclick=()=\u003e{try{if(runtime.graphicsLost){graphicsStatus('browser still owns lost context \u00b7 waiting');return}stopRendering();renderer.dispose();renderer=makeRenderer();positionAttr.needsUpdate=true;normalAttr.needsUpdate=true;rockTexture.needsUpdate=true;resize();document.getElementById('fault').style.display='none';graphicsStatus('renderer rebuilt');startRendering()}catch(e){fail('manual-recover',e)}};try{rebuild();resize();graphicsStatus('ready \u00b7 retained terrain buffers \u00b7 shadows off');startRendering()}catch(e){fail('boot',e)}\n\u003c/script\u003e\n\u003cscript type=\"text/plain\" id=\"world-lab-handoff\"\u003e\nWORLD LAB V0.1 \u2014 RESILIENT CORE / CAPACITY PASS\n================================================\nTHIS PASS OPTIMIZES CAPACITY, NOT METEOR OR SWORD FIDELITY.\nThe laboratory is infrastructure for many grammars. Current meteor/sword implementations are specimens, not privileged architecture.\n\nGRAPHICS FAILURE FINDING\nThe Android/Chrome sad-face WebGL icon means the browser lost the WebGL context; it is not a Three.js UI element. JS error handlers alone cannot catch this class of failure.\n\nV0.1 CHANGES\n- WebGL context loss/restoration is explicitly observed. On loss the animation loop stops and world state remains in CPU memory. On browser restoration, terrain buffers/textures are marked dirty and rendering resumes.\n- RECOVER can rebuild the Three.js renderer after recoverable renderer-loop trouble without resetting world state.\n- Terrain now owns one retained BufferGeometry. Frequent sculpt/remesh operations update reusable DynamicDrawUsage position/normal buffers instead of disposing and replacing a GPU geometry every stroke. Buffers grow geometrically only when required.\n- Terrain normals are generated while copying triangles into the retained buffer; computeVertexNormals no longer scans spare buffer capacity.\n- Baseline shadow maps are disabled. A 2048\u00b2 dynamic shadow map was expensive persistent GPU state that did not define the laboratory's semantics. Future shadows must earn their budget.\n- Device pixel ratio is capped at 1.15 for this mobile-first lab. Resolution is a budget, not world state.\n- RESET now disposes persistent sword geometry/materials instead of merely removing their groups.\n\nCAPACITY RULE\nPrefer retained/poolable resources for high-frequency systems. Persistent semantic objects may own persistent resources. Transient effects should share/pool geometry/material machinery and have bounded populations. Never allocate GPU resources at gesture frequency when an existing buffer can be updated.\n\nRECOVERY RULE\nCPU world state is authoritative. GPU resources are a reconstructible view of it. Context loss should pause presentation, preserve the world, and reconstruct presentation when possible.\n\nWORLD LAB \u2014 V0 SHARED SPATIAL LABORATORY\n========================================\n\nPURPOSE\nThis is the current common home for the user's little-world experiments. Do not treat Living Miniatures, Touch Probes, orbital interactions, terrain deformation, procedural actors, or future perspective experiments as unrelated projects by default. They are disposable/progressive manifestations of one evolving spatial-toy vocabulary.\n\nV0 QUESTION\nCan one persistent volumetric world remain pleasant to inspect and manipulate through multiple observer perspectives while retaining the terrain behaviors and event grammars already earned in earlier probes?\n\nWORLD / PERSPECTIVE / GRAMMAR\nWORLD = substance + discrete objects + processes + accumulated history.\nPERSPECTIVE = observer/camera/interaction lens onto that same world. Changing VIEW must never rebuild, reinterpret, or mutate world state.\nGRAMMAR = a bounded capability that acts on the world: carve, raise, smooth, meteor, embedded sword, and later rip/tether/fling/extrude/rigged actors.\n\nPORTABLE CRAFT KNOWLEDGE \u2014 DO NOT RELEARN\n- Known-good Three.js browser import: https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\n- Three.js is renderer, not ontology.\n- Use visible pre-module window.error + unhandledrejection diagnostics; failures must not go silent.\n- Keep one authoritative runtime/world state. Avoid brittle shadow globals and dual ownership.\n- Scene-specific visual assets are generated/encoded in-artifact. Do not introduce external texture/model/image dependencies casually.\n- Terrain is substance. Geometry is only the current visible boundary. Positive signed density = solid; negative = empty.\n- True caves, tunnels, overhangs, craters, cuts and raised forms are topology of the same substance, not decorative meshes.\n- Camera transforms are observer transforms, not world transforms. Preserve world state across perspective changes.\n- Free inspection is valuable. God-eye panorama is a strong canonical scale, but close inspection is allowed and useful.\n- Detail can be authored above normal viewing resolution; perceptual collapse at miniature scale turns many small assertions into richness.\n- Greebling/appearance/process belong to the semantic object that gives them meaning; avoid a global decoration pass that knows every object type.\n- Directional effects should derive from explicit semantic direction/state, not incidental mesh orientation.\n- Persistent consequences belong to world state; transient FX clarify events and then die.\n- FX resource ownership must be explicit. Shared resources are not disposed by individual effects. Bound sustained transient populations on mobile.\n- Impact residue belongs to the resulting cavity/state, not stale pre-impact surface coordinates. Depth-test it so topology occludes it.\n- A probe is not allowed to redefine the thing it is probing. Promote lessons carefully; preserve local failures as evidence rather than universal law.\n\nPRESERVED DISCOVERIES / ARCHAEOLOGY\nT0.4 STATIC PAINTERLY PROBE: pulled-back miniature scale + dense object-owned geometric evidence produced a dramatic improvement even without fog. Distance is a visual budget, not a prohibition on zoom.\nT0.5 ABYSS: real topology mattered; ecology had to respect cuts; shared boundaries beat independently approximated seams; continuous wall/skirt beat spaghetti terraces.\nT0.7 DEFORMABLE SUBSTANCE: coarse signed-density field + synchronous remesh was fast and responsive on the target phone. This is the foundation used here.\nT0.8.2 METEOR RESIDUE: tiny impacts became fading Dark-Souls-like bonfires when heat/embers lived volumetrically inside the wound.\nT0.8.4.1 FX HARDENING: explicit resource ownership, shared transient geometry and bounded populations survived sustained meteor/sword abuse.\nT0.9\u2013T0.11 SEMANTIC CARVING: noun-to-shape compilation failed; iterative affordance evaluation was richer, but scalar metrics reward-hacked themselves. This branch is preserved knowledge, not the current focus.\nTOUCH T0.1: stable world substance + touch-defined topology + liberated debris + ballistic deposited material was a powerful cheap 2D interaction sketchpad.\nTOUCH SKYHOOK: touch should establish physical relationships between hand and world rather than merely map gestures to UI commands. Successful cheap touch grammars are candidates for promotion here; the brown 2D substrate is not a replacement world architecture.\n\nCURRENT WORLD\nThe current world is intentionally modest: one seeded volumetric landmass rendered from a 30\u00d722\u00d730 signed-density field. It is not the final visual target and not a claim that all future worlds share this resolution or geology.\n\nCURRENT PERSPECTIVES\nVIEW cycles PANORAMA / MINIATURE / CLOSE. They are convenience presets over one camera/world, not separate scenes. LOOK then allows free orbit; two fingers pan/pinch and wheel zoom remains available. Future situated/character perspectives should obey the same invariant: perspective does not redefine world state.\n\nCURRENT TERRAIN VERBS\nRAISE adds substance. CARVE subtracts substance. SMOOTH relaxes local density. These are direct edits to the authoritative field and can create/modify actual topology.\nMETEOR is a persistent mutually exclusive sky-rain grammar that excavates the same field and leaves bounded volumetric fading residue.\nSWORDS is a sibling sky-rain grammar whose blades embed persistently while fire/ember/smoke residue remains ephemeral.\nRESET restores the canonical seeded field and clears event artifacts. VIEW changes only observation.\n\nTOUCH / INTERACTION THESIS\nDo not start by inventing gestures. Invent physical relationships between hand and world. Cheap probes established useful candidate verbs: RIP, SPRAY, DROP, FLING, TETHER/PULL, JOIN, EXTRUDE/CHANNEL. These are interaction grammars, not a mandatory final control scheme.\nBefore inventing an in-world machine, ask whether the player's hand can simply be that machine.\n\nNEXT RICH AREA\nProcedural articulation: simple rigs with root/body/limb chains/joints/end effectors; behaviors target constraints rather than canned animation names. Deformable worlds especially reward procedural bodies because authored animation assumes authored geometry. A tiny multi-legged actor that genuinely seeks footholds on deformed terrain is a good bounded proof. Do not build a universal character system first.\n\nHANDOFF MAINTENANCE RULE\nThis embedded semantic layer is part of the artifact, not cleanup documentation. Update it whenever implementation changes architecture, ownership, interaction meaning, portable craft knowledge, or an important experimental lesson. Keep portable knowledge distinct from probe-local observations. A fresh model receiving only the latest World Lab artifact should not need to rediscover imports, boot/diagnostic discipline, terrain ontology, camera semantics, or already-paid-for behavior lessons before continuing.\n\u003c/script\u003e\u003cscript type=\"text/plain\" id=\"test-chamber-current-semantics\"\u003e\n3D TEST CHAMBER \u2014 T1 GRANULAR / CAUSAL FLOW\n\nT1.1 \u2014 COLLAPSIBLE LAB CONTROLS\nThe chamber control surface starts open but is now owned by one persistent TEST CHAMBER binary toggle. Collapsing it removes the experiment controls from the world view without changing simulation state, active interaction mode, or any world state. This is lab-local UI; the World Lab host remains ignorant of chamber controls.\n\nT1.2 \u2014 OBSERVER / EMITTER MANIPULATION\nThe chamber now separates three observer/manipulation verbs: LOOK orbits freely, DRAG CAMERA pans the observer target, and two-finger pinch continues to zoom while translating the camera target with the pinch centroid. MOVE EMITTERS directly drags either physical ball emitter across a horizontal world plane; emission originates from the emitter\u2019s live transform rather than hard-coded coordinates. Moving Source B also updates the visible A\u2192B causal link. These are observer and infrastructure manipulations only: moving the camera never mutates world state, while moving an emitter explicitly does.\n\n\nThe chamber is an independent lab. It inherits no runtime dependency from 3D VOLUMETRIC, though this first pass deliberately retained its signed-density terrain, direct deformation, camera, meteor/sword grammar, and graphics diagnostics as earned evidence.\n\nThe active question is whether visible matter/population flow remains intrinsically satisfying when the human manipulates causes rather than puppeteering outcomes. Two physical bearing streams are coupled by a collector/link/emitter chain. The link is visible and severable. A physical gate can interrupt flow. Terrain deformation changes routes. Meteors deform terrain and impart impulse to granular matter. Twenty deliberately cheap walkers share the changing terrain but pursue their own deterministic destination pressure.\n\nGranular representation is intentionally hybrid and approximate. Balls have independent position/velocity state and are rendered with instancing; high population registers reduce rendered sampling. Collision uses a cached top-surface query derived from the authoritative volumetric field, plus a cheap occupancy pile term. This means caves/overhangs are not yet full granular collision volumes and ball-ball collision is not rigid-body exact. Those are explicit compromises in service of testing causal legibility at 1K\u2192100K scale.\n\nPopulation ladder is evidence, not a score. The useful result is the largest regime where flow, interruption, rerouting and intervention remain legible and tactile.\n\nThe external first-pass specification that caused this implementation is embedded verbatim in #test-chamber-first-pass-spec so future workers can distinguish intended experiment from implementation evidence.\n\n\nT2 \u2014 CLEAN MATERIALS YARD / PRE-BUILD INTENT + IMPLEMENTATION ARCHAEOLOGY\nThe preceding T1 chamber produced unexpected evidence worth protecting: 100k bearings remained smooth; settled piles were metastable; carving a retaining lip produced slow gravity-accelerated streams; carving support from beneath a dense pile caused the population to resume falling together; meteor impulse composed temporally, with repeated impacts accelerating already-moving matter.\n\nT2 intentionally removes emitters, collectors, links, gates, swords and lemmings from the default chamber. It is a clean materials-testing yard: broad flat deformable floor, deformable perimeter containment, shallow/medium/steep grades, and a flat vertical terrain wall. No matter exists until explicitly spawned. SPAWN BALLS places the selected atomic bucket at the tapped terrain point. Buckets deliberately extend from 100 through 1M so device/perceptual limits can be discovered rather than assumed. BEARINGS constants remain the T1 baseline. Large populations retain authoritative CPU particle state while rendering is progressively sampled above the previously proven range.\n\nThe perimeter is made from the same signed-density terrain as the floor and test forms. It is not an invisible collision fence; breaching it is a legitimate experiment. Terrain brushes now have SMALL/MED/HUGE radius registers. LOOK, DRAG CAMERA, pinch zoom/pan, gravity registers, METEOR, visible diagnostics, context recovery, and the collapsible lab-local menu remain.\n\n\nT2.1 \u2014 LOCAL GRAVITY BALL\n\n\nT2.2 \u2014 LOCUS NAVIGATION / MOBILE BATTLE-ROOM CAMERA\nThe chamber became spatially interesting enough that observer manipulation itself required a semantic upgrade. FOCUS LOCUS is a mobile-first navigation verb: tapping an addressable node (currently the gravity ball) or any terrain point establishes the observer working locus and smoothly retargets the camera without moving world state. LOOK continues to orbit freely around the current locus; DRAG CAMERA continues to translate it; pinch continues to zoom and pan. FRAME LOCUS restores a useful inspection distance around the current locus without resetting world orientation. The gravity ball is the first world node participating in this grammar; future pylons and other deliberate nodes should become loci rather than inventing separate camera affordances. Empty terrain can create a temporary WORK locus, so observation does not require an object to already exist there. Principle: the world owns coordinates; the observer owns a current locus.\nA persistent visible gravity ball now occupies the center of the materials yard and can be toggled independently of global gravity. It is a softened local attractor acting directly on existing bearing velocity state, so its force composes with meteors and global gravity rather than triggering a canned orbit behavior. Its peak acceleration is deliberately below EARTH gravity: it should perturb and gather against 1g without defeating it, pull substantially against LOW gravity, and dominate MICRO gravity. This is a causal-field probe, not yet an energy-gate or pylon system.\n\nDEFERRED / DO NOT FORGET\nThe human explicitly wants a later construction grammar where pylons can be slammed into the terrain and energy gates formed between them. Do not smuggle that into this clean matter pass. Preserve it as a next experiment candidate.\n\u003c/script\u003e\n\u003c/body\u003e\u003c/html\u003e\n"},{"id":"3d-works","title":"3D \u00b7 WORKS","kind":"Three.js / Deformable Terrain + Physical Machinery Work Surface","source":"\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\u003chead\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"\u003e\n\u003ctitle\u003eWorld Lab \u2014 3D \u00b7 WORKS T0\u003c/title\u003e\n\u003cstyle\u003e\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#b9c8c7;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}#stage{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}#chamberToggle{position:fixed;left:10px;top:10px;z-index:11;min-height:40px;padding:7px 11px;border:1px solid #31413a55;border-radius:8px;background:#eee7d1e8;color:#26352e;font:700 10px ui-monospace,monospace;letter-spacing:.04em}#hud{position:fixed;left:10px;top:58px;z-index:10;max-width:min(650px,calc(100vw - 20px));padding:8px 10px;border:1px solid #31413a33;border-radius:9px;background:#eee7d1d8;color:#26352e;font-size:10px;line-height:1.35}#hud.closed{display:none}#hud b{font-size:11px;letter-spacing:.04em}.row{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}button{font:10px ui-monospace,monospace;border:1px solid #52605788;border-radius:6px;background:#f3eddc;color:#26352e;padding:6px 9px}button.on{background:#394c42;color:#f5f0df}#status{opacity:.72;margin-top:4px}#perf{opacity:.72;margin-top:2px}#gpu{opacity:.58;margin-top:2px}#note{position:fixed;right:10px;bottom:9px;color:#273a3277;font-size:10px;pointer-events:none;text-align:right}#momControls{position:fixed;z-index:12;left:10px;right:10px;bottom:max(10px,env(safe-area-inset-bottom));display:flex;gap:8px;justify-content:center;pointer-events:none}#momControls button{pointer-events:auto;flex:1 1 0;max-width:210px;min-height:48px;font-size:11px;font-weight:800;background:#f3eddcee;box-shadow:0 3px 14px #0003}#momControls button.on{background:#394c42;color:#f5f0df}#note{display:none!important}#fault{display:none;position:fixed;z-index:100;left:10px;right:10px;bottom:10px;max-height:45vh;overflow:auto;white-space:pre-wrap;padding:12px;border:2px solid #76261e;border-radius:8px;background:#f5dfcf;color:#501a16;font:12px/1.35 ui-monospace,monospace}\n\u003c/style\u003e\u003cscript\u003e(function(){window.__LM_FAIL__=(scope,err)=\u003e{const e=document.getElementById('fault');if(!e)return;const m=err\u0026\u0026(err.stack||err.message)?(err.stack||err.message):String(err);e.style.display='block';e.textContent='3D WORKS \u2014 VISIBLE FAILURE\\n['+scope+']\\n'+m};addEventListener('error',e=\u003ewindow.__LM_FAIL__('window.error',e.error||e.message));addEventListener('unhandledrejection',e=\u003ewindow.__LM_FAIL__('unhandledrejection',e.reason));})();\u003c/script\u003e\u003c/head\u003e\u003cbody\u003e\n\u003c!--\n3D \u00b7 WORKS \u2014 MOM INHERITANCE PASS 3 / QUIET PLAY SURFACE\nThis distribution view preserves the full WORKS implementation but makes first contact world-first.\nThe accumulated laboratory workbench starts collapsed. Three persistent bottom controls expose the\nsmall play grammar: WORLD cycles LOOK / RAISE / CARVE / SMOOTH; DEPLOY toggles LOOK / ARM; PAYLOAD\ncycles the active orbital payload. METEOR is one single-strike payload in that cycle rather than a\nseparate bombardment mode. Camera gestures remain available in LOOK. FPS/frame telemetry is hidden.\nTerrain and Extruder yield present as one ordinary material in this inheritance build; E8 biome\nprovenance code remains archaeological implementation, not active presentation or play semantics.\nThis is distribution-layer subtraction, not a replacement interaction architecture.\n--\u003e\n\n\u003ccanvas id=\"stage\"\u003e\u003c/canvas\u003e\u003cbutton id=\"chamberToggle\" type=\"button\" aria-expanded=\"false\"\u003eWORKS \u25be\u003c/button\u003e\u003cdiv id=\"hud\" class=\"closed\"\u003e\u003cb\u003eWORLD LAB \u2014 3D \u00b7 WORKS \u00b7 T0\u003c/b\u003e\n\u003cdiv class=\"row\"\u003e\u003cbutton data-mode=\"orbit\" class=\"on\"\u003eLOOK\u003c/button\u003e\u003cbutton data-mode=\"pan\"\u003eDRAG CAMERA\u003c/button\u003e\u003cbutton data-mode=\"focus\"\u003eFOCUS LOCUS\u003c/button\u003e\u003cbutton id=\"frameLocus\"\u003eFRAME LOCUS\u003c/button\u003e\u003cbutton id=\"homeLocus\"\u003eLOCUS \u00b7 CENTER\u003c/button\u003e\u003cbutton id=\"viewPreset\"\u003eVIEW \u00b7 MINIATURE\u003c/button\u003e\u003cbutton data-mode=\"spawn\"\u003eSPAWN BALLS\u003c/button\u003e\u003cbutton id=\"bucket\"\u003eBUCKET \u00b7 10K\u003c/button\u003e\u003cbutton data-mode=\"raise\"\u003eRAISE\u003c/button\u003e\u003cbutton data-mode=\"carve\"\u003eCARVE\u003c/button\u003e\u003cbutton data-mode=\"smooth\"\u003eSMOOTH\u003c/button\u003e\u003cbutton id=\"brush\"\u003eBRUSH \u00b7 MED\u003c/button\u003e\u003cbutton id=\"meteor\"\u003e\u2604 METEOR\u003c/button\u003e\u003cbutton id=\"payloadKind\"\u003ePAYLOAD \u00b7 THUMPER\u003c/button\u003e\u003cbutton id=\"payloadCall\"\u003eCALL DOWN\u003c/button\u003e\u003cbutton id=\"probeKind\"\u003ePROBE \u00b7 IK WALKER\u003c/button\u003e\u003cbutton id=\"probeCall\"\u003eDROP PROBE\u003c/button\u003e\u003c/div\u003e\n\u003cdiv class=\"row\"\u003e\u003cbutton id=\"gravity\"\u003eG \u00b7 EARTH\u003c/button\u003e\u003cbutton id=\"attractor\"\u003eATTRACTOR \u00b7 OFF\u003c/button\u003e\u003cbutton id=\"clearBalls\"\u003eCLEAR BALLS\u003c/button\u003e\u003cbutton id=\"recover\" title=\"Rebuild renderer after a recoverable graphics failure\"\u003eRECOVER\u003c/button\u003e\u003cbutton id=\"reset\"\u003eRESET WORKS\u003c/button\u003e\u003cbutton id=\"terrainShuffle\"\u003eSHUFFLE TERRAIN\u003c/button\u003e\u003cbutton id=\"waterToggle\"\u003eWATER \u00b7 OFF\u003c/button\u003e\u003cbutton id=\"wondersToggle\"\u003eWONDERS \u00b7 OFF\u003c/button\u003e\u003cbutton id=\"civToggle\"\u003eCITIES \u00b7 OFF\u003c/button\u003e\u003cbutton id=\"civPump\"\u003eCITY MATTER\u003c/button\u003e\u003c/div\u003e\n\u003cdiv id=\"status\"\u003ebooting volumetric field\u2026\u003c/div\u003e\u003cdiv id=\"flow\"\u003ematter: starting\u2026\u003c/div\u003e\u003cdiv id=\"perf\"\u003emeteor profiler: waiting for impact\u2026\u003c/div\u003e\u003cdiv id=\"gpu\"\u003egraphics: starting\u2026\u003c/div\u003e\u003c/div\u003e\u003cdiv id=\"momControls\" aria-label=\"WORKS play controls\"\u003e\u003cbutton id=\"momWorld\"\u003eWORLD \u00b7 LOOK\u003c/button\u003e\u003cbutton id=\"momDeploy\"\u003eDEPLOY \u00b7 LOOK\u003c/button\u003e\u003cbutton id=\"momPayload\"\u003ePAYLOAD \u00b7 THUMPER\u003c/button\u003e\u003cbutton id=\"momReset\"\u003eRESET\u003c/button\u003e\u003c/div\u003e\u003cpre id=\"fault\"\u003e\u003c/pre\u003e\u003cdiv id=\"note\"\u003eFPS \u003cspan id=\"fps\"\u003e--\u003c/span\u003e \u00b7 FRAME \u003cspan id=\"frameMs\"\u003e--\u003c/span\u003e ms\u003c/div\u003e\n\u003cscript type=\"module\"\u003e\nimport * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';\nconst canvas=document.getElementById('stage'),status=document.getElementById('status'),perf=document.getElementById('perf'),fpsEl=document.getElementById('fps'),frameMsEl=document.getElementById('frameMs'),fail=(s,e)=\u003ewindow.__LM_FAIL__(s,e),clamp=(x,a,b)=\u003eMath.max(a,Math.min(b,x));\nconst chamberToggle=document.getElementById('chamberToggle'),chamberHud=document.getElementById('hud');\nfunction setChamberMenu(open){chamberHud.classList.toggle('closed',!open);chamberToggle.setAttribute('aria-expanded',String(open));chamberToggle.textContent=open?'WORKS \u25b4':'WORKS \u25be';}\nchamberToggle.addEventListener('click',e=\u003e{e.stopPropagation();setChamberMenu(chamberHud.classList.contains('closed'));});\nsetChamberMenu(false);\nclass RNG{constructor(s=1){this.s=s\u003e\u003e\u003e0||1}next(){let x=this.s;x^=x\u003c\u003c13;x^=x\u003e\u003e\u003e17;x^=x\u003c\u003c5;this.s=x\u003e\u003e\u003e0;return this.s/4294967296}}\nfunction hash2(x,y,s=0){let n=(Math.imul(x|0,374761393)+Math.imul(y|0,668265263)+Math.imul(s|0,1442695041))|0;n^=n\u003e\u003e\u003e13;n=Math.imul(n,1274126177);return((n^(n\u003e\u003e\u003e16))\u003e\u003e\u003e0)/4294967295}function noise(x,y,s=0){const ix=Math.floor(x),iy=Math.floor(y),fx=x-ix,fy=y-iy,u=fx*fx*(3-2*fx),v=fy*fy*(3-2*fy),a=hash2(ix,iy,s),b=hash2(ix+1,iy,s),c=hash2(ix,iy+1,s),d=hash2(ix+1,iy+1,s);return TH