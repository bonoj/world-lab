croll-behavior-x:contain}#palette::-webkit-scrollbar{display:none}.swatch{flex:0 0 46px;width:46px;height:46px;padding:0;border-radius:50%;border:3px solid #ffffff26;box-sizing:border-box;touch-action:pan-x}.swatch.on{outline:3px solid #f2ead2;outline-offset:2px}.paletteAction{flex:0 0 auto;height:46px;padding:0 12px}#fail{display:none;position:fixed;z-index:99;left:10px;right:10px;bottom:10px;max-height:45%;overflow:auto;white-space:pre-wrap;background:#351717;color:#ffd2c8;border:1px solid #ff8c78;padding:12px;border-radius:8px;font:12px/1.4 ui-monospace,monospace}\n\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\n\u003ccanvas id=\"c\"\u003e\u003c/canvas\u003e\n\u003cbutton id=\"toolToggle\" type=\"button\" aria-expanded=\"true\"\u003eWALK \u25be\u003c/button\u003e\n\u003cdiv id=\"hud\" class=\"open\"\u003e\u003cb\u003e2D \u00b7 EXTENSIBLE WORLD \u2014 FIRST INHABITED STRIP\u003c/b\u003e\n\u003cdiv id=\"status\"\u003ea road reaches a declining coast\u003c/div\u003e\n\u003cdiv class=\"row\"\u003e\u003cbutton data-mode=\"walk\" class=\"on\"\u003eWALK\u003c/button\u003e\u003cbutton data-mode=\"dig\"\u003eDIG\u003c/button\u003e\u003cbutton data-mode=\"timber\"\u003eTIMBER\u003c/button\u003e\u003cbutton data-mode=\"lamp\"\u003eLAMP\u003c/button\u003e\u003cbutton id=\"home\"\u003eFIND ME\u003c/button\u003e\u003cbutton id=\"reset\"\u003eRESET\u003c/button\u003e\u003cbutton id=\"export\"\u003eEXPORT EVIDENCE\u003c/button\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"hint\" style=\"bottom:74px\"\u003etap a color to finger-paint directly into world coordinates\u003cbr\u003epaint is evidence, not encoded semantics\u003c/div\u003e\n\u003cdiv id=\"palette\" aria-label=\"finger paint pigments\"\u003e\u003c/div\u003e\n\u003cpre id=\"fail\"\u003e\u003c/pre\u003e\n\u003cscript\u003e\nconst __toolToggle=document.getElementById('toolToggle'),__hud=document.getElementById('hud');\nfunction __setToolsOpen(open){__hud.classList.toggle('open',open);__toolToggle.setAttribute('aria-expanded',String(open));}\n__toolToggle.addEventListener('click',e=\u003e{e.stopPropagation();__setToolsOpen(!__hud.classList.contains('open'));});\n__hud.addEventListener('click',e=\u003e{const b=e.target.closest\u0026\u0026e.target.closest('[data-mode]');if(b)__toolToggle.textContent=b.textContent+' \u25be';});\n\n/*\n2D \u00b7 EXTENSIBLE WORLD \u2014 T0.6 / REUSABLE ATMOSPHERE KIT\n\nThis README is intentionally invisible at runtime and extensible in-place.\nIt is the lab's semantic continuity surface, not user-facing instructions.\n\nSTATUS\nIndependent primary World Lab laboratory. It does not inherit 2D \u00b7 SUBSTANCE.\nThe first registration-only T0 protected the ontology. T0.1 spends that freedom\non one bounded inhabited strip rather than on a general engine.\n\nCENTRAL QUESTION\nCan a crude persistent 2D world begin to feel like somewhere before a reader is\nvisible, using prose only as semantic pressure on what the substrate bothers to\nrepresent?\n\nCURRENT PROBE\nA horizontally traversable coastal strip with:\n- one persistent traveler;\n- several crude inhabitants with local wandering/rest behavior;\n- terrain that can be excavated;\n- timber that can be placed as world structure;\n- lamps that establish small local pools of night-readable space;\n- a road, river/bridge, declining settlement, marsh and sea as continuous places;\n- camera travel independent of traveler movement.\n\nThe point is not to illustrate Innsmouth. The prose is allowed to pressure the\nworld toward roads, decay, water, bridges, roofs, industry, sparse life and a\ncoast. Those become reusable world vocabulary rather than scene illustration.\n\nREADER\nThe reader is deliberately absent on-screen. A small public-domain prose seed\nfrom H. P. Lovecraft's The Shadow Over Innsmouth (Project Gutenberg #73181) is\nembedded below as source pressure. Later reading machinery should not be assumed\nto require rebuilding this world.\n\nOWNERSHIP\nterrain[] = authoritative editable ground profile.\nstructures[] = persistent placed/built world objects.\ntraveler = persistent situated moving body.\ninhabitants[] = cheap local agents; not an NPC architecture.\ncameraX = observer state, not world state.\npaintStrokes[] = persistent uninterpreted marks in world coordinates. Color carries no encoded meaning.\nsoilPatches[] = local ground material with moisture, not a global terrain repaint.\nplants[] = persistent individual living things whose growth responds to local moisture.\nweather = local atmospheric actors and precipitation state; rain is physical world-space evidence.\nworldTime = slow environmental phase used by light/weather/life, not a quest clock.\nbiomeRegions[] = soft world-local region descriptions whose visuals/affordances can differ without becoming a universal biome taxonomy.\nbackgroundRanges[] = non-walkable depth/composition evidence; mountains may remain cheap silhouettes until more fidelity is earned.\nlakes[] = world-local water regions that interrupt ordinary walking. Bridges can restore traversable continuity across them.\nforestBands[] = spatial vegetation pressure, currently realized as cheap layered tree masses rather than an ecology engine.\n\nINTERACTION\nWALK: tap traversable ground to commit the traveler to a destination.\nDIG: carve the local terrain profile.\nTIMBER: add a rough beam/platform where touched.\nLAMP: place a persistent light.\nDrag empty sky horizontally to inspect/travel without teleporting the traveler.\nPAINT: choosing any pigment enters one fixed finger-paint mode. No brush taxonomy, opacity, shape tools, or color semantics.\nEXPORT EVIDENCE: emits a self-contained HTML specimen containing the full world strip bitmap, current viewport bitmap, complete authoritative world state, all paint strokes, camera/viewport metadata, palette, and this lab semantic document. It is a handoff specimen, not a canonical save/load system.\n\nBOUNDARIES\nDo not generalize this into an infinite chunk engine, settlement simulator,\nreader framework, NPC framework, toy editor, or material taxonomy yet.\nThe strip is intentionally finite but wider than the screen. \"Extensible\" means\nthe substrate can gain vocabulary and space without changing identity; it does\nnot require literal infinity.\n\nFAILURE ARCHAEOLOGY \u2014 T0.1.1\n- T0.1 initially mounted its HTML/HUD but its world and controls were inert because\n  the lab script had a JavaScript parse error: unary '-' was applied directly to an\n  exponentiation expression in two Gaussian terrain terms. Since parsing failed before\n  the lab's own error handlers installed, the failure was silent inside the iframe.\n- Lesson: host-safe source encoding is not enough; embedded lab source also needs a\n  pre-mount syntax check or an outer iframe bootstrap capable of reporting parse failure.\n\nINVARIANTS\n- Independent lab, shared World Lab project.\n- Visible diagnostics.\n- World state and observer state remain distinct.\n- New affordances must earn themselves through use.\n- Prose pressures representation; it does not dictate a literal illustration.\n- Keep this README current as the lab learns.\n- Handoff capture is broader than the viewport: offscreen world state and marks are first-class evidence.\n- Paint is a spatial request language. Meaning is inferred from marks relative to each other and to world evidence; palette colors never map to built-in features.\n- No canonical save-state/migration machinery yet. Evolving implementations may reincarnate the world from evidence.\n\nT0.3 \u2014 CRAYON BECOMES CAUSAL WORLD\nThe first exported crayon specimen was interpreted by composition rather than palette legend: cloud forms above falling blue marks above a bounded brown ground patch containing several distinct living marks, with a sun sharing the sky. The cheapest honest promotion is causal, not cosmetic. A local soil patch can hold moisture; world-space clouds can precipitate; raindrops collide with terrain and wet soil; individual plants consume moisture and grow; a slow sun/time phase changes illumination and helps weather transition. These are intentionally tiny systems, not a generalized climate, hydrology, farming, biome, or material engine. The original paint vocabulary remains available and uninterpreted.\n\nT0.4 \u2014 WEATHER ESCAPES CONTAINMENT / CAUSAL LEGIBILITY\nA second painted specimen used large directional sky marks while observing the ecology probe. Subsequent verbal clarification confirmed the marks were asking for two related promotions: the sun should visibly traverse the sky as a compressed day/night cycle, and weather should operate across the entire strip rather than remain a garden demonstration. The sparse original rain and subtle plant changes also exposed a perceptual failure: causal state can exist without being available to play. T0.4 therefore makes the same tiny systems louder rather than deeper. A day lasts about 48 seconds; the sun crosses the observer sky and night visibly arrives; multiple world-space weather cells advect across the full strip; rain is dense and slanted by a crude shared wind; impacts leave temporary wet traces on any terrain and strongly wet local soil; plant growth and health transitions are accelerated and visually staged. No clock, moisture meter, weather icon, growth bar, forecast, farming UI, or generalized climate model is added. The world itself must make causality readable.\n\nT0.6 \u2014 REUSABLE ATMOSPHERE KIT / SOFT INFERRABLES\nA later crayon specimen was initially misread as another request for dynamics. Human clarification established a higher-level use: systems-mode drawing can teach the collaborating worldbuilder kinds of places and relationships it may later choose to instantiate from prose or other pressure. The marks suggested background mountains/depth, foreground forest, a lake whose water should not be ordinary walkable ground, a bridge that restores traversal across it, and a beach-like regional transition. The headline is BIOMES, but deliberately not as a rigid generator or pigment legend. A region may coherently vary terrain, vegetation, atmosphere, materials, structures, depth treatment, and affordances. Context decides whether a future mark means \u201clearn this vocabulary,\u201d \u201cbuild this here now,\u201d \u201cplan this,\u201d or something else. Geometry, color, adjacency, current activity, existing world state, recent history, and prose may all contribute evidence; none is individually authoritative.\n\nThis incarnation installs cheap reusable examples rather than a universal biome engine: layered background mountain silhouettes, a foreground forest band, a lake basin with non-walkable water, a spanning bridge that becomes the walkable surface across that interruption, and a beach transition before the coast. Existing weather/day systems remain intentionally legible. These representations are allowed to stay ugly while new. Later beauty work should add higher-fidelity registers without deleting the cheap ancestors.\n\nTRANSFERABLE LESSON\nA system is not successfully externalized merely because its state exists. Its causal behavior must be perceptually available at the spatial scale and temporal tempo of play. Spatial marks can request forces, transformations, extent, and legibility\u2014not only entities.\n\nNEW QUESTION\nCan world-scale weather and compressed environmental time become legible enough that the player can reason about causality by watching, then steer the next system by marking the world again?\n\nT0.6.13 \u2014 FIXED PRECIPITATION CLOCK\nThe first clean rebuild still visibly reversed. Inspection found the actual chronology\nbug: candidate birth interval was derived from current rain amount. As rain intensity\nchanged, the interval changed, which renumbered generations and retroactively changed\ntheir computed birth times. Current fall speed also varied with rain amount. The renderer\ntherefore violated its own apparent `y = startY + vy * age` invariant because both `age`\nand `vy` were being recomputed from changing weather.\n\nCandidate precipitation now uses one immutable 80 ms world-time birth clock. Cell +\ngeneration permanently identify an event and its seeded birth offset and vertical speed.\nRain amount is only a density gate over those fixed candidates; it cannot alter their\nbirth chronology or vertical motion. Natural vertical velocity is event-owned, positive,\nand constant. Present weather may change opacity, streak appearance, and severe horizontal\nwind response, but never Y position.\n\nThis is the first rain repair based on the actual observed reversal mechanism rather than\na presumed sign/wind/phase failure.\n\nT0.6.12 \u2014 PRECIPITATION RESET / BABY-BATHWATER REBUILD\nThe accumulated wind/rain renderer from T0.6.5\u2013T0.6.11 was discarded after repeated\nfield-wide stop-and-reverse behavior survived local trajectory repairs. Cloud appearance,\natmospheric regions, their evolution, and the sixty-second observational specimen were\npreserved.\n\nRain was rebuilt from a deliberately smaller contract. Atmospheric precipitation exposes\nonly amount plus an explicit severe-wind register. Amount controls births. Every natural\ndrop has one bounded positive vertical speed and exactly one vertical-motion equation:\n`y = startY + vy * age`, with `vy \u003e 0`. Camera, density, cloud state, wind and drawing\ncannot modify the sign. There is no modulo trajectory, vertical phase, gravity flag,\ngeneral wind inheritance, per-drop wandering wind, or reverse-rain path in the ordinary\nrenderer.\n\nWind was rebuilt as precipitation response rather than shared motion. Rain ignores it\nentirely below a high severe-wind threshold. Above threshold it contributes only a\ncoherent positive horizontal X component; it never enters Y. Visual streak length is\nbounded separately from physical speed.\n\nFuture anomalous upward rain remains a desirable capability, but it is intentionally\nabsent from this natural-rain implementation. When revisited it should be a separate\nexplicit anomalous precipitation behavior rather than a latent sign switch inside\nordinary weather.\n\nT0.6.11 \u2014 COHERENT GALE THRESHOLD\nPer-drop birth wind was rejected because it removed synchronized oscillation by making\nrain direction locally wishy-washy. Ordinary rain should be gravity-dominant and visually\ncoherent.\n\nCloud/system drift and precipitation deflection now have separate response curves.\nRain has a strong-wind dead zone: ordinary atmospheric motion can move weather and clouds\nwithout visibly canting drops. Only coherent local rain wind beyond a gale-like threshold\ncontributes horizontal velocity. Above that threshold nearby drops share one direction,\nwith only tiny seeded variance for texture.\n\nThe sixty-second specimen keeps rain essentially vertical through its lower and middle\nregisters. A one-direction coherent wind develops only during the severe late phase,\nproducing slashing rain, then eases without reversing. This tests gale deflection without\nmaking changing wind direction part of the precipitation probe.\n\nT0.6.15 \u2014 CLEANUP REGRESSION REPAIR\nv0.11.2 incorrectly removed the `precipParticles=[]` declaration while retaining live\naliases/export references to that presentation array. The declaration is restored.\nNo rain chronology, motion, wind, cloud, or rendering behavior is changed.\n\nT0.6.14 \u2014 CLEAN WEATHER BASELINE\nDead legacy rain helpers/state/export fields removed. No behavioral change.\n\nT0.6.10\u2013T0.6.13 \u2014 RAIN ARCHAEOLOGY \u2192 CLEAN BASELINE\nSeveral successive rain probes exposed a chronology bug rather than a gravity/sign bug.\nThe failed lineage tried birth-sampled wind, bounded velocity, deterministic generations,\na gale threshold, and finally a precipitation reset. The decisive failure was allowing\ncurrent rain intensity to alter the event interval: generation numbering and computed\nbirth times changed underneath already-visible rain, producing coherent slow \u2192 stop \u2192\nreverse motion despite locally positive vertical velocity.\n\nCURRENT RAIN CONTRACT:\n- Candidate births use one immutable 80 ms world-time clock.\n- `(world cell, generation)` permanently identifies a candidate event.\n- Seeded birth offset and vertical velocity are stable for that event.\n- Natural `vy` is positive and constant; `y = startY + vy * age` is the sole Y-motion law.\n- Rain amount gates candidate visibility/density only; it does not own chronology or motion.\n- Ordinary atmospheric/cloud drift does not steer rain.\n- Explicit severe-wind response has a large dead zone and affects X only.\n- Streak appearance is bounded presentation and cannot feed back into position.\n- Shelter clips rain against world geometry.\n- Upward/anomalous precipitation is intentionally absent from ordinary rain. If restored,\n  it should be a separate explicit behavior, not a latent sign switch.\n\nThe cloud/atmospheric field and retained 60-second weather specimen remain authoritative;\nthis cleanup changes no weather behavior.\n\nT0.6.4 \u2014 RETAINED WEATHER SPECIMEN\nThe visible vertical sampling grid from the first field renderer was rejected as a\npresentation artifact. The scalar field remains authoritative but invisible; broad\ngradient consequences replace column-by-column field visualization.\n\nOne intentionally retained testCycle atmospheric region sits near the starting locus.\nIt traverses fair/building/overcast/hard-rain/weakening/clearing regimes in roughly\n20 seconds, continuously rather than through buttons or named runtime states. This is\nan observational specimen: a cheap persistent way to inspect the entire atmospheric\nvocabulary while it evolves. It is not a universal weather clock or player command.\n\nT0.6.3 \u2014 ATMOSPHERIC FIELD / PAINTERLY INTERPRETATION\nThe prior cloud-as-emitter model was rejected after inspection. weatherCells[] now\nrepresent evolving world-space atmospheric regions, not visible cloud objects.\nTheir broad weighted influence produces coherent non-rectangular weather edges.\nA region can build, rain, weaken, and clear without being replaced by a different\nontological object.\n\nPresentation is deliberately split across spaces. World weather space is authoritative.\nPainterly cloud masses and middle-distance haze interpret it. Individual rain streaks\nare cheap ephemeral viewport presentation sampled from atmosphereAt(worldX), so free\ncamera pan does not detach rain from geography. Substantial roofs/terrain provide a\ncheap rain-blocking height query so precipitation does not visibly pass through shelter.\nThe camera remains independent of the traveler in this lab; that is an affordance of\nthis experiment, not a World Lab rule.\n\nClouds render through a low-resolution aggregate surface so construction primitives\ncollapse into broad masses rather than procedural cauliflower. Beauty is evaluated at\nthe composition level: silhouette, value, mass, illuminated edge, haze, and transition.\n\nT0.6.2 \u2014 TOUCH ARBITRATION / LEGIBLE STORM ENCOUNTER\nLab controls start open and retain user-controlled disclosure state; selecting a tool\ndoes not collapse the workbench. Canvas touch begins ambiguous: crossing a small\nmovement threshold promotes the gesture to camera manipulation and cancels the tap\naction for that gesture. This arbitration belongs to the lab, not the host.\n\nWeather must be perceptually available at play tempo. One moving storm is deliberately\nassertive enough to read as an approaching regional event: cloud mass, distant rain\ncurtain, local streaks, impacts/wetness, then departure. There is no weather command;\nthe point is encounter, not demonstration. Cloud morphology and precipitation remain\nrelated atmospheric facts rather than one object type implying the other.\n\nT0.6.1 \u2014 LAB-OWNED CONTROLS / FULL-STAGE WORLD\nThe host chooses laboratories; this lab alone owns its experimental controls.\nIts control surface collapses by default and expands temporarily over the world.\nThis is a lab-local interface decision, not a host toolbar convention.\n\nT0.6 \u2014 REUSABLE ATMOSPHERE KIT / TEMPORARY PRODUCTIONIZATION\nThe strip has outlived its role as a destination. It is now primarily a proving\nground for discovering what toy worlds can look and feel like. This pass therefore\ndoes not repair every incongruity in the inherited geography. It productionizes\na few earned atmospheric systems so the worldbuilder can wield them later at a\nhigher visual register.\n\nATMOSPHERE OWNERSHIP\nweatherCells[] own moving regional atmospheric conditions: cloud family,\ncoverage/intensity, precipitation kind, and local phase. They do not own terrain,\nplants, the sun, or traversal.\nprecipParticles[] own short-lived rain/snow presentation and motion.\nwind remains a small shared world field sampled independently by clouds and\nprecipitation; future smoke, foliage, waves, cloth, debris, etc. may sample the\nsame field without Weather knowing they exist.\nworldTime/daylight remain environmental facts. This pass does not redesign the\nexisting sun trajectory. Atmosphere samples available light; it does not own it.\nSurface wetness and soil moisture continue to react to rain impacts as separate\nworld systems.\n\nCLOUD VOCABULARY\nWeather cells can now realize several cheap particle/puff families: wispy high\ncloud, fair cumulus, broad overcast, and heavy storm mass. These are procedural\nvisual grammars rather than baked assets. Coverage, depth, softness, altitude,\nscale, and internal drift vary per cell.\n\nPRECIPITATION VOCABULARY\nPrecipitation is no longer synonymous with one cyan rain stroke. Cells may be\ndry, drizzle/light rain, heavy rain, or snow. Rain ranges from fine/fuzzy depth\nstreaks to discrete heavy drops; snow drifts and visibly samples wind. Intensity\nis continuous enough to produce variation without creating a meteorology engine.\n\nFIDELITY LESSON\nUgly-but-legible remains the preferred birth state for new ideas. Earned systems\nmay later gain reusable presentation grammars without deleting their cheap\nancestors. The worldbuilder should eventually be able to choose gesture, sketch,\nprimitive system, established grammar, or authored composition according to the\nworld and activity.\n\nCOMMUNICATION LESSON\nFinger paint and full evidence export are affordances, not privileged protocols.\nUse the cheapest communication channel that preserves relevant evidence: a mark,\na screenshot, a sentence, raw state, or a complete handoff specimen. Spatial\nevidence remains valuable when spatial ambiguity is the information.\n\nCURRENT DIRECTION\nThe valuable product of this proving ground is not its geography. It is portable\nworldbuilding vocabulary, composition constraints, interaction lessons, and\nmultiple fidelity registers. Future blank-world tests should ask what survives\nwhen this particular strip is discarded.\n\nPROSE PRESSURE \u2014 PUBLIC DOMAIN IN THE USA / PROJECT GUTENBERG #73181\n\"The vast huddle of sagging gambrel roofs and peaked gables conveyed with\noffensive clearness the idea of wormy decay...\"\n\"Stretching inland I saw the rusted, grass-grown line of the abandoned railway...\"\n\"Here and there the ruins of wharves jutted out from the shore...\"\n*/\nconst fail=document.querySelector('#fail');\nfunction showFail(kind,e){fail.style.display='block';fail.textContent='2D EXTENSIBLE WORLD \u2014 VISIBLE FAILURE\\n['+kind+']\\n'+(e?.stack||e?.message||String(e));}\naddEventListener('error',e=\u003eshowFail('window.error',e.error||e.message));\naddEventListener('unhandledrejection',e=\u003eshowFail('unhandledrejection',e.reason));\n\nconst c=document.querySelector('#c'),g=c.getContext('2d',{alpha:false});\nlet W=1,H=1,dpr=1,cameraX=0,mode='walk',drag=null,last=performance.now(),capturingFullStrip=false;\nconst PALETTE=['#e53935','#f57c00','#f6d743','#9acd32','#2e9b50','#168f88','#28c7d9','#2868d7','#7048b8',