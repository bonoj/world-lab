nicalProbes(){for(const p of mechanicalProbes)scene.remove(p.g);mechanicalProbes.length=0}\n\n\n/* E1 PHASE 2 \u2014 MECHANICAL FAN-OUT\n   Phase 1 passed in play: moving geometry can do persistent work on ordinary WORKS bearings.\n   This batch stresses that truth through different arrangements. Each specimen remains local and\n   intentionally crude. Shared architecture is NOT inferred merely because several things move.\n\n   FLIPPER  \u2014 angular impulse.\n   JAWS     \u2014 opposed contact / temporary containment.\n   TUMBLER  \u2014 continuous rotation / lift-and-spill transport.\n   LEG      \u2014 articulated contact / body support.\n   TENDON   \u2014 actuation expressed as changing distance between attachment points.\n\n   Bearings remain the diagnostic material. These probes are allowed to fail visibly.\n*/\nconst probeGrey=new THREE.MeshStandardMaterial({color:0x70777c,roughness:.72,metalness:.22});\nconst probeOrange=new THREE.MeshStandardMaterial({color:0xd7772a,roughness:.58,metalness:.12});\nconst probeBone=new THREE.MeshStandardMaterial({color:0xb9a982,roughness:.82,metalness:.02});\nconst probeMuscle=new THREE.MeshStandardMaterial({color:0x7e4d66,roughness:.8,metalness:.02});\n\nfunction addProbe(type,x,z){\n if(type==='LINEAR ACTUATOR')return buildLinearActuatorProbe(x,z);\n const y=payloadSupportY(x,z),g=new THREE.Group();g.position.set(x,y,z);scene.add(g);\n const p={id:'probe-'+nextEntityId++,type,g,born:performance.now(),phase:0,forwardLocal:new THREE.Vector3(0,0,1)};mechanicalProbes.push(p);\n if(type==='FLIPPER'){\n   pbox(g,3.6,.32,2.8,0,.16,0,probeGrey);\n   const pivot=new THREE.Group();pivot.position.set(0,.42,-1.05);g.add(pivot);\n   const deck=pbox(pivot,3.0,.22,2.5,0,0,1.15,probeOrange);\n   pcyl(g,.22,.22,3.35,0,.48,-1.05,probeGrey,8).rotation.z=Math.PI/2;\n   p.pivot=pivot;p.deck=deck;p.prevAngle=0;\n }else if(type==='JAWS'){\n   pbox(g,4.4,.3,3.0,0,.15,0,probeGrey);\n   const left=new THREE.Group(),right=new THREE.Group();left.po