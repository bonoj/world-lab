, 0).applyAxisAngle(V(0, 1, 0), d.mesh.rotation.y));\n      droneDummy.rotation.set(Math.PI / 2, d.mesh.rotation.y, 0);\n      droneDummy.scale.set(1, 1, 1);\n      droneDummy.updateMatrix();\n      droneRotors.setMatrixAt(i * 2 + side, droneDummy.matrix);\n    }\n  });\n  for (const m of [droneBodies, droneWings, droneRotors])\n    m.instanceMatrix.needsUpdate = true;\n}\n\nfunction moveToward(pos, target, step) {\n  const d = target.clone().sub(pos),\n    len = d.length();\n  pos.addScaledVector(d, len \u003c= step ? 1 : step / len);\n  return len \u003c= step;\n}\nfunction intakeRoom(c, cargo) {\n  if (c.caps.includes(\"zip\") \u0026\u0026 cargo.stage === \"raw\") {\n    const raw = inventory(c)\n      .filter((l) =\u003e l.stage === \"raw\")\n      .reduce((n, l) =\u003e n + qty(l.comp), 0);\n    // R1.3.10: only material already admitted plus this cargo matters.\n    // Other waiting drones do not reserve future intake room.\n    return raw + qty(cargo.comp) \u003c= c.capacity * 0.12;\n  }\n  return true;\n}\nfunction updateDrones(dt) {\n  for (const d of world.drones) {\n    if (!d.home.enabled \u0026\u0026 !d.cargo) {\n      if (d.target) d.target.claim = null;\n      d.target = null;\n      d.state = \"docked\";\n      moveToward(d.pos, port(d.home), dt * 10);\n      continue;\n    }\n    if (d.cargo) {\n      // R1.3.2: collection has one earned civilization intake. Drones do not\n      // opportunistically deposit raw cargo into any city with spare capacity.\n      // Unzip currently owns the intake capability; downstream movement begins only\n      // after that cargo has entered the processing chain.\n      // R1.3.8: destination and admission are different questions.\n      // A loaded collector always flies to the civilization's intake (Unzip).\n      // Intake capacity may delay unloading at the interface, but must never strand\n      // cargo over the extraction site.\n      const receiver = world.cities.find(\n        (c) =\u003e c.enabled \u0026\u0026 c.caps.includes(\"intake\"),\n      );\n      if (!receiver) {\n        d.receiver = null;\n        d.state = \"holding cargo \u00b7 intake offline\";\n        continue;\n      }\n      d.receiver = receiver;\n      const target = port(receiver);\n      d.state = \"carrying \u2192 intake\";\n      moveToward(d.pos, target, dt * 11);\n\n      const canUnload =\n        intakeRoom(receiver, d.cargo) \u0026\u0026\n        amount(receiver) + reserved(receiver, d.cargo) + qty(d.cargo.comp) \u003c= receiver.capacity;\n\n      if (d.pos.distanceTo(target) \u003c= 3.5 \u0026\u0026 canUnload) {\n        d.cargo.owner = receiver;\n        d.cargo.pos.copy(target);\n        d.cargo = null;\n        d.receiver = null;\n        d.target = null;\n        d.state = \"returning home\";\n        world.delivered++;\n      } else {\n        if (d.pos.distanceTo(target) \u003c= 3.5 \u0026\u0026 !canUnload)\n          d.state = \"holding cargo \u00b7 intake backpressure\";\n        d.cargo.pos.copy(d.pos).add(V(0, -0.6, 0));\n      }\n    } else {\n      // R1.3.9: every completed delivery closes the work cycle at Drone City.\n      // A drone must physically return home before it may claim another ground lot.\n      if (d.state === \"returning home\") {\n        const homeTarget = port(d.home);\n        if (moveToward(d.pos, homeTarget, dt * 10)) {\n          d.state = \"seeking\";\n        }\n        continue;\n      }\n      if (!d.target || d.target.owner !== \"ground\") {\n        d.target = world.lots\n          .filter((l) =\u003e l.owner === \"ground\" \u0026\u0026 !l.claim \u0026\u0026 qty(l.comp) \u003e 0.1)\n          .sort(\n            (a, b) =\u003e\n              a.pos.distanceToSquared(d.pos) - b.pos.distanceToSquared(d.pos),\n          )[0];\n        if (d.target) d.target.claim = d;\n      }\n      if (!d.target) {\n        d.state = \"waiting for exposed matter\";\n        const a = world.time * 0.15 + d.id;\n        moveToward(\n          d.pos,\n          port(d.home).add(V(Math.cos(a) * 9, 3, Math.sin(a) * 9)),\n          dt * 3,\n        );\n        continue;\n      }\n      d.state = \"collecting\";\n      const target = d.target.pos.clone().add(V(0, 1, 0));\n      const ground = terrain.height(d.pos.x, d.pos.z);\n      // R1.3.6: collection belongs to the claim, not to exact navigation completion.\n      // The visual ground witness can cover a few world units around its authoritative lot.\n      // Once the claiming drone is horizontally over that patch, it may collect the claimed\n      // quantity; moveToward remains only the crude approach animation.\n      const horizontalToClaim = Math.hypot(\n        d.target.pos.x - d.pos.x,\n        d.target.pos.z - d.pos.z,\n      );\n      if (horizontalToClaim \u003c= 3.5) {\n        const l = d.target,\n          c = qty(l.comp) \u003e 45 ? take(l, 45) : l;\n        l.claim = null;\n        c.owner = d;\n        c.claim = null;\n        c.pos.copy(d.pos);\n        d.cargo = c;\n        d.target = null;\n        d.state = \"carrying\";\n      } else {\n        if (d.pos.distanceTo(target) \u003e 5)\n          target.y = Math.max(target.y, ground + 6);\n        moveToward(d.pos, target, dt * 10);\n      }\n    }\n  }\n}\n// Ballistic logistics commits real inventory at the actual muzzle. Landed loads rejoin shared matter.\nconst beacons = [V(122, 0, 112), V(84, 0, -54), V(53, 0, 68)];\nbeacons.forEach((p) =\u003e (p.y = terrain.height(p.x, p.z)));\nconst beaconGroup = new THREE.Group();\nsceneRoot.add(beaconGroup);\nfor (const p of beacons) {\n  cyl(beaconGroup, stone, p.clone().add(V(0, 0.15, 0)), 3, 0.3);\n  ring(beaconGroup, p.clone().add(V(0, 0.3, 0)), 2.7, V(0, 1, 0), gold);\n  beam(beaconGroup, p, p.clone().add(V(0, 5, 0)), 0.09);\n}\nfunction muzzle(c) {\n  c.mesh.updateMatrixWorld(true);\n  return c.parts.barrel.localToWorld(V(0, 0, -11.7));\n}\n// R1.2.3: R1.2.2's kinetic time compression flattened the accelerator's arc.\n// Revert to the prior coherent ballistic solver while launch purpose is investigated separately.\n// R1.2.4: solving a firing orientation and physically moving the accelerator are separate jobs.\n// The solver may temporarily sample barrel poses synchronously, but restores the visible pose\n// before returning. The actuator below owns finite yaw/pitch slew and firing readiness.\nfunction firingSolution(c, target) {\n  const actualPitch = c.parts.barrel.rotation.x;\n  let pitch = actualPitch;\n  let velocity = V(0, 0, 0);\n  let T = 3;\n  for (let i = 0; i \u003c 5; i++) {\n    c.parts.barrel.rotation.x = pitch;\n    const start = muzzle(c);\n    T = Math.max(3, start.distanceTo(target) / 17);\n    velocity = target.clone().sub(start).multiplyScalar(1 / T);\n    velocity.y += 4.9 * T;\n    pitch = Math.atan2(velocity.y, Math.hypot(velocity.x, velocity.z));\n  }\n  c.parts.barrel.rotation.x = actualPitch;\n  c.mesh.updateMatrixWorld(true);\n  return { pitch, velocity, T };\n}\n// R1.3.13 \u2014 earned ballistic presentation rule.\n// Inspection established two satisfying temporal pairings while preserving the accepted parabola:\n// world 1\u00d7 uses 3\u00d7 projectile traversal; world 4\u00d7 uses 1\u00d7 projectile traversal. This is no longer\n// an observer probe. Initial projectile velocity scales by m and projectile-only gravity by m\u00b2,\n// preserving the same spatial trajectory while changing only traversal time.\nfunction ballisticSpeedMultiplier() { return world.speed === 1 ? 3 : 1; }\nfunction launch(c, l, target) {\n  let need = 75;\n  const parts = [];\n  for (const stock of inventory(c).filter((a) =\u003e a.stage === \"packed\" || a.stage === \"sorted\")) {\n    const q = qty(stock.comp) \u003e need ? take(stock, need) : stock;\n    parts.push(q);\n    need -= qty(q.comp);\n    if (need \u003c 0.00001) break;\n  }\n  const q = combine(parts, c, c.pos, \"packed\");\n  const start = muzzle(c),\n    T = Math.max(3, start.distanceTo(target) / 17);\n  q.owner = \"projectile\";\n  q.pos.copy(start);\n  q.velocity = target\n    .clone()\n    .sub(start)\n    .multiplyScalar(1 / T);\n  q.velocity.y += 0.5 * 9.8 * T;\n  const ballisticScale = ballisticSpeedMultiplier();\n  q.velocity.multiplyScalar(ballisticScale);\n  q.ballisticTimeScale = ballisticScale;\n  q.stage = \"packed\";\n  world.shots++;\n  event(\n    `${c.name} launches ${Math.round(qty(q.comp))} units to a reclamation ground at ${ballisticScale}\u00d7 ballistic traversal.`,\n  );\n}\nfunction updatePhysics(dt) {\n  for (const l of world.lots) {\n    if (l.owner !== \"ground\" \u0026\u0026 l.owner !== \"projectile\") continue;\n    const ballisticScale = l.owner === \"projectile\" ? (l.ballisticTimeScale || 1) : 1;\n    l.velocity.y -= 9.8 * ballisticScale * ballisticScale * dt;\n    l.pos.addScaledVector(l.velocity, dt);\n    const h = terrain.height(l.pos.x, l.pos.z) + 0.25;\n    if (l.pos.y \u003c h) {\n      const was = l.owner === \"projectile\";\n      l.pos.y = h;\n      l.velocity.multiplyScalar(0.15);\n      l.velocity.y = 0;\n      if (was) {\n        l.owner = \"ground\";\n        l.stage = \"raw\";\n        event(\n          `Delivery ${l.id} settled; collectors can recover its original composition.`,\n        );\n      }\n    }\n  }\n  for (const c of world.cities) {\n    let support = -Infinity;\n    for (let k = 0; k \u003c 8; k++) {\n      const a = (k / 8) * TAU;\n      support = Math.max(\n        support,\n        terrain.height(c.pos.x + Math.cos(a) * 5, c.pos.z + Math.sin(a) * 5),\n      );\n    }\n    if (c.pos.y \u003e support + 0.05) {\n      c.velocity -= 9.8 * dt;\n      c.pos.y += c.velocity * dt;\n      if (c.pos.y \u003c= support) {\n        c.pos.y = support;\n        c.velocity = 0;\n      }\n    } else if (c.pos.y \u003c support) {\n      c.pos.y = support;\n      c.velocity = 0;\n    }\n    c.mesh.position.copy(c.pos);\n  }\n}\nfunction updateCities(dt) {\n  for (const c of world.cities) {\n    if (!c.enabled) {\n      c.state = \"suspended\";\n      continue;\n    }\n    c.timer += dt;\n    const inv = inventory(c);\n    if (c.caps.includes(\"extract\")) {\n      const loose = world.lots\n        .filter((l) =\u003e l.owner === \"ground\")\n        .reduce((s, l) =\u003e s + qty(l.comp), 0);\n      c.state =\n        loose \u003e 5000 ? \"waiting \u00b7 exposed stock sufficient\" : \"excavating\";\n      if (loose \u003c 5000 \u0026\u0026 c.timer \u003e 3.5) {\n        c.timer = 0;\n        const i = c.workIndex++,\n          a = ((i % 12) / 12) * TAU,\n          r = 9 + (Math.floor(i / 12) % 3) * 2.5;\n        c.workPos = V(Math.sin(a) * r, 0, Math.cos(a) * r);\n        const x = c.pos.x + c.workPos.x * 1.2,\n          z = c.pos.z + c.workPos.z * 1.2;\n        const l = terrain.extract(x, z, 3.2, 0.9);\n        if (!l) c.state = \"bedrock\";\n        else c.lastAction = world.time;\n      }\n    }\n    if (c.caps.includes(\"sort\")) {\n      const raw = inv.filter((l) =\u003e l.stage === \"raw\");\n      c.state = raw.length ? \"separating\" : \"waiting \u00b7 mixed intake\";\n      if (raw.length \u0026\u0026 c.timer \u003e 0.35) {\n        c.timer = 0;\n        const input = qty(raw[0].comp) \u003e 360 ? take(raw[0], 360) : raw[0];\n        for (let k = 0; k \u003c 4; k++)\n          if (input.comp[k] \u003e 0.00001) {\n            const m = composition();\n            m[k] = input.comp[k];\n            lot(m, c, c.pos, \"sorted\", input.origins);\n          }\n        world.sorted += qty(input.comp);\n        removeLot(input);\n        c.lastAction = world.time;\n      }\n    }\n    if (c.caps.includes(\"zip\")) {\n      const sorted = inv.filter((l) =\u003e l.stage === \"sorted\");\n      c.state =\n        amount(c) \u003e c.capacity * 0.93\n          ? \"full \u00b7 backpressure\"\n          : sorted.length\n            ? \"assembling mixed capsules\"\n            : \"buffering\";\n      if (\n        sorted.length \u003e 1 \u0026\u0026\n        sorted.reduce((n, l) =\u003e n + qty(l.comp), 0) \u003e= 120 \u0026\u0026\n        c.timer \u003e 3.3\n      ) {\n        const chosen = [];\n        let n = 0;\n        for (const l of sorted) {\n          const q = qty(l.comp) \u003e 60 ? take(l, 60) : l;\n          chosen.push(q);\n          n += qty(q.comp);\n          if (n \u003e= 180) break;\n        }\n        if (chosen.length) {\n          combine(chosen, c, c.pos, \"packed\");\n          world.zipped += n;\n          c.lastAction = world.time;\n          c.timer = 0;\n        }\n      }\n    }\n    if (c.caps.includes(\"launch\")) {\n      const processed = inv.filter((l) =\u003e l.stage === \"packed\" || l.stage === \"sorted\");\n      const processedQty = processed.reduce((n, l) =\u003e n + qty(l.comp), 0);\n      const ready = processedQty \u003e= 75 ? processed[0] : null;\n      if (c.nextLaunchAt == null) c.nextLaunchAt = world.time + 6 + Math.random() * 14;\n      if (!c.pendingLaunchTarget \u0026\u0026 ready \u0026\u0026 world.time \u003e= c.nextLaunchAt) {\n        c.pendingLaunchTarget = beacons[Math.floor(Math.random() * beacons.length)];\n        c.target = c.pendingLaunchTarget;\n        event(`${c.name} commits an irregular ballistic delivery.`);\n      }\n      const target = c.pendingLaunchTarget || c.target || null;\n      if (target) {\n        c.target = target;\n        const delta = target.clone().sub(c.pos);\n        const desired = Math.atan2(-delta.x, -delta.z);\n        let diff = Math.atan2(\n          Math.sin(desired - c.aim),\n          Math.cos(desired - c.aim),\n        );\n        c.aim += clamp(diff, -dt * 0.55, dt * 0.55);\n        c.parts.aim.rotation.y = c.aim;\n        const solution = firingSolution(c, target);\n        const pitchDiff = solution.pitch - c.parts.barrel.rotation.x;\n        c.parts.barrel.rotation.x += clamp(pitchDiff, -dt * 0.42, dt * 0.42);\n        const yawAligned = Math.abs(diff) \u003c 0.03;\n        const pitchAligned = Math.abs(pitchDiff) \u003c 0.02;\n        if (c.pendingLaunchTarget \u0026\u0026 ready \u0026\u0026 ya