x.stroke()}\n  }else if(kind==='malachite'){\n    for(let j=0;j\u003c20;j++){x.strokeStyle=`rgba(${25+rand()*35},${105+rand()*65},${78+rand()*45},.5)`;x.lineWidth=4+rand()*10;x.beginPath();let y=j*14+rand()*8;x.moveTo(0,y);for(let xx=0;xx\u003c=256;xx+=24)x.lineTo(xx,y+Math.sin(xx*.035+j)*8);x.stroke()}\n  }else if(kind==='wood'){\n    for(let j=0;j\u003c50;j++){x.strokeStyle=`rgba(52,30,17,${.07+rand()*.14})`;x.lineWidth=1+rand()*2;x.beginPath();let y=rand()*256;x.moveTo(0,y);for(let xx=0;xx\u003c=256;xx+=16)x.lineTo(xx,y+Math.sin(xx*.05+j)*2);x.stroke()}\n  }\n  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(2,2);return t;\n}\nfunction cargoMaterial(kind,metalness,roughness){return new THREE.MeshStandardMaterial({map:makeCargoTexture(kind),metalness,roughness});}\nconst cargoMats=[\n  cargoMaterial('brass',.72,.31),cargoMaterial('nickel',.76,.27),\n  cargoMaterial('granite',.03,.86),cargoMaterial('marble',.02,.67),\n  cargoMaterial('malachite',.08,.58),cargoMaterial('wood',0,.82)\n];\nconst cargoMaterialNames=['brass','nickel','granite','white-marble','malachite','wood'];\nlet cargoSerial=0;\nfunction cargoRoot(kind,label,pos,rotY=0,matIndex=0){\n  const g=new THREE.Group();\n  const id=`pallet-lander-001.cargo-${String(++cargoSerial).padStart(2,'0')}`;\n  const material=cargoMaterialNames[matIndex%cargoMaterialNames.length];\n  g.name=id;g.position.set(...pos);g.rotation.y=rotY;\n  g.userData={semanticId:id,semanticType:'cargo-object',cargoKind:kind,label,materialIdentity:material,\n    provenance:{work:'The Time Machine',scope:'Chapters I\u2013VII material notebook',catalog:'Materials So Far',material}};\n  cargoGroup.add(g);return g;\n}\nfunction cargoBox(kind,label,pos,size,matIndex=0,rotY=0){\n  const g=cargoRoot(kind,label,pos,rotY,matIndex);\n  const m=new THREE.Mesh(new THREE.BoxGeometry(...size),cargoMats[matIndex%cargoMats.length]);\n  m.name=`${g.name}.body`;m.position.y=size[1]/2;g.add(m);return g;\n}\nfunction cargoCylinder(kind,label,pos,r,h,matIndex=1,rot=[0,0,0]){\n  const g=cargoRoot(kind,label,pos,0,matIndex);\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,14),cargoMats[matIndex%cargoMats.length]);\n  m.name=`${g.name}.body`;m.position.y=h/2;m.rotation.set(...rot);g.add(m);return g;\n}\nfunction cargoDomed(label,pos,r,h,matIndex=3){\n  const g=cargoRoot('domed-cylinder',label,pos,0,matIndex);\n  const body=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,14),cargoMats[matIndex%cargoMats.length]);\n  body.name=`${g.name}.body`;body.position.y=h/2;g.add(body);\n  const dome=new THREE.Mesh(new THREE.SphereGeometry(r,14,8,0,Math.PI*2,0,Math.PI/2),cargoMats[matIndex%cargoMats.length]);\n  dome.name=`${g.name}.dome`;dome.position.y=h;g.add(dome);return g;\n}\n\n// Deck top is local y\u2248.475. Cargo roots sit there and own all of their geometry.\nconst cargoY=.505;\ncargoBox('cube','small-cube-a',[-.49,cargoY,-.17],[.22,.22,.22],0,.08);\ncargoBox('cube','small-cube-b',[-.25,cargoY,-.18],[.18,.18,.18],2,-.05);\ncargoBox('rectangular-box','long-billet-a',[.02,cargoY,-.20],[.42,.14,.16],1,.03);\ncargoBox('rectangular-box','tall-case',[.45,cargoY,-.17],[.20,.34,.18],0,-.06);\ncargoBox('rectangular-box','flat-case',[-.42,cargoY,.12],[.34,.12,.19],4,-.04);\ncargoBox('rectangular-box','medium-case',[-.08,cargoY,.13],[.27,.25,.20],2,.05);\n\n// Three individually addressable horizontal cylinders, visually reading as a stack/bundle.\nfor(let i=0;i\u003c3;i++){\n  const g=cargoRoot('horizontal-cylinder',`cylinder-bundle-${i+1}`,[.25+i*.105,cargoY+.07,.12],0,1);\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.28,12),cargoMats[1]);\n  m.name=`${g.name}.body`;m.rotation.z=Math.PI/2;g.add(m);\n}\n\n// Vertical tanks.\ncargoCylinder('vertical-cylinder','tank-a',[.57,cargoY,.11],.065,.29,3);\ncargoCylinder('vertical-cylinder','tank-b',[.57,cargoY,.24],.055,.23,1);\n\n// Two domed cylinders complete the first heterogeneous material landscape.\n// Living specimens: transparent cylinders with disc bases.\n// Every botanical part is deliberately bounded inside its vessel.\nconst specimenGlassMat=new THREE.MeshPhysicalMaterial({\n  color:0xd8f3ee,transparent:true,opacity:.20,roughness:.08,metalness:0,\n  transmission:.42,thickness:.025,depthWrite:false,side:THREE.DoubleSide\n});\nconst specimenBaseMat=new THREE.MeshStandardMaterial({color:0x535b58,roughness:.42,metalness:.62});\nconst soilMat=new THREE.MeshStandardMaterial({color:0x34271d,roughness:.96});\nconst stemMat=new THREE.MeshStandardMaterial({color:0x416b3d,roughness:.78});\nconst leafMat=new THREE.MeshStandardMaterial({color:0x4d7d47,roughness:.76,side:THREE.DoubleSide});\nconst flowerMat=new THREE.MeshStandardMaterial({color:0xd97a9b,roughness:.64,side:THREE.DoubleSide});\n\nfunction cylinderBetween(a,b,r,mat,parent,name){\n  const d=new THREE.Vector3().subVectors(b,a),mid=new THREE.Vector3().addVectors(a,b).multiplyScalar(.5);\n  const mesh=new THREE.Mesh(new THREE.CylinderGeometry(r,r,d.length(),7),mat);\n  mesh.position.copy(mid);mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.clone().normalize());\n  mesh.name=name;parent.add(mesh);return mesh;\n}\nfunction makeLivingSpecimen(label,pos,r,h,kind='rhododendron'){\n  const g=cargoRoot('living-specimen',label,pos,0,4);\n  g.userData.materialIdentity='living-specimen';\n  g.userData.specimen=kind;\n  g.userData.provenance={\n    work:'The Time Machine',scope:'Chapters I\u2013VII material notebook',\n    catalog:'Organic / Biological',material:kind\n  };\n\n  // A slightly wider, shallow disc foot makes the vessel read as an object rather than a loose glass primitive.\n  const base=new THREE.Mesh(new THREE.CylinderGeometry(r*1.22,r*1.22,.025,18),specimenBaseMat);\n  base.name=`${g.name}.disc-base`;base.position.y=.0125;g.add(base);\n\n  const soilH=.032;\n  const soil=new THREE.Mesh(new THREE.CylinderGeometry(r*.82,r*.82,soilH,16),soilMat);\n  soil.name=`${g.name}.substrate`;soil.position.y=.025+soilH*.5;g.add(soil);\n\n  // Plant envelope intentionally stays well inside both radius and dome height.\n  const plant=new THREE.Group();plant.name=`${g.name}.plant`;g.add(plant);\n  const y0=.025+soilH;\n  const top=y0+h*.58;\n  cylinderBetween(new THREE.Vector3(0,y0,0),new THREE.Vector3(0,top,0),r*.055,stemMat,plant,`${g.name}.stem`);\n\n  const branchData=[[-.34,.42,.12],[.32,.51,-.10],[-.25,.60,-.14],[.26,.69,.11]];\n  for(let i=0;i\u003cbranchData.length;i++){\n    const [sx,sy,sz]=branchData[i];\n    const by=y0+(top-y0)*sy;\n    const tip=new THREE.Vector3(r*sx,by+h*.12,r*sz);\n    cylinderBetween(new THREE.Vector3(0,by,0),tip,r*.035,stemMat,plant,`${g.name}.branch-${i+1}`);\n\n    // Two tiny leaves at each branch tip.\n    for(const sign of [-1,1]){\n      const leaf=new THREE.Mesh(new THREE.CircleGeometry(r*.16,7),leafMat);\n      leaf.scale.set(1,.42,1);\n      leaf.position.set(tip.x+sign*r*.09,tip.y-r*.01,tip.z);\n      leaf.rotation.set(-Math.PI/2,0,sign*.35);\n      leaf.name=`${g.name}.leaf-${i+1}-${sign\u003e0?'a':'b'}`;plant.add(leaf);\n    }\n  }\n\n  // Compact rhododendron blossom cluster below the dome, never intersecting glass.\n  const bloomY=top+h*.055;\n  for(let i=0;i\u003c7;i++){\n    const a=i/7*Math.PI*2;\n    const petal=new THREE.Mesh(new THREE.CircleGeometry(r*.105,7),flowerMat);\n    petal.scale.set(1,.72,1);\n    petal.position.set(Math.cos(a)*r*.18,bloomY+(i%2)*r*.035,Math.sin(a)*r*.18);\n    petal.rotation.set(-Math.PI/2,a,0);\n    petal.name=`${g.name}.blossom-${i+1}`;plant.add(petal);\n  }\n\n  // Clear cylindrical wall plus shallow dome. Plant envelope remains below dome spring line.\n  const wallH=h*.76;\n  const wall=new THREE.Mesh(new THREE.CylinderGeometry(r,r,wallH,20,1,true),specimenGlassMat);\n  wall.name=`${g.name}.glass-wall`;wall.position.y=.025+wallH*.5;wall.renderOrder=4;g.add(wall);\n  const dome=new THREE.Mesh(new THREE.SphereGeometry(r,20,10,0,Math.PI*2,0,Math.PI/2),specimenGlassMat);\n  dome.name=`${g.name}.glass-dome`;dome.position.y=.025+wallH;dome.renderOrder=4;g.add(dome);\n\n  return g;\n}\nmakeLivingSpecimen('rhododendron-specimen-a',[.03,cargoY,.25],.085,.22,'rhododendron');\nmakeLivingSpecimen('rhododendron-specimen-b',[.19,cargoY,.25],.070,.18,'rhododendron');\n\n// Blister emitter: one central mast and one thin expanding canopy.\n// Cargo never moves. The field is required for flight.\nconst blisterEmitter=new THREE.Group();\nblisterEmitter.name='pallet-lander-001.blister-emitter';\nblisterEmitter.userData={semanticType:'deployable-pressure-field-emitter',state:'ACTIVE'};\npalletLander.add(blisterEmitter);\n\n// Air blister is an energy field, not glass. The old skin geometry remains only\n// as an invisible semantic envelope; visible containment comes from diffuse sprites.\nconst blisterSkinMat=new THREE.MeshBasicMaterial({\n  color:0x78d7ff,transparent:true,opacity:.075,depthWrite:false,\n  side:THREE.DoubleSide,blending:THREE.AdditiveBlending\n});\nconst emitterMat=new THREE.MeshStandardMaterial({color:0x707b7f,roughness:.4,metalness:.76});\nconst canopyMat=new THREE.MeshStandardMaterial({color:0x8a9699,roughness:.36,metalness:.72});\n\nconst mastBaseY=.49, mastHeight=.58;\nconst mast=new THREE.Mesh(new THREE.CylinderGeometry(.035,.045,mastHeight,10),emitterMat);\nmast.name='pallet-lander-001.blister-emitter.mast';\nmast.position.set(0,mastBaseY+mastHeight*.5,0);\nblisterEmitter.add(mast);\n\n// Thin rectangular emitter plate. It stays comfortably inside the pallet footprint.\nconst canopyGeom=new THREE.BoxGeometry(1.02,.028,.48);\nconst canopy=new THREE.Mesh(canopyGeom,canopyMat);\ncanopy.name='pallet-lander-001.blister-emitter.canopy';\ncanopy.position.set(0,mastBaseY+mastHeight,0);\nblisterEmitter.add(canopy);\n\n// The pressure field is a separate visual consequence of the deployed emitter.\nconst airBlister=new THREE.Group();\nairBlister.name='pallet-lander-001.air-blister';\nairBlister.userData={semanticType:'pressure-containment',contains:'pallet-lander-001.cargo',state:'ACTIVE'};\npalletLander.add(airBlister);\n\nconst blisterShape=new THREE.Shape();\nblisterShape.moveTo(-.69,.49);\nblisterShape.lineTo(-.69,.90);\nblisterShape.lineTo(-.56,1.032);\nblisterShape.lineTo(.56,1.032);\nblisterShape.lineTo(.69,.90);\nblisterShape.lineTo(.69,.49);\nblisterShape.closePath();\nconst blisterGeom=new THREE.ExtrudeGeometry(blisterShape,{depth:.60,bevelEnabled:false,steps:1});\nblisterGeom.translate(0,0,-.30);\nconst blisterSkin=new THREE.Mesh(blisterGeom,blisterSkinMat);\nblisterSkin.name='pallet-lander-001.air-blister.pressure-skin';\nblisterSkin.renderOrder=2;\nairBlister.add(blisterSkin);\n\n// The membrane itself establishes inside/outside. A brighter edge makes the\n// boundary read instantly without turning it back into a glass object.\nconst blisterEdgesGeom=new THREE.EdgesGeometry(blisterGeom,24);\nconst blisterEdgeMat=new THREE.LineBasicMaterial({\n  color:0x73d9ff,transparent:true,opacity:.58,\n  depthWrite:false,blending:THREE.AdditiveBlending\n});\nconst blisterEdges=new THREE.LineSegments(blisterEdgesGeom,blisterEdgeMat);\nblisterEdges.name='pallet-lander-001.air-blister.energy-boundary';\nblisterEdges.renderOrder=3;\nairBlister.add(blisterEdges);\n\n// The canopy is the visibly energetic source; the membrane itself stays restrained.\nconst blisterCrownMat=new THREE.MeshBasicMaterial({\n  color:0x7fdcff,transparent:true,opacity:.34,depthWrite:false,\n  blending:THREE.AdditiveBlending\n});\nconst blisterCrown=new THREE.Mesh(new THREE.BoxGeometry(1.0,.018,.46),blisterCrownMat);\nblisterCrown.name='pallet-lander-001.air-blister.emitter-glow';\nblisterCrown.position.set(0,1.052,0);\nairBlister.add(blisterCrown);\n\nlet blisterActive=true;\nlet blisterFlash={mode:null,t:0,step:0};\n\n// Low-level visibility is separate from semantic ACTIVE state so startup/shutdown\n// flickers can preview the membrane without lying to the flight interlock.\nfunction showBlisterField(on){\n  blisterSkin.visible=!!on;\n  blisterEdges.visible=!!on;\n  blisterCrown.visible=!!on;\n}\nfunction setBlisterActive(on){\n  blisterActive=!!on;\n  showBlisterField(blisterActive);\n  airBlister.userData.state=blisterActive?'ACTIVE':'INACTIVE';\n}\nfunction beginBlisterStartupFlicker(){\n  blisterActive=false;\n  airBlister.userData.state='CHARGING';\n  blisterFlash={mode:'STARTUP',t:0,step:0};\n  showBlisterField(false);\n}\nfunction beginBlisterShutdownFlicker(){\n  blisterActive=false; // flight interlock drops immediately\n  airBlister.userData.state='DISCHARGING';\n  blisterFlash={mode:'SHUTDOWN',t:0,step:0};\n  showBlisterField(true);\n}\nfunction updateBlisterFlash(dt){\n  const f=blisterFlash;\n  if(!f.mode)return;\n  f.t+=dt;\n\n  // Startup: ON/OFF, ON/OFF, then establish continuously.\n  // Shutdown: one brief after-flash, then dark.\n  const startup=[\n    [.075,true],[.065,false],[.075,true],[.075,false],[.001,true]\n  ];\n  const shutdown=[\n    [.075,true],[.065,false],[.075,true],[.095,false]\n  ];\n  const seq=f.mode==='STARTUP'?startup:shutdown;\n  while(f.step\u003cseq.length \u0026\u0026 f.t\u003e=seq[f.step][0]){\n    f.t-=seq[f.step][0];\n    showBlisterField(seq[f.step][1]);\n    f.step++;\n  }\n  if(f.step\u003e=seq.length){\n    if(f.mode==='STARTUP'){\n      blisterFlash={mode:null,t:0,step:0};\n      setBlisterActive(true);\n      emitterMotion.state='ACTIVE';blisterEmitter.userData.state='ACTIVE';\n      updateLanderControlCue();\n    }else{\n      blisterFlash={mode:null,t:0,step:0};\n      showBlisterField(false);\n      airBlister.userData.state='INACTIVE';\n      // Electrical shutdown is visibly complete; only now may hardware collapse.\n      if(emitterMotion.state==='WAITING_TO_STOW'){\n        emitterMotion.state='STOWING';emitterMotion.t=0;\n        blisterEmitter.userData.state='STOWING';\n      }\n    }\n  }\n}\n\nconst emitterMotion={state:'STOWED',t:0,duration:.90};\nfunction setEmitterDeployment(q){\n  q=THREE.MathUtils.clamp(q,0,1); // 0 stowed, 1 deployed\n\n  // Sequential mechanism:\n  // deployment: mast rises first, then the rectangular plate expands horizontally.\n  // stow: plate contracts first, then mast telescopes into its deck socket.\n  const mastQ=smooth01(THREE.MathUtils.clamp(q*2,0,1));\n  const plateQ=smooth01(THREE.MathUtils.clamp(q*2-1,0,1));\n\n  canopy.scale.set(Math.max(.001,plateQ),1,1);\n  canopy.visible=plateQ\u003e.015;\n\n  mast.scale.y=Math.max(.001,mastQ);\n  mast.position.y=mastBaseY+(mastHeight*mastQ)*.5;\n  mast.visible=mastQ\u003e.015;\n  canopy.position.y=mastBaseY+mastHeight*mastQ;\n}\nfunction beginEmitterStow(){\n  if(emitterMotion.state!=='ACTIVE')return;\n  // Field shuts down completely before any mast/canopy motion begins.\n  emitterMotion.state='WAITING_TO_STOW';emitterMotion.t=0;\n  blisterEmitter.userData.state='DISCHARGING';\n  beginBlisterShutdownFlicker();\n  updateLanderControlCue();\n}\nfunction beginEmitterDeploy(){\n  if(emitterMotion.state!=='STOWED')return;\n  emitterMotion.state='DEPLOYING';emitterMotion.t=0;\n  blisterEmitter.userData.state='DEPLOYING';\n  updateLanderControlCue();\n}\nfunction updateBlisterEmitter(dt){\n  const m=emitterMotion;\n  if(m.state==='STOWING'){\n    m.t+=dt; const q=smooth01(m.t/m.duration);\n    setEmitterDeployment(1-q);\n    if(m.t\u003e=m.duration){\n      setEmitterDeployment(0);m.state='STOWED';blisterEmitter.userData.state='STOWED';\n      updateLanderControlCue();\n    }\n  }else if(m.state==='DEPLOYING'){\n    m.t+=dt; const q=smooth01(m.t/m.duration);\n    setEmitterDeployment(q);\n    if(m.t\u003e=m.duration){\n      setEmitterDeployment(1);\n      // Hardware is fully deployed; field coughs twice before becoming authoritative.\n      m.state='CHARGING';blisterEmitter.userData.state='CHARGING';\n      beginBlisterStartupFlicker();updateLanderControlCue();\n    }\n  }\n}\nsetEmitterDeployment(0);\nsetBlisterActive(false);\n\n// Four retractable legs. Retraction is local to each leg group. Retraction is local to each leg group.\nconst legGroups=[];\nfor(const [i,x,z] of [[0,-.62,-.28],[1,.62,-.28],[2,-.62,.28],[3,.62,.28]]){\n  const g=new THREE.Group();g.name=`pallet-lander-001.leg-${i+1}`;g.position.set(x,0,z);palletLander.add(g);\n  landerBox(`${g.name}.strut`,[.075,.31,.075],[0,.155,0],landerDark,g);\n  landerBox(`${g.name}.foot`,[.22,.045,.18],[0,.022,0],landerFootMat,g);\n  legGroups.push(g);\n}\n\n// Main center lift engine and its cheap procedural plume.\nconst mainEngine=new THREE.Group();mainEngine.name='pallet-lander-001.main-thruster';mainEngine.position.set(0,.18,0);palletLander.add(mainEngine);\nconst bell=landerCyl('pallet-lander-001.main-thruster.bell',.105,.17,.16,[0,0,0],landerDark,mainEngine);\nconst mainPlume=new THREE.Mesh(new THREE.ConeGeometry(.12,.62,18,1,true),plumeMat);\nmainPlume.name='pallet-lander-001.main-thruster.plume';\nmainPlume.position.y=-.38;mainPlume.rotation.z=Math.PI;mainPlume.visible=false;mainEngine.add(mainPlume);\n\n// Four canted station-keeping thrusters. Their plumes pulse during hover correction.\nconst stationThrusters=[];\nfor(const [i,x,z,sx,sz] of [\n  [0,-.66,-.30,-1,-1],[1,.66,-.30,1,-1],[2,-.66,.30,-1,1],[3,.66,.30,1,1]\n]){\n  const g=new THREE.Group();g.name=`pallet-lander-001.station-thruster-${i+1}`;\n  g.position.set(x,.25,z);\n  // local -Y points roughly outward/down after these small cant rotations\n  g.rotation.z=-sx*.38;g.rotation.x=sz*.30;\n  palletLander.add(g);\n  landerCyl(`${g.name}.nozzle`,.035,.065,.11,[0,0,0],landerDark,g,10);\n  const p=new THREE.Mesh(new THREE.ConeGeometry(.038,.24,10,1,true),pulseMat.clone());\n  p.name=`${g.name}.plume`;p.position.y=-.16;p.rotation.z=Math.PI;p.visible=false;g.add(p);\n  stationThrusters.push({group:g,plume:p,index:i});\n}\n\n// Diffuse blue exhaust particles. Existing cone plumes remain as disabled fallback geometry.\nfunction makeExhaustSprite(){\n  const c=document.createElement('canvas');c.width=c.height=64;\n  const x=c.getContext('2d');\n  const g=x.createRadialGradient(32,32,0,32,32,31);\n  g.addColorStop(0,'rgba(235,252,255,1)');\n  g.addColorStop(.18,'rgba(120,225,255,.95)');\n  g.addColorStop(.48,'rgba(45,145,255,.48)');\n  g.addColorStop(1,'rgba(20,80,255,0)');\n  x.fillStyle=g;x.fillRect(0,0,64,64);\n  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;\n}\nconst exhaustSprite=makeExhaustSprite();\nfunction makeParticleExhaust(parent,name,count,length,radius,size,origin,direction){\n  const group=new THREE.Group();group.name=name;parent.add(group);\n  const dir=direction.clone().normalize();\n  // Build a stable perpendicular basis around the semantic exhaust vector.\n  const helper=Math.abs(dir.y)\u003c.9?new THREE.Vector3(0,1,0):new THREE.Vector3(1,0,0);\n  const u=new THREE.Vector3().crossVectors(dir,helper).normalize();\n  const v=new THREE.Vector3().crossVectors(dir,u).normalize();\n  const particles=[];\n  for(let i=0;i\u003ccount;i++){\n    const mat=new THREE.SpriteMaterial({\n      map:exhaustSprite,color:0xbfefff,transparent:true,opacity:0,\n      depthWrite:false,blending:THREE.AdditiveBlending\n    });\n    const p=new THREE.Sprite(mat);p.visible=false;group.add(p);\n    particles.push({sprite:p,phase:i/count,jitter:((i*37)%17)/17,length,radius,size});\n  }\n  return {group,particles,strength:0,origin:origin.clone(),direction:dir,u,v};\n}\n\n// Propulsion semantics are explicit rather than inferred from CylinderGeometry.\n// Center exhaust: straight down from the bell mouth in lander-local coordinates.\nconst mainExhaust=makeParticleExhaust(\n  palletLander,'pallet-lander-001.main-thruster.exhaust-particles',\n  30,.72,.085,.095,\n  new THREE.Vector3(0,.07,0),\n  new THREE.Vector3(0,-1,0)\n);\n\n// Corner exhausts: down + radially INWARD toward the protected plume envelope.\n// This preserves the original dockworker-safe cant while keeping direction explicit.\nconst stationExhausts=stationThrusters.map((t,i)=\u003e{\n  const x=t.group.position.x,z=t.group.position.z;\n  const inward=new THREE.Vector3(-x,-Math.hypot(x,z)*1.55,-z).normalize();\n  const origin=new THREE.Vector3(x,t.group.position.y-.055,z).addScaledVector(inward,.055);\n  return makeParticleExhaust(\n    palletLander,`pallet-lander-001.station-thruster-${i+1}.exhaust-particles`,\n    10,.27,.045,.045,origin,inward\n  );\n});\nmainPlume.visible=false;\nfor(const t of stationThrusters){t.plume.visible=false;t.particleActive=false;t.particleStrength=0;}\n\nfunction updateParticleExhaust(sys,on,strength,now){\n  sys.strength=on?strength:0;\n  for(let i=0;i\u003csys.particles.length;i++){\n    const e=sys.particles[i],p=e.sprite;\n    if(!on){p.visible=false;continue}\n    const travel=(e.phase+now*.54)%1;\n    const ang=i*2.399963;\n    // Plume silhouette is broad at the nozzle and tapers with travel.\n    // A small residual radius avoids collapsing every distal particle onto one line.\n    const taper=.16+.84*(1-travel);\n    const spread=e.radius*taper*(0.45+e.jitter*.75);\n\n    // Position = explicit nozzle mouth + travel along semantic exhaust direction\n    // + tapered radial spread in the plane perpendicular to that direction.\n    p.position.copy(sys.origin)\n      .addScaledVector(sys.direction,.02+travel*e.length)\n      .addScaledVector(sys.u,Math.cos(ang)*spread)\n      .addScaledVector(sys.v,Math.sin(ang)*spread);\n\n    const sz=e.size*(1.08-.62*travel)*(0.82+e.jitter*.35);\n    p.scale.set(sz,sz,1);\n    p.material.opacity=(1-travel)*(.24+.42*strength);\n    p.visible=true;\n  }\n}\n\n// Physical chassis button: the only control for this first toy pass.\nconst landerButton=landerCyl('pallet-lander-001.control.flight-button',.09,.09,.055,[.49,.31,.418],buttonMat,palletLander,18);\nlanderButton.rotation.x=Math.PI/2;\nlanderButton.userData.semanticType='physical-control';\nlanderButton.userData.control='flight-cycle';\ninteriorInteractives.push(landerButton);\n\n// Tiny status lamp is world feedback, not UI. It shares the front-right control cluster.\nconst statusLampMat=new THREE.MeshBasicMaterial({color:0x8fd6a4});\nconst statusLamp=landerCyl('pallet-lander-001.status-lamp',.035,.035,.018,[.30,.31,.408],statusLampMat,palletLander,12);\nstatusLamp.rotation.x=Math.PI/2;\n\n// -----------------------------------------------------------------------------\n// ROOM 001 CONTENTS \u2014 ORRERY SEED 001\n// A second toy, deliberately beginning with less ontology than the lander.\n// Known now: compact brass mechanism, one physical control, three folded arms,\n// three materially distinct bodies, and a deploy/turn cycle.\n// Unknown on purpose: whether it is model, instrument, navigator, or something else.\nconst orrerySeed=new THREE.Group();\norrerySeed.name='orrery-seed-001';\norrerySeed.position.set(.92,1.10,-.12);\norrerySeed.scale.setScalar(.72);\norrerySeed.userData={\n  semanticId:'orrery-seed-001',\n  semanticType:'tabletop-toy',\n  sceneAnchor:'room-001.workbench.right',\n  interpretation:'unresolved',\n  state:'FOLDED'\n};\nroomContents.add(orrerySeed);\n// INHERITANCE PASS 2: preserve the orrery implementation but keep it out of the quiet first encounter.\norrerySeed.visible=false;\n\nconst orreryBrass=new THREE.MeshStandardMaterial({color:0x8f6c32,roughness:.34,metalness:.82});\nconst orreryDark=new THREE.MeshStandardMaterial({color:0x272b2d,roughness:.46,metalness:.72});\nconst orreryIvory=new THREE.MeshStandardMaterial({color:0xd5ccb2,roughness:.58,metalness:.08});\nconst orreryGreen=new THREE.MeshStandardMaterial({color:0x315f52,roughness:.44,metalness:.28});\nconst orrerySilver=new THREE.MeshStandardMaterial({color:0xaab2b4,roughness:.28,metalness:.86});\nconst orreryButtonMat=new THREE.MeshStandardMaterial({color:0x755128,emissive:0x1c0e02,emissiveIntensity:.2,roughness:.38,metalness:.7});\n\nfunction orreryCyl(name,r,h,pos,mat=orreryBrass,parent=orrerySeed,radial=20){\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,radial),mat);\n  m.name=name;m.position.set(...pos);parent.add(m);return m;\n}\nconst orreryBase=orreryCyl('orrery-seed-001.base',.43,.13,[0,.065,0],orreryDark);\nconst orreryRing=new THREE.Mesh(new THREE.TorusGeometry(.34,.035,8,28),orreryBrass);\norreryRing.name='orrery-seed-001.base-ring';orreryRing.rotation.x=Math.PI/2;orreryRing.position.y=.14;orrerySeed.add(orreryRing);\nconst orrerySpindle=orreryCyl('orrery-seed-001.spindle',.055,.34,[0,.25,0],orreryBrass);\n\nconst orreryArmRoot=new THREE.Group();\norreryArmRoot.name='orrery-seed-001.armature';\norreryArmRoot.position.y=.39;\norrerySeed.add(orreryArmRoot);\n\nconst armSpecs=[\n  {a:0,len:.42,mat:orreryIvory,r:.085},\n  {a:Math.PI*2/3,len:.56,mat:orreryGreen,r:.105},\n  {a:Math.PI*4/3,len:.70,mat:orrerySilver,r:.075}\n];\nconst orreryArms=[];\nfor(let i=0;i\u003carmSpecs.length;i++){\n  const spec=armSpecs[i], pivot=new THREE.Group();\n  pivot.name=`orrery-seed-001.arm-${i+1}`;\n  pivot.rotation.y=spec.a;\n  orreryArmRoot.add(pivot);\n  const beam=new THREE.Mesh(new THREE.BoxGeometry(spec.len,.035,.045),orreryBrass);\n  beam.position.x=spec.len/2;beam.name=`orrery-seed-001.arm-${i+1}.beam`;pivot.add(beam);\n  // The arm endpoint is a carrier. The body has its own local orbit around it.\n  const localOrbit=new THREE.Group();\n  localOrbit.name=`orrery-seed-001.body-${i+1}.local-orbit`;\n  localOrbit.position.x=spec.len;\n  pivot.add(localOrbit);\n\n  const orbitTilt=[.18,-.27,.41][i];\n  localOrbit.rotation.z=orbitTilt;\n\n  const orbitRadius=[.105,.145,.205][i];\n  const orbitCarrier=new THREE.Group();\n  orbitCarrier.name=`orrery-seed-001.body-${i+1}.orbit-carrier`;\n  localOrbit.add(orbitCarrier);\n\n  const body=new THREE.Mesh(new THREE.SphereGeometry(spec.r,18,12),spec.mat);\n  body.position.x=orbitRadius;\n  body.name=`orrery-seed-001.body-${i+1}`;\n  orbitCarrier.add(body);\n\n  // A restrained physical ring makes the local mechanism legible without\n  // deciding whether this is astronomy, navigation, computation, or ritual.\n  const track=new THREE.Mesh(\n    new THREE.TorusGeometry(orbitRadius,.008,6,32),\n    new THREE.MeshStandardMaterial({color:0x6e5935,roughness:.48,metalness:.72})\n  );\n  track.name=`orrery-seed-001.body-${i+1}.orbit-track`;\n  track.rotation.x=Math.PI/2;\n  localOrbit.add(track);\n\n  pivot.userData.localOrbit=orbitCarrier;\n  pivot.userData.orbitBody=body;\n  pivot.userData.orbitRate=[1.07,-.71,.43][i];\n  pivot.userData.phase=[.25,2.15,4.35][i];\n  orbitCarrier.rotation.y=pivot.userData.phase;\n\n  pivot.scale.x=.08;\n  orreryArms.push(pivot);\n}\n\n// One chunky physical control. Like the lander, it is part of the toy, not overlay UI.\nconst orreryButton=orreryCyl('orrery-seed-001.control.deploy',.075,.055,[.27,.19,.27],orreryButtonMat,orrerySeed,18);\norreryButton.rotation.x=Math.PI/2;\norreryButton.userData.semanticType='physical-control';\norreryButton.userData.control='deploy-cycle';\ninteriorInteractives.push(orreryButton);\n\n// Central alignment detector: three quiet brass sights and one physical latch tile.\n// It observes current body geometry; it does not know what an alignment means.\nconst detector=new THREE.Group();\ndetector.name='orrery-seed-001.alignment-detector';\ndetector.position.y=.18;\norrerySeed.add(detector);\nfor(let i=0;i\u003c3;i++){\n  const a=i*Math.PI*2/3;\n  const sight=new THREE.Mesh(new THREE.BoxGeometry(.025,.22,.025),orreryBrass);\n  sight.name=`orrery-seed-001.alignment-detector.sight-${i+1}`;\n  sight.position.set(Math.cos(a)*.115,.11,Math.sin(a)*.115);\n  sight.rotation.z=Math.cos(a)*.08;\n  detector.add(sight);\n}\nconst latchTile=new THREE.Mesh(new THREE.BoxGeometry(.20,.035,.13),orreryIvory);\nlatchTile.name='orrery-seed-001.alignment-latch';\nlatchTile.position.set(-.19,.155,.24);\nlatchTile.userData.semanticType='alignment-record';\nlatchTile.userData.meaning='unresolved';\norrerySeed.add(latchTile);\n\nconst alignmentSense={\n  latched:false,\n  clear:true,\n  pulse:0,\n  // enter tighter than exit: geometric hysteresis prevents chatter.\n  enterAngle:THREE.MathUtils.degToRad(7),\n  exitAngle:THREE.MathUtils.degToRad(12)\n};\nfunction bodyDirectionFromCenter(arm){\n  const body=arm.userData.orbitBody;\n  if(!body)return null;\n  const p=new THREE.Vector3();\n  body.getWorldPosition(p);\n  const c=new THREE.Vector3();\n  orreryArmRoot.getWorldPosition(c);\n  return p.sub(c).normalize();\n}\nfunction smallestBodySeparation(){\n  const dirs=orreryArms.map(bodyDirectionFromCenter).filter(Boolean);\n  let best=Math.PI;\n  for(let i=0;i\u003cdirs.length;i++)for(let j=i+1;j\u003cdirs.length;j++){\n    best=Math.min(best,Math.acos(THREE.MathUtils.clamp(dirs[i].dot(dirs[j]),-1,1)));\n  }\n  return best;\n}\nfunction updateAlignmentDetector(dt){\n  const active=orreryMotion.state==='TURNING';\n  if(!active){\n    alignmentSense.latched=false;alignmentSense.clear=true;alignmentSense.pulse=0;\n    latchTile.position.y=.155;latchTile.rotation.z=0;\n    return;\n  }\n  const sep=smallestBodySeparation();\n  if(alignmentSense.clear \u0026\u0026 sep\u003calignmentSense.enterAngle){\n    alignmentSense.latched=true;alignmentSense.clear=false;alignmentSense.pulse=1;\n    latchTile.userData.lastObservedSeparation=sep;\n  }else if(!alignmentSense.clear \u0026\u0026 sep\u003ealignmentSense.exitAngle){\n    alignmentSense.clear=true;\n  }\n  if(alignmentSense.pulse\u003e0)alignmentSense.pulse=Math.max(0,alignmentSense.pulse-dt*2.4);\n  const pop=alignmentSense.latched ? .075 : 0;\n  const kick=alignmentSense.pulse*.018;\n  latchTile.position.y=.155+pop+kick;\n  latchTile.rotation.z=alignmentSense.pulse*.08;\n}\n\nconst orreryMotion={state:'FOLDED',t:0,angle:0};\nfunction requestOrreryCycle(){\n  if(orreryMotion.state==='FOLDED'){orreryMotion.state='DEPLOYING';orreryMotion.t=0;orrerySeed.userData.state='DEPLOYING'}\n  else if(orreryMotion.state==='TURNING'){orreryMotion.state='FOLDING';orreryMotion.t=0;orrerySeed.userData.state='FOLDING'}\n}\norreryButton.userData.onActivate=requestOrreryCycle;\n\nfunction updateOrrery(dt){\n  const m=orreryMotion;\n  if(m.state==='DEPLOYING'){\n    m.t+=dt;const q=smooth01(Math.min(1,m.t/1.35));\n    orrerySpindle.scale.y=.22+.78*q;\n    for(let i=0;i\u003correryArms.length;i++)orreryArms[i].scale.x=.08+.92*Math.max(0,Math.min(1,(q-i*.12)/(1-i*.12)));\n    if(q\u003e=1){m.state='TURNING';m.t=0;orrerySeed.userData.state='TURNING'}\n  }else if(m.state==='TURNING'){\n    m.angle+=dt*.34;\n    orreryArmRoot.rotation.y=m.angle;\n    // Each body advances on an independent, deliberately incommensurate cycle.\n    // One runs retrograde. Relationships drift rather than repeating quickly.\n    for(const arm of orreryArms){\n      const local=arm.userData.localOrbit;\n      if(local)local.rotation.y+=dt*arm.userData.orbitRate;\n    }\n  }else if(m.state==='FOLDING'){\n    m.t+=dt;const q=smooth01(Math.min(1,m.t/1.15)),inv=1-q;\n    for(let i=0;i\u003correryArms.length;i++)orreryArms[i].scale.x=.08+.92*inv;\n    orrerySpindle.scale.y=.22+.78*inv;\n    if(q\u003e=1){m.state='FOLDED';m.t=0;orrerySeed.userData.state='FOLDED'}\n  }\n}\n\nconst landerFlight={\n  state:'LANDED',\n  stateT:0,\n  landingY:1.09,\n  hoverHeight:.78,\n  hoverBaseY:1.87,\n  lastTime:performance.now()/1000,\n  hoverPhase:0\n};\nfunction updateLanderControlCue(){\n  // Lamp communicates the orange button's next action.\n  // dim = cargo accessible / deploy containment\n  // cyan = containment established / flight ready\n  // blue = airborne / land\n  // muted = machinery in transition\n  if(landerFlight.state==='LANDED'){\n    const ready=blisterActive \u0026\u0026 emitterMotion.state==='ACTIVE';\n    const accessible=!blisterActive \u0026\u0026 emitterMotion.state==='STOWED';\n    statusLampMat.color.set(ready?0x66d9ff:(accessible?0x6b7477:0x4d5254));\n    buttonMat.color.copy((ready||accessible)?buttonLive:buttonIdle);\n    buttonMat.emissiveIntensity=(ready||accessible)?.65:.2;\n  }else if(landerFlight.state==='HOVERING'){\n    statusLampMat.color.set(0x9fc8ff);\n    buttonMat.color.copy(buttonLive);buttonMat.emissiveIntensi