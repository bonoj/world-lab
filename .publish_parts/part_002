l);\nroomBox('room-001.rear-wall',[0,1.62,6.25],[7.6,3.25,.14],IM.shell);\n\n// Window wall: one continuous structural plane with a shaped pressure opening.\n// Wall, glass, and frame all derive from the same octagonal aperture path.\nconst wx=2.91, wy=.975, wc=.36;\nconst windowOctPts=[\n [-wx+wc,-wy],[wx-wc,-wy],[wx,-wy+wc],[wx,wy-wc],\n [wx-wc,wy],[-wx+wc,wy],[-wx,wy-wc],[-wx,-wy+wc]\n];\n\nfunction octPath(points){\n  const p=new THREE.Path();\n  p.moveTo(points[0][0],points[0][1]);\n  for(let i=1;i\u003cpoints.length;i++)p.lineTo(points[i][0],points[i][1]);\n  p.closePath();\n  return p;\n}\n\n// Full front-wall silhouette with the viewport cut from it as a real hole.\nconst frontWallShape=new THREE.Shape();\nfrontWallShape.moveTo(-3.8,-1.625);\nfrontWallShape.lineTo( 3.8,-1.625);\nfrontWallShape.lineTo( 3.8, 1.625);\nfrontWallShape.lineTo(-3.8, 1.625);\nfrontWallShape.closePath();\nfrontWallShape.holes.push(octPath(windowOctPts));\n\nconst frontWall=new THREE.Mesh(new THREE.ShapeGeometry(frontWallShape),IM.shell);\nfrontWall.name='room-001.window-wall';\nfrontWall.position.set(0,1.625,-3.13);\ninteriorRoot.add(frontWall);\n\n// Glass is the exact same aperture silhouette, slightly exterior of the wall.\nconst windowShape=new THREE.Shape();\nwindowShape.moveTo(windowOctPts[0][0],windowOctPts[0][1]);\nfor(let i=1;i\u003cwindowOctPts.length;i++)windowShape.lineTo(windowOctPts[i][0],windowOctPts[i][1]);\nwindowShape.closePath();\nconst glass=new THREE.Mesh(new THREE.ShapeGeometry(windowShape),IM.glass);\nglass.name='room-001.window-glass';\nglass.position.set(0,1.65,-3.08);\ninteriorRoot.add(glass);\n\n// Structural frame is one continuous extruded ring derived from the same\n// canonical aperture. No intersecting beam ends, so no pokey corner overlaps.\n// True polygon offset: intersect adjacent edge-parallel lines so the ring\n// keeps constant perpendicular thickness through straight and chamfered edges.\nfunction offsetConvexPolygon(points,d){\n  const out=[];