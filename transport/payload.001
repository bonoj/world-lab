Only cities whose verbs actually participate in ring freight expose freight interfaces.\n// Drone and Thumper remain world-space actors: drones carry loose matter through space and\n// Thumper exposes loose matter into terrain. Link is a relay interface, not a warehouse.\nfunction hasFreightInterface(c) {\n  return c.caps.some((cap) =\u003e [\"launch\", \"sort\", \"zip\", \"relay\"].includes(cap));\n}\nfunction hasStorageCapacity(c) {\n  return Number.isFinite(c.capacity) \u0026\u0026 c.capacity \u003e 0;\n}\nfunction buildRoutes() {\n  // R1.3.1: ring freight is hub-mediated. A freight interface grants access to the\n  // network; it does not grant peer-to-peer connectivity. Link is the switchyard.\n  // Processing/storage endpoints therefore expose one spoke to Link and never create\n  // direct endpoint-to-endpoint conduits.\n  const link = world.cities.find((c) =\u003e c.caps.includes(\"relay\"));\n  if (!link) return;\n  const endpoints = world.cities.filter(\n    (c) =\u003e c !== link \u0026\u0026 hasFreightInterface(c),\n  );\n  for (const endpoint of endpoints) {\n    const route = {\n      id: world.routes.length,\n      a: endpoint,\n      b: link,\n      enabled: true,\n      group: new THREE.Group(),\n      rings: [],\n    };\n    sceneRoot.add(route.group);\n    world.routes.push(route);\n    for (let j = 1; j \u003c= 4; j++)\n      route.rings.push(ring(route.group, V(), 1.35));\n  }\n}\nfunction inRange(r) {\n  return (\n    r.a.pos.distanceTo(r.b.pos) \u003c=\n    (r.a.caps.includes(\"relay\") || r.b.caps.includes(\"relay\") ? 150 : 82)\n  );\n}\nfunction available(r) {\n  if (\n    !inRange(r) ||\n    !r.enabled ||\n    !r.a.enabled ||\n    !r.b.enabled ||\n    !r.a.connected ||\n    !r.b.connected\n  )\n    return false;\n  for (const t of [0.2, 0.4, 0.6, 0.8]) {\n    const p = routePoint(r, t);\n    if (p.y \u003c terrain.height(p.x, p.z) + 0.8) return false;\n  }\n  return true;\n}\nfunction port(c) {\n  return c.pos.clone().add(V(0, c.caps.includes(\"relay\") ? 6 : 4.8, 0));\n}\nfunction routePoint(r, t) {\n  const p = port(r.a).lerp(port(r.b), t);\n  p.y += Math.sin(t * Math.PI) * 8;\n  return p;\n}\n// A conduit is physically bidirectional but half-duplex while occupied. Same-direction\n// packets may follow, provided the entry has cleared enough world-space headway. Temporary\n// occupancy is traffic, not topology: blocked cargo waits at the interface and does not\n// cause Dijkstra rerouting.\nconst ROUTE_HEADWAY = 18.0;\nfunction edgeDirection(e) {\n  return e.from === e.route.a ? 1 : -1;\n}\nfunction activeEdgeLots(route) {\n  return world.lots.filter((l) =\u003e {\n    if (l.owner !== \"transit\" || !l.journey || l.journey.waiting) return false;\n    const e = l.journey.path[l.journey.edge];\n    return e \u0026\u0026 e.route === route;\n  });\n}\nfunction waitingEdgeLots(route) {\n  return world.lots.filter((l) =\u003e {\n    if (l.owner !== \"transit\" || !l.journey || !l.journey.waiting) return false;\n    const e = l.journey.path[l.journey.edge];\n    return e \u0026\u0026 e.route === route;\n  });\n}\nfunction canEnterEdge(e, except = null) {\n  const dir = edgeDirection(e), active = activeEdgeLots(e.route).filter((l) =\u003e l !== except);\n  if (active.some((l) =\u003e edgeDirection(l.journey.path[l.journey.edge]) !== dir)) return false;\n  // Once opposite traffic is visibly queued, stop extending the current directional burst.\n  // Existing packets drain; then one waiting side can acquire the idle conduit. This prevents\n  // city update order from starving a direction forever without introducing global scheduling.\n  const opposingWaiter = waitingEdgeLots(e.route).some((l) =\u003e\n    l !== except \u0026\u0026 edgeDirection(l.journey.path[l.journey.edge]) !== dir\n  );\n  if (active.length \u0026\u0026 opposingWaiter) return false;\n  const distance = Math.max(1, e.from.pos.distanceTo(e.to.pos));\n  return active.every((l) =\u003e l.journey.t * distance \u003e= ROUTE_HEADWAY);\n}\nfunction pathBetween(from, to) {\n  if (from === to) return [];\n  if (!from.connected || !to.connected || !from.enabled || !to.enabled)\n    return null;\n  const dist = new Map([[from, 0]]),\n    prev = new Map(),\n    open = [from];\n  while (open.length) {\n    open.sort((a, b) =\u003e dist.get(a) - dist.get(b));\n    const a = open.shift();\n    if (a === to) break;\n    for (const r of world.routes) {\n      if (!available(r)) continue;\n      const b = r.a === a ? r.b : r.b === a ? r.a : null;\n      if (!b) continue;\n      const express = a.caps.includes(\"relay\") || b.caps.includes(\"relay\");\n      const nd =\n        dist.get(a) + a.pos.distanceTo(b.pos) / (express ? 2.5 : 1) + 8;\n      if (nd \u003c (dist.get(b) ?? Infinity)) {\n        dist.set(b, nd);\n        prev.set(b, { a, r });\n        if (!open.includes(b)) open.push(b);\n      }\n    }\n  }\n  if (!prev.has(to)) return null;\n  const path = [];\n  let c = to;\n  while (c !== from) {\n    const q = prev.get(c);\n    path.unshift({ route: q.r, from: q.a, to: c });\n    c = q.a;\n  }\n  return path;\n}\nbuildRoutes();\nconst routeOuter = new THREE.InstancedMesh(\n    new THREE.TorusGeometry(1.35, 0.16, 6, 32),\n    brass,\n    world.routes.length * 4,\n  ),\n  routeInner = new THREE.InstancedMesh(\n    new THREE.TorusGeometry(1.08, 0.04, 4, 32),\n    gold,\n    world.routes.length * 4,\n  ),\n  routeTeeth = new THREE.InstancedMesh(unitBox, gold, world.routes.length * 32);\nfor (const m of [routeOuter, routeInner, routeTeeth]) {\n  m.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n  m.frustumCulled = false;\n  sceneRoot.add(m);\n}\nfor (const r of world.routes) for (const m of r.rings) m.clear();\nconst routeDummy = new THREE.Object3D(),\n  toothDummy = new THREE.Object3D();\nfunction drawRoutes() {\n  let n = 0;\n  for (const r of world.routes) {\n    if (!r.group.visible) continue;\n    for (const m of r.rings) {\n      m.updateMatrix();\n      routeOuter.setMatrixAt(n, m.matrix);\n      routeInner.setMatrixAt(n, m.matrix);\n      for (let k = 0; k \u003c 8; k++) {\n        const a = (k / 8) * TAU;\n        toothDummy.position.set(Math.cos(a) * 1.35, Math.sin(a) * 1.35, 0);\n        toothDummy.scale.set(0.32, 0.32, 0.38);\n        toothDummy.rotation.set(0, 0, 0);\n        toothDummy.updateMatrix();\n        routeTeeth.setMatrixAt(\n          n * 8 + k,\n          m.matrix.clone().multiply(toothDummy.matrix),\n        );\n      }\n      n++;\n    }\n  }\n  routeOuter.count = n;\n  routeInner.count = n;\n  routeTeeth.count = n * 8;\n  for (const m of [routeOuter, routeInner, routeTeeth])\n    m.instanceMatrix.needsUpdate = true;\n}\nfunction reserved(c, except = null) {\n  // R1.3.10: reservations belong to committed ring transit, not drones\n  // physically waiting at an intake. Drone admission is local and sequential.\n  return world.lots.reduce(\n    (s, l) =\u003e\n      s +\n      (l !== except \u0026\u0026 l.owner === \"transit\" \u0026\u0026 l.journey?.destination === c\n        ? qty(l.comp)\n        : 0),\n    0,\n  );\n}\nfunction accepts(c, l) {\n  return (\n    c.enabled \u0026\u0026\n    amount(c) + reserved(c, l) + qty(l.comp) \u003c= c.capacity \u0026\u0026\n    ((l.stage === \"raw\" \u0026\u0026 c.caps.includes(\"sort\")) ||\n      (l.stage === \"sorted\" \u0026\u0026 (c.caps.includes(\"zip\") || c.caps.includes(\"launch\"))) ||\n      (l.stage === \"packed\" \u0026\u0026 c.caps.includes(\"launch\")))\n  );\n}\nfunction demandDestination(source, l) {\n  // Link owns allocation semantics even though the source commits the conserved packet to a\n  // hub-mediated path. Processed material serves Launcher first; Reservoir is overflow.\n  // No endpoint may bypass Link because pathBetween() only has hub spokes.\n  if (l.stage === \"sorted\" || l.stage === \"packed\") {\n    const launcher = world.cities.find((c) =\u003e c.caps.includes(\"launch\"));\n    if (launcher \u0026\u0026 launcher !== source \u0026\u0026 accepts(launcher, l)) {\n      const path = pathBetween(source, launcher);\n      if (path !== null) return { c: launcher, path };\n    }\n    const reservoir = world.cities.find((c) =\u003e c.caps.includes(\"zip\"));\n    if (reservoir \u0026\u0026 reservoir !== source \u0026\u0026 accepts(reservoir, l)) {\n      const path = pathBetween(source, reservoir);\n      if (path !== null) return { c: reservoir, path };\n    }\n    return undefined;\n  }\n  return world.cities\n    .filter((c) =\u003e c !== source \u0026\u0026 accepts(c, l))\n    .map((c) =\u003e ({ c, path: pathBetween(source, c) }))\n    .filter((x) =\u003e x.path !== null)\n    .sort((a, b) =\u003e amount(a.c) / a.c.capacity - amount(b.c) / b.c.capacity)[0];\n}\nfunction dispatch(c, l) {\n  const dest = demandDestination(c, l);\n  if (!dest || !dest.path.length) return false;\n  const q = qty(l.comp) \u003e 130 ? take(l, 130) : l;\n  const first = dest.path[0], enterNow = canEnterEdge(first);\n  q.owner = \"transit\";\n  q.journey = {\n    source: c,\n    destination: dest.c,\n    path: dest.path,\n    edge: 0,\n    t: 0,\n    waiting: !enterNow,\n  };\n  q.pos.copy(port(c));\n  return true;\n}\nfunction spill(l) {\n  l.owner = \"ground\";\n  l.stage = \"raw\";\n  l.claim = null;\n  l.velocity = V(0, 0, 0);\n  delete l.journey;\n  event(`Cargo ${l.id} lost lift; recoverable material falls to terrain.`);\n}\nfunction updateTransport(dt) {\n  for (const l of [...world.lots])\n    if (l.owner === \"transit\") {\n      const j = l.journey,\n        e = j.path[j.edge];\n      if (!e) {\n        l.owner = j.destination;\n        l.pos.copy(port(j.destination));\n        delete l.journey;\n        world.delivered++;\n        continue;\n      }\n      if (j.interrupted || !available(e.route)) {\n        // Cargo remains at its current position until it safely returns or falls.\n        const safe = [e.from, e.to]\n          .filter((c) =\u003e c.enabled \u0026\u0026 c.connected \u0026\u0026 hasStorageCapacity(c))\n          .sort((a, b) =\u003e {\n            const cost = (c) =\u003e\n              c.pos.distanceTo(l.pos) +\n              (amount(c) + qty(l.comp) \u003e c.capacity ? 100000 : 0);\n            return cost(a) - cost(b);\n          })[0];\n        if (safe) {\n          const d = port(safe).sub(l.pos),\n            step = dt * 10;\n          if (d.length() \u003c step) {\n            if (amount(safe) + qty(l.comp) \u003c= safe.capacity) {\n              l.owner = safe;\n              delete l.journey;\n              event(`Interrupted cargo recovered at ${safe.name}.`);\n            }\n          } else l.pos.addScaledVector(d.normalize(), step);\n        } else spill(l);\n        continue;\n      }\n      // At an intermediate interface, opposing traffic or insufficient headway makes this\n      // packet wait physically at the node. Authoritative route choice and travel speed remain\n      // unchanged; only entry onto the occupied conduit is delayed.\n      if (j.waiting) {\n        const next = j.path[j.edge];\n        if (!next) {\n          j.waiting = false;\n        } else if (canEnterEdge(next, l)) {\n          j.waiting = false;\n          j.t = 0;\n        } else {\n          l.pos.copy(port(next.from));\n          continue;\n        }\n      }\n      j.t +=\n        (dt *\n          (e.from.caps.includes(\"relay\") || e.to.caps.includes(\"relay\")\n            ? 32.5\n            : 13)) /\n        Math.max(1, e.from.pos.distanceTo(e.to.pos));\n      const t = clamp(j.t, 0, 1);\n      l.pos.copy(routePoint(e.route, e.from === e.route.a ? t : 1 - t));\n      if (j.t \u003e= 1) {\n        const nextIndex = j.edge + 1;\n        if (nextIndex === j.path.length) {\n          if (\n            j.destination.enabled \u0026\u0026\n            amount(j.destination) + qty(l.comp) \u003c= j.destination.capacity\n          ) {\n            l.owner = j.destination;\n            world.delivered++;\n            delete l.journey;\n          } else {\n            j.t = 0.99;\n          }\n        } else {\n          const next = j.path[nextIndex];\n          j.edge = nextIndex;\n          j.t = 0;\n          if (canEnterEdge(next, l)) {\n            j.waiting = false;\n            l.pos.copy(port(next.from));\n          } else {\n            j.waiting = true;\n            l.pos.copy(port(next.from));\n          }\n        }\n      }\n    }\n}\n// Drones discover unclaimed exposed matter; receivers are capabilities, never named actors.\nfunction makeDrone(home, index) {\n  const d = {\n    id: index,\n    home,\n    pos: port(home).add(V((random() - 0.5) * 10, 2, (random() - 0.5) * 10)),\n    state: \"seeking\",\n    cargo: null,\n    target: null,\n    receiver: null,\n    mesh: new THREE.Group(),\n  };\n  sceneRoot.add(d.mesh);\n  world.drones.push(d);\n}\nfor (const c of world.cities.filter((c) =\u003e c.caps.includes(\"collect\")))\n  for (let i = 0; i \u003c 24; i++) makeDrone(c, i);\nconst droneBodies = new THREE.InstancedMesh(\n    unitBox,\n    brass,\n    world.drones.length,\n  ),\n  droneWings = new THREE.InstancedMesh(unitBox, gold, world.drones.length),\n  droneRotors = new THREE.InstancedMesh(\n    new THREE.TorusGeometry(0.28, 0.065, 4, 10),\n    dark,\n    world.drones.length * 2,\n  ),\n  droneDummy = new THREE.Object3D();\nfor (const m of [droneBodies, droneWings, droneRotors]) {\n  m.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n  m.frustumCulled = false;\n  sceneRoot.add(m);\n}\nfunction drawDrones() {\n  world.drones.forEach((d, i) =\u003e {\n    droneDummy.position.copy(d.pos);\n    droneDummy.rotation.set(0, d.mesh.rotation.y, 0);\n    droneDummy.scale.set(0.8, 0.25, 0.5);\n    droneDummy.updateMatrix();\n    droneBodies.setMatrixAt(i, droneDummy.matrix);\n    droneDummy.scale.set(1.8, 0.08, 0.18);\n    droneDummy.updateMatrix();\n    droneWings.setMatrixAt(i, droneDummy.matrix);\n    for (let side = 0; side \u003c 2; side++) {\n      const x = side ? 0.75 : -0.75;\n      droneDummy.position\n        .copy(d.pos)\n        .add(V(x, 0, 0).applyAxisAngle(V(0, 1, 0), d.mesh.rotation.y));\n      droneDummy.rotation.set(Math.PI / 2, d.mesh.rotation.y, 0);\n      droneDummy.scale.set(1, 1, 1);\n      droneDummy.updateMatrix();\n      droneRotors.setMatrixAt(i * 2 + side, droneDummy.matrix);\n    }\n  });\n  for (const m of [droneBodies, droneWings, droneRotors])\n    m.instanceMatrix.needsUpdate = true;\n}\n\nfunction moveToward(pos, target, step) {\n  const d = target.clone().sub(pos),\n    len = d.length();\n  pos.addScaledVector(d, len \u003c= step ? 1 : step / len);\n  return len \u003c= step;\n}\nfunction intakeRoom(c, cargo) {\n  if (c.caps.includes(\"zip\") \u0026\u0026 cargo.stage === \"raw\") {\n    const raw = inventory(c)\n      .filter((l) =\u003e l.stage === \"raw\")\n      .reduce((n, l) =\u003e n + qty(l.comp), 0);\n    // R1.3.10: only material already admitted plus this cargo matters.\n    // Other waiting drones do not reserve future intake room.\n    return raw + qty(cargo.comp) \u003c= c.capacity * 0.12;\n  }\n  return true;\n}\nfunction updateDrones(dt) {\n  for (const d of world.drones) {\n    if (!d.home.enabled \u0026\u0026 !d.cargo) {\n      if (d.target) d.target.claim = null;\n      d.target = null;\n      d.state = \"docked\";\n      moveToward(d.pos, port(d.home), dt * 10);\n      continue;\n    }\n    if (d.cargo) {\n      // R1.3.2: collection has one earned civilization intake. Drones do not\n      // opportunistically deposit raw cargo into any city with spare capacity.\n      // Unzip currently owns the intake capability; downstream movement begins only\n      // after that cargo has entered the processing chain.\n      // R1.3.8: destination and admission are different questions.\n      // A loaded collector always flies to the civilization's intake (Unzip).\n      // Intake capacity may delay unloading at the interface, but must never strand\n      // cargo over the extraction site.\n      const receiver = world.cities.find(\n        (c) =\u003e c.enabled \u0026\u0026 c.caps.includes(\"intake\"),\n      );\n      if (!receiver) {\n        d.receiver = null;\n        d.state = \"holding cargo \u00b7 intake offline\";\n        continue;\n      }\n      d.receiver = receiver;\n      const target = port(receiver);\n      d.state = \"carrying \u2192 intake\";\n      moveToward(d.pos, target, dt * 11);\n\n      const canUnload =\n        intakeRoom(receiver, d.cargo) \u0026\u0026\n        amount(receiver) + reserved(receiver, d.cargo) + qty(d.cargo.comp) \u003c= receiver.capacity;\n\n      if (d.pos.distanceTo(target) \u003c= 3.5 \u0026\u0026 canUnload) {\n        d.cargo.owner = receiver;\n        d.cargo.pos.copy(target);\n        d.cargo = null;\n        d.receiver = null;\n        d.target = null;\n        d.state = \"returning home\";\n        world.delivered++;\n      } else {\n        if (d.pos.distanceTo(target) \u003c= 3.5 \u0026\u0026 !canUnload)\n          d.state = \"holding cargo \u00b7 intake backpressure\";\n        d.cargo.pos.copy(d.pos).add(V(0, -0.6, 0));\n      }\n    } else {\n      // R1.3.9: every completed delivery closes the work cycle at Drone City.\n      // A drone must physically return home before it may claim another ground lot.\n      if (d.state === \"returning home\") {\n        const homeTarget = port(d.home);\n        if (moveToward(d.pos, homeTarget, dt * 10)) {\n          d.state = \"seeking\";\n        }\n        continue;\n      }\n      if (!d.target || d.target.owner !== \"ground\") {\n        d.target = world.lots\n          .filter((l) =\u003e l.owner === \"ground\" \u0026\u0026 !l.claim \u0026\u0026 qty(l.comp) \u003e 0.1)\n          .sort(\n            (a, b) =\u003e\n              a.pos.distanceToSquared(d.pos) - b.pos.distanceToSquared(d.pos),\n          )[0];\n        if (d.target) d.target.claim = d;\n      }\n      if (!d.target) {\n        d.state = \"waiting for exposed matter\";\n        const a = world.time * 0.15 + d.id;\n        moveToward(\n          d.pos,\n          port(d.home).add(V(Math.cos(a) * 9, 3, Math.sin(a) * 9)),\n          dt * 3,\n        );\n        continue;\n      }\n      d.state = \"collecting\";\n      const target = d.target.pos.clone().add(V(0, 1, 0));\n      const ground = terrain.height(d.pos.x, d.pos.z);\n      // R1.3.6: collection belongs to the claim, not to exact navigation completion.\n      // The visual ground witness can cover a few world units around its authoritative lot.\n      // Once the claiming drone is horizontally over that patch, it may collect the claimed\n      // quantity; moveToward remains only the crude approach animation.\n      const horizontalToClaim = Math.hypot(\n        d.target.pos.x - d.pos.x,\n        d.target.pos.z - d.pos.z,\n      );\n      if (horizontalToClaim \u003c= 3.5) {\n        const l = d.target,\n          c = qty(l.comp) \u003e 45 ? take(l, 45) : l;\n        l.claim = null;\n        c.owner = d;\n        c.claim = null;\n        c.pos.copy(d.pos);\n        d.cargo = c;\n        d.target = null;\n        d.state = \"carrying\";\n      } else {\n        if (d.pos.distanceTo(target) \u003e 5)\n          target.y = Math.max(target.y, ground + 6);\n        moveToward(d.pos, target, dt * 10);\n      }\n    }\n  }\n}\n// Ballistic logistics commits real inventory at the actual muzzle. Landed loads rejoin shared matter.\nconst beacons = [V(122, 0, 112), V(84, 0, -54), V(53, 0, 68)];\nbeacons.forEach((p) =\u003e (p.y = terrain.height(p.x, p.z)));\nconst beaconGroup = new THREE.Group();\nsceneRoot.add(beaconGroup);\nfor (const p of beacons) {\n  cyl(beaconGroup, stone, p.clone().add(V(0, 0.15, 0)), 3, 0.3);\n  ring(beaconGroup, p.clone().add(V(0, 0.3, 0)), 2.7, V(0, 1, 0), gold);\n  beam(beaconGroup, p, p.clone().add(V(0, 5, 0)), 0.09);\n}\nfunction muzzle(c) {\n  c.mesh.updateMatrixWorld(true);\n  return c.parts.barrel.localToWorld(V(0, 0, -11.7));\n}\n// R1.2.3: R1.2.2's kinetic time compression flattened the accelerator's arc.\n// Revert to the prior coherent ballistic solver while launch purpose is investigated separately.\n// R1.2.4: solving a firing orientation and physically moving the accelerator are separate jobs.\n// The solver may temporarily sample barrel poses synchronously, but restores the visible pose\n// before returning. The actuator below owns finite yaw/pitch slew and firing readiness.\nfunction firingSolution(c, target) {\n  const actualPitch = c.parts.barrel.rotation.x;\n  let pitch = actualPitch;\n  let velocity = V(0, 0, 0);\n  let T = 3;\n  for (let i = 0; i \u003c 5; i++) {\n    c.parts.barrel.rotation.x = pitch;\n    const start = muzzle(c);\n    T = Math.max(3, start.distanceTo(target) / 17);\n    velocity = target.clone().sub(start).multiplyScalar(1 / T);\n    velocity.y += 4.9 * T;\n    pitch = Math.atan2(velocity.y, Math.hypot(velocity.x, velocity.z));\n  }\n  c.parts.barrel.rotation.x = actualPitch;\n  c.mesh.updateMatrixWorld(true);\n  return { pitch, velocity, T };\n}\n// R1.3.13 \u2014 earned ballistic presentation rule.\n// Inspection established two satisfying temporal pairings while preserving the accepted parabola:\n// world 1\u00d7 uses 3\u00d7 projectile traversal; world 4\u00d7 uses 1\u00d7 projectile traversal. This is no longer\n// an observer probe. Initial projectile velocity scales by m and projectile-only gravity by m\u00b2,\n// preserving the same spatial trajectory while changing only traversal time.\nfunction ballisticSpeedMultiplier() { return world.speed === 1 ? 3 : 1; }\nfunction launch(c, l, target) {\n  let need = 75;\n  const parts = [];\n  for (const stock of inventory(c).filter((a) =\u003e a.stage === \"packed\" || a.stage === \"sorted\")) {\n    const q = qty(stock.comp) \u003e need ? take(stock, need) : stock;\n    parts.push(q);\n    need -= qty(q.comp);\n    if (need \u003c 0.00001) break;\n  }\n  const q = combine(parts, c, c.pos, \"packed\");\n  const start = muzzle(c),\n    T = Math.max(3, start.distanceTo(target) / 17);\n  q.owner = \"projectile\";\n  q.pos.copy(start);\n  q.velocity = target\n    .clone()\n    .sub(start)\n    .multiplyScalar(1 / T);\n  q.velocity.y += 0.5 * 9.8 * T;\n  const ballisticScale = ballisticSpeedMultiplier();\n  q.velocity.multiplyScalar(ballisticScale);\n  q.ballisticTimeScale = ballisticScale;\n  q.stage = \"packed\";\n  world.shots++;\n  event(\n    `${c.name} launches ${Math.round(qty(q.comp))} units to a reclamation ground at ${ballisticScale}\u00d7 ballistic traversal.`,\n  );\n}\nfunction updatePhysics(dt) {\n  for (const l of world.lots) {\n    if (l.owner !== \"ground\" \u0026\u0026 l.owner !== \"projectile\") continue;\n    const ballisticScale = l.owner === \"projectile\" ? (l.ballisticTimeScale || 1) : 1;\n    l.velocity.y -= 9.8 * ballisticScale * ballisticScale * dt;\n    l.pos.addScaledVector(l.velocity, dt);\n    const h = terrain.height(l.pos.x, l.pos.z) + 0.25;\n    if (l.pos.y \u003c h) {\n      const was = l.owner === \"projectile\";\n      l.pos.y = h;\n      l.velocity.multiplyScalar(0.15);\n      l.velocity.y = 0;\n      if (was) {\n        l.owner = \"ground\";\n        l.stage = \"raw\";\n        event(\n          `Delivery ${l.id} settled; collectors can recover its original composition.`,\n        );\n      }\n    }\n  }\n  for (const c of world.cities) {\n    let support = -Infinity;\n    for (let k = 0; k \u003c 8; k++) {\n      const a = (k / 8) * TAU;\n      support = Math.max(\n        support,\n        terrain.height(c.pos.x + Math.cos(a) * 5, c.pos.z + Math.sin(a) * 5),\n      );\n    }\n    if (c.pos.y \u003e support + 0.05) {\n      c.velocity -= 9.8 * dt;\n      c.pos.y += c.velocity * dt;\n      if (c.pos.y \u003c= support) {\n        c.pos.y = support;\n        c.velocity = 0;\n      }\n    } else if (c.pos.y \u003c support) {\n      c.pos.y = support;\n      c.velocity = 0;\n    }\n    c.mesh.position.copy(c.pos);\n  }\n}\nfunction updateCities(dt) {\n  for (const c of world.cities) {\n    if (!c.enabled) {\n      c.state = \"suspended\";\n      continue;\n    }\n    c.timer += dt;\n    const inv = inventory(c);\n    if (c.caps.includes(\"extract\")) {\n      const loose = world.lots\n        .filter((l) =\u003e l.owner === \"ground\")\n        .reduce((s, l) =\u003e s + qty(l.comp), 0);\n      c.state =\n        loose \u003e 5000 ? \"waiting \u00b7 exposed stock sufficient\" : \"excavating\";\n      if (loose \u003c 5000 \u0026\u0026 c.timer \u003e 3.5) {\n        c.timer = 0;\n        const i = c.workIndex++,\n          a = ((i % 12) / 12) * TAU,\n          r = 9 + (Math.floor(i / 12) % 3) * 2.5;\n        c.workPos = V(Math.sin(a) * r, 0, Math.cos(a) * r);\n        const x = c.pos.x + c.workPos.x * 1.2,\n          z = c.pos.z + c.workPos.z * 1.2;\n        const l = terrain.extract(x, z, 3.2, 0.9);\n        if (!l) c.state = \"bedrock\";\n        else c.lastAction = world.time;\n      }\n    }\n    if (c.caps.includes(\"sort\")) {\n      const raw = inv.filter((l) =\u003e l.stage === \"raw\");\n      c.state = raw.length ? \"separating\" : \"waiting \u00b7 mixed intake\";\n      if (raw.length \u0026\u0026 c.timer \u003e 0.35) {\n        c.timer = 0;\n        const input = qty(raw[0].comp) \u003e 360 ? take(raw[0], 360) : raw[0];\n        for (let k = 0; k \u003c 4; k++)\n          if (input.comp[k] \u003e 0.00001) {\n            const m = composition();\n            m[k] = input.comp[k];\n            lot(m, c, c.pos, \"sorted\", input.origins);\n          }\n        world.sorted += qty(input.comp);\n        removeLot(input);\n        c.lastAction = world.time;\n      }\n    }\n    if (c.caps.includes(\"zip\")) {\n      const sorted = inv.filter((l) =\u003e l.stage === \"sorted\");\n      c.state =\n        amount(c) \u003e c.capacity * 0.93\n          ? \"full \u00b7 backpressure\"\n          : sorted.length\n            ? \"assembling mixed capsules\"\n            : \"buffering\";\n      if (\n        sorted.length \u003e 1 \u0026\u0026\n        sorted.reduce((n, l) =\u003e n + qty(l.comp), 0) \u003e= 120 \u0026\u0026\n        c.timer \u003e 3.3\n      ) {\n        const chosen = [];\n        let n = 0;\n        for (const l of sorted) {\n          const q = qty(l.comp) \u003e 60 ? take(l, 60) : l;\n          chosen.push(q);\n          n += qty(q.comp);\n          if (n \u003e= 180) break;\n        }\n        if (chosen.length) {\n          combine(chosen, c, c.pos, \"packed\");\n          world.zipped += n;\n          c.lastAction = world.time;\n          c.timer = 0;\n        }\n      }\n    }\n    if (c.caps.includes(\"launch\")) {\n      const processed = inv.filter((l) =\u003e l.stage === \"packed\" || l.stage === \"sorted\");\n      const processedQty = processed.reduce((n, l) =\u003e n + qty(l.comp), 0);\n      const ready = processedQty \u003e= 75 ? processed[0] : null;\n      if (c.nextLaunchAt == null) c.nextLaunchAt = world.time + 6 + Math.random() * 14;\n      if (!c.pendingLaunchTarget \u0026\u0026 ready \u0026\u0026 world.time \u003e= c.nextLaunchAt) {\n        c.pendingLaunchTarget = beacons[Math.floor(Math.random() * beacons.length)];\n        c.target = c.pendingLaunchTarget;\n        event(`${c.name} commits an irregular ballistic delivery.`);\n      }\n      const target = c.pendingLaunchTarget || c.target || null;\n      if (target) {\n        c.target = target;\n        const delta = target.clone().sub(c.pos);\n        const desired = Math.atan2(-delta.x, -delta.z);\n        let diff = Math.atan2(\n          Math.sin(desired - c.aim),\n          Math.cos(desired - c.aim),\n        );\n        c.aim += clamp(diff, -dt * 0.55, dt * 0.55);\n        c.parts.aim.rotation.y = c.aim;\n        const solution = firingSolution(c, target);\n        const pitchDiff = solution.pitch - c.parts.barrel.rotation.x;\n        c.parts.barrel.rotation.x += clamp(pitchDiff, -dt * 0.42, dt * 0.42);\n        const yawAligned = Math.abs(diff) \u003c 0.03;\n        const pitchAligned = Math.abs(pitchDiff) \u003c 0.02;\n        if (c.pendingLaunchTarget \u0026\u0026 ready \u0026\u0026 yawAligned \u0026\u0026 pitchAligned) {\n          c.timer = 0;\n          launch(c, ready, target);\n          c.pendingLaunchTarget = null;\n          c.nextLaunchAt = world.time + 9 + Math.random() * 17;\n          c.lastAction = world.time;\n          c.state = \"committed\";\n        } else if (c.pendingLaunchTarget) {\n          c.state = ready ? \"aiming \u00b7 launch committed\" : \"waiting \u00b7 launch committed, no packaged supply\";\n        } else {\n          c.state = ready ? \"ready \u00b7 between irregular launches\" : \"waiting \u00b7 no packaged supply\";\n        }\n      } else {\n        c.state = ready ? \"ready \u00b7 between irregular launches\" : \"waiting \u00b7 no packaged supply\";\n      }\n    }\n    if (c.caps.includes(\"relay\"))\n      c.state = c.connected ? \"relaying compatible traffic\" : \"isolated\";\n    if (c.caps.includes(\"collect\"))\n      c.state = \"collectors discovering exposed stock\";\n    // Any interface can forward cargo whose next consumer is compatible.\n    c.dispatchClock = (c.dispatchClock || 0) + dt;\n    const dispatchInterval = c.caps.includes(\"sort\") ? 0.28 : 1.5;\n    if (c.dispatchClock \u003e dispatchInterval) {\n      c.dispatchClock = 0;\n      const launcherNeedsProcessed = c.caps.includes(\"zip\") \u0026\u0026 world.cities.some((x) =\u003e\n        x.caps.includes(\"launch\") \u0026\u0026 x.enabled \u0026\u0026 amount(x) + reserved(x) \u003c x.capacity\n      );\n      const outgoing = inventory(c).filter((l) =\u003e\n        !acceptsOwnProcessing(c, l) || (launcherNeedsProcessed \u0026\u0026 l.stage === \"sorted\")\n      );\n      let sent = false;\n      for (const out of outgoing)\n        if (dispatch(c, out)) {\n          sent = true;\n          break;\n        }\n      if (outgoing.length \u0026\u0026 !sent)\n        c.state = \"blocked \u00b7 no compatible route / capacity\";\n    }\n  }\n}\nfunction acceptsOwnProcessing(c, l) {\n  return (\n    (l.stage === \"raw\" \u0026\u0026 c.caps.includes(\"sort\")) ||\n    (l.stage === \"sorted\" \u0026\u0026 (c.caps.includes(\"zip\") || c.caps.includes(\"launch\"))) ||\n    (l.stage === \"packed\" \u0026\u0026 c.caps.includes(\"launch\"))\n  );\n}\n// Presentation: each bead samples a known material population, never invented traffic.\nconst MAX_BEADS = 22000,\n  beadMesh = new THREE.InstancedMesh(\n    new THREE.IcosahedronGeometry(1, 0),\n    new THREE.MeshStandardMaterial({\n      metalness: 0.25,\n      roughness: 0.54,\n      envMapIntensity: 0.4,\n    }),\n    MAX_BEADS,\n  );\nbeadMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\nbeadMesh.frustumCulled = false;\nbeadMesh.castShadow = false;\nsceneRoot.add(beadMesh);\nconst beadDummy = new THREE.Object3D(),\n  colors = materials.map((m) =\u003e new THREE.Color(m.color));\nlet beads = 0;\nfunction bead(pos, size, k) {\n  if (beads \u003e= MAX_BEADS) return;\n  beadDummy.position.copy(pos);\n  beadDummy.scale.setScalar(size);\n  beadDummy.rotation.set(0, 0, 0);\n  beadDummy.updateMatrix();\n  beadMesh.setMatrixAt(beads, beadDummy.matrix);\n  beadMesh.setColorAt(beads, colors[k]);\n  beads++;\n}\nfunction hash(n) {\n  const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;\n  return x - Math.floor(x);\n}\nfunction materialAt(l, f) {\n  let n = f * qty(l.comp);\n  for (let k = 0; k \u003c 4; k++) {\n    n -= l.comp[k];\n    if (n \u003c= 0) return k;\n  }\n  return 3;\n}\nconst capsuleMesh = new THREE.InstancedMesh(\n  new THREE.TorusGeometry(1, 0.075, 4, 12),\n  brass,\n  256,\n);\ncapsuleMesh.frustumCulled = false;\nsceneRoot.add(capsuleMesh);\nlet capsules = 0;\nfunction capsule(pos, r) {\n  if (capsules \u003e= 256) return;\n  beadDummy.position.copy(pos);\n  beadDummy.scale.setScalar(r);\n  beadDummy.rotation.set(Math.PI / 2, 0, 0);\n  beadDummy.updateMatrix();\n  capsuleMesh.setMatrixAt(capsules++, beadDummy.matrix);\n}\n// Reservoir presentation owns spatial history, not material truth.  A fixed slot field\n// fills the ellipsoidal hemisphere from its floor upward. Inventory composition deltas\n// append visible strata; withdrawals peel newest compatible strata without rewriting\n// the authoritative lot ordering or Zip behavior.\nconst RESERVOIR_VISUAL_SLOTS = 9000,\n  RESERVOIR_RADIUS = 6.82,\n  RESERVOIR_FLOOR_Y = 1.52,\n  RESERVOIR_DOME_CENTER_Y = 1.3,\n  RESERVOIR_DOME_HEIGHT = 8.0,\n  reservoirSlots = [];\nfunction hemisphereHeightForVolumeFraction(f) {\n  // Ellipsoid scaling cancels from the normalized hemisphere-volume equation:\n  // F(t) = 1.5 t - 0.5 t^3, where t is height from the equator/base in [0,1].\n  let lo = 0, hi = 1;\n  for (let i = 0; i \u003c 18; i++) {\n    const t = (lo + hi) * 0.5,\n      v = 1.5 * t - 0.5 * t * t * t;\n    if (v \u003c f) lo = t; else hi = t;\n  }\n  return (lo + hi) * 0.5;\n}\nfor (let i = 0; i \u003c RESERVOIR_VISUAL_SLOTS; i++) {\n  const f = (i + 0.5) / RESERVOIR_VISUAL_SLOTS,\n    t = hemisphereHeightForVolumeFraction(f),\n    y = RESERVOIR_FLOOR_Y + t * (RESERVOIR_DOME_HEIGHT - (RESERVOIR_FLOOR_Y - RESERVOIR_DOME_CENTER_Y)),\n    dy = clamp((y - RESERVOIR_DOME_CENTER_Y) / RESERVOIR_DOME_HEIGHT, 0, 0.999),\n    legalR = RESERVOIR_RADIUS * Math.sqrt(Math.max(0, 1 - dy * dy)),\n    a = i * 2.399963229728653,\n    rr = Math.sqrt(hash(i * 0.917 + 41.7)) * legalR * 0.965;\n  reservoirSlots.push(V(Math.cos(a) * rr, y, Math.sin(a) * rr));\n}\nfunction inventoryComposition(c) {\n  const out = composition();\n  for (const l of inventory(c)) l.comp.forEach((v, k) =\u003e out[k] += v);\n  return out;\n}\nfunction syncReservoirVisualHistory(c) {\n  const now = inventoryComposition(c);\n  if (!c.reservoirVisual) {\n    c.reservoirVisual = { layers: [], previous: [...now] };\n    // Initial lots are archaeological starting strata in their authoritative creation order.\n    for (const l of inventory(c))\n      if (qty(l.comp) \u003e 1e-6) c.reservoirVisual.layers.push({ comp: [...l.comp] });\n    return c.reservoirVisual;\n  }\n  const h = c.reservoirVisual,\n    delta = now.map((v, k) =\u003e v - h.previous[k]);\n  // Withdrawals peel the newest visible material that can account for each constituent.\n  for (let k = 0; k \u003c 4; k++) {\n    let remove = Math.max(0, -delta[k]);\n    for (let i = h.layers.length - 1; i \u003e= 0 \u0026\u0026 remove \u003e 1e-7; i--) {\n      const q = Math.min(remove, h.layers[i].comp[k]);\n      h.layers[i].comp[k] -= q;\n      remove -= q;\n    }\n  }\n  h.layers = h.layers.filter((layer) =\u003e qty(layer.comp) \u003e 1e-5);\n  const added = delta.map((v) =\u003e Math.max(0, v));\n  if (qty(added) \u003e 1e-5) h.layers.push({ comp: added });\n  h.previous = [...now];\n  return h;\n}\nfunction drawReservoirFill(c, sampleRatio) {\n  const total = amount(c);\n  if (total \u003c= 0) return;\n  const history = syncReservoirVisualHistory(c),\n    maxByCapacity = Math.floor((total / c.capacity) * RESERVOIR_VISUAL_SLOTS),\n    desired = Math.max(1, Math.ceil(total * 1.35 * sampleRatio)),\n    count = Math.min(maxByCapacity, desired, RESERVOIR_VISUAL_SLOTS),\n    layers = history.layers,\n    layerTotals = layers.map((x) =\u003e qty(x.comp));\n  let li = 0,\n    layerStart = 0,\n    layerEnd = layerTotals[0] || total;\n  for (let i = 0; i \u003c count; i++) {\n    const mass = ((i + 0.5) / count) * total;\n    while (li \u003c layers.length - 1 \u0026\u0026 mass \u003e layerEnd) {\n      layerStart = layerEnd;\n      li++;\n      layerEnd += layerTotals[li];\n    }\n    const layer = layers[li] || { comp: inventoryComposition(c) },\n      local = clamp((mass - layerStart) / Math.max(1e-9, qty(layer.comp)), 0, 0.999999),\n      k = materialAt(layer, local),\n      slotIndex = Math.min(\n        RESERVOIR_VISUAL_SLOTS - 1,\n        Math.floor(((i + 0.5) / count) * maxByCapacity),\n      ),\n      p = reservoirSlots[slotIndex].clone().add(V(c.pos.x, c.pos.y, c.pos.z));\n    bead(p, 0.15, k);\n  }\n}\nfunction drawMatter() {\n  beads = 0;\n  capsules = 0;\n  const sampleRatio = Math.min(\n    1,\n    (MAX_BEADS - world.lots.length * 2) /\n      Math.max(\n        1,\n        world.lots.reduce((n, l) =\u003e n + qty(l.comp) * 1.5, 0),\n      ),\n  );\n  for (const c of world.cities) {\n    const inv = inventory(c),\n      total = amount(c);\n    if (!total) continue;\n    let offset = 0;\n    const reservoir = c.caps.includes(\"zip\"),\n      r = reservoir ? 7.08 : c.caps.includes(\"sort\") ? 3.12 : 2.88;\n    if (reservoir) {\n      drawReservoirFill(c, sampleRatio);\n      if (inv.some((l) =\u003e l.stage === \"packed\" || l.stage === \"sorted\"))\n        capsule(c.pos.clone().add(V(0, 2.5, 0)), r * 0.8);\n      continue;\n    }\n    for (const l of inv) {\n      const separated = c.caps.includes(\"sort\") \u0026\u0026 l.stage === \"sorted\",\n        kBin = l.comp.findIndex((v) =\u003e v \u003e 0),\n        binAngle = (kBin / 3 - 0.5) * Math.PI * 0.95,\n        center = separated\n          ? c.pos\n              .clone()\n              .add(\n                V(\n                  Math.sin(binAngle) * 8.4,\n                  0,\n                  Math.cos(binAngle) * 8.4,\n                ).multiplyScalar(clamp((world.time - l.createdAt) / 1.4, 0, 1)),\n              )\n          : c.pos;\n      const count = Math.max(1, Math.ceil(qty(l.comp) * 1.5 * sampleRatio));\n      for (let j = 0; j \u003c count; j++) {\n        const u = (offset + j) / Math.max(1, total * 1.5 * sampleRatio),\n          a = (offset + j) * 2.399963,\n          radius = (separated ? 1.3 : r) * Math.sqrt(hash(offset + j + 17));\n        const height = Math.min(3, (total / c.capacity) * 4 + 0.3);\n        const k = materialAt(l, hash(j + l.id * 0.33));\n        bead(\n          V(\n            center.x + Math.cos(a) * radius,\n            center.y + 1.74 + u * height * 1.2,\n            center.z + Math.sin(a) * radius,\n          ),\n          0.12,\n          k,\n        );\n      }\n      offset += count;\n    }\n    if (inv.some((l) =\u003e l.stage === \"packed\" || l.stage === \"sorted\"))\n      capsule(c.pos.clone().add(V(0, 2.5, 0)), r * 0.8);\n  }\n  for (const l of world.lots) {\n    if (typeof l.owner === \"object\" \u0026\u0026 world.cities.includes(l.owner)) continue;\n    const count = Math.min(\n      l.owner === \"ground\" ? 260 : 100,\n      Math.max(1, Math.ceil(qty(l.comp) * 1.2 * sampleRatio)),\n    );\n    const moving = l.owner === \"transit\",\n      packed = l.stage === \"packed\";\n    for (let j = 0; j \u003c count; j++) {\n      const k = materialAt(l, hash(j * 0.73 + l.id)),\n        a = j * 2.399963,\n        rr = Math.sqrt(hash(j + l.id * 3));\n      let p;\n      if (moving \u0026\u0026 l.journey) {\n        const e = l.journey.path[l.journey.edge];\n        if (!e || l.journey.waiting) {\n          // Waiting packets condense at the interface rather than smearing through a blocked edge.\n          p = l.pos.clone().add(V(Math.cos(a) * rr * 0.42, Math.sin(a) * rr * 0.36, (hash(j + 13) - 0.5) * 0.7));\n        } else {\n          const centerT = clamp(l.journey.t, 0, 1),\n            elasticity = Math.sin(Math.PI * centerT),\n            routeDistance = Math.max(1, e.from.pos.distanceTo(e.to.pos)),\n            // Longitudinal extent grows with distance from either interface, but remains a\n            // bounded fraction of this conduit. Quantity changes how many discrete witnesses\n            // are visible, not authoritative packet timing.\n            halfExtentT = Math.min(0.19, 8.5 / routeDistance) * elasticity,\n            rank = count \u003c= 1 ? 0 : j / (count - 1) - 0.5,\n            // Stable tiny irregularity avoids a synthetic dotted line while preserving order.\n            irregular = (hash(j * 5.17 + l.id * 11.3) - 0.5) * (count \u003c= 1 ? 0 : 0.34 / count),\n            grainT = clamp(centerT + rank * 2 * halfExtentT + irregular * elasticity, 0, 1),\n            routeT = e.from === e.route.a ? grainT : 1 - grainT;\n          p = routePoint(e.route, routeT);\n          // Keep transverse noise subordinate to longitudinal separation and orient it in a\n          // local frame around the curved conduit rather than in fixed world X/Y.\n          const eps = 0.004,\n            ta = clamp(routeT - eps, 0, 1),\n            tb = clamp(routeT + eps, 0, 1),\n            tangent = routePoint(e.route, tb).sub(routePoint(e.route, ta)).normalize(),\n            side = V(0, 1, 0).cross(tangent).normalize(),\n            up = tangent.clone().cross(side).normalize(),\n            radial = 0.10 + rr * 0.16;\n          p.addScaledVector(side, Math.cos(a) * radial);\n          p.addScaledVector(up, Math.sin(a) * radial * 0.75);\n        }\n      } else if (l.owner === \"ground\") {\n        const radius = Math.min(3.2, 0.4 + Math.sqrt(qty(l.comp)) * 0.11);\n        p = l.pos\n          .clone()\n          .add(V(Math.cos(a) * rr * radius, 0, Math.sin(a) * rr * radius));\n        p.y =\n          Math.max(l.pos.y, terrain.height(p.x, p.z) + 0.18) +\n          (1 - rr) * Math.min(1, qty(l.comp) * 0.003);\n      } else\n        p = l.pos\n          .clone()\n          .add(\n            V(\n              Math.cos(a) * rr * 0.55,\n              Math.sin(a) * rr * 0.5,\n              (hash(j + 13) - 0.5) * 1.1,\n            ),\n          );\n      bead(p, l.owner === \"ground\" ? 0.16 : 0.115, k);\n    }\n    if (packed) capsule(l.pos, 0.85);\n  }\n  beadMesh.count = beads;\n  beadMesh.instanceMatrix.needsUpdate = true;\n  if (beadMesh.instanceColor) beadMesh.instanceColor.needsUpdate = true;\n  capsuleMesh.count = capsules;\n  capsuleMesh.instanceMatrix.needsUpdate = true;\n}\nconst selectionRing = ring(sceneRoot, V(), 10, V(0, 1, 0), gold);\nselectionRing.visible = false;\nlet selected = null,\n  mode = null;\nfunction updatePresentation() {\n  for (const r of world.routes) {\n    r.group.visible = inRange(r) \u0026\u0026 r.a.connected \u0026\u0026 r.b.connected;\n    const on = available(r);\n    r.rings.forEach((m, i) =\u003e {\n      const t = (i + 1) / 5;\n      m.position.copy(routePoint(r, t));\n      const tangent = routePoint(r, Math.min(1, t + 0.01)).sub(\n        routePoint(r, Math.max(0, t - 0.01)),\n      );\n      m.quaternion.setFromUnitVectors(V(0, 0, 1), tangent.normalize());\n      m.scale.setScalar(on ? 1 : 0.6);\n    });\n  }\n  for (const c of world.cities) {\n    if (c.parts.hammer) {\n      const p = c.workPos || V(0, 0, 9);\n      c.parts.hammer.position.x = p.x;\n      c.parts.hammer.position.z = p.z;\n      c.parts.arm.position.set(p.x / 2, 9, p.z / 2);\n      c.parts.arm.scale.set(1, 1, Math.hypot(p.x, p.z));\n      c.parts.arm.rotation.y = Math.atan2(p.x, p.z);\n      c.parts.hammer.position.y =\n        (terrain.height(c.pos.x + p.x * 1.2, c.pos.z + p.z * 1.2) - c.pos.y) /\n          1.2 +\n        2 +\n        (c.state === \"excavating\"\n          ? Math.pow(Math.sin((c.timer / 3.5) * Math.PI), 2) * 5\n          : 4);\n      const hy = c.parts.hammer.position.y;\n      c.parts.ram.position.set(p.x, (9 + hy) / 2, p.z);\n      c.parts.ram.scale.y = Math.max(0.05, (9 - hy) / 6);\n    }\n    if (c.parts.sorter \u0026\u0026 c.state === \"separating\")\n      c.parts.sorter.rotation.z = world.time * 0.7;\n    if (c.parts.zip \u0026\u0026 c.state.includes(\"assembl\"))\n      c.parts.zip.rotation.z = -world.time * 0.5;\n  }\n  for (const d of world.drones) {\n    d.mesh.position.copy(d.pos);\n    d.mesh.rotation.y = Math.sin(world.time * 0.4 + d.id) * 0.2;\n  }\n  if (selected) {\n    selectionRing.visible = true;\n    selectionRing.position.copy(selected.pos).add(V(0, 0.25, 0));\n  } else selectionRing.visible = false;\n  waterUniform.time.value = world.time;\n  drawMatter();\n  drawRoutes();\n  drawDrones();\n}\nfunction audit() {\n  const total = world.lots.reduce((s, l) =\u003e s + qty(l.comp), 0),\n    expected = world.initial + world.extracted;\n  const constituents = composition();\n  for (const l of world.lots) l.comp.forEach((v, k) =\u003e (constituents[k] += v));\n  const constituentErrors = constituents.map(\n    (v, k) =\u003e v - world.initialComposition[k] - world.extractedComposition[k],\n  );\n  return {\n    time: world.time,\n    total,\n    expected,\n    error: total - expected,\n    constituentErrors,\n    lots: world.lots.length,\n    ground: world.lots.filter((l) =\u003e l.owner === \"ground\").length,\n    transit: world.lots.filter((l) =\u003e l.owner === \"transit\").length,\n    shots: world.shots,\n    sorted: world.sorted,\n    zipped: world.zipped,\n    deliveries: world.delivered,\n    excavations: world.excavations,\n    cities: world.cities.map((c) =\u003e ({\n      name: c.name,\n      state: c.state,\n      stock: amount(c),\n    })),\n  };\n}\nfunction step(dt) {\n  world.time += dt;\n  updatePhysics(dt);\n  updateDrones(dt);\n  for (const d of world.drones) {\n    d.pos.y = Math.max(d.pos.y, terrain.height(d.pos.x, d.pos.z) + 1);\n    if (d.cargo) d.cargo.pos.copy(d.pos).add(V(0, -0.6, 0));\n  }\n  updateTransport(dt);\n  updateCities(dt);\n  for (const l of [...world.lots])\n    if (qty(l.comp) \u003c 0.00001 \u0026\u0026 !l.claim) removeLot(l);\n  if (world.lots.length \u003e 1800) {\n    // Consolidate only equal ownership, stage and spatially equivalent piles.\n    const groups = new Map();\n    for (const l of world.lots) {\n      if (\n        l.claim ||\n        l.owner === \"transit\" ||\n        l.owner === \"projectile\" ||\n        world.drones.includes(l.owner)\n      )\n        continue;\n      const key =\n        (typeof l.owner === \"object\"\n          ? l.owner.id\n          : \"g\" + Math.round(l.pos.x / 3) + \",\" + Math.round(l.pos.z / 3)) +\n        l.stage;\n      if (!groups.has(key)) groups.set(key, []);\n      groups.get(key).push(l);\n    }\n    for (const ls of groups.values())\n      if (ls.length \u003e 3) combine(ls, ls[0].owner, ls[0].pos, ls[0].stage);\n  }\n}\n// Compact investigation UI; no command economy and no canned capability demonstrations.\nconst ui = document.createElement(\"div\");\nui.id = \"civilization-ui\";\nui.innerHTML = `\u003cheader\u003e\u003cdiv\u003e\u003cstrong\u003eSIX CITIES\u003c/strong\u003e\u003cspan\u003e A living material civilization\u003c/span\u003e\u003c/div\u003e\u003cnav\u003e\u003cbutton id=\"pause\"\u003e\u2161\u003c/button\u003e\u003cbutton id=\"speed\"\u003e1\u00d7\u003c/button\u003e\u003cbutton id=\"overview\"\u003eOverview\u003c/button\u003e\u003cbutton id=\"help\"\u003e?\u003c/button\u003e\u003c/nav\u003e\u003c/header\u003e\u003cdiv id=\"city-list\"\u003e\u003c/div\u003e\u003csection id=\"inspector\" hidden\u003e\u003c/section\u003e\u003caside id=\"guide\" hidden\u003e\u003cb\u003eFollow the matter.\u003c/b\u003e\u003cp\u003eDrag to orbit. Shift/right drag to pan. Pinch to zoom and pan. Tap a city to inspect.\u003c/p\u003e\u003cp\u003eForested aggregate, amber sandstone, pale granite and dark ironstone travel as mixed loads. Unzip separates them. The Reservoir assembles recoverable mixed capsules. The Launcher delivers them ballistically to reclamation grounds.\u003c/p\u003e\u003cp\u003eSuspend a city, isolate its interfaces, disable one route, or relocate it onto new terrain. Supply and connectivity determine what happens next.\u003c/p\u003e\u003cp\u003eThe Thumper leaves real excavation. Drones collect exposed material, carry it, and choose available receivers. Brass bands denote combined capsules; unbanded streams are separated grains.\u003c/p\u003e\u003cbutton id=\"close-help\"\u003eContinue observing\u003c/button\u003e\u003c/aside\u003e\u003cfooter\u003e\u003cspan id=\"telemetry\"\u003e\u003c/span\u003e\u003cbutton id=\"ledger-button\"\u003eWorld ledger\u003c/button\u003e\u003c/footer\u003e\u003csection id=\"ledger\" hidden\u003e\u003c/section\u003e`;\ndocument.body.append(ui);\nconst css = document.createElement(\"style\");\ncss.textContent = `#status{display:none}#civilization-ui{position:fixed;inset:0;pointer-events:none;font:11px/1.5 ui-monospace,monospace;color:#ece8d8}button{color:inherit;font:inherit;background:#14272ade;border:1px solid #d9c79b50;border-radius:5px;padding:6px 10px;cursor:pointer;touch-action:manipulation}button:hover,button.active{background:#74613edc;border-color:#dfc58c}header{position:absolute;left:16px;right:16px;top:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;text-shadow:0 1px 5px #162b30}header strong{font-size:14px;letter-spacing:.16em}header span{display:block;font:italic 12px Georgia,serif;opacity:.85}nav{display:flex;gap:5px;pointer-events:auto}#city-list{position:absolute;top:76px;left:16px;display:flex;gap:5px;flex-wrap:wrap;max-width:calc(100% - 32px);pointer-events:auto}#city-list button{padding:5px 8px;background:#172d31ae}#inspector,#guide,#ledger{position:absolute;right:16px;top:116px;width:300px;max-width:calc(100vw - 54px);max-height:calc(100dvh - 190px);overflow:auto;padding:14px;background:#102428ed;backdrop-filter:blur(12px);border:1px solid #c5ad7766;border-radius:8px;pointer-events:auto;touch-action:pan-y}#inspector h2{font:20px Georgia,serif;margin:0;color:#f0d49a}#inspector small{color:#aec5c4}#inspector p{margin:8px 0}#inspector .actions{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0}#inspector .bar{height:5px;background:#07171c;display:flex;margin:7px 0}#inspector .bar i{display:block;height:5px}#inspector details{margin:8px 0}#inspector summary{cursor:pointer}#inspector .route{display:flex;justify-content:space-between;align-items:center;margin:4px 0}#inspector button{padding:4px 7px}#guide{left:16px;right:auto}footer{position:absolute;bottom:12px;left:16px;right:16px;display:flex;justify-content:space-between;align-items:end;gap:10px;flex-wrap:wrap;text-shadow:0 1px 4px #152328}footer button{pointer-events:auto}#telemetry{background:#132b30bf;padding:5px 8px;border-radius:4px;font-size:10px}#ledger{top:auto;bottom:52px;left:16px;right:auto;width:450px}#ledger p{margin:6px 0;border-top:1px solid #c7bc8b22;padding-top:5px}#fault{z-index:999}#inspector[hidden],#guide[hidden],#ledger[hidden]{display:none}@media(max-width:600px){header{left:10px;right:10px;top:8px}header strong{font-size:12px}header span{font-size:10px}#city-list{top:68px;left:10px;gap:4px}#city-list button{font-size:10px;padding:4px 6px}#inspector,#guide{right:10px;top:130px;max-height:calc(100dvh - 205px);width:260px}footer{left:10px;right:10px;font-size:9px}#telemetry{font-size:8px;max-width:66%}}`;\ndocument.head.append(css);\nconst $ = (id) =\u003e document.getElementById(id);\nfor (const c of world.cities) {\n  const b = document.createElement(\"button\");\n  b.textContent = c.name;\n  b.onclick = () =\u003e select(c);\n  $(\"city-list\").append(b);\n}\nfunction relocateCity(c, x, z) {\n  // A moved interface may redraw its future routes, never teleport existing cargo.\n  for (const l of world.lots) {\n    if (l.journey?.path.some((e) =\u003e e.from === c || e.to === c))\n      l.journey.interrupted = true;\n  }\n  c.pos.set(x, terrain.height(x, z), z);\n  c.velocity = 0;\n  c.mesh.position.copy(c.pos);\n  for (const l of inventory(c)) l.pos.copy(c.pos);\n  renderer.shadowMap.needsUpdate = true;\n  event(`${c.name} relocated; spatial route availability recomputed.`);\n}\nfunction select(c) {\n  selected = c;\n  mode = null;\n  $(\"inspector\").hidden = !c;\n  if (c) renderInspector(true);\n}\nfunction renderInspector(force = false) {\n  if (!selected) return;\n  const c = selected,\n    inv = inventory(c),\n    comp = composition();\n  inv.forEach((l) =\u003e l.comp.forEach((v, k) =\u003e (comp[k] += v)));\n  const n = qty(comp);\n  if (force) {\n    $(\"inspector\").innerHTML =\n      `\u003cdiv style=\"float:right\"\u003e\u003cbutton id=\"close-inspector\"\u003e\u00d7\u003c/button\u003e\u003c/div\u003e\u003ch2\u003e${c.name} City\u003c/h2\u003e\u003csmall\u003e${c.verb}\u003c/small\u003e\u003cp id=\"city-state\"\u003e\u003c/p\u003e\u003cdiv class=\"bar\" id=\"stock-bar\"\u003e\u003c/div\u003e\u003cdiv id=\"stock\"\u003e\u003c/div\u003e\u003cdiv class=\"actions\"\u003e\u003cbutton id=\"toggle-city\"\u003e\u003c/button\u003e\u003cbutton id=\"toggle-network\"\u003e\u003c/button\u003e\u003cbutton id=\"move-city\"\u003eRelocate\u003c/button\u003e\u003cbutton id=\"excavate\"\u003eUndercut support\u003c/button\u003e\u003c/div\u003e\u003cdiv id=\"intent\"\u003e\u003c/div\u003e\u003cdetails\u003e\u003csummary\u003eInterfaces \u0026 routes\u003c/summary\u003e\u003cdiv id=\"routes\"\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails\u003e\u003csummary\u003eMaterial witness\u003c/summary\u003e\u003cdiv id=\"witness\"\u003e\u003c/div\u003e\u003c/details\u003e`;\n    $(\"close-inspector\").onclick = () =\u003e select(null);\n    $(\"toggle-city\").onclick = () =\u003e {\n      c.enabled = !c.enabled;\n      event(`${c.name} ${c.enabled ? \"resumed\" : \"suspended\"}.`);\n      renderInspector(true);\n    };\n    $(\"toggle-network\").onclick = () =\u003e {\n      if (!hasFreightInterface(c)) return;\n      c.connected = !c.connected;\n      event(`${c.name} interfaces ${c.connected ? \"restored\" : \"isolated\"}.`);\n      renderInspector(true);\n    };\n    $(\"move-city\").onclick = () =\u003e {\n      mode = \"move\";\n      $(\"intent\").textContent =\n        \"Tap a new patch of terrain. Inventory moves with its container; routes follow their interface reach.\";\n    };\n    $(\"excavate\").onclick = () =\u003e {\n      terrain.extract(c.pos.x, c.pos.z, 12, 2);\n      event(\n        `Observer undercut ${c.name}; support is resampled by world gravity.`,\n      );\n    };\n    for (const r of world.routes.filter((r) =\u003e r.a === c || r.b === c)) {\n      const d = document.createElement(\"div\");\n      d.className = \"route\";\n      const other = r.a === c ? r.b : r.a;\n      d.innerHTML = `\u003cspan\u003e${other.name}\u003c/span\u003e\u003cbutton\u003e${r.enabled ? \"Disconnect\" : \"Reconnect\"}\u003c/button\u003e`;\n      d.querySelector(\"button\").onclick = () =\u003e {\n        r.enabled = !r.enabled;\n        event(\n          `${c.name} \u2194 ${other.name} ${r.enabled ? \"restored\" : \"interrupted\"}.`,\n        );\n        renderInspector(true);\n      };\n      $(\"routes\").append(d);\n    }\n  }\n  $(\"city-state\").textContent = c.state;\n  $(\"toggle-city\").textContent = c.enabled ? \"Suspend\" : \"Resume\";\n  const freightInterface = hasFreightInterface(c);\n  $(\"toggle-network\").style.display = freightInterface ? \"\" : \"none\";\n  $(\"toggle-network\").textContent = c.connected ? \"Isolate\" : \"Reconnect\";\n  if (hasStorageCapacity(c)) {\n    $(\"stock\").textContent =\n      `${Math.round(n).toLocaleString()} / ${c.capacity.toLocaleString()} units \u00b7 ${inv.length} lots`;\n    $(\"stock-bar\").innerHTML = comp\n      .map(\n        (v, k) =\u003e\n          `\u003ci style=\"width:${(v / c.capacity) * 100}%;background:#${materials[k].color.toString(16)}\"\u003e\u003c/i\u003e`,\n      )\n      .join(\"\");\n  } else {\n    $(\"stock\").textContent = c.caps.includes(\"relay\")\n      ? \"Transit infrastructure \u00b7 no authoritative storage\"\n      : \"No authoritative city inventory\";\n    $(\"stock-bar\").innerHTML = \"\";\n  }\n  $(\"witness\").innerHTML =\n    materials.map((m, k) =\u003e `${m.short}: ${Math.round(comp[k])}`).join(\" \u00b7 \") +\n    `\u003cp\u003e${\n      inv\n        .slice(0, 3)\n        .map(\n          (l) =\u003e\n            `Lot ${l.id} \u00b7 ${l.stage} \u00b7 ${l.origins.slice(0, 2).join(\"; \")}`,\n        )\n        .join(\"\u003cbr\u003e\") || \"No material held.\"\n    }\u003c/p\u003e`;\n}\nfunction layoutUI() {\n  const bottom = ui.querySelector(\"header\").getBoundingClientRect().bottom;\n  $(\"city-list\").style.top = bottom + 12 + \"px\";\n  const top = $(\"city-list\").getBoundingClientRect().bottom + 10;\n  for (const id of [\"inspector\", \"guide\"]) {\n    $(id).style.top = top + \"px\";\n    $(id).style.maxHeight = Math.max(120, innerHeight - top - 75) + \"px\";\n  }\n}\naddEventListener(\"resize\", () =\u003e requestAnimationFrame(layoutUI));\nrequestAnimationFrame(layoutUI);\n$(\"pause\").onclick = () =\u003e {\n  world.paused = !world.paused;\n  $(\"pause\").textContent = world.paused ? \"\u25b6\" : \"\u2161\";\n};\n$(\"speed\").onclick = () =\u003e {\n  world.speed = world.speed === 1 ? 4 : 1;\n  $(\"speed\").textContent = world.speed + \"\u00d7\";\n};\n$(\"help\").onclick = () =\u003e {\n  $(\"guide\").hidden = !$(\"guide\").hidden;\n};\n$(\"close-help\").onclick = () =\u003e {\n  $(\"guide\").hidden = true;\n};\n$(\"ledger-button\").onclick = () =\u003e {\n  $(\"ledger\").hidden = !$(\"ledger\").hidden;\n};\nfunction overview() {\n  view.target.set(0, 6, -8);\n  view.distance = innerWidth \u003c 700 ? 300 : 230;\n  view.yaw = 0.22;\n  view.pitch = 0.52;\n  applyView();\n}\n$(\"overview\").onclick = overview;\nconst raycaster = new THREE.Raycaster(),\n  pointer = new THREE.Vector2();\nlet clickStart = null;\ncanvas.addEventListener(\"pointerdown\", (e) =\u003e {\n  clickStart = {\n    x: e.clientX,\n    y: e.clientY,\n    t: performance.now(),\n    multi: view.pointers.size \u003e 1,\n  };\n});\ncanvas.addEventListener(\"pointerup\", (e) =\u003e {\n  if (\n    !clickStart ||\n    clickStart.multi ||\n    Math.hypot(e.clientX - clickStart.x, e.clientY - clickStart.y) \u003e 7 ||\n    performance.now() - clickStart.t \u003e 700\n  )\n    return;\n  pointer.set(\n    (e.clientX / innerWidth) * 2 - 1,\n    1 - (e.clientY / innerHeight) * 2,\n  );\n  raycaster.setFromCamera(pointer, camera);\n  if (mode === \"move\" \u0026\u0026 selected) {\n    const hit = raycaster.intersectObject(terrain.mesh)[0];\n    if (hit) {\n      relocateCity(selected, hit.point.x, hit.point.z);\n      mode = null;\n      renderInspector(true);\n    }\n    return;\n  }\n  const hit = raycaster.intersectObjects(world.cities.map((c) =\u003e c.pick))[0];\n  if (hit) select(hit.object.userData.city);\n});\nlet last = performance.now(),\n  accum = 0,\n  drawClock = 0,\n  uiClock = 0,\n  fps = 60;\nfunction animate(now) {\n  try {\n    const elapsed = (now - last) / 1000,\n      real = Math.min(0.1, elapsed);\n    last = now;\n    fps = fps * 0.97 + 0.03 / Math.max(0.001, elapsed);\n    if (!world.paused) {\n      accum += real * world.speed;\n      let steps = 0;\n      while (accum \u003e= 1 / 30 \u0026\u0026 steps++ \u003c 15) {\n        step(1 / 30);\n        accum -= 1 / 30;\n      }\n    }\n    if (terrain.dirty) updateTerrain();\n    drawClock += real;\n    if (drawClock \u003e 0.06) {\n      updatePresentation();\n      drawClock = 0;\n    }\n    uiClock += real;\n    if (uiClock \u003e 0.5) {\n      uiClock = 0;\n      renderInspector();\n      const a = audit();\n      $(\"telemetry\").textContent =\n        `${Math.floor(fps)} fps \u00b7 ${Math.round(world.time)}s \u00b7 ${Math.round(a.total).toLocaleString()} matter \u00b7 ${a.transit} shipments \u00b7 ${world.drones.filter((d) =\u003e d.cargo).length} laden drones`;\n      $(\"ledger\").innerHTML =\n        `\u003cb\u003eWorld ledger \u00b7 conserved matter\u003c/b\u003e\u003cp\u003eInitial ${world.initial.toFixed(1)} + extracted ${world.extracted.toFixed(1)} = present ${a.total.toFixed(1)}\u003cbr\u003eConservation residual ${a.error.toExponential(2)}\u003cbr\u003e${world.shots} launches \u00b7 ${world.delivered} arrivals \u00b7 ${Math.round(world.sorted)} sorted \u00b7 ${Math.round(world.zipped)} packaged \u00b7 ${world.excavations} excavations\u003c/p\u003e` +\n        world.events\n          .slice(0, 12)\n          .map((e) =\u003e `\u003cp\u003e${Math.round(e.time)}s \u00b7 ${e.text}\u003c/p\u003e`)\n          .join(\"\");\n      if (\n        Math.abs(a.error) \u003e 0.1 ||\n        a.constituentErrors.some((v) =\u003e Math.abs(v) \u003e 0.1)\n      )\n        throw new Error(\"Matter conservation violated: \" + a.error);\n    }\n    renderer.render(scene, camera);\n  } catch (e) {\n    renderer.setAnimationLoop(null);\n    fail(\"civilization runtime\", e);\n  }\n}\nwindow.civilization = {\n  world,\n  terrain,\n  materials,\n  step,\n  audit,\n  inventory,\n  pathBetween,\n  select,\n  updatePresentation,\n  renderInspector,\n  overview,\n  renderer,\n  scene,\n  camera,\n  view,\n  relocate: (i, x, z) =\u003e {\n    relocateCity(world.cities[i], x, z);\n  },\n  simulate: (seconds) =\u003e {\n    for (let t = 0; t \u003c seconds; t += 1 / 30) step(1 / 30);\n    if (terrain.dirty) updateTerrain();\n    updatePresentation();\n    return audit();\n  },\n};\noverview();\nupdatePresentation();\nevent(\"Civilization awake. Surface stock and stored strata are finite.\");\nrenderer.setAnimationLoop(animate);\nwindow.__CIV_READY__ = true;\n\n\u003c/script\u003e\n\u003c!-- Embedded vendor module. Opaque renderer dependency, not civilization semantics. --\u003e\n\u003cscript id=\"embedded-three\" type=\"application/octet-stream\"\u003edata:text/javascript;base64,