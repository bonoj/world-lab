]===selected);$('owner').innerHTML='';for(const a of state.nodes){const opt=document.createElement('option');opt.value=a[0];opt.textContent=a[0]+(records[a[0]]?'':' \u00b7 absent');$('owner').append(opt)}$('owner').value=selected;$('material').value=n[4];$('age').value=n[5];$('ageValue').value=n[5].toFixed(1);$('lift').value=n[6]?.lift||0;$('liftValue').value=String(n[6]?.lift||0);$('presence').textContent=n[6]?.off?'Restore owner':'Remove owner';$('mode').textContent=full?'Machinery ON':'Masses ONLY';$('mode').classList.toggle('on',!full);$('seed').textContent='Seed '+state.seed+' +1';$('program').textContent='seed '+state.seed+' / '+state.ground+'\\n'+state.nodes.map(n=\u003e{const [id,op,s,rel,mat,age,edit]=n;return id+': '+op+' '+JSON.stringify(s)+' '+JSON.stringify(rel)+' '+mat+' age='+age+(edit?.lift?' lift='+edit.lift:'')+(edit?.off?' OFF':'')}).join('\\n');}\nfunction draw(){renderer.render(scene,camera);$('status').textContent=(full?'MATERIAL WORLD':'SEMANTIC MASSES')+' \u00b7 '+Object.keys(records||{}).length+' owners \u00b7 '+instances+' instances \u00b7 '+renderer.info.render.calls+' draws \u00b7 '+buildMS+'ms build \u00b7 '+signature;}\nfunction guard(fn){return(...args)=\u003e{try{fn(...args)}catch(e){vmFail('experiment',e)}}}\nfunction edit(fn){const n=state.nodes.find(n=\u003en[0]===selected);fn(n);rebuild()}\n$('tools').onclick=()=\u003e{$('panel').classList.toggle('open');$('tools').setAttribute('aria-expanded',String($('panel').classList.contains('open')))};\n$('preset').onchange=guard(()=\u003e{state=structuredClone(presets[$('preset').selectedIndex]);selected=state.nodes[0][0];rebuild()});\n$('mode').onclick=guard(()=\u003e{full=!full;rebuild()});$('owner').onchange=guard(()=\u003e{selected=$('owner').value;syncUI();highlight();draw()});$('cycle').onclick=guard(()=\u003e{selected=state.nodes[(state.nodes.findIndex(n=\u003en[0]===selected)+1)%state.nodes.length][0];syncUI();highlight();draw()});\n$('material').onchange=guard(()=\u003eedit(n=\u003en[4]=$('material').value));$('age').onchange=guard(()=\u003eedit(n=\u003en[5]=+$('age').value));$('age').oninput=()=\u003e{$('ageValue').value=$('age').value};$('lift').onchange=guard(()=\u003eedit(n=\u003e{n[6]||={};n[6].lift=+$('lift').value}));$('lift').oninput=()=\u003e{$('liftValue').value=$('lift').value};$('presence').onclick=guard(()=\u003eedit(n=\u003e{n[6]||={};n[6].off=!n[6].off}));$('seed').onclick=guard(()=\u003e{state.seed++;rebuild()});$('reset').onclick=guard(()=\u003e{state=structuredClone(presets[$('preset').selectedIndex]);selected=state.nodes[0][0];rebuild()});$('home').onclick=guard(()=\u003e{view.target.set(0,2,0);view.yaw=.62;view.pitch=.52;view.distance=55;applyView();draw()});\nconst pointers=new Map();let last=null,tap=null;const canvas=$('c');function gesture(){const a=[...pointers.values()];if(!a.length)return null;return{x:a.reduce((s,p)=\u003es+p.x,0)/a.length,y:a.reduce((s,p)=\u003es+p.y,0)/a.length,d:a.length\u003e1?Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y):0,n:a.length}}\nfunction pan(dx,dy){const scale=2*view.distance*Math.tan(16*Math.PI/180)/innerHeight;view.target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,0),-dx*scale);view.target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,1),dy*scale)}\ncanvas.addEventListener('pointerdown',e=\u003e{canvas.setPointerCapture(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});last=gesture();tap=pointers.size===1?{x:e.clientX,y:e.clientY,id:e.pointerId}:null});\ncanvas.addEventListener('pointermove',guard(e=\u003e{if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});const g=gesture();if(tap\u0026\u0026Math.hypot(e.clientX-tap.x,e.clientY-tap.y)\u003e5)tap=null;if(last\u0026\u0026g.n===last.n){const dx=g.x-last.x,dy=g.y-last.y;if(g.n\u003e1){pan(dx,dy);if(g.d\u003e0\u0026\u0026last.d\u003e0)view.distance*=last.d/g.d}else if(e.shiftKey||e.buttons===2)pan(dx,dy);else{view.yaw-=dx*.006;view.pitch+=dy*.004}applyView();draw()}last=g}));\ncanvas.addEventListener('pointerup',guard(e=\u003e{if(tap\u0026\u0026tap.id===e.pointerId){const ray=new THREE.Raycaster();ray.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,1-e.clientY/innerHeight*2),camera);const hit=ray.intersectObject(root,true)[0];if(hit\u0026\u0026hit.object.userData.owner!=='ground'){selected=hit.object.userData.owner;syncUI();highlight();draw()}}pointers.delete(e.pointerId);last=gesture();tap=null}));\nfor(const type of ['pointercancel','lostpointercapture'])canvas.addEventListener(type,e=\u003e{pointers.delete(e.pointerId);last=gesture();tap=null});canvas.addEventListener('contextmenu',e=\u003ee.preventDefault());canvas.addEventListener('wheel',guard(e=\u003e{e.preventDefault();view.distance*=Math.exp(clamp(e.deltaY,-150,150)*.002);applyView();draw()}),{passive:false});addEventListener('resize',guard(resize));\nstate=structuredClone(presets[0]);selected=state.nodes[0][0];rebuild();resize();window.vmReady=true;clearTimeout(window.vmWatch);\n// Small inspection surface for reproducibility/automation, not a host API or save contract.\nwindow.vmInspect=()=\u003e({state:structuredClone(state),camera:{target:view.target.toArray(),yaw:view.yaw,pitch:view.pitch,distance:view.distance},signature,instances,owners:Object.keys(records),drawCalls:renderer.info.render.calls,geometries:renderer.info.memory.geometries,buildMS,full,ready:window.vmReady});\n} catch(e) {clearTimeout(window.vmWatch);vmFail('module / startup',e);}\n\u003c/script\u003e\n\u003cscript type=\"text/plain\" id=\"visual-machinery-semantics\"\u003e\nVISUAL MACHINERY \u2014 T1 / SMALL PROGRAM, OWNED MATERIAL CONSEQUENCES\nCENTRAL QUESTION\nCan masses + relations + material + condition produce coherent distant richness, without a finished-object catalog? This pass tests the lower half of prose -\u003e program -\u003e world. No prose ingestion, inference, generated imagery, raster scene assets, or dependencies on other labs.\n\nACTUAL VOCABULARY\nEach line is [id, operation, dimensions, relation, material, age, optional edit]. The displayed program is a readable serialization of the actual authoritative tuples, not a decorative paraphrase. Dimensions are width/height/depth. mass uses a center position; stack rests on parent top; cap is a triangular prism resting on parent top; attach uses [parent, side \u00b11]; span uses ordered [left anchor, right anchor], deriving its width and height from their bounds. span dimension x=0 means inferred, not zero-width mesh. stone spans realize an arch, other materials realize braced beams. Presets are data only. Suspended court has no dedicated generator. Scene ground is either an island or a channel; these finite composition priors are explicit semantic input, not an inferred ecology.\nMATERIAL REGIONS\nstone: dark mortar core + stagger-free irregular courses and coping; timber: panels + dark posts and belts; copper: large patinated panels. cap: shared pitched silhouette, overlapping courses, ridge, fascia. span: shared arch spandrel or braced deck, partial parapet losses. Openings use projecting frames and dark fields, not Boolean cutouts. age controls clustered stains, missing surface pieces, edge dislocation, attached foliage and debris. No structural stability simulation. Aged cores remain intact; damage is surface/parapet damage, not arbitrary volumetric fracture.\n\nOWNERSHIP / DETERMINISM\nTuples and seed own world state. Topologically ordered relationships resolve in a single pass. Removing an owner suppresses all transitive dependents; restoring it restores them. Lift offsets the selected owner in world Y and propagates through relationships. A lifted attachment can float: this is an intentional relation probe, not physics. A span uses the lower anchor top rather than tilting, so lifting one anchor need not move the span until it becomes the limiting anchor. Each owner's RNG uses scene seed + stable id, preventing edits from shuffling unrelated owners. Draw batches retain owner id, material region and shape; CPU raycast maps an instance to that owner. ground owns terrain, shoreline and ripples. No hidden random calls, animated world time, or camera-dependent population generation. Observer state never regenerates the world. Host cold-mount still resets lab state by original host contract.\n\nVIEWING BAND\n32-degree vertical perspective; minimum orbit radius 55 world units in landscape, 55/aspect in portrait to preserve horizontal scene footprint. Maximum 2.7 times that radius. Typical world width 25, hero footprint around half the landscape width; structure details roughly subpixel to a few pixels. Zoom cannot enter asset inspection distance. Orbit, pan, material changes, mode switches, reseeding, reset and preset selection preserve observer state; Home is the sole explicit pose reset. Resize enforces the distance band only when necessary. Mouse orbit, Shift/right drag pan, wheel zoom; one-finger orbit, two-finger centroid pan + pinch. Static render-on-demand, no continuous render loop.\n\nMECHANISMS / TRANSFER HYPOTHESES\n- Shared surface subdivision with material-specific proportions creates several visual scales from one mass. Applies to all non-cap/non-span masses across presets; transferable candidate, not yet proof across arbitrary prose.\n- Large silhouette + middle-scale courses + fine world-space pigment modulation avoids relying on noise alone. Shader is procedural arithmetic, no sampled images.\n- Dark core under discrete cladding, coping light edges, and directional shadows strengthen contact/readability. Reusable across masonry/timber/copper; openings remain an illusion at grazing angles.\n- Owner-local aging and colonization cluster consequences on their source instead of scattering unrelated decorations. Cheap transferable surface grammar, not ecology or growth simulation.\n- Caps, arch edges and broken parapets carry silhouette information while shader grain carries only pigment. Instancing per owner/material/shape bounds draw calls; shared geometry/materials survive rebuilds and generated geometries are disposed.\n\nCOMPARISON / LIMITS / ARCHAEOLOGY\nMasses mode preserves primary silhouettes, terrain support and lighting but removes details and substitutes neutral material. Water remains a common stage. This measures the aggregate material/detail contribution, not an isolated ablation of each mechanism. It does not remove the semantic roof/arch primitives themselves. Outline is an observer diagnostic.\nNo visual-model calls were used for construction or validation. Perceptual success still needs human inspection. Tiny near-coplanar window fields and moss are distant-view approximations. Terrain is a bounded cluster of coarse rocks, not continuous height-field geology. Arch remains structurally whole beneath damaged parapets. World-space shader phase changes when a parent moves; geometry RNG remains parent stable. Topological tuples are trusted built-in data, not a general parser/editor. CDN Three.js is required, consistent with sibling labs; failed load, script parse, shader compilation, WebGL loss and runtime exceptions surface through independent bootstrap, watchdog and guarded controls. CDN absence is a reported failure, not an offline fallback.\n\nVALIDATION EVIDENCE \u2014 FIRST PASS\nHeadless Chromium 153 / software WebGL: all three presets started without script or shader errors. Fixed-seed detail -\u003e masses -\u003e detail restored identical world signatures; reset restored each preset. Owner material/age/lift edits, transitive remove/restore and repeat reseeding executed. Preset instance counts 2236 / 1902 / 2207; main render draw counts 40 / 50 / 49. Twelve successive reseeds left geometry allocation count at 7. Build times in this test were roughly 9\u201330ms, not an Android benchmark. 390px touch emulation verified orbit, two-finger pan/pinch and camera preservation through comparison. UI stayed within viewport width. Host navigation retained one active iframe and successfully cold-mounted back. Forced CDN rejection and injected module syntax failure both produced visible lab diagnostics. All original lab sources and host bytes were checked unchanged; every embedded executable script was parsed separately. Raster capture had nonempty scene variation, but no visual-model inspection or beauty rating was performed.\nThe environment's browser could not directly fetch CDN modules; runtime tests routed exact Three.js 0.180.0 bytes downloaded from the specified CDN into the browser. Production HTML retains the CDN import. Network portability and actual Android GPU performance remain user-device checks. No claimed external service fallback.\n\nPROJECT BOUNDARY\nThe host and the five earlier labs remain unchanged. No renderer, material, entity, camera or state framework is shared. No new collaboration method is claimed. Preserve this semantic surface as the experiment learns.\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e\n"},{"id":"orbital-construction","title":"3D \u00b7 ORBITAL CONSTRUCTION","kind":"Three.js / Modular Orbital Construction Toy","source":"\u003c!doctype html\u003e\u003chtml lang=\"en\"\u003e\u003chead\u003e\n\u003cmeta charset=\"utf-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\"\u003e\n\u003ctitle\u003eOrbital Construction \u2014 E2 Construction Vocabulary\u003c/title\u003e\n\u003cstyle\u003ehtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#010204;touch-action:none}canvas{display:block;touch-action:none}#reset{position:fixed;right:16px;bottom:16px;width:44px;height:44px;border-radius:50%;border:1px solid #ffffff38;background:#10151caa;color:#ddd;font:21px system-ui;z-index:3} \n\n#selection{position:fixed;left:50%;top:max(14px,env(safe-area-inset-top));transform:translateX(-50%);\npadding:7px 11px;border:1px solid #ffffff28;border-radius:8px;background:#0c1118c9;color:#e7ebef;\nfont:12px/1.2 system-ui;letter-spacing:.04em;z-index:4;opacity:0;pointer-events:none;transition:opacity .12s}\n#selection.show{opacity:1}\n#fault{position:fixed;left:10px;bottom:10px;color:#ffb36b;font:11px system-ui;z-index:9;pointer-events:none}\n\n\n#controls{position:fixed;left:16px;bottom:16px;display:flex;flex-wrap:wrap;gap:8px;max-width:calc(100vw - 92px);z-index:3}\n#controls button{height:44px;padding:0 14px;border-radius:22px;border:1px solid #ffffff38;background:#10151caa;color:#ddd;font:12px system-ui;letter-spacing:.08em;white-space:nowrap}\n\n#xp-top{position:fixed;top:10px;left:10px;right:10px;display:flex;gap:6px;flex-wrap:wrap;z-index:5;align-items:center;pointer-events:none}#xp-top\u003e*{pointer-events:auto}#xp-top select,#xp-top button,#xp-panel button,#xp-panel select{font:11px system-ui;color:#e4e8e9;background:#101b25eb;border:1px solid #ffffff38;border-radius:7px;min-height:38px;padding:6px 9px;max-width:100%}#xp-top .on{background:#3d5960}#xp-panel{display:none;position:fixed;top:57px;left:10px;width:355px;max-width:calc(100vw - 20px);max-height:calc(100dvh - 160px);overflow:auto;touch-action:pan-y;background:#101923f5;color:#d5dfe3;border:1px solid #83959e77;border-radius:9px;padding:11px;box-sizing:border-box;z-index:6;font:11px/1.5 system-ui}#xp-panel.open{display:block}.xp-row{display:flex;gap:6px;flex-wrap:wrap;margin:7px 0}#xp-panel select{flex:1;min-width:110px}#xp-readout{font:10px/1.5 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:160px;overflow:auto;padding:8px;background:#080f16}#xp-status{font:10px system-ui;opacity:.8}#xp-panel button:disabled{opacity:.35}#fault{display:none;z-index:99;left:10px;right:10px;bottom:75px;max-height:45%;overflow:auto;pointer-events:auto;background:#351b1bf5;border:1px solid #d98565;border-radius:6px;padding:12px;white-space:pre-wrap}#selection{top:auto;bottom:76px;max-width:90%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#controls{gap:5px;left:10px;bottom:10px;max-width:calc(100vw - 70px)}#controls button{height:40px;font-size:10px;padding:0 10px}#reset{right:10px;bottom:10px}button{cursor:pointer}@media(max-width:430px){#xp-top{gap:4px}#xp-top select,#xp-top button{font-size:10px;padding:5px 6px}#xp-compose{max-width:170px!important}}\n\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\n\u003cdiv id=\"xp-top\"\u003e\u003cselect id=\"xp-compose\" aria-label=\"Composition\"\u003e\u003coption value=\"habitat\"\u003eAccreted habitation\u003c/option\u003e\u003coption value=\"yard\"\u003eOrbital construction yard\u003c/option\u003e\u003coption value=\"radial\"\u003eRadial junction network\u003c/option\u003e\u003coption value=\"bench\"\u003eSingle-module bench\u003c/option\u003e\u003coption value=\"archive\"\u003eOriginal V1.65 station\u003c/option\u003e\u003c/select\u003e\u003cbutton id=\"xp-tools\" aria-expanded=\"false\"\u003eModules \u25be\u003c/button\u003e\u003cbutton id=\"xp-ports\"\u003ePorts\u003c/button\u003e\u003cbutton id=\"xp-home\"\u003eHome\u003c/button\u003e\u003c/div\u003e\n\u003csection id=\"xp-panel\"\u003e\u003cb\u003eORBITAL CONSTRUCTION \u00b7 E2\u003c/b\u003e\u003cdiv class=\"xp-row\"\u003e\u003cselect id=\"xp-owner\" aria-label=\"Selected semantic module\"\u003e\u003c/select\u003e\u003cbutton id=\"xp-solo\"\u003eIsolate\u003c/button\u003e\u003c/div\u003e\u003cdiv class=\"xp-row\"\u003e\u003cselect id=\"xp-port\" aria-label=\"Selected interface\"\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"xp-row\"\u003e\u003cselect id=\"xp-kind\" aria-label=\"Module vocabulary\"\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"xp-row\"\u003e\u003cbutton id=\"xp-add\"\u003eAttach at port\u003c/button\u003e\u003cbutton id=\"xp-study\"\u003eStudy unattached\u003c/button\u003e\u003c/div\u003e\u003cdiv class=\"xp-row\"\u003e\u003cbutton id=\"xp-detach\"\u003eDetach branch\u003c/button\u003e\u003cbutton id=\"xp-nudge\"\u003eMove +X\u003c/button\u003e\u003cbutton id=\"xp-roll\"\u003eRoll joint 90\u00b0\u003c/button\u003e\u003c/div\u003e\u003cpre id=\"xp-readout\"\u003e\u003c/pre\u003e\u003cdiv id=\"xp-status\"\u003e\u003c/div\u003e\u003cp\u003eTap a module to inspect. Drag to orbit; pinch to zoom. Shift-drag / two-finger drag to pan. Detail and Texture are independent. Amber: free pressure port. Blue: free structural port. Green: joined.\u003c/p\u003e\u003cp\u003eBuilt-in isolation hatches keep free pressure interfaces sealed. Terminations are separate one-port modules. Attach rejects incompatible or occupied ports. Assembly edits preserve the observer; Home frames the result. Room 001 remains the preserved interior probe.\u003c/p\u003e\u003c/section\u003e\n\u003cdiv id=\"selection\"\u003e\u003c/div\u003e\u003cdiv id=\"fault\"\u003e\u003c/div\u003e\u003cbutton id=\"reset\" aria-label=\"Reset view\"\u003e\u21ba\u003c/button\u003e\u003cdiv id=\"controls\"\u003e\u003cbutton id=\"greeble\" aria-label=\"Toggle detail\"\u003eDETAIL ON\u003c/button\u003e\u003cbutton id=\"texture\" aria-label=\"Toggle texture\"\u003eTEXTURE ON\u003c/button\u003e\u003cbutton id=\"interior\" aria-label=\"Enter interior\"\u003eINTERIOR\u003c/button\u003e\u003c/div\u003e\n\u003cscript type=\"text/plain\" id=\"orbital-e2-semantics\"\u003eORBITAL CONSTRUCTION \u2014 E2 / VISUAL MACHINERY EXPEDITION\nCURRENT CONTRACT (supersedes implementation-specific portions of the preserved V0\u2013V1.65 archaeology below)\n\nQUESTION\nCan a small set of semantic construction families produce materially different, rich orbital facilities, while every component is complete when unattached and every connection remains explicit? The reference images supplied construction evidence: pressure shells versus open frames, inhabited glazing, working decks, lifting/receiving equipment, routed services and multiple visual frequencies. They are not runtime assets or traced layouts. This implementation uses geometry, procedural shader surfaces and existing procedural textures only; no image generation or inference service.\n\nPRESERVED\nThe existing World Lab host and all six unrelated lab sources are untouched. Within Orbital, the original exterior remains under Original V1.65 station. Its module IDs and older stationToy API survive. Room 001, its unresolved metric containment, human-scale look/bounded dolly, lander, containment sequencing, cargo hierarchy and orrery/alignment detector remain implemented. Original lighting is restored when observing the archive or interior. Detail and Texture retain separate meanings. The full earlier semantic/development record remains verbatim after this document. It is archaeology, not a demand to preserve weak rendering mechanisms.\n\nNEW MODULE CONTRACT\nA module owns a finished shell/frame, its generated detail, per-module surface state, named local ports and optional local practical lights. Unattached pressure modules have real built-in closed isolation hatches. These valves are intrinsic manufactured anatomy, not anonymous endcap modules added to conceal holes. Connected pressure ports remain coupled/isolated: the joint is a sealed union, not a claim that a door has opened or pressure has equalized. Explicit one-port termination modules add function beyond that intrinsic closure. The exterior graph represents sealed pressure boundaries; it is not a traversable internal floor plan or pressure-flow simulation.\n\nPORTS / SNAPPING\nEvery port stores a local position, outward unit normal, canonical tangent frame, interface family, size and occupancy. Standard pressure radius = .48; wide pressure = .8; frame half-width = .42. The scale adapter joins standard to wide; the communal volume accepts the wide interface at its aft end. Pressure collar contact planes and frame plates are authored in these same frames, with hardware behind the plane. Small bolt protrusion is mating hardware, not stray detail.\nSnapping aligns full frames with opposite normals, coincident contact points and an optional roll. It does not derive topology from mesh overlap. Type/size mismatches, occupied ports, self-links, multiple incoming constraints and cycles are rejected before a pose change. Stations currently form directed assembly forests: each child has one incoming joint; loops/multi-anchor constraint solving are deliberately unsupported. Descendants follow a detached/reconnected or rolled branch rigidly while retaining stable IDs. Moving a connected child independently is rejected. UI Detach moves the branch 1.6 units along its former parent-port normal to expose the now-independent interfaces.\nPressure ports include sleeved collars, seating rings, isolation hatch and repeated fastening hardware. Structural interfaces have square plates, corner fixtures and backing stems. Platform edge corridors deliberately omit rail segments opposite docking faces. Detail placement uses oriented, shape-aware bounding envelopes sampled along the long axis against finite port exclusion cylinders; unsafe whole pieces are rejected, not clipped through sockets. This protects local intended interfaces, not arbitrary world-space neighbors.\n\nVOCABULARY \u2014 37 NAMED KINDS IN SEVEN REALIZATION FAMILIES\nJunctions: elbow, tee, wye, orthogonal cross, six-axis cross (four lateral + poles), radial-six, octagon (eight lateral + poles). A junction is explicitly named; no leftover mesh is promoted into topology. Octagon uses an eight-sided chamber whose face apothem and port radius agree. Junctions also offer one structural mounting interface.\nPressure: arm, long-arm; scale adapter is its own realization family.\nHabitation: short-drum, long-drum, compact pod, industrial workshop, observation, greenhouse, communal, utility. Their distinctions include elliptical/round versus box shells, panoramic glazed bays with actual shallow interior geometry, planted trays, workshop window rhythms, communal scale and external utility tanks. Round and rectangular forms have different envelope-derived frame/detail rules.\nWork platforms: yard, cargo-dock, service-dock, receiving, crane-platform, equipment, airlock-platform. Load rails, receiving shoes, cargo restraint geometry, service banks, tank racks, entry steps and crane foundations distinguish function. Equipment and cargo here are module-owned consequences, not independent simulated actors.\nStructure: open truss, pylon, beam, service-frame. Shared repeated stations derive rails, crossmembers and diagonal bracing; beams add a load-bearing web.\nMachines: articulated crane, handling gantry, instrument mast. These are complete, selectable modules with structural foot interfaces. Crane boom/cable/hook/counterweight and gantry hoist have explicit geometry but no new articulated animation or load simulation.\nTerminations: sealed bulkhead, observation endcap, airlock, docking termination, service termination. Each has exactly one pressure port. The docking termination's exposed capture hardware is not a second station-construction port in this pass.\n\nTHREE COMPOSITIONAL TESTS\nAccreted habitation: 25 modules, 24 explicit connections; wide adapter/communal annex, industrial workshop, greenhouse, long habitat, observation tower, secondary junction, cargo spur and deliberate terminations.\nConstruction yard: 17 modules, 16 connections; receiving gantry, central crane, cargo and service wings, pylon/service frame, instrument mast and sparse pressure architecture.\nRadial network: 21 modules, 20 connections; octagon with T/Y/vertical/radial branches, cross and elbow routes plus a small inhabited terminus. These are add/connect programs using the same catalog, not separate scene generators.\nSingle-module bench: any catalog kind alone, with its ports unoccupied. This is an executable test of the module contract. Isolate hides neighbors for observer inspection without changing occupancy; use the bench or Detach to inspect truly unattached state.\n\nLAYERS / OWNERSHIP\nModule roots are transform/semantic objects. Form is split between pressure and structural layers according to function/material region. Detail is independent optional construction evidence. Surface state is independent of both. Merged meshes retain owner ID, region and layer; the station is never merged into one opaque mesh. Existing setDetail / setFrame / setTexture handles remain, and stationToy.expedition exposes catalog, registry, links, make, connect, detach, moveBranch, inspect and composition. Ports are module-local even when the complete module is rotated. inspect() emits plain graph/pose/port data plus alignment and resource metrics.\n\nMACHINERY THAT TRANSFERS\n1. Envelope-first realization: round service lanes follow curvature; rectangular lanes follow flat faces. Frame bands, mounting offsets and detail placements consume the same dimensions. Applying cylindrical bands to box habitats initially produced intersecting/floating frames; this was replaced, not accepted as decoration.\n2. Protected interface corridors: port geometry, exclusion regions and working-platform rail gaps share one semantic interface. Detail cannot claim space simply because the surface has room for another object.\n3. Manufactured frequency hierarchy: primary pressure volumes/open spans; middle bands, cross-braces, window bays, receiving rails and routed services; fine panels, fasteners, replacement-tone variation and directional scuff marks. Detail OFF retains meaningful structure and functional silhouettes.\n4. Procedural object-local surfaces: antialiased panel rhythm, seams, fastener fields, plate variation and restrained marks. Region-specific surface scales distinguish hull, deck and frame. Fields move with module geometry. Texture OFF removes these treatments but leaves physical beams, windows, ribs, cables and beveled geometry intact.\n5. Shared bevel primitive gives small housings/decks/crates edge response without unique meshes. Curved profile primitives and repeated stations produce more material variation with few geometry rules.\n6. Local glazed compartments: transparent sides, opaque envelope, floor, plants/furniture and a local practical light preserve parallax and sparse warm inhabited evidence. No scene image behind the window.\n7. Ownership-preserving batching: shared authoring primitives are transformed/merged per owner + layer + material region. This reduces thousands of independent detail objects while retaining selection and per-module layers. Geometry/materials are disposed on composition replacement. Fixed module IDs seed any variation.\n8. Static exterior rendering and cached directional shadows: camera/UI/world changes mark the exterior dirty; the renderer sleeps between changes. Interior toys keep their existing animation loop. Pixel ratio is capped at 1.5. No required postprocessing. The shadow frustum is bounded to the vicinity of supplied compositions; very large custom extensions may outgrow its high-quality coverage.\n\nOBSERVER / INTERACTION\nExterior orbit/pinch behavior remains; Shift/right drag and two-finger centroid pan are added. Two-finger cancellation releases gesture state. Tap selects semantic owners, including generated detail. Hidden archive/isolated modules are excluded from selection. All assembly edits, Detail, Texture and isolation preserve camera state. Composition replacement and explicit Home frame the new view; Home fits per-module bounds rather than the empty corners of one enormous assembly AABB. Interior entry/exit preserves the earlier situated camera contract and exterior pose. No world transform represents observer motion. UI controls wrap and the module panel scrolls within narrow displays.\n\nPERFORMANCE / COMPROMISES\nExterior complexity is approximately 86k\u2013146k merged triangles in the supplied scenes, plus hardware hatches and the sparse background; no per-frame procedural regeneration. Software Chromium renders reported roughly 124\u2013234 draw calls, with cached shadows. These are test-environment observations, not an Android performance guarantee. The original exterior/interior remain resident CPU-side as archaeology, though hidden and unrendered outside their view. A 60-module UI assembly cap bounds interactive growth; programmatic consumers must remain responsible for budgets.\nNo global collision solver, automatic rerouting, multibody load simulation, articulated crane controls, cyclic assembly solver or full pressure interior generation is included. A locally valid snap can put another branch through nearby architecture; inspect composition after recombination. Major primitive shells are intentionally economical; bevels and service grammar improve manufactured read but do not reproduce the reference images' fine realism. Transparent glazing is conventionally sorted, not order-independent. Shader treatment is color/material evidence, not geometric displacement. Existing interior layout is preserved as its own unresolved probe, not automatically assigned to each new habitat.\n\nFAILURE ARCHAEOLOGY / VALIDATION\nFirst runtime checks caught: a .48 versus .42 structural-port default mismatch; GLSL's reserved word `patch`; and a preset consuming a Y junction's already-used input. All were corrected. These were startup/runtime faults that a JavaScript parse check alone would not catch. They are preserved here as evidence for explicit interface typing, shader compilation checks and occupancy validation.\nAn independent classic bootstrap reports module parse/load/runtime failures. A watchdog reports startup stalls; WebGL context loss is visible. Optional expansion-construction errors restore the earlier exterior where possible. Surface-shader failures request a retry with plain materials and leave diagnostics visible. Dependency/module parse failure cannot execute the base lab and is reported rather than disguised as a fallback. CDN Three.js 0.180.0 remains the sole renderer dependency.\nHeadless Chromium 153/software WebGL validated all compositions and all 37 standalone types, sealed unused pressure ports, finite transforms, clean startup/shader compilation, exact port mating (errors below 2e-15 world units), independent comparison layers, branch mutation/reconnection, occupied/type/cycle rejection, preservation of the room/toy handles, responsive 390px controls, and stable geometry allocations through repeated rebuilds. Browser testing used exact pinned CDN bytes routed locally because this execution environment's browser fetch path is restricted; actual user-device network and Android GPU behavior remain field tests. Supplied image references were authoring-time evidence only.\n\nNEXT EVIDENCE\nInspect unfamiliar combinations on the bench and in the graph. Stronger local surface routing, collision-aware branch placement or a useful articulated machine should be earned by those observations. Do not replace this with an encyclopedia of scene-specific finished stations. Preserve the earlier archaeology below while revising this current semantic surface with actual findings.\n\nFINAL SUCCESS-CONDITION REVIEW\n1. Same semantic project, stronger construction vocabulary: preserved legacy station/room/toy handles and added 37 named types through shared realization families.\n2. Strong form without optional layers: inspected the habitat composition with Detail/Texture comparison; all compositions share the same independent layers. Pressure envelopes, trusses, crane/gantry, collars, rails and inhabited bays remain geometry.\n3\u20134. Organized detail and manufactured surfaces: curved/flat service lanes, access routes, repeated fixtures, plate rhythm and physical bevels supply distinct scales. The pass improves construction legibility; its economical geometry and restrained wear remain below the references' fine realism.\n5. Required family coverage: all junction, habitat, working-space, structural and five one-port termination families are available in the bench/catalog, including the eight-lateral-plus-two-pole hub and usable standard/wide adapter.\n6\u20138. Independent completeness and clean interfaces: all 37 bench types passed finite geometry, free-port and sealed-hatch checks. A separate audit of generated detail vertex positions found no intrusion into the protected local port regions for any kind. Explicit joints maintain coincident planes/opposed normals; no neighbor is needed to seal a free pressure interface.\n9\u201310. Transfer and manipulation: three distinct shared-vocabulary programs; attach/roll/detach/move/reconnect tested with descendant preservation. Observer changes leave graph data unchanged. Isolated inspection now follows a newly selected owner instead of leaving the old module visible.\n11. Responsiveness: touch orbit, pinch and pan exercised in Chromium touch emulation; narrow portrait and landscape control wrapping inspected. Module panel height derives from both wrapped header and footer bounds, avoiding overlap. Actual Android hardware performance remains unmeasured; no claim of a device benchmark.\n12. Preservation: byte comparison confirmed unchanged host code/project surfaces, all six unrelated lab entries, the complete prior semantic archaeology and the original Room 001/lander/orrery implementation block.\n13. Visible failures: deliberately blocked renderer dependency, injected module parse fault, injected optional construction exception and actual shader compile failure all produced diagnostics. Optional construction restored the base; shader failure rendered with plain surfaces. The first meaningful error cancels the watchdog so its diagnostic is not later overwritten by a generic timeout.\n14. Continuity: this current document records implementation, ownership, contracts, evidence, known limits and corrected failures; the earlier archaeology remains intact after it. No new cross-lab architecture or collaboration method was introduced.\n\u003c/script\u003e\n\u003cscript type=\"text/plain\" id=\"v0-spec\"\u003eORBITAL CONSTRUCTION TOY \u2014 V0 INSPECTION SUBSTRATE\n\nPURPOSE\nA mobile-first Three.js executable conversational artifact. V0 asks only:\nDoes holding and inspecting this little modular station feel good?\n\nMETHOD\nconversation \u2192 executable \u2192 direct manipulation \u2192 observation \u2192 conversation \u2192 bounded modification \u2192 next executable.\nThe visual station is replaceable; the semantically addressable station graph is valuable.\n\nVISUAL LANGUAGE\nOpen black space, sparse stars, strong distant sun. Small incomplete asymmetrical constructed station. Cool white/light grey hulls, dark mechanical structure, orange framework, scarce warm amber inhabited interiors. No finished O'Neill cylinder and no monolithic spacecraft silhouette.\n\nSEMANTIC STRUCTURE\nStationRoot\n\u251c\u2500 Spine / stable segments\n\u251c\u2500 Workshop / Hull / Glass / Interior / Desk / Shelf / Light / AttachmentNodes\n\u251c\u2500 Habitat_A / Hull / Glass / Interior / AttachmentNodes\n\u251c\u2500 ReceivingYard / Platform / Framework / AttachmentNodes\n\u251c\u2500 Crane_A / Base / Boom / EndNode\n\u251c\u2500 Truss modules\n\u2514\u2500 AttachmentNodes\n\nMeaningful modules receive stable IDs and deliberately small metadata. Attachment nodes are explicit transforms and semantic addresses. Do not prematurely encode economy, crafting, damage, engineering or narrative ontology.\n\nHABITAT PARALLAX\nWarm windows contain actual shallow geometry behind transparent glass: floor, rear wall, crude furniture/equipment and warm local light. Orbiting shifts window frames against interior objects and those objects against rear surfaces. FAR: warm inhabited point. MEDIUM: compartment. CLOSE: there is a room in there. Same orbital camera; no ENTER button.\n\nTOUCH\nOne-finger drag orbits broadly around the station. Pinch zoom spans tiny-station-in-space through close inspection of habitat glass. Avoid camera roll and frustrating inertia. Pan not required. Small reset-view affordance.\n\nPERFORMANCE\nContemporary mobile target. Primitive/reused geometry and materials, modest mesh count, inexpensive lights, conservative transparency, no required postprocessing. Responsive portrait/landscape canvas.\n\nOUT OF SCOPE\nBooks/prose, Clara, materials, inventory, cargo, construction tools, crafting, economy, objectives, progression, damage, physics simulation, station management, save UI, complete cylinder, procedural generation, narrative, tutorial, labels, selection outlines, semantic UI, elaborate HUD.\n\nPRESERVE FOR LATER, DO NOT IMPLEMENT\nModule selection and mutation; object attachment; receiving materials at ReceivingYard; interior placement; persistence; multiple locations; scale transitions; orbital-to-interior inspection; prose-derived construction.\n\nSUCCESS\nUser discovers drag and pinch without instruction, peers into warm rooms, understands those rooms spatially within the larger station, and keeps manipulating the station despite having no objective.\n\nV0 IS AN INSPECTABLE PLACE, NOT A GAME.\nBuild enough station to make inspection interesting, enough interior to make closeness rewarding, and enough semantic structure that future conversation has handles. Then stop. Touch it. The experience determines V1.\n\nV1 DELTA \u2014 2026-09-21\n- Orthogonal construction grammar for now; radial capability preserved but not exercised.\n- Curved pressure-hull language for inhabited modules.\n- No black metal: structural darks become readable greys.\n- Long primary beams extend from central structure.\n- Nothing structural should visually float; modules receive visible load paths/collars.\n- Physical attachment hardware corresponds to semantic attachment nodes.\n- Greebling is a separate toggleable layer with varied greys; interiors remain independent.\n- Greebles are subordinate to large readable structural forms.\n\n\nV1.65 ORRERY ALIGNMENT LATCH\nThe toy now notices one property of its own moving configuration. Three restrained brass sights and an ivory latch tile have been added at the center. While the orrery is turning, the detector derives each body's actual current world-space direction from the center and compares pairwise angular separation. If any pair enters a seven-degree alignment tolerance, the ivory tile physically pops up with a tiny kick. A wider twelve-degree release threshold provides hysteresis so the mechanism does not chatter at the boundary. This is geometric observation, not a timer.\nThe tile carries no label and no assigned interpretation. It records only that the machine recognized a configuration. Existing clipping, displaced button, floating collapsed spindle, and collapsed-body squashing remain untouched.\nRule: the toy may respond to relationships it physically exhibits without yet explaining those relationships.\n\nV1.64 ORRERY LOCAL CYCLES\nThe second toy receives one conceptual upgrade only. Each of its three bodies is no longer fixed to the end of a rotating arm. Each arm endpoint now carries a small tilted local orbit mechanism, with a restrained brass track and an independently moving body. The three local periods are deliberately incommensurate and one runs retrograde, so relationships drift and occasional alignments can emerge while the common armature continues its slow rotation. No purpose, labels, projection, lighting system, or additional controls have been assigned.\nThe observed floating collapsed spindle and displaced physical button are intentionally left untouched in this pass.\nRule: the machine now expresses relationships, not merely rotation.\n\nV1.63 SECOND TOY SEED \u2014 ORRERY\nThe preserved pallet lander is translated carefully to the left side of the workbench without changing its internal geometry, flight state machine, containment sequence, or Y-axis flight semantics.\nA new independent tabletop toy, Orrery Seed 001, begins on the right. It intentionally carries very little interpretation: a compact brass base, central spindle, three folded articulated arms, three materially distinct bodies, and one physical control. Pressing the control deploys the spindle/arms and begins a slow turn; pressing again folds it. Whether it is a model, instrument, navigator, or something else remains unresolved.\nRule: transfer the toy-building grammar, not the lander's ontology.\n\nV1.62 ELECTRICAL-OFF BEFORE MECHANICAL-STOW\nShutdown ordering is now explicit. When the lander settles, semantic containment drops and the membrane performs its full double shutdown flicker while the mast and canopy remain completely deployed and motionless. Only after the second flicker has finished and the field is fully dark does the emitter transition into STOWING and begin canopy contraction / mast collapse.\nRule: electrical field shutdown completes before mechanical emitter stow begins.\n\nV1.61 SYMMETRIC BLISTER FLICKER\nThe blister now uses the same terse double-flicker vocabulary at both ends of its cycle: two establishment flashes before stable activation, and two dying flashes after containment deactivates. Semantic containment authority still begins only after startup flicker completes and drops immediately before shutdown flicker begins.\n\nV1.60 BLISTER IGNITION FLICKER\nThe air blister now has a deliberately tiny electrical establishment/failure cue. After the emitter mast and canopy finish deploying, the membrane flashes on/off twice before becoming continuously active. Those preview flashes are visual only: the semantic containment state remains CHARGING and the flight interlock does not treat the blister as established until the final continuous activation.\nOn shutdown, containment authority drops immediately and the membrane gives two brief dying after-flashes while the mechanical emitter begins stowing.\nThe effect is intentionally terse\u2014two startup coughs, one shutdown cough\u2014not a looping animation or new gameplay system.\n\nV1.59 HAIRLINE EMITTER GAP\nThe V1.58 separation between canopy and membrane was visually too large. The membrane top is raised back to within a hairline of the emitter canopy, retaining only enough spatial separation to avoid the previous additive/near-coplanar material collision. No other blister or lander behavior changed.\n\nV1.58 BLISTER EMITTER GAP\nThe energy membrane and its edge were meeting the telescoping canopy too closely, producing noisy additive/near-coplanar material interactions at the top of the blister. The field's upper boundary is lowered slightly while the physical canopy remains unchanged, creating a small clean separation between emitter hardware and projected containment. The canopy glow is also shifted slightly below the physical panel.\nNo field material, deployment behavior, cargo, or flight behavior changed.\n\nV1.57 ENERGY MEMBRANE AIR BLISTER\nThe V1.56 particle cloud failed to communicate containment because it removed the continuous inside/outside boundary that made the earlier glass version immediately legible.\nThe original containment geometry is visible again, but no longer uses glass-like transmission, thickness, or refraction. It is now an extremely faint additive blue membrane. A brighter additive edge is derived directly from the same envelope geometry, so activation reads as an instantaneous luminous boundary: pop, the volume is enclosed.\nThe free-floating field particles and their shimmer animation are removed entirely. The canopy retains a restrained stronger blue glow as the visible source of the field.\nRule: containment is communicated by a continuous boundary; energy styling modifies that boundary rather than replacing it with volumetric activity.\n\nV1.56 DIFFUSE AIR BLISTER\nThe air blister no longer renders as a transparent glass-like solid pane. Its existing extruded geometry is retained invisibly as the semantic containment envelope, while the visible field is now a sparse shell of soft additive blue procedural sprites concentrated around the perimeter and chamfered shoulders.\nThe field is intentionally diffuse and low-energy: cargo remains clearly readable through it. A restrained brighter blue strip immediately beneath the deployed canopy communicates the emitter source. Field particles have only a very slow low-amplitude local shimmer rather than a global pulse.\nBlister deployment/state semantics are unchanged: the diffuse field appears only when containment is active and disappears before the emitter mechanically stows.\n\nV1.55 STEADY PRIMARY DRIVE\nThe primary exhaust no longer breathes, accelerates, or decelerates during hover. Particle travel now uses one constant recycle rate, and hover uses one constant visual plume strength. The value is deliberately near the middle of the previous slow/fast impression.\nThis removes animation complexity that was not earning its keep at the fidelity of the surrounding toy. Flight motion and station-keeping behavior are unchanged.\n\nV1.54 QUIETER PRIMARY DRIVE\nThe primary lift plume is slimmer and substantially calmer. Its emitter radius, sprite size, particle count, opacity, and commanded thrust-visual strength are reduced. Hover no longer drives a rapid high-energy oscillation; it uses a low-amplitude slow variation instead.\nParticle advection is also slowed dramatically. Importantly, increasing visual thrust strength no longer makes particles race faster: stronger output now slightly slows the recycled particle travel, producing a steadier sustained plume rather than a frantic one. Lift and landing are toned down as well, while the actual lander motion/state timing is unchanged.\nThis is a visual-energy correction only; propulsion mechanics remain identical.\n\nV1.53 TAPERED SAFE-ENVELOPE THRUST\nScreenshot inspection established two desired visual/functional properties from the earlier solid-cone pass. First, the plume silhouette should taper away from the nozzle rather than expand: particles now begin broad, dense, bright, and relatively large at the nozzle mouth, then progressively narrow, shrink, fade, and become sparse downrange. Second, the four station-keeping jets deliberately cant downward and inward toward the lander's protected central plume envelope rather than outward toward surrounding dockworkers or infrastructure.\nThe explicit semantic exhaust-origin/direction architecture from V1.52 is retained; only the authored vectors and particle distribution changed. Thus direction remains independent of incidental nozzle mesh orientation while preserving the useful original vehicle design.\nRule refined: explicit semantic direction describes intended operational geometry; particle distribution describes the visible plume silhouette.\n\nV1.52 EXPLICIT EXHAUST VECTORS\nThe two sign-flip failures exposed the actual modeling error: exhaust direction was being inferred from incidental mesh/local-cylinder orientation. Thrusters now own explicit semantic exhaust origins and directions.\nThe center booster exhaust originates at its bell mouth and points straight down in lander-local space. Each station-keeping exhaust originates just outside its corner nozzle and points down plus radially outward from the vehicle center.\nParticle systems are parented to the lander and construct their own perpendicular cone basis from those semantic vectors, so nozzle mesh rotations cannot invert or redirect the exhaust. Existing propulsion timing and flight behavior remain unchanged.\nRule promoted: directional effects derive from explicit semantic direction, not incidental render-mesh orientation.\n\nV1.51 THRUSTER AXIS CORRECTION\nVisual inspection showed every particle exhaust cone traveling in the opposite direction from its nozzle. The particle emitter had assumed local -Y while this lander's thruster geometry is authored with exhaust along local +Y. Particle travel is now flipped to local +Y for both the center booster and all four canted station-keeping thrusters. No propulsion logic, pulse timing, or vehicle motion changed.\n\nV1.50 DIFFUSE PARTICLE THRUST\nThe lander's geometric cone plumes remain in the artifact as disabled fallback geometry, but propulsion now renders through a procedural particle exhaust system.\nA small CanvasTexture radial sprite supplies a blue-white emissive-looking particle vocabulary. The center lift engine emits a dense narrow cone of camera-facing particles: brightest and tightest at the nozzle, widening and fading with travel. Particle motion is deterministic and continuously recycled rather than allocated per frame.\nThe four canted station-keeping thrusters use the same emitter vocabulary at much smaller scale and particle count. Their existing hover-correction logic now drives short particle pulses instead of toggling solid cone meshes.\nNo new propulsion state is introduced: exhaust remains a visual consequence of the existing lift/hover/landing and attitude-correction states. This is intentionally cheap mobile-friendly exhaust, not volumetric simulation.\n\nV1.49 LIVING SPECIMEN CYLINDERS\nThe two previous domed-cylinder cargo objects are promoted into self-contained living specimen vessels derived from the Time Machine notebook's Organic / Biological catalog, using rhododendron as the first probe.\nEach vessel now has a shallow metal disc base, dark substrate/soil, a tiny procedural plant built from stems, branches, flattened leaf primitives, and a compact pink blossom cluster, plus a transparent cylindrical wall and shallow glass dome.\nThe botanical geometry is intentionally conservative: all stems, leaves, and blossoms are sized to remain completely inside the glass cylinder/dome envelope rather than clipping through it. The vessel glass uses transparent physical material with depthWrite disabled to reduce nested-transparency artifacts inside the larger pallet blister.\nThis remains primitive procedural geometry rather than botanical modeling. The question is whether a visibly living object inside a transparent, physically based specimen container materially changes the pallet's read.\n\nV1.48 TIME MACHINE MATERIAL SHIPMENT\nThe pallet's existing primitive cargo is now a first shipment from the established Time Machine Chapters I\u2013VII material notebook. Geometry is deliberately unchanged.\nSix procedural CanvasTexture material families are mapped across the existing boxes and cylinders: brass, nickel, granite, white marble, malachite, and wood. Their treatments emphasize worked-metal striation, mineral speckling, marble veining, malachite banding, and directional wood grain.\nEvery cargo root remains individually addressable and now carries a material identity plus provenance back to The Time Machine / Chapters I\u2013VII / Materials So Far. No bespoke meshes, labels, new cargo mechanics, or invented source claims are introduced.\nThis is the intended cheap probe: can primitive stock plus procedural surface identity make the pallet read as a shipment from the notebook?\n\nV1.47 BLISTER AS NORMAL LANDER CYCLE\nThe emitter is no longer a separately discoverable control. Mast/canopy tap behavior has been removed. The orange lander button now owns the complete operating sequence.\nThe resting landed state is cargo-accessible: emitter mast stowed flush, canopy collapsed, pressure field off. First orange-button press deploys containment: mast rises, then the rectangular canopy expands along its LONG X AXIS ONLY, then the blue field establishes. The lamp becomes cyan to communicate flight-ready.\nA second orange-button press may initiate flight only when both emitter and pressure field are fully active. Containment remains active through gear retraction, lift, hover, landing, and gear deployment.\nAfter landing is mechanically complete and the legs are down, containment automatically shuts down: blue field off, canopy contracts along X to zero, then mast telescopes to its fixed deck socket. The machine returns to cargo-accessible resting state.\nThis makes containment a required preflight/postflight phase of the lander's normal state machine rather than an optional subsystem. The flight invariant remains hard: no active blister, no launch.\n\nV1.46 BLISTER EMITTER MECHANISM REPAIR\nVisual review of deployed and hovering states exposed two concrete problems: the canopy plate extended too far horizontally, and although emitter stow/deploy functions existed, no physical interaction could actually invoke them.\nThe canopy is now a simple thin rectangle sized inside the pallet footprint.\nEmitter motion is explicitly sequential. On stow, the plate contracts horizontally to effectively zero first; only then does the mast shorten vertically into its fixed deck socket. Deployment reverses the sequence: mast rises first, then the plate expands. Neither operation can translate geometry below the pallet.\nFor this probe, tapping the mast or canopy while LANDED toggles emitter stow/deploy. The flight button remains separate and retains the hard invariant that flight can begin only while the emitter and pressure field are fully ACTIVE. Emitter hardware cannot be collapsed while airborne.\nThis physical-control mapping is provisional; it exists so the collapse mechanism can actually be experienced before control layout is redesigned.\n\nV1.45 CENTRAL BLISTER EMITTER + FLIGHT INVARIANT\nThe CargoStage experiment has been removed. Cargo is payload and remains permanently on the pallet deck; it never telescopes, translates, or stows into the chassis.\nThe Air Blister is now generated by one deployable central emitter: a mast fixed to a deck socket and a thin octagonal canopy at its top. Retraction is deliberately abstract and clipping-safe: the blue pressure field switches off, the canopy scales horizontally toward zero around the mast, then the mast shortens vertically toward its fixed deck base. No component translates below the lander. Deployment reverses those transforms and establishes the blue field only after the emitter is fully deployed.\nThe emitter is semantically independent from both cargo and the pressure field: `PalletLander001 -\u003e Cargo/*`, `PalletLander001 -\u003e BlisterEmitter -\u003e Mast + Canopy`, and `PalletLander001 -\u003e AirBlister -\u003e PressureField`.\nCRUCIAL FLIGHT INVARIANT: the pallet cannot initiate flight unless the blister field is ACTIVE and the emitter is fully ACTIVE. Flight no longer requires or triggers blister shutdown; containment remains active during gear retraction, lift, hover, landing, and gear deployment. The button only launches from the landed state when that invariant is satisfied.\nEmitter stow/deploy functions remain exposed for later physical-control experimentation, but the current flight button will never use them to create an uncontained flight state.\n\nV1.44 CARGO ENVELOPE + BLISTER SUPPORT REPAIR\nThe first telescoping pass exposed two physical-model errors.\nFirst, the cargo stage's stowed travel exceeded the placeholder chassis envelope, so the payload visibly translated below the lander. Stowed travel is now bounded to the current chassis depth (`stowedY=-0.36`) rather than pretending the chassis has invisible storage volume beneath itself. Exact packing/lid geometry remains intentionally unresolved.\nSecond, the Air Blister previously had only deck-perimeter rails, so deactivating its blue pressure skin left no convincing support apparatus. It now has explicit physical support hardware: four corner masts, a restrained upper perimeter, and short shoulder braces following the wrapped-present profile.\nPressure field and support hardware are now separate states. `setBlisterActive(false)` hides only the translucent blue pressure skin; the mechanical blister supports remain visible and descend with CargoStage.\nThese corrections preserve the hierarchy: PalletLander001 moves flight; CargoStage moves payload and containment apparatus; AirBlister independently controls pressure-field visibility.\n\nV1.43 TELESCOPING CARGO STAGE\nThe heterogeneous cargo field and Air Blister have been reparented beneath a new semantic/mechanical root: `pallet-lander-001.cargo-stage`. Individual cargo objects remain individually addressable; only their shared mechanical owner changed.\nThe cargo stage now has a lift platform and four simple telescoping rails. Stowing deactivates the blue pressure blister first, then lowers the entire stage\u2014including every cargo object\u2014into the chassis as one transform. Deploying reverses the stage motion and only reactivates the blister after the stage reaches full height.\nCargo is intentionally allowed to clip through the current placeholder chassis during this architecture pass. No attempt is made yet to solve lids, packing, cavities, or exact storage volume.\nFlight is now gated by cargo-stage state. The physical button sequence is:\nLANDED + DEPLOYED -\u003e STOWING -\u003e LANDED + STOWED -\u003e RETRACT GEAR / LIFT / HOVER -\u003e LAND -\u003e DEPLOY GEAR -\u003e DEPLOY CARGO -\u003e BLISTER ACTIVE.\nThe status lamp communicates the next action: cyan = stow cargo, amber = launch, blue = land, green reserved for deployed/return semantics, dim = transition.\nMost importantly, neither flight code nor any individual cargo object knows how cargo stowing works. Flight moves PalletLander001; cargo handling moves CargoStage; cargo objects simply inherit both transforms.\n\nV1.42 AIR BLISTER + BUTTON CYCLE CUE\nThe deployed cargo field is now enclosed by `pallet-lander-001.air-blister`, an independently addressable pressure-containment module beneath PalletLander001. Its translucent blue skin uses a broad box-like wrapped-present profile with chamfered shoulders and a shallow roof. Sparse perimeter rails explain its deck attachment without turning it into a cage.\nThe blister contains the cargo semantically but does not own or merge any cargo object. Cargo remains individually addressable beneath the cargo collection.\nThe existing physical button now demonstrates a tiny staged interaction while landed: with the blister active, the first press deactivates containment; with containment inactive, the next press begins the existing retract/lift/hover sequence. Landing completes by redeploying the legs and reactivating the blister, closing the current toy cycle.\nThe adjacent status lamp now communicates the button's next meaningful action rather than merely reporting vehicle state: cyan while containment is active and the next press will deactivate it; amber when containment is inactive and flight is armed; blue while hovering and the next press will land; dim during mechanical transitions.\nThis is temporary interaction plumbing for the prototype. It establishes that local physical controls can sequence nested systems without creating global UI.\n\nV1.41 HETEROGENEOUS CARGO LANDSCAPE\nPallet Lander 001 now carries a first heterogeneous cargo field. Every visible cargo item is an independently addressable semantic object beneath `pallet-lander-001.cargo`; none of the pile is baked into the chassis or represented as one merged mesh.\nInitial cargo vocabulary: individual cubes, rectangular cases/billets, three separate horizontal cylinders that visually form a bundle, two vertical tanks, and two domed cylinders. Each cargo root records a stable semantic ID, cargo kind, human-readable label, and unresolved provenance.\nThe collection currently rides directly on the chassis deck. Its metadata marks `cargo-stage` as the future parent boundary so a telescoping stage can adopt the cargo roots later without touching flight code.\nNo material identity is asserted yet. Surface differences are visual heterogeneity only.\nBecause cargo remains beneath PalletLander001, the existing flight substrate carries the entire collection without any flight-system changes.\n\nV1.40 LANDER CONTROL FACE + EYE TUNE\nThe Pallet Lander's physical flight button and status lamp now live on the front (+Z) chassis face as a right-justified local control cluster rather than on the deck. Their interaction semantics are unchanged.\nRoom 001's canonical eye is raised slightly again, from y=1.78 to y=1.88. The existing modest downward pitch remains unchanged.\n\nV1.39 TABLETOP COMPOSITION TUNE\nPallet Lander 001 is uniformly scaled to 75% at its root. Internal proportions, state machine, thruster behavior, and scene anchor are unchanged.\nRoom 001's canonical eye is raised modestly from y=1.62 to y=1.78 and its initial pitch is biased slightly downward (-0.095 rad). Existing one-finger look and pinch-dolly semantics are unchanged; no new gesture is introduced.\nThis is a composition correction discovered by the flight coupon: preserve the human-scale controller and make the tabletop readable before adding cargo detail.\n\nV1.38 TABLETOP TOY \u2014 PALLET LANDER FLIGHT SUBSTRATE\nRoom 001 now owns its first stateful content module: Pallet Lander 001. The current geometry is intentionally a crude flight coupon, not the finished cargo lander.\nSemantic hierarchy:\nRoom 001 -\u003e Contents -\u003e Pallet Lander 001 -\u003e Chassis / Legs / Main Thruster / Station-Keeping Thrusters / Controls.\nThe entire vehicle is parented beneath one PalletLander001 root. Flight motion is applied only to that root so future cargo, air blister, telescoping stage, drones, and other descendants inherit flight without modifying hover code.\nThe lander's current scene anchor is the middle of the workbench. This is a convenient scene-local anchor, not lore or resolved station geography.\nA physical button on the chassis owns the interaction. There is no new global flight UI.\nCurrent state loop:\nLANDED -\u003e RETRACTING_GEAR -\u003e LIFTING -\u003e HOVERING -\u003e LANDING -\u003e DEPLOYING_GEAR -\u003e LANDED.\nThe main center thruster carries lift. Four canted corner thrusters are station-keeping/attitude devices and pulse during hover corrections.\nInterior tap interaction is distinct from interior look: a short stationary tap may activate an in-scene interactive; dragging still changes gaze and pinch still dollies.\nSwitching between EXTERIOR and INTERIOR does not reset the lander. Its local state persists because scene visibility is not world-state mutation.\nThis pass intentionally does NOT add cargo, blister, telescoping cargo stage, drones, destinations, or raster output. The purpose is to prove the parent transform and local state-machine boundary while the vehicle is still a flying brick.\n\nV1.37 PROXY TOPOLOGY \u2014 DRUM B IS ATTACHED TO THE ARM END\nHabitat Drum B is no longer independently positioned in the Room 001 exterior composition. Its proxy position is derived from Habitat Arm West's far endpoint after the arm's +90\u00b0 Y orientation transform.\nFor this proxy the arm is 5.6 units long, so the far endpoint is 2.8 local units along its rotated long axis. Drum B is placed directly beyond that endpoint with only a small collar clearance. The minimal connective frame is derived at the same attachment location.\nThis preserves the unresolved metric status of Room 001 while restoring the already-known topological fact: Habitat Arm West terminates at Habitat Drum B.\n\nV1.36 VIEW COMPOSITION \u2014 ARM IS PERPENDICULAR TO THE WINDOW PLANE\nThe Habitat Arm West proxy is authored along local X. V1.35 left that local axis unrotated, which made the arm run laterally across the window plane. The complete proxy module is now rotated +90\u00b0 about Y so its long axis projects into/out of the window plane.\nThis is an observer-composition transform on the situated proxy only; it does not alter authoritative station topology or resolve Room 001's metric location.\n\nV1.35 STARTUP REPAIR \u2014 PROXY USES THE ACTUAL HULL TEXTURE FACTORY\nV1.34 referenced a nonexistent `makeSurfaceTexture()` helper. Because the proxy is constructed during startup, that ReferenceError aborted the optional frame/proxy stage and triggered the visible FRAME LAYER ERROR fallback.\nThe situated exterior proxy now uses the already-established `makeHullTexture(seed)` factory\u2014the same procedural hull skin vocabulary used by station modules. No new texture factory or startup dependency is introduced.\nThis is a runtime-name failure that static syntax checking cannot detect; optional visual additions must call existing substrate APIs by their actual names.\n\nV1.34 WINDOW COMPOSITION CORRECTION \u2014 RIGHT-ANCHORED, SIDE-ON ARCHITECTURE\nThe Room 001 exterior proxy is recomposed rather than metrically solved. Habitat Arm West now runs perpendicular to the window/view axis and occupies a substantial lower-right span. Habitat Drum B is placed beyond it at the right corner, side-on and intended to remain fully legible rather than peeking above the sill.\nThe proxy no longer attempts to discover texture maps through module userData. It owns procedural CanvasTextures generated by the same surface-texture factory and semantic seeds, so its pressure skins visibly participate in TEXTURE ON/OFF.\nThis remains a situated view representation, not a declaration of Room 001's exact coordinates.\n\nV1.33 SITUATED EXTERIOR PROXY \u2014 VISIBILITY WITHOUT METRIC COMMITMENT\nRoom 001's window now looks from a conceptual location somewhere along habitat-arm-forward across a composed proxy of habitat-arm-west and habitat-drum-b.\nThese are not authoritative duplicate world objects and do not establish Room 001 coordinates. They are a situated visual representation of already-known station architecture while the room's exact metric placement remains unresolved.\nThe proxy reuses the station's pressure-skin, orderly Detail, and orange Frame vocabulary. Its architecture is placed somewhat below the aperture sightline so textured and detailed exterior surfaces remain legible from human scale.\nDETAIL and TEXTURE controls propagate to the proxy. No planet, invented deck plan, new windows, or decorative exterior lore is introduced.\n\nV1.32 INTERIOR SKIN DELTA \u2014 SLIGHTLY STRONGER READ + SEMANTIC FASTENERS\nInterior procedural contrast is raised modestly rather than redesigned: panel seams, floor joints, work-surface lines, and wear haze read slightly more clearly at human scale.\nSmall rivet/fastener marks are introduced only along plausible shell panel seams and floor plate joints. They are texture information, not free-floating decoration, and do not appear on glass, frame, lights, door, or workbench legs.\nThe workbench skin remains comparatively restrained so the architecture establishes scale without every surface competing for attention.\n\nV1.31 STARTUP SAFETY \u2014 LATE SYSTEMS MAY NOT ENTER EARLY LEXICAL TDZ\nV1.30 broke startup because the exterior texture initializer called setAllTextures(true) before the later interior `const IM` binding had initialized. `typeof` does not protect access to a lexical binding inside its temporal dead zone.\nInterior material handles are now published only after construction through a startup-safe runtime registry. Early exterior initialization never touches the late interior binding; later user toggles synchronize both systems.\nThe base station and its debug fallback remain authoritative: an optional interior skin system must never prevent the substrate from booting.\n\nV1.30 INVARIANT \u2014 HUMAN-SCALE TEXTURE REMAINS SKIN\nRoom 001 gains three restrained procedural CanvasTexture families: manufactured wall/ceiling panels, broad industrial floor plates, and a finer utilitarian work-surface skin.\nThey alter only surface appearance. Room geometry, pressure openings, frame, door, workbench structure, lights, and glass remain independent.\nFrame, door, workbench legs, lights, and glass intentionally stay materially clean so procedural texture does not become procedural greeble.\nThe existing global TEXTURE control now governs these interior skins as well as exterior module skins.\n\nV1.29 INVARIANT \u2014 FRAME THICKNESS IS A TRUE EDGE OFFSET\nThe continuous viewport ring's outer boundary is computed by offsetting every aperture edge by a constant perpendicular distance and intersecting adjacent offset lines.\nThis preserves visually consistent frame thickness through both orthogonal and chamfered edges instead of making diagonal corners artificially fat.\n\nV1.29 SMALL INTERIOR DELTA \u2014 WORKBENCH LEG INSET REBALANCED\nThe V1.28 leg inset was too aggressive. Legs now sit halfway between their original and V1.28 positions: still visibly contained beneath the tabletop, but with a broader, more plausible stance.\n\nV1.28 INVARIANT \u2014 APERTURE FRAME IS ONE CONTINUOUS RING\nThe viewport frame is a single shallow extruded ring, not eight intersecting beam meshes.\nIts inner boundary is the canonical aperture path; its outer boundary is a small offset rectangular-octagonal loop.\nContinuous frame topology eliminates protruding member ends at chamfer junctions and keeps the entire viewport assembly derived from one semantic aperture.\n\nV1.28 SMALL INTERIOR DELTA \u2014 WORKBENCH LEG INSET\nWorkbench legs are inset slightly in both axes so their silhouettes remain visually contained beneath the work surface rather than clipping its visible edge.\n\nV1.27 INVARIANT \u2014 SHAPED OPENINGS ARE BOOLEAN TOPOLOGY, NOT ASSEMBLED TRIM\nRoom 001's front wall is one continuous planar structural mesh whose Shape contains the rectangular-octagonal viewport as a true hole.\nThe wall opening, glass silhouette, and structural frame are all derived from the same canonical eight-point aperture path.\nThere are no rectangular opening slabs, corner patches, or triangular infill pieces to drift apart under oblique viewing.\nThis establishes a reusable architectural primitive: a wall surface may own shaped pressure openings, and dependent glass/frame geometry derives from the opening definition rather than approximating it independently.\n\nV1.26 INVARIANT \u2014 VIEWPORT SHAPE IS STRUCTURAL\nRoom 001's exterior viewport is a wide rectangular octagon: the four corners of the former rectangular aperture are physically chamfered.\nThe glass follows the same eight-edge aperture and the frame is authored as eight structural members, including four true diagonal corner members.\nThe octagonal silhouette belongs to the pressure boundary/window assembly itself; it is not cosmetic trim laid over rectangular glass.\n\nV1.25 INVARIANT \u2014 PINCH DIRECTLY ADDRESSES THE DOLLY TRACK\nInterior entry and reset begin at the midpoint of the permitted fore/aft camera track rather than at either extreme.\nA single two-finger pinch gesture is intentionally high-gain: from any current dolly position, one ordinary continuous pinch has sufficient range to reach either track endpoint.\nThe gesture is anchored to the dolly position at pinch start, so movement is continuous and does not accumulate across repeated pinch gestures.\nThe existing hard forward boundary and rear-wall safety boundary remain authoritative.\n\nV1.24 INVARIANT \u2014 CAMERA TRACK RESPECTS THE ROOM ENVELOPE\nRoom 001's rear half is extended without moving the window/front wall or canonical eye point.\nThe rear wall and its doorway move together because the doorway belongs to that boundary.\nThe permitted backward dolly grows by less than the room extension and retains a deliberate safety margin before the rear wall.\nA camera track must never terminate inside enclosing geometry; room-envelope changes and camera bounds are related semantic constraints.\n\nV1.23 INVARIANT \u2014 MOBILE INTERIOR CAMERA = LOOK + BOUNDED DOLLY\nThe interior mobile interaction vocabulary is intentionally small:\none-finger drag rotates gaze from a situated human-scale viewpoint;\ntwo-finger pinch controls a fore/aft camera dolly along the room's canonical axis.\nThe canonical eye point is the hard forward boundary. Dolly may retreat from it and may return to it, but may never advance farther into the room.\nThis preserves the successful fixed-camera feel while allowing the observer to back up for composition and spatial inspection.\nIf more retreat is needed, enlarge the room/camera allowance rather than weakening the forward boundary.\n\nV1.22 INVARIANT \u2014 INTERIOR OBSERVATION IS SITUATED LOOK\nExterior inspection and interior observation intentionally use different camera semantics.\nExterior one-finger drag orbits the observer around the station.\nInterior one-finger drag changes yaw/pitch of a fixed human-scale eye point; it never changes eye position, orbit radius, Room 001 transform, or StationRoot.\nPinch is not optical zoom in the interior: it is a bounded camera dolly. Wheel remains disabled for the interior probe.\nReset in interior mode restores the canonical eye position and forward gaze.\nA tap in interior mode does not perform exterior module selection.\n\nV1.22 LESSON \u2014 CAMERA BEHAVIOR IS PART OF WORLD SEMANTICS\nThe V1.21 escape bug showed that identical gestures cannot safely share identical spatial meaning across observational scales.\nInteraction controllers therefore belong to view semantics, not merely input plumbing.\nThe accidental free-camera view was useful development evidence but is not the normal interior experience.\n\nV1.21 INVARIANT \u2014 CONTAINMENT DOES NOT IMPLY COORDINATES\nRoom 001 is contained by Habitat Drum A but has no resolved metric placement, deck, azimuth, or exterior transform.\nIts local frame belongs to the station, while its exact location within the containing module remains unresolved until an experience requires resolution.\nThe exterior window establishes only that Room 001 has an exterior-facing view; exact window placement is unresolved.\nThe window may therefore use a station-world view representation without asserting a fabricated deck plan.\n\nV1.21 INVARIANT \u2014 OBSERVER TRANSFORMS ARE NOT WORLD TRANSFORMS\nExterior orbit is an inspection operation by the observer. It must not be interpreted as an in-world physical rotation event.\nInterior entry changes observational scale/view mode, not world state.\nRoom 001 remains station-local regardless of the exterior observer's last inspection angle.\n\nV1.21 INTERIOR PROBE\nThe first interior deliberately establishes only structural human-scale anchors: shell, floor, ceiling, one doorway, one work surface, one large exterior window, and functional light.\nNo interior texture, decorative clutter, interior greebling, complete deck plan, locomotion system, or avatar is implied.\nThe workbench is reserved as a future tangible-material staging surface.\n\nV1.20 INVARIANT \u2014 ORIENTATION IS A SEMANTIC NORMAL\nDirectional modules are authored once in a canonical local frame (+Z for EndCap) and the complete module is quaternion-aligned to an explicit outward normal.\nChild geometry must not independently encode world-axis cases or signs.\nThe outward normal is semantic module state and is stored on the EndCap.\nThis guarantees that pressure bulkhead, taper, Detail, and future hatch/window geometry all agree about \"outward.\"\nAxis-plus-sign special casing is obsolete for EndCap orientation.\n\nV1.19 LESSON \u2014 TERMINATIONS COME FROM TOPOLOGY, WITH ORIENTATION\nEnd caps must only occupy genuinely exposed pressure ports.\nA port already consumed by another module (the west arm into Drum B) must not also receive a cap.\nEvery termination must carry an explicit outward direction; V1.20 represents that direction as a semantic normal rather than axis-plus-sign special cases.\nThe central trunk has two exposed axial boundaries, so its top and bottom each receive correctly outward-facing caps.\nThe forward cap was already correct and is preserved.\nThis pass exposes the next architectural target: derive termination placement from port occupancy rather than maintaining a hand-authored cap list.\n\nV1.18 INVARIANT \u2014 END CAP IS A PRESSURE-TOPOLOGY MODULE\nAn EndCap is a semantic one-port PressureModule, not a loose decorative disk.\nIts inward port terminates an exposed pressure boundary with a heavy collar, recessed bulkhead, and shallow exterior cap.\nEnd caps inherit the same module-owned SurfaceMaterial and Detail systems as other architecture.\nThe current caps seal the forward and east-upper expansion ends plus the central trunk top and bottom. The west end is not capped because Drum B already consumes that connection.\nFuture one-port termination modules (window, airlock, docking port, equipment cap) can reuse the same connection grammar.\n\nV1.17 INVARIANT \u2014 FULL PRESSURE-SKIN TEXTURE + RESPONSIVE CONTROLS\nDETAIL and TEXTURE live in a wrapping control dock and cannot overlap on narrow displays.\n\nV1.16 INVARIANT \u2014 MODULE-OWNED SURFACE TEXTURE\nEach semantic module owns its PressureVolume surface-material state.\nProcedural CanvasTextures provide restrained plate variation, seams, service bands, and sparse wear.\nTexture covers the full exterior PressureVolume architecture of every module, including hulls, collars, belts and bulkheads; inward cavity shells remain clean. Structure and Detail remain independent.\nTEXTURE ON/OFF is an aggregate control over module-owned material states.\nPer-module texture control is exposed through stationToy.setTexture(id,on).\n\nV1.15 INVARIANT \u2014 DETAIL PROMOTED; EXPERIMENT SCAFFOLD REMOVED\nThe A/B greeble experiment is complete.\nLegacy hand-authored boxy Detail children are purged.\nThe winning generated style-guide field is now the canonical per-module Detail layer.\nDETAIL ON/OFF is the sole global visibility control.\nNo separate Greeble mode or Greeble UI remains.\n\nV1.14 STYLE GUIDE \u2014 UNIFORM MANUFACTURED SURFACE LANGUAGE\nThe generated reference image is now treated as the visual target.\nGreebles are organized, not sprinkled: regular panel stations, repeated rows/columns, embedded 3/4/5-bit arrays, and coherent three-pipe bundles.\nDrum panels and pipes follow curvature. Arm detail aligns to stable longitudinal surface lanes.\nDetail remains thin and subordinate to the hull.\nConnection points receive enlarged exclusion zones; generators reject detail near semantic ports and arm endpoints.\nThe uniform style-guide generator is canonical Detail; DETAIL ON/OFF is its sole global visibility control.\n\nV1.10 INVARIANT \u2014 NO ANONYMOUS JUNCTIONS\nThe legacy migration that promoted leftover pressure meshes into junction-\u003cuuid\u003e modules is removed.\nLoose collars/belts/bulkheads are not topology and are discarded instead of becoming selectable modules.\nA junction may exist only when explicitly authored as a named pressure module through the port/connection grammar.\n\nV1.9 INVARIANT \u2014 MODULES OWN PORTS; CONNECTIONS FOLLOW\nReusable PressureModule, DrumModule, PressurePort, and ArmConnection classes now hold connection rules once.\nDrum A has been moved farther east; Habitat Arm East derives its span from the trunk port to Drum A's west port.\nDrum B and Habitat Arm West now use the identical port-to-port connection mechanism.\nIndividual drums no longer encode special arm lengths.\n\nV1.8 INVARIANT \u2014 UNIVERSAL PRESSURE BRANCHES\nThere is no branch-riser module type. Risers, links, continuations, and branches are ordinary Habitat Arms.\nNew pressure arms are authored between explicit attachment surfaces via pressureArmBetween().\nA branch from a trunk begins at the trunk exterior surface; it does not originate at the trunk center and overlap outward.\nThe attachment relationship, not visual overlap, defines the connection.\n\nV1.7 INVARIANT \u2014 ENDPOINT-AUTHORED MODULE CONNECTIONS\nHabitat Arm East is no longer positioned by an independent center + nominal length.\nIts endpoints are derived from Central Trunk's exterior surface and Habitat Drum A's west attachment plane.\nThe arm therefore terminates at the drum surface instead of occupying the drum interior.\nIts derived frame and frame sockets consume the exact same connection length.\n\nV1.6 INVARIANT \u2014 DERIVED FRAME GRAMMAR\nOrange Structure.Frame geometry is derived from its owning PressureVolume, never authored as arbitrary free lines.\nArm frames use four exterior longitudinal rails plus end frames at radius + clearance.\nDrum frames use exterior rings and orthogonal tangent rails at radius + clearance.\nFrame sockets are generated from the same module-local profile.\nFuture cross-module continuity is socket-to-socket. Ordinary frame generation therefore cannot enter its own pressure volume.\nThe failed post-hoc collision/clipping approach is intentionally removed.\n\nV1.3 INVARIANT \u2014 LOCAL OWNERSHIP\nStationRoot is a transform/container only and owns no visible geometry.\nEvery visible object belongs to an addressable module.\nEach module owns PressureVolume, Structure.Primary, Structure.Frame, Detail, and AttachmentNodes.\nOrange frame geometry is module-local structural detail.\nAdjacent modules use matching frame-interface metadata so independent frames can visually continue across a joint.\nIf something spans modules and cannot belong cleanly to either, it must become an addressable junction/connector module.\n\nV1.1 DELTA \u2014 HOLLOW TOPOLOGY\n- The station's primary architecture is itself inhabitable.\n- Large hubs are hollow drum/chamber volumes, not pills.\n- Branching arms are hollow orthogonal pressure volumes, not rods or trusses.\n- Interiors are intentionally empty for now; hollow volume is the only interior requirement.\n- Every arm joins a hub/spine through visible collars and terminates at a physical bulkhead/attachment collar.\n- External trusses/braces/greebles are secondary support/detail layers, never substitutes for inhabited arms.\n- All primary architecture remains orthogonal for this pass. Radial capability is preserved but unused.\n- No floating decorative arc.\n\u003c/script\u003e\n\u003cscript\u003e\nwindow.orbitalFail=(scope,e)=\u003e{clearTimeout(window.orbitalWatch);const f=document.getElementById('fault');f.style.display='block';f.textContent='ORBITAL CONSTRUCTION \u2014 '+scope+'\\n'+(e?.stack||e?.message||String(e));};\naddEventListener('error',e=\u003eorbitalFail('startup / runtime',e.error||e.message));addEventListener('unhandledrejection',e=\u003eorbitalFail('promise',e.reason));window.orbitalWatch=setTimeout(()=\u003e{if(!window.orbitalReady)orbitalFail('load watchdog','Lab did not finish startup within 30 seconds. Check CDN access / WebGL support.');},30000);\n\u003c/script\u003e\n\u003cscript type=\"module\"\u003e\nimport * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';\nconst scene=new THREE.Scene(); scene.background=new THREE.Color(0x010204);\nconst camera=new THREE.PerspectiveCamera(46,innerWidth/innerHeight,.03,1000);\nconst renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,1.5)); renderer.setSize(innerWidth,innerHeight);\nrenderer.outputColorSpace=THREE.SRGBColorSpace; renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.05;\ndocument.body.prepend(renderer.domElement);\nrenderer.domElement.addEventListener('webglcontextlost',e=\u003e{e.preventDefault();orbitalFail('WebGL context lost','Reload the lab to reconstruct the station.');});\nrenderer.debug.onShaderError=(gl,p,vs,fs)=\u003e{orbitalFail('shader; retrying with plain surfaces',gl.getProgramInfoLog(p)+'\\n'+gl.getShaderInfoLog(vs)+'\\n'+gl.getShaderInfoLog(fs));window.orbitalSurfaceRecover?.();};\n\nconst M={\n white:new THREE.MeshStandardMaterial({color:0xd9dde0,roughness:.55,metalness:.28}),\n pale:new THREE.MeshStandardMaterial({color:0x89939c,roughness:.55,metalness:.42}),\n greyA:new THREE.MeshStandardMaterial({color:0x4f5961,roughness:.48,metalness:.58}),\n greyB:new THREE.MeshStandardMaterial({color:0x68737b,roughness:.5,metalness:.52}),\n greyC:new THREE.MeshStandardMaterial({color:0x7f8990,roughness:.54,metalness:.46}),\n orange:new THREE.MeshStandardMaterial({color:0xd87417,roughness:.45,metalness:.5}),\n warm:new THREE.MeshStandardMaterial({color:0x75431e,emissive:0xff9138,emissiveIntensity:1.55,roughness:.7}),\n glass:new THREE.MeshPhysicalMaterial({color:0xffb15f,transparent:true,opacity:.3,roughness:.12,transmission:.28,thickness:.05,side:THREE.DoubleSide,depthWrite:false})\n};\nfunction sem(id,type,parent){const g=new THREE.Group();g.name=id;g.userData={id,type,parent:parent?.name||null,attachmentNodes:[]};if(parent)parent.add(g);return g}\nfunction box(p,s,x,m=M.white,n=''){const o=new THREE.Mesh(new THREE.BoxGeometry(...s),m);o.position.set(...x);o.name=n;p.add(o);return o}\nfunction beam(p,a,b,r=.05,m=M.orange,n='beam'){const A=new THREE.Vector3(...a),B=new THREE.Vector3(...b),d=B.clone().sub(A);const o=new THREE.Mesh(new THREE.CylinderGeometry(r,r,d.length(),8),m);o.position.copy(A).add(B).multiplyScalar(.5);o.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.normalize());o.name=n;p.add(o);return o}\nfunction node(p,id,x){const o=new THREE.Object3D();o.name=id;o.position.set(...x);o.userData={id,type:'attachment-node'};p.add(o);p.userData.attachmentNodes?.push(id);return o}\nfunction trussBox(p,w,h,d){\n const x=w/2,y=h/2,z=d/2;\n [[-x,-y,-z],[x,-y,-z],[-x,y,-z],[x,y,-z],[-x,-y,z],[x,-y,z],[-x,y,z],[x,y,z]].forEach((q,i)=\u003e{\n  if(i\u003c4)beam(p,q,[q[0],q[1],z],.035);\n });\n for(const zz of [-z,z]){beam(p,[-x,-y,zz],[x,-y,zz],.035);beam(p,[-x,y,zz],[x,y,zz],.035);beam(p,[-x,-y,zz],[-x,y,zz],.035);beam(p,[x,-y,zz],[x,y,zz],.035)}\n}\n\nfunction capsuleHull(parent,id,pos,scale){\n const g=sem(id,'pressure-hull',parent); g.position.set(...pos);\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(.62,1.25,8,18),M.white);body.rotation.z=Math.PI/2;body.scale.set(...scale);g.add(body);return g;\n}\nfunction collar(parent,pos,axis='x'){\n const m=new THREE.Mesh(new THREE.CylinderGeometry(.22,.22,.18,16),M.greyB);m.position.set(...pos);if(axis==='x')m.rotation.z=Math.PI/2;else if(axis==='z')m.rotation.x=Math.PI/2;parent.add(m);return m;\n}\n\n// V1.2 module anatomy: every targetable module owns its four independent strata.\nconst modules=new Map();\nfunction moduleRoot(id,type,parent){\n  const root=sem(id,type,parent);\n  root.userData.selectableModule=id;\n  const pressure=sem(id+'.pressure','pressure-volume',root);\n  const structure=sem(id+'.structure','structure',root);\n  const detail=sem(id+'.detail','detail',root);\n  const attachments=sem(id+'.attachments','attachment-nodes',root);\n  root.userData.layers={pressure,structure,detail,attachments};\n  modules.set(id,root);\n  return root;\n}\nfunction tagModule(root){\n  root.traverse(o=\u003e{if(o.isMesh)o.userData.selectableModule=root.userData.selectableModule});\n}\nfunction adoptModule(oldRoot){\n  // Existing V1.1 roots become selectable modules. Their current geometry is PressureVolume;\n  // dedicated Structure/Detail/Attachment layers are added without visually changing the station.\n  oldRoot.userData.selectableModule=oldRoot.name;\n  const structure=sem(oldRoot.name+'.structure','structure',oldRoot);\n  const primary=sem(oldRoot.name+'.structure.primary','primary-structure',structure);\n  const frame=sem(oldRoot.name+'.structure.frame','orange-frame',structure);\n  const detail=sem(oldRoot.name+'.detail','detail',oldRoot);\n  const attachments=sem(oldRoot.name+'.attachments','attachment-nodes',oldRoot);\n  oldRoot.userData.layers={pressure:oldRoot,structure,primary,frame,detail,attachments};\n  modules.set(oldRoot.name,oldRoot);\n  tagModule(oldRoot);\n  return oldRoot;\n}\n\n// V1.1: the pressure-volume topology IS the station.\nconst station=sem('station-root','station',scene);\n\nconst pressure=sem('pressure-volume-network','nonvisual-registry',station);\npressure.visible=true; // temporary construction parent; emptied after module ownership migration.\nconst structure=sem('external-structure','nonvisual-registry',station);\nconst greebles=sem('greeble-layer','nonvisual-registry',station);\n\nfunction shellCylinder(parent,id,radius,length,pos,axis='y',mat=M.white){\n  const g=sem(id,'hollow-pressure-volume',parent); g.position.set(...pos);\n  // Open-ended shell: BackSide makes the hollow interior legible when viewed through an opening.\n  const outerMat=mat.clone(); outerMat.side=THREE.FrontSide;\n  const innerMat=M.greyC.clone(); innerMat.side=THREE.BackSide;\n  const outer=new THREE.Mesh(new THREE.CylinderGeometry(radius,radius,length,28,1,true),outerMat);\n  const inner=new THREE.Mesh(new THREE.CylinderGeometry(radius-.10,radius-.10,length-.02,28,1,true),innerMat);\n  if(axis==='x'){outer.rotation.z=Math.PI/2;inner.rotation.z=Math.PI/2}\n  if(axis==='z'){outer.rotation.x=Math.PI/2;inner.rotation.x=Math.PI/2}\n  outer.name=id+'-outer-shell'; inner.name=id+'-inner-shell'; g.add(outer,inner);\n  return g;\n}\nfunction ring(parent,pos,axis='x',r=.64,t=.08,mat=M.greyB,name='collar'){\n  const o=new THREE.Mesh(new THREE.TorusGeometry(r,t,10,28),mat);o.position.set(...pos);\n  if(axis==='x')o.rotation.y=Math.PI/2;\n  else if(axis==='y')o.rotation.x=Math.PI/2;\n  o.name=name;parent.add(o);return o;\n}\nfunction bulkhead(parent,pos,axis='x',r=.57,mat=M.pale,name='bulkhead'){\n  const o=new THREE.Mesh(new THREE.CylinderGeometry(r,r,.08,28),mat);o.position.set(...pos);\n  if(axis==='x')o.rotation.z=Math.PI/2; else if(axis==='z')o.rotation.x=Math.PI/2;\n  o.name=name;parent.add(o);return o;\n}\nfunction arm(parent,id,length,pos,axis='x',radius=.48){\n  const g=shellCylinder(parent,id,radius,length,pos,axis,M.white);\n  const half=length/2;\n  const a=[...pos],b=[...pos];\n  const k=axis==='x'?0:axis==='y'?1:2; a[k]-=half;b[k]+=half;\n  ring(parent,a,axis,radius+.03,.07,M.greyB,id+'-collar-a');\n  ring(parent,b,axis,radius+.03,.07,M.greyB,id+'-collar-b');\n  node(g,id+'.a',a.map((v,i)=\u003ev-pos[i])); node(g,id+'.b',b.map((v,i)=\u003ev-pos[i]));\n  return g;\n}\n\nfunction pressureArmBetween(parent,id,start,end,radius=.48){\n  // Universal arm primitive: geometry is authored by its two attachment surfaces.\n  // The arm itself never decides to bury either endpoint inside a parent pressure volume.\n  const A=new THREE.Vector3(...start),B=new THREE.Vector3(...end),D=B.clone().sub(A);\n  const length=D.length();\n  if(length\u003c.001)throw new Error(id+' has coincident attachment surfaces');\n  const axisVec=D.clone().normalize();\n  const dominant=Math.max(Math.abs(axisVec.x),Math.abs(axisVec.y),Math.abs(axisVec.z));\n  if(dominant\u003c.999)throw new Error(id+' must remain orthogonal in this prototype');\n  const axis=Math.abs(axisVec.x)\u003e.999?'x':Math.abs(axisVec.y)\u003e.999?'y':'z';\n  const center=A.clone().add(B).multiplyScalar(.5);\n  const g=arm(parent,id,length,center.toArray(),axis,radius);\n  g.userData.connection={start:[...start],end:[...end],axis,radius};\n  return g;\n}\n\n// V1.9 reusable pressure topology. Rules live here, not in individual modules.\nclass PressurePort {\n  constructor(module,name,localPosition){this.module=module;this.name=name;this.local=new THREE.Vector3(...localPosition)}\n  world(){return this.module.root.localToWorld(this.local.clone())}\n}\nclass PressureModule {\n  constructor(root){this.root=root;this.ports=new Map()}\n  port(name,localPosition){const p=new PressurePort(this,name,localPosition);this.ports.set(name,p);return p}\n  moveTo(x,y,z){this.root.position.set(x,y,z);return this}\n}\nclass DrumModule extends PressureModule {\n  constructor(root,radius,height){\n    super(root);this.radius=radius;this.height=height;\n    this.port('east',[ radius,0,0]);this.port('west',[-radius,0,0]);\n    this.port('forward',[0,0,radius]);this.port('aft',[0,0,-radius]);\n  }\n}\n\nclass EndCapModule extends PressureModule {\n  constructor(root,outwardNormal,radius=.47){\n    super(root);this.radius=radius;\n    this.outwardNormal=outwardNormal.clone().normalize();\n    // One-port module. Geometry is authored canonically toward local +Z;\n    // the entire module is oriented from this outward normal.\n    this.port('inward',[0,0,0]);\n    root.userData.termination='sealed';\n    root.userData.portCount=1;\n    root.userData.outwardNormal=this.outwardNormal.toArray();\n  }\n}\nfunction makeEndCap(id,pos,outwardNormal,radius=.47){\n  const outwardN=outwardNormal.clone().normalize();\n  const root=sem(id,'sealed-end-cap',pressure);root.position.set(...pos);\n\n  // Author the complete termination in canonical local +Z.\n  // No child knows about world axis/sign. Rotate the module once at the end.\n  ring(root,[0,0,0],'z',radius+.055,.075,M.greyB,id+'-collar');\n\n  const disk=new THREE.Mesh(new THREE.CylinderGeometry(radius*.90,radius*.90,.055,32),M.white);\n  disk.rotation.x=Math.PI/2;\n  disk.position.z=.03;\n  disk.name=id+'-pressure-bulkhead';\n  root.add(disk);\n\n  // CylinderGeometry's radiusTop lies at local +Y. After rotation +X/2,\n  // local +Y maps to +Z, so the smaller radius is deliberately OUTWARD.\n  const cap=new THREE.Mesh(new THREE.CylinderGeometry(radius*.72,radius*.91,.14,32),M.white);\n  cap.rotation.x=Math.PI/2;\n  cap.position.z=.085;\n  cap.name=id+'-shallow-cap';\n  root.add(cap);\n\n  node(root,id+'.inward',[0,0,0]);\n\n  // Canonical +Z -\u003e semantic outward normal. This rotates bulkhead, taper,\n  // attachment metadata and all future child geometry as one unit.\n  root.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1),outwardN);\n\n  return {root,module:new EndCapModule(root,outwardN,radius)};\n}\n\nclass ArmConnection {\n  constructor(root,a,b,radius){this.root=root;this.a=a;this.b=b;this.radius=radius;this.refresh()}\n  refresh(){\n    const A=this.a.world(),B=this.b.world(),D=B.clone().sub(A),L=D.length();\n    const axis=Math.abs(D.x)\u003eMath.abs(D.y)\u0026\u0026Math.abs(D.x)\u003eMath.abs(D.z)?'x':Math.abs(D.y)\u003eMath.abs(D.z)?'y':'z';\n    this.root.userData.connection={from:this.a.name,to:this.b.name,length:L,axis};\n    return this;\n  }\n}\nfunction makeConnectedArm(id,a,b,radius=.48){\n  const A=a.world(),B=b.world(),D=B.clone().sub(A),L=D.length();\n  const axis=Math.abs(D.x)\u003eMath.abs(D.y)\u0026\u0026Math.abs(D.x)\u003eMath.abs(D.z)?'x':Math.abs(D.y)\u003eMath.abs(D.z)?'y':'z';\n  const center=A.clone().add(B).multiplyScalar(.5);\n  const root=arm(pressure,id,L,center.toArray(),axis,radius);\n  return new ArmConnection(root,a,b,radius);\n}\nfunction gbox(s,p,mat,name='greeble'){return box(greebles,s,p,mat,name)}\nfunction supportBeam(a,b,r=.045,mat=M.orange,name='support'){return beam(structure,a,b,r,mat,name)}\n\n// Central inhabited vertical trunk: a hollow pressure corridor.\nconst trunk=arm(pressure,'central-trunk',6.8,[0,0,0],'y',.58);\nring(pressure,[0,2.1,0],'y',.64,.075,M.greyB,'trunk-belt-upper');\nring(pressure,[0,0,0],'y',.64,.075,M.greyB,'trunk-belt-mid');\nring(pressure,[0,-2.1,0],'y',.64,.075,M.greyB,'trunk-belt-lower');\n\n// Large circular habitat: broad hollow drum, axis vertical.\nconst hub=sem('habitat-drum-a','hollow-habitat-drum',pressure); hub.position.set(2.55,.85,0);\nconst hubOuter=new THREE.Mesh(new THREE.CylinderGeometry(1.55,1.55,1.35,36,1,true),M.white);\nconst hubInnerMat=M.greyC.clone();hubInnerMat.side=THREE.BackSide;\nconst hubInner=new THREE.Mesh(new THREE.CylinderGeometry(1.43,1.43,1.31,36,1,true),hubInnerMat);\nhub.add(hubOuter,hubInner);\nring(hub,[0,.67,0],'y',1.57,.09,M.greyB,'upper-belt'); ring(hub,[0,-.67,0],'y',1.57,.09,M.greyB,'lower-belt');\nfor(const a of [0,Math.PI/2,Math.PI,Math.PI*1.5]){\n  const x=Math.cos(a)*1.55,z=Math.sin(a)*1.55;\n  // port rings sit on the circumference; arms use orthogonal ports only.\n  if(Math.abs(x)\u003e1) ring(hub,[x,0,z],'x',.52,.07,M.greyB,'hub-port');\n  else ring(hub,[x,0,z],'z',.52,.07,M.greyB,'hub-port');\n}\nnode(hub,'habitat-drum-a.east',[1.62,0,0]);node(hub,'habitat-drum-a.west',[-1.62,0,0]);\nnode(hub,'habitat-drum-a.forward',[0,0,1.62]);node(hub,'habitat-drum-a.aft',[0,0,-1.62]);\n\n// Trunk-to-hub inhabited connector.\n// Every branch begins and ends on explicit pressure-volume surfaces.\n// No special \"riser\" ontology: vertical branches are ordinary habitat arms.\n// Drum A moved outward as the experiment. The connecting arm follows module ports.\nhub.position.x=3.15;\nconst trunkModule=new PressureModule(trunk);\nconst trunkEastAtHub=trunkModule.port('east-at-drum-a',[.58,.85,0]);\nconst drumAModule=new DrumModule(hub,1.55,1.35);\nconst eastConnection=makeConnectedArm('habitat-arm-east',trunkEastAtHub,drumAModule.ports.get('west'),.5);\nconst eastLength=eastConnection.root.userData.connection.length;\n\n// Long inhabited branches. These remain visually positioned as before for this pass;\n// subsequent passes can migrate each endpoint to named ports without changing the primitive.\n// habitat-arm-west is created from module ports after Drum B is instantiated.\narm(pressure,'habitat-arm-forward',4.0,[0,.05,2.45],'z',.47);\narm(pressure,'habitat-arm-east-upper',4.5,[2.75,2.45,0],'x',.47);\n\n// The former \"branch riser\" bubbles from the +X surface of the central trunk.\n// It is simply a vertical habitat arm whose lower attachment lies on that surface.\n// The horizontal continuation begins at that arm's own surface/end attachment.\nconst branchX=.58;\nconst branchBottom=[branchX,.90,0];\nconst branchTop=[branchX,2.45,0];\npressureArmBetween(pressure,'habitat-arm-branch-east-vertical',branchBottom,branchTop,.47);\npressureArmBetween(pressure,'habitat-arm-branch-east-link',[branchX,2.45,0],[1.445,2.45,0],.47);\n\n// Small secondary hollow chamber on west branch.\nconst small=sem('habitat-drum-b','hollow-habitat-drum',pressure);small.position.set(-4.85,-1.25,0);\nconst so=new THREE.Mesh(new THREE.CylinderGeometry(.92,.92,1.0,30,1,true),M.white);\nconst siMat=M.greyC.clone();siMat.side=THREE.BackSide;\nconst si=new THREE.Mesh(new THREE.CylinderGeometry(.82,.82,.96,30,1,true),siMat);small.add(so,si);\nring(small,[0,.5,0],'y',.94,.07,M.greyB);ring(small,[0,-.5,0],'y',.94,.07,M.greyB);\n\nconst drumBModule=new DrumModule(small,.92,1.0);\nconst trunkWestAtB=trunkModule.port('west-at-drum-b',[-.58,-1.25,0]);\nconst westConnection=makeConnectedArm('habitat-arm-west',trunkWestAtB,drumBModule.ports.get('east'),.47);\nconst westLength=westConnection.root.userData.connection.length;\n\nring(small,[.92,0,0],'x',.5,.07,M.greyB,'west-port');\nnode(small,'habitat-drum-b.east',[1,0,0]);\n\n// V1.18: exposed expansion boundaries terminate in explicit one-port EndCap modules.\n// These are topology, not decorative bulkhead meshes.\nconst endCapForward=makeEndCap('end-cap-forward',[0,.05,4.45],new THREE.Vector3(0,0,1),.46);\nconst endCapEastUpper=makeEndCap('end-cap-east-upper',[5.0,2.45,0],new THREE.Vector3(1,0,0),.46);\nconst endCapTrunkTop=makeEndCap('end-cap-trunk-top',[0,3.40,0],new THREE.Vector3(0,1,0),.58);\nconst endCapTrunkBottom=makeEndCap('end-cap-trunk-bottom',[0,-3.40,0],new THREE.Vector3(0,-1,0),.58);\n\n// External support grammar: secondary, orthogonal, and physically tied to pressure volumes.\nfor(const y of [-2.5,-1.25,0,1.25,2.5]){\n  supportBeam([-.82,y,-.82],[-.82,y,.82],.035,M.orange,'trunk-crossbrace');\n  supportBeam([.82,y,-.82],[.82,y,.82],.035,M.orange,'trunk-crossbrace');\n}\nsupportBeam([.78,-2.9,-.78],[.78,3.0,-.78],.045,M.orange,'trunk-frame');\nsupportBeam([-.78,-2.9,-.78],[-.78,3.0,-.78],.045,M.orange,'trunk-frame');\nsupportBeam([.78,-2.9,.78],[.78,3.0,.78],.045,M.orange,'trunk-frame');\nsupportBeam([-.78,-2.9,.78],[-.78,3.0,.78],.045,M.orange,'trunk-frame');\n\n// Braces support the long branches rather than floating independently.\nsupportBeam([.72,2.9,-.62],[4.85,2.9,-.62],.045,M.orange,'east-upper-rail');\nsupportBeam([.72,2.0,-.62],[4.85,2.0,-.62],.045,M.orange,'east-upper-rail');\nfor(const x of [1.2,2.2,3.2,4.2]) supportBeam([x,2.0,-.62],[x,2.9,-.62],.032,M.orange,'east-upper-rung');\nsupportBeam([-4.7,-1.78,-.58],[-.65,-1.78,-.58],.04,M.orange,'west-support');\nsupportBeam([-4.7,-.72,-.58],[-.65,-.72,-.58],.04,M.orange,'west-support');\n\n// Separate varied-grey greeble layer; deliberately sparse at this stage.\nconst gm=[M.greyA,M.greyB,M.greyC,M.pale];\n[\n [[.22,.18,.16],[.7,1.2,.63]], [[.32,.14,.18],[-.72,.3,.62]], [[.18,.5,.16],[-.72,-2.0,-.6]],\n [[.42,.16,.22],[2.2,1.58,1.1]], [[.2,.3,.2],[3.3,.18,-1.2]], [[.35,.12,.18],[-2.5,-.72,.52]],\n [[.16,.55,.16],[.58,2.1,.65]], [[.28,.16,.3],[4.1,2.82,.45]]\n].forEach((v,i)=\u003egbox(v[0],v[1],gm[i%gm.length]));\n// Conduits visibly hug inhabited volumes.\nfor(let i=0;i\u003c7;i++) supportBeam([-.64,-2.3+i*.65,.6],[-.64,-1.95+i*.65,.6],.022,gm[i%gm.length],'conduit');\n\n// Detail toggle remains an inspection instrument.\nlet detailOn=true;document.getElementById('greeble').onclick=()=\u003e{detailOn=!detailOn;for(const m of modules.values())m.userData.layers.detail.visible=detailOn;if(window.__stationOutdoorsProxy?.userData?.setDetail)window.__stationOutdoorsProxy.userData.setDetail(detailOn);document.getElementById('greeble').textContent=detailOn?'DETAIL ON':'DETAIL OFF'};\n\n\n// Promote pressure topology into independently targetable top-level modules.\nconst moduleCandidates=[\n trunk, hub, small,\n endCapForward.root, endCapEastUpper.root, endCapTrunkTop.root, endCapTrunkBottom.root,\n pressure.getObjectByName('habitat-arm-east'),\n pressure.getObjectByName('habitat-arm-west'),\n pressure.getObjectByName('habitat-arm-forward'),\n pressure.getObjectByName('habitat-arm-east-upper'),\n pressure.getObjectByName('branch-riser-east'),\n pressure.getObjectByName('branch-link-east')\n].filter(Boolean);\nmoduleCandidates.forEach(adoptModule);\n\n// Move modules out of the construction registry: StationRoot now owns modules only.\nfor(const mod of moduleCandidates) station.attach(mod);\n\n// Utility: assign a visible object to the nearest module while preserving world transform.\nfunction nearestModule(obj){\n  const wp=new THREE.Vector3();obj.getWorldPosition(wp);\n  let best=null,bestD=Infinity;\n  for(const mod of modules.values()){\n    const mp=new THREE.Vector3();mod.getWorldPosition(mp);\n    const d=mp.distanceToSquared(wp);\n    if(d\u003cbestD){bestD=d;best=mod}\n  }\n  return best;\n}\nfunction migrateChildren(source,layerName){\n  const children=[...source.children];\n  for(const obj of children){\n    const best=nearestModule(obj); if(!best)continue;\n    best.userData.layers[layerName].attach(obj);\n    obj.traverse(o=\u003e{if(o.isMesh)o.userData.selectableModule=best.name});\n  }\n}\n\n// Orange frames/supports become locally owned Frame detail.\n// Grey greebles become locally owned Detail.\nmigrateChildren(structure,'frame');\nmigrateChildren(greebles,'detail');\n\n// Legacy cleanup: loose pressure-network meshes used to be promoted into anonymous\n// junction-\u003cuuid\u003e modules. Those were construction leftovers (collars/belts/bulkheads),\n// not real topology. Keep no anonymous junction ontology.\n// Any future junction must be an explicit named pressure module created through ports.\nfor(const obj of [...pressure.children]){\n  if(obj.userData?.type==='attachment-node') continue;\n  pressure.remove(obj);\n}\n\n// Defensive cleanup: anonymous legacy junctions are never valid modules.\nfor(const [id,m] of [...modules]){\n  if(id.startsWith('junction-')){ station.remove(m); modules.delete(id); }\n}\n\n// StationRoot invariant: direct children may only be semantic modules or empty registries.\n// Remove empty construction registries entirely.\nstation.remove(pressure,structure,greebles);\n\n// Frame-interface metadata: neighboring modules can independently terminate their orange\n// frame grammar at the same attachment plane without sharing geometry.\nfunction frameInterface(mod,id,axis='x',profile='four-corner'){\n  mod.userData.frameInterfaces??=[];\n  mod.userData.frameInterfaces.push({id,axis,profile});\n}\nfor(const m of modules.values()){\n  for(const aid of (m.userData.attachmentNodes||[])) frameInterface(m,aid,'orthogonal','four-corner');\n}\nframeInterface(trunk,'trunk.east-upper','x');\nframeInterface(hub,'habitat-drum-a.west','x');\nconst west=modules.get('habitat-arm-west'); if(west){frameInterface(west,'habitat-arm-west.east','x');frameInterface(west,'habitat-arm-west.west','x')}\nconst upper=modules.get('habitat-arm-east-upper'); if(upper){frameInterface(upper,'habitat-arm-east-upper.west','x');frameInterface(upper,'habitat-arm-east-upper.east','x')}\n\n\n// V1.6 DERIVED FRAME GRAMMAR\n// Orange frames are not arbitrary free geometry and are never collision-clipped.\n// They are regenerated from each module's own pressure geometry + clearance.\nfunction clearFrameLayer(mod){\n  const f=mod.userData.layers.frame;\n  while(f.children.length)f.remove(f.children[0]);\n}\nfunction frameRail(frame,a,b,r=.035,name='rail'){return beam(frame,a,b,r,M.orange,name)}\nfunction frameRing(frame,center,axis,radius,t=.045,name='frame-ring'){\n  const o=new THREE.Mesh(new THREE.TorusGeometry(radius,t,10,32),M.orange);\n  o.position.set(...center);\n  if(axis==='x')o.rotation.y=Math.PI/2;\n  else if(axis==='y')o.rotation.x=Math.PI/2;\n  o.name=name;frame.add(o);return o;\n}\nfunction deriveArmFrame(mod,axis,length,radius){\n  clearFrameLayer(mod);\n  const f=mod.userData.layers.frame, c=radius+.19, h=length/2;\n  const ends=[-h,h];\n  // Four longitudinal exterior rails. Coordinates are local to the pressure module.\n  if(axis==='x'){\n    for(const y of [-c,c])for(const z of [-c,c])frameRail(f,[-h,y,z],[h,y,z],.035,'longitudinal');\n    for(const x of ends){\n      frameRail(f,[x,-c,-c],[x,c,-c],.032,'end-frame');frameRail(f,[x,c,-c],[x,c,c],.032,'end-frame');\n      frameRail(f,[x,c,c],[x,-c,c],.032,'end-frame');frameRail(f,[x,-c,c],[x,-c,-c],.032,'end-frame');\n    }\n  }else if(axis==='y'){\n    for(const x of [-c,c])for(const z of [-c,c])frameRail(f,[x,-h,z],[x,h,z],.035,'longitudinal');\n    for(const y of ends){\n      frameRail(f,[-c,y,-c],[c,y,-c],.032,'end-frame');frameRail(f,[c,y,-c],[c,y,c],.032,'end-frame');\n      frameRail(f,[c,y,c],[-c,y,c],.032,'end-frame');frameRail(f,[-c,y,c],[-c,y,-c],.032,'end-frame');\n    }\n  }else{\n    for(const x of [-c,c])for(const y of [-c,c])frameRail(f,[x,y,-h],[x,y,h],.035,'longitudinal');\n    for(const z of ends){\n      frameRail(f,[-c,-c,z],[c,-c,z],.032,'end-frame');frameRail(f,[c,-c,z],[c,c,z],.032,'end-frame');\n      frameRail(f,[c,c,z],[-c,c,z],.032,'end-frame');frameRail(f,[-c,c,z],[-c,-c,z],.032,'end-frame');\n    }\n  }\n  mod.userData.frameGrammar={kind:'arm',axis,length,radius,clearance:.19,profile:'four-corner'};\n  tagModule(mod);\n}\nfunction deriveDrumFrame(mod,radius,height){\n  clearFrameLayer(mod);\n  const f=mod.userData.layers.frame, r=radius+.16, y=height/2+.10;\n  frameRing(f,[0,y,0],'y',r,.045,'upper-frame-ring');\n  frameRing(f,[0,-y,0],'y',r,.045,'lower-frame-ring');\n  // Four orthogonal vertical rails tangent to the drum exterior.\n  for(const [x,z] of [[r,0],[-r,0],[0,r],[0,-r]])frameRail(f,[x,-y,z],[x,y,z],.038,'vertical-frame');\n  mod.userData.frameGrammar={kind:'drum',axis:'y',radius,height,clearance:.16,profile:'orthogonal-four'};\n  tagModule(mod);\n}\n\ntry {\n// Delete every migrated legacy orange member. Module frames are now purely derived.\nfor(const m of modules.values())clearFrameLayer(m);\n\n// Generate legal exterior frames from module dimensions.\nderiveArmFrame(trunk,'y',6.8,.58);\nconst east=modules.get('habitat-arm-east');if(east)deriveArmFrame(east,'x',eastLength,.5);\nconst westArm=modules.get('habitat-arm-west');if(westArm)deriveArmFrame(westArm,'x',westLength,.47);\nconst forward=modules.get('habitat-arm-forward');if(forward)deriveArmFrame(forward,'z',4.0,.47);\nconst upperArm=modules.get('habitat-arm-east-upper');if(upperArm)deriveArmFrame(upperArm,'x',4.5,.47);\nconst riser=modules.get('habitat-arm-branch-east-vertical');\nif(riser)deriveArmFrame(riser,'y',branchTop[1]-branchBottom[1],.47);\nconst link=modules.get('habitat-arm-branch-east-link');\nif(link)deriveArmFrame(link,'x',1.445-branchX,.47);\nderiveDrumFrame(hub,1.55,1.35);\nderiveDrumFrame(small,.92,1.0);\n\n// Frame sockets are derived from the same profile as the frame itself.\n// Future module-to-module orange continuity connects socket-to-socket; no arbitrary through-space rails.\nfunction armSockets(mod,axis,length,radius){\n  const c=radius+.19,h=length/2, pts=[];\n  if(axis==='x')for(const end of [-h,h])for(const y of [-c,c])for(const z of [-c,c])pts.push([end,y,z]);\n  if(axis==='y')for(const end of [-h,h])for(const x of [-c,c])for(const z of [-c,c])pts.push([x,end,z]);\n  if(axis==='z')for(const end of [-h,h])for(const x of [-c,c])for(const y of [-c,c])pts.push([x,y,end]);\n  mod.userData.frameSockets=pts;\n}\narmSockets(trunk,'y',6.8,.58);\nif(east)armSockets(east,'x',eastLength,.5);if(westArm)armSockets(westArm,'x',westLength,.47);\nif(forward)armSockets(forward,'z',4,.47);if(upperArm)armSockets(upperArm,'x',4.5,.47);\nif(riser)armSockets(riser,'y',branchTop[1]-branchBottom[1],.47);\nif(link)armSockets(link,'x',1.445-branchX,.47);\n\n\n} catch (err) { console.error('Derived frame layer failed safely:',err); }\n\n\n// V1.16 MODULE-OWNED PROCEDURAL SURFACE MATERIALS\n// Texture paints PressureVolume only. It is independent of Detail and Structure.\nfunction makeHullTexture(seed=1){\n  const N=256,c=document.createElement('canvas');c.width=c.height=N;\n  const x=c.getContext('2d'),rng=mulberry32(seed);\n  x.fillStyle='#d8d9d5';x.fillRect(0,0,N,N);\n\n  // Broad manufactured plate variation.\n  const cell=32;\n  for(let yy=0;yy\u003cN;yy+=cell)for(let xx=0;xx\u003cN;xx+=cell){\n    const v=196+Math.floor(rng()*30);\n    x.fillStyle=`rgb(${v},${v+1},${v+2})`;\n    x.fillRect(xx+1,yy+1,cell-2,cell-2);\n  }\n  // Fine seams: regular, restrained, architectural.\n  x.strokeStyle='rgba(62,67,70,.28)';x.lineWidth=1;\n  for(let q=0;q\u003c=N;q+=cell){x.beginPath();x.moveTo(q,0);x.lineTo(q,N);x.stroke();x.beginPath();x.moveTo(0,q);x.lineTo(N,q);x.stroke()}\n  // Sparse wear/scuffs, kept low contrast.\n  for(let i=0;i\u003c95;i++){\n    const px=rng()*N,py=rng()*N,len=2+rng()*10;\n    x.strokeStyle=`rgba(70,72,70,${.025+rng()*.06})`;x.lineWidth=.5+rng();\n    x.beginPath();x.moveTo(px,py);x.lineTo(px+len,py+(rng()-.5)*2);x.stroke();\n  }\n  // A few faint service bands.\n  x.fillStyle='rgba(90,94,94,.08)';\n  for(let i=0;i\u003c4;i++){const yy=Math.floor(rng()*N);x.fillRect(0,yy,N,2)}\n  const t=new THREE.CanvasTexture(c);\n  t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(2.5,2.5);\n  t.colorSpace=THREE.SRGBColorSpace;\n  t.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy());\n  return t;\n}\nconst textureRegistry=new Map();\nfunction installModuleSurfaceMaterial(mod){\n  const pressure=mod.userData.layers?.pressure||mod;\n  const seed=hashSeed(mod.name||'module');\n  const tex=makeHullTexture(seed);\n  const entries=[];\n  pressure.traverse(o=\u003e{\n    if(!o.isMesh)return;\n    // Only actual hull-shell material receives painted skin. Preserve collars, glass,\n    // orange structure and generated Detail as independent material systems.\n    const mat=o.material;\n    // Texture the complete exterior pressure architecture: hulls, collars,\n    // bulkheads and belts. Inward-facing cavity shells stay clean so the\n    // surface treatment reads as an exterior manufactured skin.\n    if(!mat || mat.side===THREE.BackSide || mat===M.glass || mat===M.orange)return;\n    const clean=mat;\n    const textured=mat.clone();\n    textured.map=tex;\n    textured.roughness=Math.max(.62,mat.roughness??.62);\n    textured.metalness=mat.metalness??.22;\n    textured.needsUpdate=true;\n    entries.push({mesh:o,clean,textured});\n  });\n  mod.userData.surfaceMaterial={texture:tex,entries,enabled:true};\n  textureRegistry.set(mod.name,mod.userData.surfaceMaterial);\n}\nfunction setModuleTexture(id,on){\n  const mod=modules.get(id);if(!mod?.userData.surfaceMaterial)return;\n  const sm=mod.userData.surfaceMaterial;sm.enabled=on;\n  for(const e of sm.entries)e.mesh.material=on?e.textured:e.clean;\n}\nlet textureOn=true;\nfunction setAllTextures(on){\n  textureOn=on;\n  for(const id of textureRegistry.keys())setModuleTexture(id,on);\n  // Interior materials are initialized later than the exterior texture system.\n  // Never reference their lexical binding during startup; the button can safely\n  // synchronize them after the whole module has initialized.\n  if(window.__room001Materials){\n    const R=window.__room001Materials;\n    R.shell.map=on?R.textures.shell:null;\n    R.floor.map=on?R.textures.floor:null;\n    R.table.map=on?R.textures.table:null;\n    R.shell.needsUpdate=R.floor.needsUpdate=R.table.needsUpdate=true;\n  }\n  if(window.__stationOutdoorsProxy?.userData?.setTexture)\n    window.__stationOutdoorsProxy.userData.setTexture(on);\n  const b=document.getElementById('texture');if(b)b.textContent='TEXTURE '+(on?'ON':'OFF');\n}\nfor(const m of modules.values())installModuleSurfaceMaterial(m);\nsetAllTextures(true);\ndocument.getElementById('texture')?.addEventListener('click',()=\u003esetAllTextures(!textureOn));\n\n\n// V1.15 DETAIL PROMOTION\n// The generated surface language is now the canonical Detail layer.\n// Purge legacy hand-authored boxy detail before canonical generation.\nfor(const m of modules.values()){\n  const d=m.userData?.layers?.detail;\n  if(d)while(d.children.length)d.remove(d.children[0]);\n}\n\n// V1.14 STYLE-GUIDE GREEBLING\n// Uniform manufactured panel language: bands, grids, embedded bits, pipe bundles.\n// Every placement is surface-derived and rejected inside connector exclusion zones.\nfunction mulberry32(seed){return function(){let t=seed+=0x6D2B79F5;t=Math.imul(t^t\u003e\u003e\u003e15,t|1);t^=t+Math.imul(t^t\u003e\u003e\u003e7,t|61);return((t^t\u003e\u003e\u003e14)\u003e\u003e\u003e0)/4294967296}}\nfunction hashSeed(str){let h=2166136261;for(let i=0;i\u003cstr.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619)}return h\u003e\u003e\u003e0}\nfunction clearGeneratedDetail(mod){const d=mod.userData.layers.detail;for(const o of [...d.children])if(o.userData.generatedGreeble)d.remove(o)}\nfunction markGenerated(o){o.userData.generatedGreeble=true;return o}\nfunction connectionExclusions(mod){\n  const out=[];\n  const c=mod.userData.connection;\n  if(c){const L=c.length||0;if(c.axis==='x')out.push(new THREE.Vector3(-L/2,0,0),new THREE.Vector3(L/2,0,0));\n    else if(c.axis==='y')out.push(new THREE.Vector3(0,-L/2,0),new THREE.Vector3(0,L/2,0));\n    else out.push(new THREE.Vector3(0,0,-L/2),new THREE.Vector3(0,0,L/2));}\n  // Explicit semantic ports that are children of the module itself.\n  mod.traverse(o=\u003e{if(o.userData?.type==='attachment-node')out.push(o.getWorldPosition(new THREE.Vector3()).applyMatrix4(mod.matrixWorld.clone().invert()))});\n  return out;\n}\nfunction portClear(mod,p,r=.62){return !connectionExclusions(mod).some(q=\u003eq.distanceTo(p)\u003cr)}\nfunction surfaceBox(root,p,n,w,h,d,mat,name){\n  const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);o.position.copy(p);\n  o.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1),n.clone().normalize());\n  o.name=name;markGenerated(o);root.add(o);return o;\n}\nfunction surfacePipe(root,a,b,r,mat,name){const o=beam(root,a.toArray(),b.toArray(),r,mat,name);markGenerated(o);return o}\nfunction drumP(radius,a,y,lift=0){return new THREE.Vector3(Math.cos(a)*(radius+lift),y,Math.sin(a)*(radius+lift))}\nfunction drumN(a){return new THREE.Vector3(Math.cos(a),0,Math.sin(a))}\nfunction arcPipe(root,radius,y,a0,a1,t,mat,name){\n  const curve=new THREE.Curve();curve.getPoint=u=\u003edrumP(radius,a0+(a1-a0)*u,y,.028);\n  const o=new THREE.Mesh(new THREE.TubeGeometry(curve,Math.max(8,Math.ceil(Math.abs(a1-a0)*18)),t,6,false),mat);\n  o.name=name;markGenerated(o);root.add(o);return o;\n}\nfunction curvedPanel(root,radius,a,y,arc,h,depth,mat,name){\n  const segs=Math.max(3,Math.ceil(arc/.055));\n  for(let i=0;i\u003csegs;i++){const q=a-arc/2+arc*(i+.5)/segs,n=drumN(q),p=drumP(radius,q,y,depth/2);\n    surfaceBox(root,p,n,radius*arc/segs*1.05,h,depth,mat,name)}\n}\nfunction drumPortClear(mod,radius,a,y,r=.70){return portClear(mod,drumP(radius,a,y),r)}\nfunction generateDrumField(mod,radius,height,seed){\n  clearGeneratedDetail(mod);const root=mod.userData.layers.detail,rng=mulberry32(seed),m=[M.greyA,M.greyB,M.greyC];\n  // 1) broad, orderly panel bands. Quiet gaps between them are intentional.\n  const rows=5;\n  for(let row=0;row\u003crows;row++){\n    const y=-height*.34+row*(height*.68/(rows-1));\n    const cols=12;\n    for(let col=0;col\u003ccols;col++){\n      if((col+row*2)%5===0)continue; // manufactured rhythm, not total coverage\n      const a=col*Math.PI*2/cols + (row%2)*.025;\n      if(!drumPortClear(mod,radius,a,y,.72))continue;\n      curvedPanel(root,radius,a,y,.22,.075,.018,m[(row+col)%3],'skin-panel');\n      // embedded 3/4/5 bit array inside selected panels\n      if((col+row)%3===0){\n        const count=3+((col+row)%3),step=.032;\n        for(let k=0;k\u003ccount;k++){const yy=y+(k-(count-1)/2)*step,n=drumN(a),pp=drumP(radius,a,yy,.028);\n          surfaceBox(root,pp,n,.026,.018,.014,M.greyC,'embedded-bit')}\n      }\n    }\n  }\n  // 2) coherent circumferential pipe bundles, 3 parallel thin runs.\n  for(const y0 of [-height*.22,height*.18]){\n    for(let k=-1;k\u003c=1;k++){\n      const y=y0+k*.035,a0=.38,a1=2.15;\n      const mid=(a0+a1)/2;if(drumPortClear(mod,radius,mid,y,.78))arcPipe(root,radius,y,a0,a1,.011,M.greyB,'pipe-bundle');\n    }\n  }\n  // 3) sparse vent/panel features aligned to grid.\n  for(let i=0;i\u003c8;i++){\n    const a=(i+.5)*Math.PI/4,y=((i%3)-1)*height*.20;\n    if(!drumPortClear(mod,radius,a,y,.72))continue;\n    curvedPanel(root,radius,a,y,.16,.15,.022,M.greyC,'service-panel');\n  }\n  root.userData.generator='style-guide-uniform';root.userData.seed=seed;tagModule(mod);\n}\nfunction armFrame(axis){return axis==='x'?{along:new THREE.Vector3(1,0,0),faces:[new THREE.Vector3(0,1,0),new THREE.Vector3(0,-1,0),new THREE.Vector3(0,0,1),new THREE.Vector3(0,0,-1)]}:\n  axis==='y'?{along:new THREE.Vector3(0,1,0),faces:[new THREE.Vector3(1,0,0),new THREE.Vector3(-1,0,0),new THREE.Vector3(0,0,1),new THREE.Vector3(0,0,-1)]}:\n  {along:new THREE.Vector3(0,0,1),faces:[new THREE.Vector3(1,0,0),new THREE.Vector3(-1,0,0),new THREE.Vector3(0,1,0),new THREE.Vector3(0,-1,0)]}}\nfunction armPoint(axis,along,n,radius,cross=0){\n  const p=n.clone().multiplyScalar(radius+.022),t=new THREE.Vector3();\n  if(axis==='x'){p.x=along;t.set(0,-n.z,n.y)}else if(axis==='y'){p.y=along;t.set(-n.z,0,n.x)}else{p.z=along;t.set(-n.y,n.x,0)}\n  return p.addScaledVector(t,cross);\n}\nfunction generateArmField(mod,axis,length,radius,seed){\n  clearGeneratedDetail(mod);const root=mod.userData.layers.detail,rng=mulberry32(seed),m=[M.greyA,M.greyB,M.greyC],half=length/2,{faces}=armFrame(axis);\n  const safeHalf=Math.max(.05,half-.62);\n  // 1) regular axial panel columns on all four surface lanes.\n  const stations=Math.max(3,Math.floor(length/.38));\n  for(let fi=0;fi\u003cfaces.length;fi++){\n    const n=faces[fi];\n    for(let j=0;j\u003cstations;j++){\n      const along=-safeHalf+(stations===1?0:j*(2*safeHalf/(stations-1)));\n      if(Math.abs(along)\u003ehalf-.58)continue;\n      const p=armPoint(axis,along,n,radius);\n      if(!portClear(mod,p,.58))continue;\n      surfaceBox(root,p.clone().addScaledVector(n,.012),n,.18,.11,.018,m[(fi+j)%3],'skin-panel');\n      // embedded uniform ||||| / ===== arrays\n      if((j+fi)%2===0){\n        const count=3+((j+fi)%3);\n        for(let k=0;k\u003ccount;k++){\n          const q=armPoint(axis,along+(k-(count-1)/2)*.035,n,radius+.018,.035);\n          if(portClear(mod,q,.58))surfaceBox(root,q,n,.018,.032,.012,M.greyC,'embedded-bit');\n        }\n      }\n    }\n  }\n  // 2) coherent longitudinal pipe bundles: three parallel rails on selected faces.\n  for(const fi of [0,2]){\n    const n=faces[fi],start=-safeHalf,end=safeHalf;\n    for(let k=-1;k\u003c=1;k++){\n      const a=armPoint(axis,start,n,radius+.035,k*.035),b=armPoint(axis,end,n,radius+.035,k*.035);\n      if(portClear(mod,a,.60)\u0026\u0026portClear(mod,b,.60))surfacePipe(root,a,b,.0105,M.greyB,'pipe-bundle');\n    }\n  }\n  root.userData.generator='style-guide-uniform';root.userData.seed=seed;tagModule(mod);\n}\nfunction generateCleanAll(){for(const m of modules.values())clearGeneratedDetail(m)}\nfunction greebleAll(){\n  generateDrumField(hub,1.55,1.35,hashSeed('habitat-drum-a'));\n  generateDrumField(small,.92,1,hashSeed('habitat-drum-b'));\n  const specs=[[trunk,'y',6.8,.58],[modules.get('habitat-arm-east'),'x',eastLength,.5],[modules.get('habitat-arm-west'),'x',westLength,.47],\n    [modules.get('habitat-arm-forward'),'z',4,.47],[modules.get('habitat-arm-east-upper'),'x',4.5,.47],\n    [modules.get('habitat-arm-branch-east-vertical'),'y',branchTop[1]-branchBottom[1],.47],[modules.get('habitat-arm-branch-east-link'),'x',1.445-branchX,.47]];\n  for(const [mod,a,L,r] of specs)if(mod)generateArmField(mod,a,L,r,hashSeed(mod.name));\n}\n// Canonical Detail population. DETAIL ON/OFF is now the only visibility control.\ngenerateCleanAll();\ngreebleAll();\n\n// End caps participate in canonical Detail with a deliberately quiet termination face.\nfunction detailEndCap(mod,radius,seed){\n  const root=mod.userData.layers.detail;\n  // Detail is authored in the same canonical +Z frame as the cap itself.\n  // Module orientation carries it outward automatically.\n  const n=new THREE.Vector3(0,0,1),tangent=new THREE.Vector3(0,1,0),bitangent=new THREE.Vector3(1,0,0);\n  const face=n.clone().multiplyScalar(.165);\n  for(let i=0;i\u003c5;i++){\n    const p=face.clone().addScaledVector(tangent,(i-2)*.045).addScaledVector(bitangent,radius*.30);\n    surfaceBox(root,p,n,.022,.075,.012,M.greyC,'endcap-service-slot');\n  }\n  root.userData.generator='style-guide-end-cap';root.userData.seed=seed;tagModule(mod);\n}\ndetailEndCap(endCapForward.root,.46,hashSeed('end-cap-forward'));\ndetailEndCap(endCapEastUpper.root,.46,hashSeed('end-cap-east-upper'));\ndetailEndCap(endCapTrunkTop.root,.58,hashSeed('end-cap-trunk-top'));\ndetailEndCap(endCapTrunkBottom.root,.58,hashSeed('end-cap-trunk-bottom'));\n\n// Global DETAIL remains an aggregate operation over locally-owned Detail only.\n// Orange Frame is intentionally a distinct structural-detail level.\n// stars\nconst pts=[];for(let i=0;i\u003c900;i++){const v=new THREE.Vector3().randomDirection().multiplyScalar(80+Math.random()*300);pts.push(v.x,v.y,v.z)}\nconst sg=new THREE.BufferGeometry();sg.setAttribute('position',new THREE.Float32BufferAttribute(pts,3));\nscene.add(new THREE.Points(sg,new THREE.PointsMaterial({color:0xc6d0da,size:.2,transparent:true,opacity:.78})));\n\nscene.add(new THREE.HemisphereLight(0x74839a,0x060708,.4));\nconst sun=new THREE.DirectionalLight(0xfff2da,4);sun.position.set(7,9,11);scene.add(sun);\nconst rim=new THREE.DirectionalLight(0x718bb8,.55);rim.position.set(-7,-3,-8);scene.add(rim);\n\n// touch orbit + pinch\nconst target=new THREE.Vector3();let radius=14.2,theta=.68,phi=1.18;const init=[radius,theta,phi];\nfunction cam(){window.orbitalDirty=true;phi=Math.max(.1,Math.min(Math.PI-.1,phi));radius=Math.max(1.85,Math.min(260,radius));camera.position.set(target.x+radius*Math.sin(phi)*Math.sin(theta),target.y+radius*Math.cos(phi),target.z+radius*Math.sin(phi)*Math.cos(theta));camera.lookAt(target)}\ncam();\nconst touches=new Map();let pinch=null,c=renderer.domElement;\nlet viewMode='exterior';\nconst interiorEye=new THREE.Vector3(0,1.88,2.45);\nconst interiorForward=new THREE.Vector3(0,0,-1);\nconst INTERIOR_DOLLY_MAX=2.75;\nconst INTERIOR_DOLLY_HOME=INTERIOR_DOLLY_MAX*.5;\nlet interiorYaw=0, interiorPitch=-0.095, interiorDolly=INTERIOR_DOLLY_HOME;\nfunction interiorCam(){\n  interiorPitch=Math.max(-1.35,Math.min(1.35,interiorPitch));\n  // Dolly is constrained to the room's canonical fore/aft axis.\n  // 0 is the original eye point and is the hard forward limit.\n  camera.position.copy(interiorEye).addScaledVector(interiorForward,-interiorDolly);\n  const cp=Math.cos(interiorPitch);\n  const dir=new THREE.Vector3(\n    Math.sin(interiorYaw)*cp,\n    Math.sin(interiorPitch),\n    -Math.cos(interiorYaw)*cp\n  );\n  camera.lookAt(interiorEye.clone().add(dir));\n}\n\nconst raycaster=new THREE.Raycaster(), pointer=new THREE.Vector2();\nconst interiorInteractives=[];\nfunction interiorInteractAt(x,y){\n  pointer.x=(x/innerWidth)*2-1;pointer.y=-(y/innerHeight)*2+1;\n  raycaster.setFromCamera(pointer,camera);\n  const hits=raycaster.intersectObjects(interiorInteractives,true);\n  const hit=hits.find(h=\u003etypeof h.object.userData.onActivate==='function');\n  if(hit){hit.object.userData.onActivate();return true}\n  return false;\n}\nlet downPoint=null, selected=null;\nconst label=document.getElementById('selection');\nfunction selectAt(x,y){\n  pointer.x=(x/innerWidth)*2-1;pointer.y=-(y/innerHeight)*2+1;\n  raycaster.setFromCamera(pointer,camera);\n  const visible=o=\u003e{for(let p=o;p;p=p.parent)if(!p.visible)return false;return true};\n  const hits=raycaster.intersectObjects([...modules.values()].filter(visible),true).filter(h=\u003evisible(h.object));\n  const hit=hits.find(h=\u003eh.object.userData.selectableModule);\n  selected=hit?modules.get(hit.object.userData.selectableModule):null;\n  if(selected){label.textContent=selected.name;label.classList.add('show')}\n  else {label.classList.remove('show')}\n}\n\nlet interiorPinchStart=null, interiorDollyStart=INTERIOR_DOLLY_HOME;\nc.addEventListener('pointerdown',e=\u003e{\n  c.setPointerCapture(e.pointerId);touches.set(e.pointerId,{x:e.clientX,y:e.clientY});\n  if(touches.size===1)downPoint={x:e.clientX,y:e.clientY,id:e.pointerId};\n  if(viewMode==='interior'\u0026\u0026touches.size===2){\n    const a=[...touches.values()];\n    interiorPinchStart=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);\n    interiorDollyStart=interiorDolly;\n  }\n});\nc.addEventListener('pointermove',e=\u003e{\n if(!touches.has(e.pointerId))return;\n let old=touches.get(e.pointerId);touches.set(e.pointerId,{x:e.clientX,y:e.clientY});let a=[...touches.values()];\n if(viewMode==='interior'){\n   // Situated look: one finger changes gaze. Two-finger pinch is a bounded\n   // fore/aft camera dolly. It may retreat from the canonical eye point,\n   // then return to it, but can never advance beyond it.\n   if(a.length===1){\n     interiorYaw-=(e.clientX-old.x)*.0045;\n     interiorPitch-=(e.clientY-old.y)*.0045;\n     interiorCam();\n   } else if(a.length===2){\n     const d=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);\n     if(!interiorPinchStart){interiorPinchStart=d;interiorDollyStart=interiorDolly}\n     // One ordinary pinch gesture has enough gain to traverse the entire track\n     // from any starting position. Spread fingers = move forward; pinch inward = retreat.\n     const delta=(d-interiorPinchStart)/Math.max(1,interiorPinchStart);\n     interiorDolly=THREE.MathUtils.clamp(interiorDollyStart-delta*INTERIOR_DOLLY_MAX*2.15,0,INTERIOR_DOLLY_MAX);\n     interiorCam();\n   }\n   return;\n }\n if(a.length===1){if(e.shiftKey||e.buttons===2){const scale=radius*.8/innerHeight;target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,0),-(e.clientX-old.x)*scale);target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,1),(e.clientY-old.y)*scale)}else{theta-=(e.clientX-old.x)*.006;phi-=(e.clientY-old.y)*.006}cam()}\n else if(a.length===2){let d=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);if(pinch\u0026\u0026d\u003e0)radius*=pinch/d;pinch=d;const scale=radius*.4/innerHeight;target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,0),-(e.clientX-old.x)*scale);target.addScaledVector(new THREE.Vector3().setFromMatrixColumn(camera.matrixWorld,1),(e.clientY-old.y)*scale);cam()}\n});\nfunction end(e){\n const isTap=e.type==='pointerup'\u0026\u0026downPoint\u0026\u0026downPoint.id===e.pointerId\u0026\u0026Math.hypot(e.clientX-downPoint.x,e.clientY-downPoint.y)\u003c8\u0026\u0026touches.size===1;\n if(viewMode==='exterior'\u0026\u0026isTap)selectAt(e.clientX,e.clientY);\n if(viewMode==='interior'\u0026\u0026isTap)interiorInteractAt(e.clientX,e.clientY);\n touches.delete(e.pointerId);if(touches.size\u003c2){pinch=null;interiorPinchStart=null}downPoint=null\n}\nc.addEventListener('contextmenu',e=\u003ee.preventDefault());c.addEventListener('lostpointercapture',e=\u003e{touches.delete(e.pointerId);pinch=null;downPoint=null});c.addEventListener('pointerup',end);c.addEventListener('pointercancel',end);\nc.addEventListener('wheel',e=\u003e{e.preventDefault();if(viewMode==='exterior'){radius*=Math.exp(e.deltaY*.001);cam()}},{passive:false});\ndocument.getElementById('reset').onclick=()=\u003e{\n if(viewMode==='interior'){interiorYaw=0;interiorPitch=-0.014;interiorDolly=INTERIOR_DOLLY_HOME;interiorCam()}\n else {[radius,theta,phi]=init;cam()}\n};\naddEventListener('resize',()=\u003e{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,1.5))});\n\n// V1.21 HUMAN-SCALE INTERIOR PROBE\n// Room 001 is semantically contained by Habitat Drum A, but its metric placement\n// within that module is intentionally unresolved. Containment does not imply coordinates.\n// Exterior orbit is observer motion, not a physical StationRoot rotation.\n//\n// The room is deliberately structural: shell, floor, ceiling, one door, one work surface,\n// one large exterior window. No decorative clutter, texture pass, or interior greeble pass.\nconst interiorRoot=new THREE.Group();\ninteriorRoot.name='interior.room-001';\ninteriorRoot.userData={\n  semanticId:'room-001',\n  type:'interior-room',\n  containedBy:'habitat-drum-a',\n  metricPlacement:'unresolved',\n  frame:'station-local',\n  window:{faces:'exterior',exactPosition:'unresolved'}\n};\nscene.add(interiorRoot);\ninteriorRoot.visible=false;\n\n\n// Human-scale procedural skins: surface information only, never geometry/detail.\nfunction makeInteriorCanvasTexture(kind,seed=1){\n  const size=512,cv=document.createElement('canvas');cv.width=cv.height=size;\n  const ctx=cv.getContext('2d'),r=mulberry32(seed);\n  const palettes={shell:'#c7c4b8',floor:'#777970',table:'#8b8776'};\n  ctx.fillStyle=palettes[kind];ctx.fillRect(0,0,size,size);\n\n  for(let i=0;i\u003c1400;i++){\n    const v=r()\u003e.5?255:0,a=.005+r()*.009,q=1+r()*3;\n    ctx.fillStyle=`rgba(${v},${v},${v},${a})`;\n    ctx.fillRect(r()*size,r()*size,q,q);\n  }\n  ctx.lineWidth=1;\n  function rivet(x,y,a=.30){\n    ctx.beginPath();ctx.arc(x,y,1.55,0,Math.PI*2);\n    ctx.fillStyle=`rgba(42,44,42,${a})`;ctx.fill();\n    ctx.beginPath();ctx.arc(x-.45,y-.45,.55,0,Math.PI*2);\n    ctx.fillStyle='rgba(245,242,225,.22)';ctx.fill();\n  }\n  if(kind==='shell'){\n    ctx.strokeStyle='rgba(48,51,49,.21)';\n    for(const x of [0,256,512]){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,512);ctx.stroke()}\n    for(const y of [0,256,512]){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(512,y);ctx.stroke()}\n    ctx.strokeStyle='rgba(255,255,245,.12)';\n    ctx.beginPath();ctx.moveTo(0,258);ctx.lineTo(512,258);ctx.stroke();\n    // Fasteners live beside major panel seams, not scattered across the skin.\n    for(const x of [8,248,264,504])for(let y=20;y\u003c512;y+=54)rivet(x,y,.25);\n    for(const y of [8,248,264,504])for(let x=28;x\u003c512;x+=72)rivet(x,y,.22);\n  }else if(kind==='floor'){\n    ctx.strokeStyle='rgba(26,29,27,.27)';\n    for(const y of [0,170,340,512]){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(512,y);ctx.stroke()}\n    for(let row=0;row\u003c3;row++){\n      const off=row%2?128:0;\n      for(let x=off;x\u003c512;x+=256){\n        ctx.beginPath();ctx.moveTo(x,row*170);ctx.lineTo(x,Math.min(512,(row+1)*170));ctx.stroke();\n      }\n    }\n    // Sparse plate fasteners follow the broad floor joints.\n    for(const y of [4,170,340,508])for(let x=32;x\u003c512;x+=96)rivet(x,y,.27);\n    const g=ctx.createLinearGradient(0,0,512,0);\n    g.addColorStop(0,'rgba(255,255,255,0)');\n    g.addColorStop(.5,'rgba(220,215,195,.075)');\n    g.addColorStop(1,'rgba(255,255,255,0)');\n    ctx.fillStyle=g;ctx.fillRect(0,0,512,512);\n  }else{\n    ctx.strokeStyle='rgba(45,45,40,.14)';\n    for(let y=0;y\u003c=512;y+=128){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(512,y);ctx.stroke()}\n    for(let i=0;i\u003c80;i++){\n      const x=r()*512,y=r()*512,l=3+r()*10;\n      ctx.strokeStyle=`rgba(45,43,38,${.012+r()*.022})`;\n      ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+l,y+(r()-.5));ctx.stroke();\n    }\n  }\n  const tex=new THREE.CanvasTexture(cv);\n  tex.wrapS=tex.wrapT=THREE.RepeatWrapping;\n  tex.colorSpace=THREE.SRGBColorSpace;\n  tex.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy());\n  return tex;\n}\nconst interiorShellTex=makeInteriorCanvasTexture('shell',7101);\nconst interiorFloorTex=makeInteriorCanvasTexture('floor',7102);\nconst interiorTableTex=makeInteriorCanvasTexture('table',7103);\ninteriorShellTex.repeat.set(2.6,2.6);\ninteriorFloorTex.repeat.set(3.0,4.0);\ninteriorTableTex.repeat.set(2.2,1.2);\n\nconst IM={\n  shell:new THREE.MeshStandardMaterial({color:0xffffff,map:interiorShellTex,roughness:.82,metalness:.10}),\n  frame:new THREE.MeshStandardMaterial({color:0x4b4f50,roughness:.62,metalness:.42}),\n  floor:new THREE.MeshStandardMaterial({color:0xffffff,map:interiorFloorTex,roughness:.88,metalness:.12}),\n  table:new THREE.MeshStandardMaterial({color:0xffffff,map:interiorTableTex,roughness:.76,metalness:.20}),\n  glass:new THREE.MeshPhysicalMaterial({color:0x9fb3c2,transparent:true,opacity:.12,roughness:.08,metalness:0,side:THREE.DoubleSide})\n};\nwindow.__room001Materials={\n  shell:IM.shell,floor:IM.floor,table:IM.table,\n  textures:{shell:interiorShellTex,floor:interiorFloorTex,table:interiorTableTex}\n};\nfunction roomBox(name,pos,size,mat=IM.shell){\n  const o=new THREE.Mesh(new THREE.BoxGeometry(...size),mat);o.name=name;o.position.set(...pos);interiorRoot.add(o);return o;\n}\n// Human-scale envelope, intentionally not mapped to exterior dimensions.\nroomBox('room-001.floor',[0,0,1.56],[7.6,.14,9.52],IM.floor);\nroomBox('room-001.ceiling',[0,3.25,1.56],[7.6,.14,9.52],IM.shell);\nroomBox('room-001.left-wall',[-3.73,1.62,1.56],[.14,3.25,9.52],IM.shell);\nroomBox('room-001.right-wall',[3.73,1.62,1.56],[.14,3.25,9.52],IM.shell);\nroomBox('room-001.rear-wall',[0,1.62,6.25],[7.6,3.25,.14],IM.shell);\n\n// Window wall: one continuous structural plane with a shaped pressure opening.\n// Wall, glass, and frame all derive from the same octagonal aperture path.\nconst wx=2.91, wy=.975, wc=.36;\nconst windowOctPts=[\n [-wx+wc,-wy],[wx-wc,-wy],[wx,-wy+wc],[wx,wy-wc],\n [wx-wc,wy],[-wx+wc,wy],[-wx,wy-wc],[-wx,-wy+wc]\n];\n\nfunction octPath(points){\n  const p=new THREE.Path();\n  p.moveTo(points[0][0],points[0][1]);\n  for(let i=1;i\u003cpoints.length;i++)p.lineTo(points[i][0],points[i][1]);\n  p.closePath();\n  return p;\n}\n\n// Full front-wall silhouette with the viewport cut from it as a real hole.\nconst frontWallShape=new THREE.Shape();\nfrontWallShape.moveTo(-3.8,-1.625);\nfrontWallShape.lineTo( 3.8,-1.625);\nfrontWallShape.lineTo( 3.8, 1.625);\nfrontWallShape.lineTo(-3.8, 1.625);\nfrontWallShape.closePath();\nfrontWallShape.holes.push(octPath(windowOctPts));\n\nconst frontWall=new THREE.Mesh(new THREE.ShapeGeometry(frontWallShape),IM.shell);\nfrontWall.name='room-001.window-wall';\nfrontWall.position.set(0,1.625,-3.13);\ninteriorRoot.add(frontWall);\n\n// Glass is the exact same aperture silhouette, slightly exterior of the wall.\nconst windowShape=new THREE.Shape();\nwindowShape.moveTo(windowOctPts[0][0],windowOctPts[0][1]);\nfor(let i=1;i\u003cwindowOctPts.length;i++)windowShape.lineTo(windowOctPts[i][0],windowOctPts[i][1]);\nwindowShape.closePath();\nconst glass=new THREE.Mesh(new THREE.ShapeGeometry(windowShape),IM.glass);\nglass.name='room-001.window-glass';\nglass.position.set(0,1.65,-3.08);\ninteriorRoot.add(glass);\n\n// Structural frame is one continuous extruded ring derived from the same\n// canonical aperture. No intersecting beam ends, so no pokey corner overlaps.\n// True polygon offset: intersect adjacent edge-parallel lines so the ring\n// keeps constant perpendicular thickness through straight and chamfered edges.\nfunction offsetConvexPolygon(points,d){\n  const out=[];\n  for(let i=0;i\u003cpoints.length;i++){\n    const p0=points[(i-1+points.length)%points.length],p1=points[i],p2=points[(i+1)%points.length];\n    const e1=[p1[0]-p0[0],p1[1]-p0[1]],e2=[p2[0]-p1[0],p2[1]-p1[1]];\n    const l1=Math.hypot(...e1),l2=Math.hypot(...e2);\n    // CCW polygon: outward normal is the right-hand normal.\n    const n1=[e1[1]/l1,-e1[0]/l1],n2=[e2[1]/l2,-e2[0]/l2];\n    const a=[p1[0]+n1[0]*d,p1[1]+n1[1]*d];\n    const b=[p1[0]+n2[0]*d,p1[1]+n2[1]*d];\n    const det=e1[0]*e2[1]-e1[1]*e2[0];\n    const q=[b[0]-a[0],b[1]-a[1]];\n    const t=(q[0]*e2[1]-q[1]*e2[0])/det;\n    out.push([a[0]+e1[0]*t,a[1]+e1[1]*t]);\n  }\n  return out;\n}\nconst frameOuterPts=offsetConvexPolygon(windowOctPts,.14);\nconst frameShape=new THREE.Shape();\nframeShape.moveTo(frameOuterPts[0][0],frameOuterPts[0][1]);\nfor(let i=1;i\u003cframeOuterPts.length;i++)frameShape.lineTo(frameOuterPts[i][0],frameOuterPts[i][1]);\nframeShape.closePath();\nframeShape.holes.push(octPath(windowOctPts));\n\nconst frameGeo=new THREE.ExtrudeGeometry(frameShape,{\n  depth:.16,\n  bevelEnabled:false,\n  curveSegments:1,\n  steps:1\n});\nframeGeo.translate(0,0,-.08);\nconst windowFrame=new THREE.Mesh(frameGeo,IM.frame);\nwindowFrame.name='room-001.window-frame';\nwindowFrame.position.set(0,1.65,-3.00);\ninteriorRoot.add(windowFrame);\n\n// Door on rear wall: closed structural placeholder into unresolved larger interior.\nroomBox('room-001.door',[2.15,1.15,6.14],[1.15,2.30,.12],IM.frame);\nroomBox('room-001.door-header',[2.15,2.48,6.12],[1.45,.18,.20],IM.shell);\n\n// Work surface only: tangible-material staging affordance for a later experiment.\nroomBox('room-001.workbench',[0,1.02,-.15],[3.9,.14,1.35],IM.table);\nfor(const x of [-1.66,1.66])for(const z of [-.45,.45])\n  roomBox('room-001.workbench-leg',[x,.51,z],[.12,1.02,.12],IM.frame);\n\n// -----------------------------------------------------------------------------\n// ROOM 001 CONTENTS \u2014 PALLET LANDER 001 / FLIGHT SUBSTRATE\n// Intentionally crude. The root is the contract; finished lander geometry comes later.\n// Workbench top is y=1.09. Root origin is the current landing plane.\nconst roomContents=new THREE.Group();\nroomContents.name='room-001.contents';\ninteriorRoot.add(roomContents);\n\nconst palletLander=new THREE.Group();\npalletLander.name='pallet-lander-001';\npalletLander.position.set(-.82,1.09,-.15);\npalletLander.scale.setScalar(.75);\npalletLander.userData={\n  semanticId:'pallet-lander-001',\n  semanticType:'tabletop-toy',\n  sceneAnchor:'room-001.workbench.left',\n  anchorStatus:'convenient-unresolved',\n  flightArchitecture:'all vehicle motion belongs to this root',\n  state:'LANDED'\n};\nroomContents.add(palletLander);\n\nconst landerMat=new THREE.MeshStandardMaterial({color:0x8b9194,roughness:.55,metalness:.58});\nconst landerDark=new THREE.MeshStandardMaterial({color:0x343a3d,roughness:.48,metalness:.72});\nconst landerFootMat=new THREE.MeshStandardMaterial({color:0x555b5d,roughness:.68,metalness:.45});\nconst buttonIdle=new THREE.Color(0x7f2d24),buttonLive=new THREE.Color(0xe0714e);\nconst buttonMat=new THREE.MeshStandardMaterial({color:buttonIdle,emissive:0x180403,emissiveIntensity:.25,roughness:.42,metalness:.35});\nconst plumeMat=new THREE.MeshBasicMaterial({color:0x9fdcff,transparent:true,opacity:.58,depthWrite:false,side:THREE.DoubleSide});\nconst pulseMat=new THREE.MeshBasicMaterial({color:0xb8e8ff,transparent:true,opacity:.0,depthWrite:false,side:THREE.DoubleSide});\n\nfunction landerBox(name,size,pos,mat=landerMat,parent=palletLander){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(...size),mat);\n  m.name=name;m.position.set(...pos);parent.add(m);return m;\n}\nfunction landerCyl(name,rTop,rBottom,h,pos,mat=landerDark,parent=palletLander,radial=16){\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(rTop,rBottom,h,radial),mat);\n  m.name=name;m.position.set(...pos);parent.add(m);return m;\n}\n\n// Placeholder chassis: deliberately simple enough that flight behavior stays legible.\nconst chassis=new THREE.Group();chassis.name='pallet-lander-001.chassis';palletLander.add(chassis);\nlanderBox('pallet-lander-001.chassis.body',[1.55,.22,.78],[0,.31,0],landerMat,chassis);\nlanderBox('pallet-lander-001.chassis.deck',[1.38,.055,.64],[0,.447,0],IM.frame,chassis);\n\n// Cargo remains permanently on the pallet deck. It is payload, not a moving stage.\n// Cargo is deliberately heterogeneous and individually addressable.\nconst cargoGroup=new THREE.Group();\ncargoGroup.name='pallet-lander-001.cargo';\ncargoGroup.userData={semanticType:'cargo-collection',ownedBy:'pallet-lander-001'};\npalletLander.add(cargoGroup);\n\n// First material shipment from the existing Time Machine notebook/catalog.\n// Primitive geometry stays primitive; material identity lives in surface + provenance.\nfunction makeCargoTexture(kind){\n  const c=document.createElement('canvas');c.width=c.height=256;\n  const x=c.getContext('2d');\n  let seed=kind.length*7919;\n  const rand=()=\u003e((seed=Math.imul(seed,1664525)+1013904223\u003e\u003e\u003e0)/4294967296);\n  const base={brass:'#a9782b',nickel:'#8b9190',granite:'#77736d',marble:'#dedbd0',malachite:'#176b58',wood:'#795234'}[kind];\n  x.fillStyle=base;x.fillRect(0,0,256,256);\n  if(kind==='brass'||kind==='nickel'){\n    for(let i=0;i\u003c110;i++){x.strokeStyle=kind==='brass'?`rgba(255,225,145,${.02+rand()*.07})`:`rgba(240,248,246,${.02+rand()*.06})`;x.beginPath();let y=rand()*256;x.moveTo(0,y);x.lineTo(256,y+rand()*3-1.5);x.stroke()}\n  }else if(kind==='granite'){\n    for(let i=0;i\u003c950;i++){let v=rand();x.fillStyle=v\u003e.72?'rgba(230,222,207,.22)':v\u003c.18?'rgba(22,24,24,.27)':'rgba(130,119,108,.18)';let r=1+rand()*4;x.fillRect(rand()*256,rand()*256,r,r)}\n  }else if(kind==='marble'){\n    for(let j=0;j\u003c8;j++){x.strokeStyle=`rgba(85,100,100,${.08+rand()*.12})`;x.lineWidth=1+rand()*2;x.beginPath();let y=rand()*256;x.moveTo(-20,y);for(let xx=0;xx\u003c=280;xx+=20){y+=rand()*18-9;x.lineTo(xx,y)}x.stroke()}\n  }else if(kind==='malachite'){\n    for(let j=0;j\u003c20;j++){x.strokeStyle=`rgba(${25+rand()*35},${105+rand()*65},${78+rand()*45},.5)`;x.lineWidth=4+rand()*10;x.beginPath();let y=j*14+rand()*8;x.moveTo(0,y);for(let xx=0;xx\u003c=256;xx+=24)x.lineTo(xx,y+Math.sin(xx*.035+j)*8);x.stroke()}\n  }else if(kind==='wood'){\n    for(let j=0;j\u003c50;j++){x.strokeStyle=`rgba(52,30,17,${.07+rand()*.14})`;x.lineWidth=1+rand()*2;x.beginPath();let y=rand()*256;x.moveTo(0,y);for(let xx=0;xx\u003c=256;xx+=16)x.lineTo(xx,y+Math.sin(xx*.05+j)*2);x.stroke()}\n  }\n  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(2,2);return t;\n}\nfunction cargoMaterial(kind,metalness,roughness){return new THREE.MeshStandardMaterial({map:makeCargoTexture(kind),metalness,roughness});}\nconst cargoMats=[\n  cargoMaterial('brass',.72,.31),cargoMaterial('nickel',.76,.27),\n  cargoMaterial('granite',.03,.86),cargoMaterial('marble',.02,.67),\n  cargoMaterial('malachite',.08,.58),cargoMaterial('wood',0,.82)\n];\nconst cargoMaterialNames=['brass','nickel','granite','white-marble','malachite','wood'];\nlet cargoSerial=0;\nfunction cargoRoot(kind,label,pos,rotY=0,matIndex=0){\n  const g=new THREE.Group();\n  const id=`pallet-lander-001.cargo-${String(++cargoSerial).padStart(2,'0')}`;\n  const material=cargoMaterialNames[matIndex%cargoMaterialNames.length];\n  g.name=id;g.position.set(...pos);g.rotation.y=rotY;\n  g.userData={semanticId:id,semanticType:'cargo-object',cargoKind:kind,label,materialIdentity:material,\n    provenance:{work:'The Time Machine',scope:'Chapters I\u2013VII material notebook',catalog:'Materials So Far',material}};\n  cargoGroup.add(g);return g;\n}\nfunction cargoBox(kind,label,pos,size,matIndex=0,rotY=0){\n  const g=cargoRoot(kind,label,pos,rotY,matIndex);\n  const m=new THREE.Mesh(new THREE.BoxGeometry(...size),cargoMats[matIndex%cargoMats.length]);\n  m.name=`${g.name}.body`;m.position.y=size[1]/2;g.add(m);return g;\n}\nfunction cargoCylinder(kind,label,pos,r,h,matIndex=1,rot=[0,0,0]){\n  const g=cargoRoot(kind,label,pos,0,matIndex);\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,14),cargoMats[matIndex%cargoMats.length]);\n  m.name=`${g.name}.body`;m.position.y=h/2;m.rotation.set(...rot);g.add(m);return g;\n}\nfunction cargoDomed(label,pos,r,h,matIndex=3){\n  const g=cargoRoot('domed-cylinder',label,pos,0,matIndex);\n  const body=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,14),cargoMats[matIndex%cargoMats.length]);\n  body.name=`${g.name}.body`;body.position.y=h/2;g.add(body);\n  const dome=new THREE.Mesh(new THREE.SphereGeometry(r,14,8,0,Math.PI*2,0,Math.PI/2),cargoMats[matIndex%cargoMats.length]);\n  dome.name=`${g.name}.dome`;dome.position.y=h;g.add(dome);return g;\n}\n\n// Deck top is local y\u2248.475. Cargo roots sit there and own all of their geometry.\nconst cargoY=.505;\ncargoBox('cube','small-cube-a',[-.49,cargoY,-.17],[.22,.22,.22],0,.08);\ncargoBox('cube','small-cube-b',[-.25,cargoY,-.18],[.18,.18,.18],2,-.05);\ncargoBox('rectangular-box','long-billet-a',[.02,cargoY,-.20],[.42,.14,.16],1,.03);\ncargoBox('rectangular-box','tall-case',[.45,cargoY,-.17],[.20,.34,.18],0,-.06);\ncargoBox('rectangular-box','flat-case',[-.42,cargoY,.12],[.34,.12,.19],4,-.04);\ncargoBox('rectangular-box','medium-case',[-.08,cargoY,.13],[.27,.25,.20],2,.05);\n\n// Three individually addressable horizontal cylinders, visually reading as a stack/bundle.\nfor(let i=0;i\u003c3;i++){\n  const g=cargoRoot('horizontal-cylinder',`cylinder-bundle-${i+1}`,[.25+i*.105,cargoY+.07,.12],0,1);\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.28,12),cargoMats[1]);\n  m.name=`${g.name}.body`;m.rotation.z=Math.PI/2;g.add(m);\n}\n\n// Vertical tanks.\ncargoCylinder('vertical-cylinder','tank-a',[.57,cargoY,.11],.065,.29,3);\ncargoCylinder('vertical-cylinder','tank-b',[.57,cargoY,.24],.055,.23,1);\n\n// Two domed cylinders complete the first heterogeneous material landscape.\n// Living specimens: transparent cylinders with disc bases.\n// Every botanical part is deliberately bounded inside its vessel.\nconst specimenGlassMat=new THREE.MeshPhysicalMaterial({\n  color:0xd8f3ee,transparent:true,opacity:.20,roughness:.08,metalness:0,\n  transmission:.42,thickness:.025,depthWrite:false,side:THREE.DoubleSide\n});\nconst specimenBaseMat=new THREE.MeshStandardMaterial({color:0x535b58,roughness:.42,metalness:.62});\nconst soilMat=new THREE.MeshStandardMaterial({color:0x34271d,roughness:.96});\nconst stemMat=new THREE.MeshStandardMaterial({color:0x416b3d,roughness:.78});\nconst leafMat=new THREE.MeshStandardMaterial({color:0x4d7d47,roughness:.76,side:THREE.DoubleSide});\nconst flowerMat=new THREE.MeshStandardMaterial({color:0xd97a9b,roughness:.64,side:THREE.DoubleSide});\n\nfunction cylinderBetween(a,b,r,mat,parent,name){\n  const d=new THREE.Vector3().subVectors(b,a),mid=new THREE.Vector3().addVectors(a,b).multiplyScalar(.5);\n  const mesh=new THREE.Mesh(new THREE.CylinderGeometry(r,r,d.length(),7),mat);\n  mesh.position.copy(mid);mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.clone().normalize());\n  mesh.name=name;parent.add(mesh);return mesh;\n}\nfunction makeLivingSpecimen(label,pos,r,h,kind='rhododendron'){\n  const g=cargoRoot('living-specimen',label,pos,0,4);\n  g.userData.materialIdentity='living-specimen';\n  g.userData.specimen=kind;\n  g.userData.provenance={\n    work:'The Time Machine',scope:'Chapters I\u2013VII material notebook',\n    catalog:'Organic / Biological',material:kind\n  };\n\n  // A slightly wider, shallow disc foot makes the vessel read as an object rather than a loose glass primitive.\n  const base=new THREE.Mesh(new THREE.CylinderGeometry(r*1.22,r*1.22,.025,18),specimenBaseMat);\n  base.name=`${g.name}.disc-base`;base.position.y=.0125;g.add(base);\n\n  const soilH=.032;\n  const soil=new THREE.Mesh(new THREE.CylinderGeometry(r*.82,r*.82,soilH,16),soilMat);\n  soil.name=`${g.name}.substrate`;soil.position.y=.025+soilH*.5;g.add(soil);\n\n  // Plant envelope intentionally stays well inside both radius and dome height.\n  const plant=new THREE.Group();plant.name=`${g.name}.plant`;g.add(plant);\n  const y0=.025+soilH;\n  const top=y0+h*.58;\n  cylinderBetween(new THREE.Vector3(0,y0,0),new THREE.Vector3(0,top,0),r*.055,stemMat,plant,`${g.name}.stem`);\n\n  const branchData=[[-.34,.42,.12],[.32,.51,-.10],[-.25,.60,-.14],[.26,.69,.11]];\n  for(let i=0;i\u003cbranchData.length;i++){\n    const [sx,sy,sz]=branchData[i];\n    const by=y0+(top-y0)*sy;\n    const tip=new THREE.Vector3(r*sx,by+h*.12,r*sz);\n    cylinderBetween(new THREE.Vector3(0,by,0),tip,r*.035,stemMat,plant,`${g.name}.branch-${i+1}`);\n\n    // Two tiny leaves at each branch tip.\n    for(const sign of [-1,1]){\n      const leaf=new THREE.Mesh(new THREE.CircleGeometry(r*.16,7),leafMat);\n      leaf.scale.set(1,.42,1);\n      leaf.position.set(tip.x+sign*r*.09,tip.y-r*.01,tip.z);\n      leaf.rotation.set(-Math.PI/2,0,sign*.35);\n      leaf.name=`${g.name}.leaf-${i+1}-${sign\u003e0?'a':'b'}`;plant.add(leaf);\n    }\n  }\n\n  // Compact rhododendron blossom cluster below the dome, never intersecting glass.\n  const bloomY=top+h*.055;\n  for(let i=0;i\u003c7;i++){\n    const a=i/7*Math.PI*2;\n    const petal=new THREE.Mesh(new THREE.CircleGeometry(r*.105,7),flowerMat);\n    petal.scale.set(1,.72,1);\n    petal.position.set(Math.cos(a)*r*.18,bloomY+(i%2)*r*.035,Math.sin(a)*r*.18);\n    petal.rotation.set(-Math.PI/2,a,0);\n    petal.name=`${g.name}.blossom-${i+1}`;plant.add(petal);\n  }\n\n  // Clear cylindrical wall plus shallow dome. Plant envelope remains below dome spring line.\n  const wallH=h*.76;\n  const wall=new THREE.Mesh(new THREE.CylinderGeometry(r,r,wallH,20,1,true),specimenGlassMat);\n  wall.name=`${g.name}.glass-wall`;wall.position.y=.025+wallH*.5;wall.renderOrder=4;g.add(wall);\n  const dome=new THREE.Mesh(new THREE.SphereGeometry(r,20,10,0,Math.PI*2,0,Math.PI/2),specimenGlassMat);\n  dome.name=`${g.name}.glass-dome`;dome.position.y=.025+wallH;dome.renderOrder=4;g.add(dome);\n\n  return g;\n}\nmakeLivingSpecimen('rhododendron-specimen-a',[.03,cargoY,.25],.085,.22,'rhododendron');\nmakeLivingSpecimen('rhododendron-specimen-b',[.19,cargoY,.25],.070,.18,'rhododendron');\n\n// Blister emitter: one central mast and one thin expanding canopy.\n// Cargo never moves. The field is required for flight.\nconst blisterEmitter=new THREE.Group();\nblisterEmitter.name='pallet-lander-001.blister-emitter';\nblisterEmitter.userData={semanticType:'deployable-pressure-field-emitter',state:'ACTIVE'};\npalletLander.add(blisterEmitter);\n\n// Air blister is an energy field, not glass. The old skin geometry remains only\n// as an invisible semantic envelope; visible containment comes from diffuse sprites.\nconst blisterSkinMat=new THREE.MeshBasicMaterial({\n  color:0x78d7ff,transparent:true,opacity:.075,depthWrite:false,\n  side:THREE.DoubleSide,blending:THREE.AdditiveBlending\n});\nconst emitterMat=new THREE.MeshStandardMaterial({color:0x707b7f,roughness:.4,metalness:.76});\nconst canopyMat=new THREE.MeshStandardMaterial({color:0x8a9699,roughness:.36,metalness:.72});\n\nconst mastBaseY=.49, mastHeight=.58;\nconst mast=new THREE.Mesh(new THREE.CylinderGeometry(.035,.045,mastHeight,10),emitterMat);\nmast.name='pallet-lander-001.blister-emitter.mast';\nmast.position.set(0,mastBaseY+mastHeight*.5,0);\nblisterEmitter.add(mast);\n\n// Thin rectangular emitter plate. It stays comfortably inside the pallet footprint.\nconst canopyGeom=new THREE.BoxGeometry(1.02,.028,.48);\nconst canopy=new THREE.Mesh(canopyGeom,canopyMat);\ncanopy.name='pallet-lander-001.blister-emitter.canopy';\ncanopy.position.set(0,mastBaseY+mastHeight,0);\nblisterEmitter.add(canopy);\n\n// The pressure field is a separate visual consequence of the deployed emitter.\nconst airBlister=new THREE.Group();\nairBlister.name='pallet-lander-001.air-blister';\nairBlister.userData={semanticType:'pressure-containment',contains:'pallet-lander-001.cargo',state:'ACTIVE'};\npalletLander.add(airBlister);\n\nconst blisterShape=new THREE.Shape();\nblisterShape.moveTo(-.69,.49);\nblisterShape.lineTo(-.69,.90);\nblisterShape.lineTo(-.56,1.032);\nblisterShape.lineTo(.56,1.032);\nblisterShape.lineTo(.69,.90);\nblisterShape.lineTo(.69,.49);\nblisterShape.closePath();\nconst blisterGeom=new THREE.ExtrudeGeometry(blisterShape,{depth:.60,bevelEnabled:false,steps:1});\nblisterGeom.translate(0,0,-.30);\nconst blisterSkin=new THREE.Mesh(blisterGeom,blisterSkinMat);\nblisterSkin.name='pallet-lander-001.air-blister.pressure-skin';\nblisterSkin.renderOrder=2;\nairBlister.add(blisterSkin);\n\n// The membrane itself establishes inside/outside. A brighter edge makes the\n// boundary read instantly without turning it back into a glass object.\nconst blisterEdgesGeom=new THREE.EdgesGeometry(blisterGeom,24);\nconst blisterEdgeMat=new THREE.LineBasicMaterial({\n  color:0x73d9ff,transparent:true,opacity:.58,\n  depthWrite:false,blending:THREE.AdditiveBlending\n});\nconst blisterEdges=new THREE.LineSegments(blisterEdgesGeom,blisterEdgeMat);\nblisterEdges.name='pallet-lander-001.air-blister.energy-boundary';\nblisterEdges.renderOrder=3;\nairBlister.add(blisterEdges);\n\n// The canopy is the visibly energetic source; the membrane itself stays restrained.\nconst blisterCrownMat=new THREE.MeshBasicMaterial({\n  color:0x7fdcff,transparent:true,opacity:.34,depthWrite:false,\n  blending:THREE.AdditiveBlending\n});\nconst blisterCrown=new THREE.Mesh(new THREE.BoxGeometry(1.0,.018,.46),blisterCrownMat);\nblisterCrown.name='pallet-lander-001.air-blister.emitter-glow';\nblisterCrown.position.set(0,1.052,0);\nairBlister.add(blisterCrown);\n\nlet blisterActive=true;\nlet blisterFlash={mode:null,t:0,step:0};\n\n// Low-level visibility is separate from semantic ACTIVE state so startup/shutdown\n// flickers can preview the membrane without lying to the flight interlock.\nfunction showBlisterField(on){\n  blisterSkin.visible=!!on;\n  blisterEdges.visible=!!on;\n  blisterCrown.visible=!!on;\n}\nfunction setBlisterActive(on){\n  blisterActive=!!on;\n  showBlisterField(blisterActive);\n  airBlister.userData.state=blisterActive?'ACTIVE':'INACTIVE';\n}\nfunction beginBlisterStartupFlicker(){\n  blisterActive=false;\n  airBlister.userData.state='CHARGING';\n  blisterFlash={mode:'STARTUP',t:0,step:0};\n  showBlisterField(false);\n}\nfunction beginBlisterShutdownFlicker(){\n  blisterActive=false; // flight interlock drops immediately\n  airBlister.userData.state='DISCHARGING';\n  blisterFlash={mode:'SHUTDOWN',t:0,step:0};\n  showBlisterField(true);\n}\nfunction updateBlisterFlash(dt){\n  const f=blisterFlash;\n  if(!f.mode)return;\n  f.t+=dt;\n\n  // Startup: ON/OFF, ON/OFF, then establish continuously.\n  // Shutdown: one brief after-flash, then dark.\n  const startup=[\n    [.075,true],[.065,false],[.075,true],[.075,false],[.001,true]\n  ];\n  const shutdown=[\n    [.075,true],[.065,false],[.075,true],[.095,false]\n  ];\n  const seq=f.mode==='STARTUP'?startup:shutdown;\n  while(f.step\u003cseq.length \u0026\u0026 f.t\u003e=seq[f.step][0]){\n    f.t-=seq[f.step][0];\n    showBlisterField(seq[f.step][1]);\n    f.step++;\n  }\n  if(f.step\u003e=seq.length){\n    if(f.mode==='STARTUP'){\n      blisterFlash={mode:null,t:0,step:0};\n      setBlisterActive(true);\n      emitterMotion.state='ACTIVE';blisterEmitter.userData.state='ACTIVE';\n      updateLanderControlCue();\n    }else{\n      blisterFlash={mode:null,t:0,step:0};\n      showBlisterField(false);\n      airBlister.userData.state='INACTIVE';\n      // Electrical shutdown is visibly complete; only now may hardware collapse.\n      if(emitterMotion.state==='WAITING_TO_STOW'){\n        emitterMotion.state='STOWING';emitterMotion.t=0;\n        blisterEmitter.userData.state='STOWING';\n      }\n    }\n  }\n}\n\nconst emitterMotion={state:'STOWED',t:0,duration:.90};\nfunction setEmitterDeployment(q){\n  q=THREE.MathUtils.clamp(q,0,1); // 0 stowed, 1 deployed\n\n  // Sequential mechanism:\n  // deployment: mast rises first, then the rectangular plate expands horizontally.\n  // stow: plate contracts first, then mast telescopes into its deck socket.\n  const mastQ=smooth01(THREE.MathUtils.clamp(q*2,0,1));\n  const plateQ=smooth01(THREE.MathUtils.clamp(q*2-1,0,1));\n\n  canopy.scale.set(Math.max(.001,plateQ),1,1);\n  canopy.visible=plateQ\u003e.015;\n\n  mast.scale.y=Math.max(.001,mastQ);\n  mast.position.y=mastBaseY+(mastHeight*mastQ)*.5;\n  mast.visible=mastQ\u003e.015;\n  canopy.position.y=mastBaseY+mastHeight*mastQ;\n}\nfunction beginEmitterStow(){\n  if(emitterMotion.state!=='ACTIVE')return;\n  // Field shuts down completely before any mast/canopy motion begins.\n  emitterMotion.state='WAITING_TO_STOW';emitterMotion.t=0;\n  blisterEmitter.userData.state='DISCHARGING';\n  beginBlisterShutdownFlicker();\n  updateLanderControlCue();\n}\nfunction beginEmitterDeploy(){\n  if(emitterMotion.state!=='STOWED')return;\n  emitterMotion.state='DEPLOYING';emitterMotion.t=0;\n  blisterEmitter.userData.state='DEPLOYING';\n  updateLanderControlCue();\n}\nfunction updateBlisterEmitter(dt){\n  const m=emitterMotion;\n  if(m.state==='STOWING'){\n    m.t+=dt; const q=smooth01(m.t/m.duration);\n    setEmitterDeployment(1-q);\n    if(m.t\u003e=m.duration){\n      setEmitterDeployment(0);m.state='STOWED';blisterEmitter.userData.state='STOWED';\n      updateLanderControlCue();\n    }\n  }else if(m.state==='DEPLOYING'){\n    m.t+=dt; const q=smooth01(m.t/m.duration);\n    setEmitterDeployment(q);\n    if(m.t\u003e=m.duration){\n      setEmitterDeployment(1);\n      // Hardware is fully deployed; field coughs twice before becoming authoritative.\n      m.state='CHARGING';blisterEmitter.userData.state='CHARGING';\n      beginBlisterStartupFlicker();updateLanderControlCue();\n    }\n  }\n}\nsetEmitterDeployment(0);\nsetBlisterActive(false);\n\n// Four retractable legs. Retraction is local to each leg group. Retraction is local to each leg group.\nconst legGroups=[];\nfor(const [i,x,z] of [[0,-.62,-.28],[1,.62,-.28],[2,-.62,.28],[3,.62,.28]]){\n  const g=new THREE.Group();g.name=`pallet-lander-001.leg-${i+1}`;g.position.set(x,0,z);palletLander.add(g);\n  landerBox(`${g.name}.strut`,[.075,.31,.075],[0,.155,0],landerDark,g);\n  landerBox(`${g.name}.foot`,[.22,.045,.18],[0,.022,0],landerFootMat,g);\n  legGroups.push(g);\n}\n\n// Main center lift engine and its cheap procedural plume.\nconst mainEngine=new THREE.Group();mainEngine.name='pallet-lander-001.main-thruster';mainEngine.position.set(0,.18,0);palletLander.add(mainEngine);\nconst bell=landerCyl('pallet-lander-001.main-thruster.bell',.105,.17,.16,[0,0,0],landerDark,mainEngine);\nconst mainPlume=new THREE.Mesh(new THREE.ConeGeometry(.12,.62,18,1,true),plumeMat);\nmainPlume.name='pallet-lander-001.main-thruster.plume';\nmainPlume.position.y=-.38;mainPlume.rotation.z=Math.PI;mainPlume.visible=false;mainEngine.add(mainPlume);\n\n// Four canted station-keeping thrusters. Their plumes pulse during hover correction.\nconst stationThrusters=[];\nfor(const [i,x,z,sx,sz] of [\n  [0,-.66,-.30,-1,-1],[1,.66,-.30,1,-1],[2,-.66,.30,-1,1],[3,.66,.30,1,1]\n]){\n  const g=new THREE.Group();g.name=`pallet-lander-001.station-thruster-${i+1}`;\n  g.position.set(x,.25,z);\n  // local -Y points roughly outward/down after these small cant rotations\n  g.rotation.z=-sx*.38;g.rotation.x=sz*.30;\n  palletLander.add(g);\n  landerCyl(`${g.name}.nozzle`,.035,.065,.11,[0,0,0],landerDark,g,10);\n  const p=new THREE.Mesh(new THREE.ConeGeometry(.038,.24,10,1,true),pulseMat.clone());\n  p.name=`${g.name}.plume`;p.position.y=-.16;p.rotation.z=Math.PI;p.visible=false;g.add(p);\n  stationThrusters.push({group:g,plume:p,index:i});\n}\n\n// Diffuse blue exhaust particles. Existing cone plumes remain as disabled fallback geometry.\nfunction makeExhaustSprite(){\n  const c=document.createElement('canvas');c.width=c.height=64;\n  const x=c.getContext('2d');\n  const g=x.createRadialGradient(32,32,0,32,32,31);\n  g.addColorStop(0,'rgba(235,252,255,1)');\n  g.addColorStop(.18,'rgba(120,225,255,.95)');\n  g.addColorStop(.48,'rgba(45,145,255,.48)');\n  g.addColorStop(1,'rgba(20,80,255,0)');\n  x.fillStyle=g;x.fillRect(0,0,64,64);\n  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;\n}\nconst exhaustSprite=makeExhaustSprite();\nfunction makeParticleExhaust(parent,name,count,length,radius,size,origin,direction){\n  const group=new THREE.Group();group.name=name;parent.add(group);\n  const dir=direction.clone().normalize();\n  // Build a stable perpendicular basis around the semantic exhaust vector.\n  const helper=Math.abs(dir.y)\u003c.9?new THREE.Vector3(0,1,0):new THREE.Vector3(1,0,0);\n  const u=new THREE.Vector3().crossVectors(dir,helper).normalize();\n  const v=new THREE.Vector3().crossVectors(dir,u).normalize();\n  const particles=[];\n  for(let i=0;i\u003ccount;i++){\n    const mat=new THREE.SpriteMaterial({\n      map:exhaustSprite,color:0xbfefff,transparent:true,opacity:0,\n      depthWrite:false,blending:THREE.AdditiveBlending\n    });\n    const p=new THREE.Sprite(mat);p.visible=false;group.add(p);\n    particles.push({sprite:p,phase:i/count,jitter:((i*37)%17)/17,length,radius,size});\n  }\n  return {group,particles,strength:0,origin:origin.clone(),direction:dir,u,v};\n}\n\n// Propulsion semantics are explicit rather than inferred from CylinderGeometry.\n// Center exhaust: straight down from the bell mouth in lander-local coordinates.\nconst mainExhaust=makeParticleExhaust(\n  palletLander,'pallet-lander-001.main-thruster.exhaust-particles',\n  30,.72,.085,.095,\n  new THREE.Vector3(0,.07,0),\n  new THREE.Vector3(0,-1,0)\n);\n\n// Corner exhausts: down + radially INWARD toward the protected plume envelope.\n// This preserves the original dockworker-safe cant while keeping direction explicit.\nconst stationExhausts=stationThrusters.map((t,i)=\u003e{\n  const x=t.group.position.x,z=t.group.position.z;\n  const inward=new THREE.Vector3(-x,-Math.hypot(x,z)*1.55,-z).normalize();\n  const origin=new THREE.Vector3(x,t.group.position.y-.055,z).addScaledVector(inward,.055);\n  return makeParticleExhaust(\n    palletLander,`pallet-lander-001.station-thruster-${i+1}.exhaust-particles`,\n    10,.27,.045,.045,origin,inward\n  );\n});\nmainPlume.visible=false;\nfor(const t of stationThrusters){t.plume.visible=false;t.particleActive=false;t.particleStrength=0;}\n\nfunction updateParticleExhaust(sys,on,strength,now){\n  sys.strength=on?strength:0;\n  for(let i=0;i\u003csys.particles.length;i++){\n    const e=sys.particles[i],p=e.sprite;\n    if(!on){p.visible=false;continue}\n    const travel=(e.phase+now*.54)%1;\n    const ang=i*2.399963;\n    // Plume silhouette is broad at the nozzle and tapers with travel.\n    // A small residual radius avoids collapsing every distal particle onto one line.\n    const taper=.16+.84*(1-travel);\n    const spread=e.radius*taper*(0.45+e.jitter*.75);\n\n    // Position = explicit nozzle mouth + travel along semantic exhaust direction\n    // + tapered radial spread in the plane perpendicular to that direction.\n    p.position.copy(sys.origin)\n      .addScaledVector(sys.direction,.02+travel*e.length)\n      .addScaledVector(sys.u,Math.cos(ang)*spread)\n      .addScaledVector(sys.v,Math.sin(ang)*spread);\n\n    const sz=e.size*(1.08-.62*travel)*(0.82+e.jitter*.35);\n    p.scale.set(sz,sz,1);\n    p.material.opacity=(1-travel)*(.24+.42*strength);\n    p.visible=true;\n  }\n}\n\n// Physical chassis button: the only control for this first toy pass.\nconst landerButton=landerCyl('pallet-lander-001.control.flight-button',.09,.09,.055,[.49,.31,.418],buttonMat,palletLander,18);\nlanderButton.rotation.x=Math.PI/2;\nlanderButton.userData.semanticType='physical-control';\nlanderButton.userData.control='flight-cycle';\ninteriorInteractives.push(landerButton);\n\n// Tiny status lamp is world feedback, not UI. It shares the front-right control cluster.\nconst statusLampMat=new THREE.MeshBasicMaterial({color:0x8fd6a4});\nconst statusLamp=landerCyl('pallet-lander-001.status-lamp',.035,.035,.018,[.30,.31,.408],statusLampMat,palletLander,12);\nstatusLamp.rotation.x=Math.PI/2;\n\n// -----------------------------------------------------------------------------\n// ROOM 001 CONTENTS \u2014 ORRERY SEED 001\n// A second toy, deliberately beginning with less ontology than the lander.\n// Known now: compact brass mechanism, one physical control, three folded arms,\n// three materially distinct bodies, and a deploy/turn cycle.\n// Unknown on purpose: whether it is model, instrument, navigator, or something else.\nconst orrerySeed=new THREE.Group();\norrerySeed.name='orrery-seed-001';\norrerySeed.position.set(.92,1.10,-.12);\norrerySeed.scale.setScalar(.72);\norrerySeed.userData={\n  semanticId:'orrery-seed-001',\n  semanticType:'tabletop-toy',\n  sceneAnchor:'room-001.workbench.right',\n  interpretation:'unresolved',\n  state:'FOLDED'\n};\nroomContents.add(orrerySeed);\n// INHERITANCE PASS 2: preserve the orrery implementation but keep it out of the quiet first encounter.\norrerySeed.visible=false;\n\nconst orreryBrass=new THREE.MeshStandardMaterial({color:0x8f6c32,roughness:.34,metalness:.82});\nconst orreryDark=new THREE.MeshStandardMaterial({color:0x272b2d,roughness:.46,metalness:.72});\nconst orreryIvory=new THREE.MeshStandardMaterial({color:0xd5ccb2,roughness:.58,metalness:.08});\nconst orreryGreen=new THREE.MeshStandardMaterial({color:0x315f52,roughness:.44,metalness:.28});\nconst orrerySilver=new THREE.MeshStandardMaterial({color:0xaab2b4,roughness:.28,metalness:.86});\nconst orreryButtonMat=new THREE.MeshStandardMaterial({color:0x755128,emissive:0x1c0e02,emissiveIntensity:.2,roughness:.38,metalness:.7});\n\nfunction orreryCyl(name,r,h,pos,mat=orreryBrass,parent=orrerySeed,radial=20){\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,radial),mat);\n  m.name=name;m.position.set(...pos);parent.add(m);return m;\n}\nconst orreryBase=orreryCyl('orrery-seed-001.base',.43,.13,[0,.065,0],orreryDark);\nconst orreryRing=new THREE.Mesh(new THREE.TorusGeometry(.34,.035,8,28),orreryBrass);\norreryRing.name='orrery-seed-001.base-ring';orreryRing.rotation.x=Math.PI/2;orreryRing.position.y=.14;orrerySeed.add(orreryRing);\nconst orrerySpindle=orreryCyl('orrery-seed-001.spindle',.055,.34,[0,.25,0],orreryBrass);\n\nconst orreryArmRoot=new THREE.Group();\norreryArmRoot.name='orrery-seed-001.armature';\norreryArmRoot.position.y=.39;\norrerySeed.add(orreryArmRoot);\n\nconst armSpecs=[\n  {a:0,len:.42,mat:orreryIvory,r:.085},\n  {a:Math.PI*2/3,len:.56,mat:orreryGreen,r:.105},\n  {a:Math.PI*4/3,len:.70,mat:orrerySilver,r:.075}\n];\nconst orreryArms=[];\nfor(let i=0;i\u003carmSpecs.length;i++){\n  const spec=armSpecs[i], pivot=new THREE.Group();\n  pivot.name=`orrery-seed-001.arm-${i+1}`;\n  pivot.rotation.y=spec.a;\n  orreryArmRoot.add(pivot);\n  const beam=new THREE.Mesh(new THREE.BoxGeometry(spec.len,.035,.045),orreryBrass);\n  beam.position.x=spec.len/2;beam.name=`orrery-seed-001.arm-${i+1}.beam`;pivot.add(beam);\n  // The arm endpoint is a carrier. The body has its own local orbit around it.\n  const localOrbit=new THREE.Group();\n  localOrbit.name=`orrery-seed-001.body-${i+1}.local-orbit`;\n  localOrbit.position.x=spec.len;\n  pivot.add(localOrbit);\n\n  const orbitTilt=[.18,-.27,.41][i];\n  localOrbit.rotation.z=orbitTilt;\n\n  const orbitRadius=[.105,.145,.205][i];\n  const orbitCarrier=new THREE.Group();\n  orbitCarrier.name=`orrery-seed-001.body-${i+1}.orbit-carrier`;\n  localOrbit.add(orbitCarrier);\n\n  const body=new THREE.Mesh(new THREE.SphereGeometry(spec.r,18,12),spec.mat);\n  body.position.x=orbitRadius;\n  body.name=`orrery-seed-001.body-${i+1}`;\n  orbitCarrier.add(body);\n\n  // A restrained physical ring makes the local mechanism legible without\n  // deciding whether this is astronomy, navigation, computation, or ritual.\n  const track=new THREE.Mesh(\n    new THREE.TorusGeometry(orbitRadius,.008,6,32),\n    new THREE.MeshStandardMaterial({color:0x6e5935,roughness:.48,metalness:.72})\n  );\n  track.name=`orrery-seed-001.body-${i+1}.orbit-track`;\n  track.rotation.x=Math.PI/2;\n  localOrbit.add(track);\n\n  pivot.userData.localOrbit=orbitCarrier;\n  pivot.userData.orbitBody=body;\n  pivot.userData.orbitRate=[1.07,-.71,.43][i];\n  pivot.userData.phase=[.25,2.15,4.35][i];\n  orbitCarrier.rotation.y=pivot.userData.phase;\n\n  pivot.scale.x=.08;\n  orreryArms.push(pivot);\n}\n\n// One chunky physical control. Like the lander, it is part of the toy, not overlay UI.\nconst orreryButton=orreryCyl('orrery-seed-001.control.deploy',.075,.055,[.27,.19,.27],orreryButtonMat,orrerySeed,18);\norreryButton.rotation.x=Math.PI/2;\norreryButton.userData.semanticType='physical-control';\norreryButton.userData.control='deploy-cycle';\ninteriorInteractives.push(orreryButton);\n\n// Central alignment detector: three quiet brass sights and one physical latch tile.\n// It observes current body geometry; it does not know what an alignment means.\nconst detector=new THREE.Group();\ndetector.name='orrery-seed-001.alignment-detector';\ndetector.position.y=.18;\norrerySeed.add(detector);\nfor(let i=0;i\u003c3;i++){\n  const a=i*Math.PI*2/3;\n  const sight=new THREE.Mesh(new THREE.BoxGeometry(.025,.22,.025),orreryBrass);\n  sight.name=`orrery-seed-001.alignment-detector.sight-${i+1}`;\n  sight.position.set(Math.cos(a)*.115,.11,Math.sin(a)*.115);\n  sight.rotation.z=Math.cos(a)*.08;\n  detector.add(sight);\n}\nconst latchTile=new THREE.Mesh(new THREE.BoxGeometry(.20,.035,.13),orreryIvory);\nlatchTile.name='orrery-seed-001.alignment-latch';\nlatchTile.position.set(-.19,.155,.24);\nlatchTile.userData.semanticType='alignment-record';\nlatchTile.userData.meaning='unresolved';\norrerySeed.add(latchTile);\n\nconst alignmentSense={\n  latched:false,\n  clear:true,\n  pulse:0,\n  // enter tighter than exit: geometric hysteresis prevents chatter.\n  enterAngle:THREE.MathUtils.degToRad(7),\n  exitAngle:THREE.MathUtils.degToRad(12)\n};\nfunction bodyDirectionFromCenter(arm){\n  const body=arm.userData.orbitBody;\n  if(!body)return null;\n  const p=new THREE.Vector3();\n  body.getWorldPosition(p);\n  const c=new THREE.Vector3();\n  orreryArmRoot.getWorldPosition(c);\n  return p.sub(c).normalize();\n}\nfunction smallestBodySeparation(){\n  const dirs=orreryArms.map(bodyDirectionFromCenter).filter(Boolean);\n  let best=Math.PI;\n  for(let i=0;i\u003cdirs.length;i++)for(let j=i+1;j\u003cdirs.length;j++){\n    best=Math.min(best,Math.acos(THREE.MathUtils.clamp(dirs[i].dot(dirs[j]),-1,1)));\n  }\n  return best;\n}\nfunction updateAlignmentDetector(dt){\n  const active=orreryMotion.state==='TURNING';\n  if(!active){\n    alignmentSense.latched=false;alignmentSense.clear=true;alignmentSense.pulse=0;\n    latchTile.position.y=.155;latchTile.rotation.z=0;\n    return;\n  }\n  const sep=smallestBodySeparation();\n  if(alignmentSense.clear \u0026\u0026 sep\u003calignmentSense.enterAngle){\n    alignmentSense.latched=true;alignmentSense.clear=false;alignmentSense.pulse=1;\n    latchTile.userData.lastObservedSeparation=sep;\n  }else if(!alignmentSense.clear \u0026\u0026 sep\u003ealignmentSense.exitAngle){\n    alignmentSense.clear=true;\n  }\n  if(alignmentSense.pulse\u003e0)alignmentSense.pulse=Math.max(0,alignmentSense.pulse-dt*2.4);\n  const pop=alignmentSense.latched ? .075 : 0;\n  const kick=alignmentSense.pulse*.018;\n  latchTile.position.y=.155+pop+kick;\n  latchTile.rotation.z=alignmentSense.pulse*.08;\n}\n\nconst orreryMotion={state:'FOLDED',t:0,angle:0};\nfunction requestOrreryCycle(){\n  if(orreryMotion.state==='FOLDED'){orreryMotion.state='DEPLOYING';orreryMotion.t=0;orrerySeed.userData.state='DEPLOYING'}\n  else if(orreryMotion.state==='TURNING'){orreryMotion.state='FOLDING';orreryMotion.t=0;orrerySeed.userData.state='FOLDING'}\n}\norreryButton.userData.onActivate=requestOrreryCycle;\n\nfunction updateOrrery(dt){\n  const m=orreryMotion;\n  if(m.state==='DEPLOYING'){\n    m.t+=dt;const q=smooth01(Math.min(1,m.t/1.35));\n    orrerySpindle.scale.y=.22+.78*q;\n    for(let i=0;i\u003correryArms.length;i++)orreryArms[i].scale.x=.08+.92*Math.max(0,Math.min(1,(q-i*.12)/(1-i*.12)));\n    if(q\u003e=1){m.state='TURNING';m.t=0;orrerySeed.userData.state='TURNING'}\n  }else if(m.state==='TURNING'){\n    m.angle+=dt*.34;\n    orreryArmRoot.rotation.y=m.angle;\n    // Each body advances on an independent, deliberately incommensurate cycle.\n    // One runs retrograde. Relationships drift rather than repeating quickly.\n    for(const arm of orreryArms){\n      const local=arm.userData.localOrbit;\n      if(local)local.rotation.y+=dt*arm.userData.orbitRate;\n    }\n  }else if(m.state==='FOLDING'){\n    m.t+=dt;const q=smooth01(Math.min(1,m.t/1.15)),inv=1-q;\n    for(let i=0;i\u003correryArms.length;i++)orreryArms[i].scale.x=.08+.92*inv;\n    orrerySpindle.scale.y=.22+.78*inv;\n    if(q\u003e=1){m.state='FOLDED';m.t=0;orrerySeed.userData.state='FOLDED'}\n  }\n}\n\nconst landerFlight={\n  state:'LANDED',\n  stateT:0,\n  landingY:1.09,\n  hoverHeight:.78,\n  hoverBaseY:1.87,\n  lastTime:performance.now()/1000,\n  hoverPhase:0\n};\nfunction updateLanderControlCue(){\n  // Lamp communicates the orange button's next action.\n  // dim = cargo accessible / deploy containment\n  // cyan = containment established / flight ready\n  // blue = airborne / land\n  // muted = machinery in transition\n  if(landerFlight.state==='LANDED'){\n    const ready=blisterActive \u0026\u0026 emitterMotion.state==='ACTIVE';\n    const accessible=!blisterActive \u0026\u0026 emitterMotion.state==='STOWED';\n    statusLampMat.color.set(ready?0x66d9ff:(accessible?0x6b7477:0x4d5254));\n    buttonMat.color.copy((ready||accessible)?buttonLive:buttonIdle);\n    buttonMat.emissiveIntensity=(ready||accessible)?.65:.2;\n  }else if(landerFlight.state==='HOVERING'){\n    statusLampMat.color.set(0x9fc8ff);\n    buttonMat.color.copy(buttonLive);buttonMat.emissiveIntensity=.65;\n  }else{\n    statusLampMat.color.set(0x4d5254);\n    buttonMat.color.copy(buttonIdle);buttonMat.emissiveIntensity=.2;\n  }\n}\nfunction setLanderState(next){\n  landerFlight.state=next;landerFlight.stateT=0;palletLander.userData.state=next;\n  updateLanderControlCue();\n}\nfunction requestLanderCycle(){\n  if(landerFlight.state==='LANDED'){\n    // First landed press establishes containment.\n    if(emitterMotion.state==='STOWED' \u0026\u0026 !blisterActive){\n      beginEmitterDeploy();\n    // Second landed press may launch only after containment is fully established.\n    }else if(emitterMotion.state==='ACTIVE' \u0026\u0026 blisterActive){\n      setLanderState('RETRACTING_GEAR');\n    }\n  }else if(landerFlight.state==='HOVERING'){\n    setLanderState('LANDING');\n  }\n}\nlanderButton.userData.onActivate=requestLanderCycle;\nsetLanderState('LANDED');\n\nfunction smooth01(t){t=THREE.MathUtils.clamp(t,0,1);return t*t*(3-2*t)}\nfunction setLegRetraction(a){\n  const q=smooth01(a);\n  for(const [i,g] of legGroups.entries()){\n    const side=i%2===0?-1:1;\n    g.position.y=.24*q;\n    g.rotation.z=side*.78*q;\n  }\n}\nlet mainExhaustOn=false,mainExhaustStrength=0;\nfunction setMainPlume(on,strength=1){\n  // Geometric cone retained only as fallback; particle exhaust is canonical.\n  mainPlume.visible=false;\n  mainExhaustOn=on;mainExhaustStrength=strength;\n}\nfunction updatePalletLander(dt,now){\n  const f=landerFlight;f.stateT+=dt;\n  if(f.state==='LANDED'){\n    palletLander.position.y=f.landingY;palletLander.rotation.set(0,0,0);setLegRetraction(0);setMainPlume(false);\n  }else if(f.state==='RETRACTING_GEAR'){\n    const q=Math.min(1,f.stateT/.72);setLegRetraction(q);setMainPlume(false);\n    if(q\u003e=1)setLanderState('LIFTING');\n  }else if(f.state==='LIFTING'){\n    setLegRetraction(1);setMainPlume(true,.62);\n    const q=smooth01(f.stateT/1.15);palletLander.position.y=THREE.MathUtils.lerp(f.landingY,f.hoverBaseY,q);\n    if(q\u003e=1)setLanderState('HOVERING');\n  }else if(f.state==='HOVERING'){\n    setLegRetraction(1);setMainPlume(true,.45);\n    f.hoverPhase+=dt;\n    const bob=Math.sin(f.hoverPhase*1.55)*.025;\n    const roll=Math.sin(f.hoverPhase*.83)*.012;\n    const pitch=Math.sin(f.hoverPhase*1.07+1.4)*.010;\n    palletLander.position.y=f.hoverBaseY+bob;\n    palletLander.rotation.z=roll;palletLander.rotation.x=pitch;\n\n    // Correction plumes correspond to the sign of the current attitude tendency.\n    const rollRate=Math.cos(f.hoverPhase*.83)*.83*.012;\n    const pitchRate=Math.cos(f.hoverPhase*1.07+1.4)*1.07*.010;\n    for(const t of stationThrusters){\n      const xSign=t.index%2===0?-1:1;\n      const zSign=t.index\u003c2?-1:1;\n      const correction=(-rollRate*xSign + pitchRate*zSign);\n      const pulse=Math.max(0,Math.sin(now*8.5+t.index*1.7))*.7 + Math.max(0,correction*70);\n      const active=pulse\u003e.56;\n      t.plume.visible=false;\n      t.particleActive=active;\n      t.particleStrength=THREE.MathUtils.clamp(.35+pulse*.45,.35,1);\n    }\n  }else if(f.state==='LANDING'){\n    setLegRetraction(1);setMainPlume(true,.48);\n    const q=smooth01(f.stateT/1.2);palletLander.position.y=THREE.MathUtils.lerp(f.hoverBaseY,f.landingY,q);\n    palletLander.rotation.x*=.9;palletLander.rotation.z*=.9;\n    for(const t of stationThrusters){t.plume.visible=false;t.particleActive=false;t.particleStrength=0;}\n    if(q\u003e=1){setMainPlume(false);setLanderState('DEPLOYING_GEAR')}\n  }else if(f.state==='DEPLOYING_GEAR'){\n    palletLander.position.y=f.landingY;setMainPlume(false);\n    const q=Math.min(1,f.stateT/.72);setLegRetraction(1-q);\n    if(q\u003e=1){\n      setLanderState('LANDED');\n      beginEmitterStow();\n    }\n  }\n  updateParticleExhaust(mainExhaust,mainExhaustOn,mainExhaustStrength,now);\n  for(let i=0;i\u003cstationThrusters.length;i++){\n    const t=stationThrusters[i];\n    updateParticleExhaust(stationExhausts[i],!!t.particleActive,t.particleStrength||0,now+i*.17);\n  }\n}\n\n\n// A few architectural light strips; illumination is functional, not clutter.\nconst interiorAmbient=new THREE.HemisphereLight(0xdde4e8,0x30343a,1.15);interiorRoot.add(interiorAmbient);\nfor(const x of [-2.1,0,2.1]){\n  const strip=roomBox('room-001.ceiling-light',[x,3.13,-.25],[1.25,.035,.16],\n    new THREE.MeshBasicMaterial({color:0xffe1ad}));\n}\nconst roomLight=new THREE.PointLight(0xffd19a,22,10,2);roomLight.position.set(0,2.75,.4);interiorRoot.add(roomLight);\n\n// Window exterior proxy: the same station vocabulary is visible beyond the glass,\n// but exact geometric correspondence is intentionally unresolved.\n// It is not a second world-state; it is a view representation owned by Room 001.\nconst windowExterior=new THREE.Group();windowExterior.name='room-001.window-exterior-view';interiorRoot.add(windowExterior);\nconst starGeo2=new THREE.BufferGeometry(),starPts=[];\nconst rr=mulberry32(90125);\nfor(let i=0;i\u003c450;i++){const z=-8-rr()*45,x=(rr()-.5)*55,y=(rr()-.5)*30;starPts.push(x,y,z)}\nstarGeo2.setAttribute('position',new THREE.Float32BufferAttribute(starPts,3));\nwindowExterior.add(new THREE.Points(starGeo2,new THREE.PointsMaterial({color:0xffffff,size:.035,sizeAttenuation:true})));\nconst extFrameMat=new THREE.MeshStandardMaterial({color:0xb85a18,roughness:.52,metalness:.55});\nconst proxyWhite=new THREE.MeshStandardMaterial({color:0xffffff,roughness:.72,metalness:.10});\nconst proxyGrey=new THREE.MeshStandardMaterial({color:0x555b5d,roughness:.58,metalness:.38});\nconst proxyDark=new THREE.MeshStandardMaterial({color:0x34393b,roughness:.52,metalness:.46});\nconst proxyArmTex=makeHullTexture(hashSeed('room-001.proxy.habitat-arm-west'));\nconst proxyDrumTex=makeHullTexture(hashSeed('room-001.proxy.habitat-drum-b'));\nproxyArmTex.repeat.set(3.2,1.35);\nproxyDrumTex.repeat.set(2.8,1.15);\n\n\n// Window exterior is a situated visual proxy, not a solved metric placement.\n// It deliberately reuses the station's pressure/detail/frame vocabulary.\nconst stationOutdoors=new THREE.Group();\nstationOutdoors.name='room-001.station-outdoors-proxy';\nstationOutdoors.userData={\n  semanticType:'situated-exterior-view',\n  viewpoint:'somewhere-along-habitat-arm-forward',\n  visibleArchitecture:['habitat-arm-west','habitat-drum-b'],\n  metricRelationship:'unresolved'\n};\nwindowExterior.add(stationOutdoors);\n\nfunction proxyPipe(root,a,b,r=.035,mat=extFrameMat,name='frame'){\n  return surfacePipe(root,new THREE.Vector3(...a),new THREE.Vector3(...b),r,mat,name);\n}\nfunction proxyPanel(root,pos,scale,mat=proxyGrey){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(...scale),mat);\n  m.position.set(...pos);root.add(m);return m;\n}\nfunction proxyArmWest(){\n  const g=new THREE.Group();g.name='proxy-habitat-arm-west';\n  // Pressure skin: horizontal cylinder, visibly below the room aperture center.\n  const skin=new THREE.Mesh(new THREE.CylinderGeometry(.70,.70,5.6,32,1,false),proxyWhite);\n  skin.rotation.z=Math.PI/2;g.add(skin);\n\n  // Same procedural surface vocabulary as the station, independently rendered\n  // for this situated proxy.\n  skin.material=new THREE.MeshStandardMaterial({\n    color:0xffffff,map:proxyArmTex,roughness:.72,metalness:.10\n  });\n\n  // Canonical orderly detail lanes, intentionally sparse at this viewing distance.\n  for(const x of [-2.05,-1.55,-1.05,-.55,.05,.55,1.05,1.55,2.05]){\n    if(Math.abs(x)\u003e2.25)continue;\n    proxyPanel(g,[x,.70,.02],[.22,.018,.12]);\n    proxyPanel(g,[x,-.70,.02],[.22,.018,.12]);\n  }\n  for(const z of [-.735,-.77,-.805])\n    proxyPipe(g,[-2.15,.02,z],[2.15,.02,z],.014,proxyDark,'pipe-bundle');\n\n  // Local orange cage derived around this proxy module.\n  const c=.91,h=2.8;\n  for(const y of [-c,c])for(const z of [-c,c])proxyPipe(g,[-h,y,z],[h,y,z],.032);\n  for(const x of [-h,h]){\n    proxyPipe(g,[x,-c,-c],[x,c,-c],.032);proxyPipe(g,[x,c,-c],[x,c,c],.032);\n    proxyPipe(g,[x,c,c],[x,-c,c],.032);proxyPipe(g,[x,-c,c],[x,-c,-c],.032);\n  }\n  return g;\n}\nfunction proxyDrumB(){\n  const g=new THREE.Group();g.name='proxy-habitat-drum-b';\n  const skin=new THREE.Mesh(new THREE.CylinderGeometry(1.28,1.28,1.55,36,1,false),proxyWhite);\n  g.add(skin);\n  skin.material=new THREE.MeshStandardMaterial({\n    color:0xffffff,map:proxyDrumTex,roughness:.72,metalness:.10\n  });\n\n  // Heavy structural rims.\n  for(const y of [-.78,.78]){\n    const r=new THREE.Mesh(new THREE.TorusGeometry(1.31,.085,10,40),proxyDark);\n    r.rotation.x=Math.PI/2;r.position.y=y;g.add(r);\n  }\n  // Repeated vertical panel/vent stations around the visible hull.\n  for(let i=0;i\u003c18;i++){\n    const a=i*Math.PI*2/18;\n    if(Math.sin(a)\u003c-.15)continue;\n    for(const y of [-.38,0,.38]){\n      const w=.18,h=.11,d=.035;\n      const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),proxyGrey);\n      m.position.set(Math.cos(a)*1.305,y,Math.sin(a)*1.305);\n      m.lookAt(new THREE.Vector3(Math.cos(a)*2.2,y,Math.sin(a)*2.2));\n      g.add(m);\n    }\n  }\n  // Orange local cage/rings.\n  for(const y of [-.92,.92]){\n    const r=new THREE.Mesh(new THREE.TorusGeometry(1.52,.035,8,40),extFrameMat);\n    r.rotation.x=Math.PI/2;r.position.y=y;g.add(r);\n  }\n  for(const a of [0,Math.PI/2,Math.PI,Math.PI*1.5]){\n    const x=Math.cos(a)*1.52,z=Math.sin(a)*1.52;\n    proxyPipe(g,[x,-.92,z],[x,.92,z],.032);\n  }\n  return g;\n}\n\n// Compose rather than solve: the neighboring architecture is placed lower than\n// the room so its textured/detail-bearing surfaces are legible through the glass.\nconst proxyWest=proxyArmWest();\n// Arm axis is local X: keep it perpendicular to the window/view direction.\n// Shift it right and low so a substantial length crosses the lower-right view.\nproxyWest.position.set(2.25,-.78,-10.35);\n// The proxy arm's cylinder is authored along local X. Rotate the whole module\n// 90\u00b0 about Y so its axis runs into/out of the window plane rather than across it.\nproxyWest.rotation.y=Math.PI/2;\nstationOutdoors.add(proxyWest);\n\nconst proxyDrum=proxyDrumB();\n// The arm is authored length 5.6 on local X and rotated +90\u00b0 about Y,\n// so its far endpoint lies 2.8 units toward -Z from proxyWest.position.\n// Drum B is attached directly at that far endpoint instead of independently composed.\nconst proxyWestFar=new THREE.Vector3(0,0,-2.8).add(proxyWest.position);\nproxyDrum.position.set(proxyWestFar.x,proxyWest.position.y,proxyWestFar.z-.18);\nstationOutdoors.add(proxyDrum);\n\n// Minimal local collar/frame relationship at the actual proxy attachment.\nproxyPipe(stationOutdoors,\n  [proxyWestFar.x-.86,proxyWestFar.y+.82,proxyWestFar.z],\n  [proxyWestFar.x+.86,proxyWestFar.y+.82,proxyWestFar.z],.032);\nproxyPipe(stationOutdoors,\n  [proxyWestFar.x-.86,proxyWestFar.y-.82,proxyWestFar.z],\n  [proxyWestFar.x+.86,proxyWestFar.y-.82,proxyWestFar.z],.032);\n\n// Proxy visibility follows the same observer-facing DETAIL/TEXTURE concepts.\nstationOutdoors.userData.setDetail=(on)=\u003e{\n  stationOutdoors.traverse(o=\u003e{\n    if(o.name==='pipe-bundle'||o.isMesh\u0026\u0026o.geometry?.type==='BoxGeometry')o.visible=on;\n  });\n};\nstationOutdoors.userData.setTexture=(on)=\u003e{\n  for(const [obj,tex] of [[proxyWest,proxyArmTex],[proxyDrum,proxyDrumTex]]){\n    const skin=obj.children.find(c=\u003ec.isMesh\u0026\u0026c.geometry?.type==='CylinderGeometry');\n    if(skin){\n      skin.material.map=on?tex:null;\n      skin.material.needsUpdate=true;\n    }\n  }\n};\nwindow.__stationOutdoorsProxy=stationOutdoors;\n\nconst exteriorCameraState={position:new THREE.Vector3(),quaternion:new THREE.Quaternion()};\nfunction enterInterior(){\n  if(viewMode==='interior')return;\n  viewMode='interior';\n  exteriorCameraState.position.copy(camera.position);exteriorCameraState.quaternion.copy(camera.quaternion);\n  station.visible=false;interiorRoot.visible=true;\n  interiorYaw=0;interiorPitch=-0.014;interiorDolly=INTERIOR_DOLLY_HOME;interiorCam();\n  const b=document.getElementById('interior');if(b)b.textContent='EXTERIOR';\n}\nfunction exitInterior(){\n  if(viewMode==='exterior')return;\n  viewMode='exterior';interiorRoot.visible=false;station.visible=true;\n  camera.position.copy(exteriorCameraState.position);camera.quaternion.copy(exteriorCameraState.quaternion);\n  const b=document.getElementById('interior');if(b)b.textContent='INTERIOR';\n}\ndocument.getElementById('interior')?.addEventListener('click',()=\u003eviewMode==='exterior'?enterInterior():exitInterior());\n\n\ntry {\n// EXPEDITION E2: independent improvement inside the existing Orbital lab.\n// Legacy exterior and the entire room / lander / orrery remain available.\nconst expedition=(()=\u003e{\nconst V=(a)=\u003enew THREE.Vector3(...a),Q=()=\u003enew THREE.Quaternion(),Z=new THREE.Vector3(0,0,1),Y=new THREE.Vector3(0,1,0),TAU=Math.PI*2;\nconst $=id=\u003edocument.getElementById(id),legacyRoots=[...station.children],legacyModules=new Map(modules);\nconst registry=new Map(),links=[],catalog={},root=new THREE.Group();root.name='expedition-architecture';station.add(root);\nconst expeditionFill=new THREE.HemisphereLight(0xa6b6ce,0x465565,.8);scene.add(expeditionFill);\nrenderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.shadowMap.autoUpdate=false;renderer.shadowMap.needsUpdate=true;sun.castShadow=true;sun.position.set(-22,35,24);sun.shadow.mapSize.set(1536,1536);Object.assign(sun.shadow.camera,{left:-26,right:26,top:26,bottom:-26,near:1,far:100});sun.shadow.bias=-.00015;sun.shadow.normalBias=.018;\nlet sequence=0,current='habitat',chosen=null,solo=false,portOverlay=false,selectionBox=null,portsGroup=new THREE.Group();scene.add(portsGroup);\nconst stats={rejectedDetails:0,buildMS:0};\nconst geo={box:new THREE.BoxGeometry(1,1,1),cyl:new THREE.CylinderGeometry(1,1,1,12),oct:new THREE.CylinderGeometry(1,1,1,8),sphere:new THREE.SphereGeometry(1,16,10),ring:new THREE.TorusGeometry(1,.075,6,24)};\nconst bevelProfile=new THREE.Shape();bevelProfile.moveTo(-.42,-.42);bevelProfile.lineTo(.4