t seam=1.-smoothstep(.009,.009+max(aa.x,aa.y)*1.5,min(d.x,d.y));\nvec2 bolt=abs(d-vec2(.045));float fastener=1.-smoothstep(.012,.012+max(aa.x,aa.y),length(bolt));\nfloat plateTone=(fhash(cell)-.5)*.11;float scuff=pow(max(0.,sin(fp.x*70.+fhash(cell)*30.)),24.)*.025;\nfactoryMask=clamp(seam*.33+fastener*.45,0.,.55);\ndiffuseColor.rgb*=1.+factorySurface*(plateTone-factoryMask-scuff);\n`:''}\n`);};a.customProgramCacheKey=()=\u003eString(styles[kind]);return a;}\nfunction def(id,label,family,spec){catalog[id]={id,label,family,...spec};}\nconst pp=(name,p,n,kind='pressure',size=kind==='frame'?.42:.48)=\u003e({name,p:V(p),n:V(n),kind,size,occupied:null});\nfunction axialPorts(length,r=.48){return[pp('aft',[0,0,-length/2-.32],[0,0,-1],'pressure',r),pp('fore',[0,0,length/2+.32],[0,0,1],'pressure',r)]}\nfunction mounting(z=0,y=-1){return pp('mount',[0,y,z],[0,-1,0],'frame',.42)}\nfunction framePorts(w,h,d){return[pp('aft',[0,0,-d/2-.18],[0,0,-1],'frame',.42),pp('fore',[0,0,d/2+.18],[0,0,1],'frame',.42),pp('left',[-w/2-.18,0,0],[-1,0,0],'frame',.42),pp('right',[w/2+.18,0,0],[1,0,0],'frame',.42),pp('top',[0,h/2+.18,0],[0,1,0],'frame',.42),pp('bottom',[0,-h/2-.18,0],[0,-1,0],'frame',.42)]}\nfor(const [id,label,angles,vertical] of [\n ['elbow','Elbow chamber',[0,90],false],['tee','T chamber',[0,90,180],false],['wye','Y chamber',[0,120,240],false],['cross','Orthogonal cross',[0,90,180,270],false],['six-axis','Cross + vertical',[0,90,180,270],true],['radial-six','Radial six',[0,60,120,180,240,300],false],['octagon','Octagonal hub + poles',[0,45,90,135,180,225,270,315],true]\n])def(id,label,'junction',{angles,vertical,r:id==='octagon'?2.05:id==='radial-six'?1.65:1.12,h:id==='octagon'?1.65:1.2});\ndef('arm','Pressure arm','pressure',{r:.62,l:3.4});def('long-arm','Long pressure arm','pressure',{r:.62,l:6});def('adapter','Scale adapter','adapter',{l:1.35});\nfor(const [id,label,r,l,shape] of [['short-drum','Short habitat drum',1.35,2,'drum'],['long-drum','Long habitat drum',1.3,4.4,'dr