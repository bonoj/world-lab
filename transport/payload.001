r(let j=0;j\u003c5;j++){const xx=x+(r()-.5)*2,zz=z+(r()-.5)*2;emit('ground','rock','rock',[xx,-.03,zz],[.12+r()*.4,.09+r()*.22,.14+r()*.3],[r(),r()*6,r()],.8+r()*.35)}if(r()\u003c.48\u0026\u0026Math.abs(z)\u003e2.9)foliage('ground',x,.15,z,.45+r()*.45,r);}}\n if(full)for(let i=0;i\u003c100;i++){const x=(r()-.5)*30,z=(r()-.5)*23;if(state.ground!=='channel'\u0026\u0026(x/13)**2+(z/9)**2\u003c1.1)continue;if(state.ground==='channel'\u0026\u0026Math.abs(x)\u003e2.8\u0026\u0026Math.abs(z)\u003c8)continue;box('ground','water',x,-.635,z,.4+r()*1.4,.008,.018+r()*.02,[0,0,0],1.2+r()*.2);}}\nfunction roof(a,r){const {id,p:[x,y,z],s:[w,h,d],age,mat}=a;\n // Same cap primitive for every parent: a triangular prism, not a building class.\n const shape=new THREE.Shape();shape.moveTo(-w/2,-h/2);shape.lineTo(w/2,-h/2);shape.lineTo(0,h/2);shape.closePath();const geo=new THREE.ExtrudeGeometry(shape,{depth:d,bevelEnabled:false,steps:1});geo.translate(x,y,z-d/2);const mesh=new THREE.Mesh(geo,full?materials[mat]:plain);mesh.userData.owner=id;mesh.castShadow=mesh.receiveShadow=true;owned.get(id).add(mesh);\n if(!full)return;\n const slope=Math.atan2(h,w/2),length=Math.hypot(h,w/2),rows=Math.ceil(length/.29),cols=Math.ceil(d/.43);\n for(const side of [-1,1])for(let i=0;i\u003crows;i++)for(let j=0;j\u003ccols;j++){\n const u=(i+.5)/rows,v=(j+.5)/cols;if(r()\u003cage*.045)continue;const xx=x+side*w*.5*u,yy=y+h*.5-h*u+.06,zz=z-d/2+d*v;emit(id,'box',mat,[xx,yy,zz],[length/rows*1.12,.065,d/cols*.96],[0,0,-side*slope+r()*.018],.72+r()*.5);}\n for(let j=0;j\u003ccols;j++)box(id,mat,x,y+h/2+.1,z-d/2+(j+.5)*d/cols,.24,.17,d/cols*.96,[0,0,0],.85+r()*.3);\n for(const zz of [z-d/2,z+d/2])for(const side of [-1,1])beam(id,'timber',[x,y+h/2+.02,zz],[x+side*w/2,y-h/2,zz],.14);\n}\nfunction surface(a,r){const {id,p:[x,y,z],s:[w,h,d],mat,age}=a;\n const base=mat==='stone'?'dark':mat;box(id,full?base:'plain',x,y,z,w,h,d);if(!full)return;\n const course=mat==='stone'?.37:mat==='timber'?.3:.65;\n // Two face pairs share one subdivision grammar, with region-specific proportions.\n for(let f=0;f\u003c4;f++){const alongX=f\u003c2,sign=f%2?1:-1,len=alongX?w:d,rows=Math.max(1,Math.floor(h/course)),cols=Math.max(1,Math.floor(len/(mat==='stone'?.72:mat==='timber'?.65:.7)));\n for(let iy=0;iy\u003crows;iy++)for(let ix=0;ix\u003ccols;ix++){const yy=y-h/2+(iy+.5)*h/rows,uu=-len/2+(ix+.5)*len/cols;const patch=Math.sin(ix*.9+f*2)+Math.cos(iy*.7+f);if(mat==='stone'\u0026\u0026iy===rows-1\u0026\u0026r()\u003cage*.14)continue;const tint=.77+r()*.38-(patch\u003e1.1?age*.14:0);const xx=alongX?x+uu:x+sign*(w/2+.018),zz=alongX?z+sign*(d/2+.018):z+uu;emit(id,'box',mat,[xx,yy,zz],alongX?[len/cols*.94,h/rows*.91,.09]:[.09,h/rows*.91,len/cols*.94],[0,0,(r()-.5)*age*.026],tint);\n if(patch\u003e1.15\u0026\u0026r()\u003cage*.4){box(id,'moss',xx,yy,zz+(alongX?sign*.052:0),alongX?len/cols*.7:.13,h/rows*.3,alongX?.13:len/cols*.7);}}\n // Openings sit inside a dark frame; dark area is an inset illusion, no expensive boolean.\n if(h\u003e1.7\u0026\u0026len\u003e1.8){const n=Math.max(1,Math.floor(len/1.8));for(let i=0;i\u003cn;i++){const u=-len/2+len*(i+.5)/n,yy=y+.12,xx=alongX?x+u:x+sign*(w/2+.08),zz=alongX?z+sign*(d/2+.08):z+u;\n box(id,'dark',xx,yy,zz,alongX?.58:.08,.88,alongX?.08:.58);\n for(const edge of [-1,1])box(id,'timber',xx+(alongX?edge*.33:sign*.02),yy,zz+(alongX?sign*.02:edge*.33),alongX?.09:.17,1.02,alongX?.17:.09);\n box(id,'timber',xx,yy+.48,zz,alongX?.75:.17,.12,alongX?.17:.75);\n const p0=alongX?[xx,yy-.48,zz+sign*.03]:[xx+sign*.03,yy-.48,zz];emit(id,'box','edge',p0,alongX?[.77,.12,.23]:[.23,.12,.77]);\n if(r()\u003e.3+age*.3)box(id,'warm',xx+(alongX?0:sign*.05),yy-.06,zz+(alongX?sign*.05:0),alongX?.23:.025,.48,alongX?.025:.23);\n }}\n if(mat==='timber'){for(const u of [-len/2+.1,0,len/2-.1]){const xx=alongX?x+u:x+sign*(w/2+.1),zz=alongX?z+sign*(d/2+.1):z+u;box(id,'dark',xx,y,zz,alongX?.13:.14,h,alongX?.14:.13);}const xx=alongX?x:x+sign*(w/2+.1),zz=alongX?z+sign*(d/2+.1):z;box(id,'dark',xx,y-h*.3,zz,alongX?w:.15,.12,alongX?.15:d);}\n }\n // Eave/coping edge provides a readable light-dark pair across material changes.\n box(id,mat,x,y+h/2+.05,z,w+.18,.14,d+.18);\n if(age\u003e.2){const count=Math.floor(age*23);for(let i=0;i\u003ccount;i++){const side=i%2?1:-1,xx=x+side*w/2+(r()-.5)*.3,zz=z+(r()-.5)*d,yy=y-h/2+r()*h*.8;foliage(id,xx,yy,zz,.12+r()*.16,r);}\n for(let i=0;i\u003cage*12;i++){const side=i%2?1:-1;emit(id,'rock',mat,[x+side*(w/2+.1+r()*.55),y-h/2-.08,z+(r()-.5)*(d+1)],[.12+r()*.2,.1+r()*.16,.12+r()*.2],[r(),r(),r()],.75+r()*.3);}}\n}\nfunction span(a,r){const {id,p:[x,y,z],s:[w,h,d],mat,age}=a;\n // An arch is one extruded spandrel silhouette; a timber span uses beam structure.\n if(mat==='stone'){\n const shape=new THREE.Shape();shape.moveTo(-w/2,h/2);shape.lineTo(w/2,h/2);shape.lineTo(w/2,-h/2);for(let i=0;i\u003c=24;i++){const t=Math.PI*i/24;shape.lineTo(Math.cos(t)*w/2,-h/2+Math.sin(t)*h*.82);}shape.closePath();const g=new THREE.ExtrudeGeometry(shape,{depth:d,bevelEnabled:false,steps:1});g.translate(x,y,z-d/2);const mesh=new THREE.Mesh(g,full?materials.stone:plain);mesh.userData.owner=id;mesh.castShadow=mesh.receiveShadow=true;owned.get(id).add(mesh);\n if(full)for(const side of [-1,1])for(let i=0;i\u003c24;i++){const t=(i+.5)*Math.PI/24,xx=x+Math.cos(t)*w/2,yy=y-h/2+Math.sin(t)*h*.82;box(id,'edge',xx,yy,z+side*(d/2+.02),w/24*.9,.18,.12,[0,0,Math.atan2(-h*.82*Math.cos(t),w/2*Math.sin(t))],.75+r()*.4);}\n }else{box(id,full?mat:'plain',x,y+h*.25,z,w,h*.3,d);if(full)for(const side of [-1,1]){beam(id,mat,[x-w/2,y-h/2,z+side*d*.4],[x+w/2,y+h*.25,z+side*d*.4],.22);beam(id,mat,[x-w/2,y+h*.25,z+side*d*.4],[x+w/2,y-h/2,z+side*d*.4],.22);}}\n if(!full)return;\n const count=Math.ceil(w/.35);for(let i=0;i\u003ccount;i++){const xx=x-w/2+(i+.5)*w/count;box(id,mat,xx,y+h/2+.06,z,w/count*.94,.12,d+.12,[0,0,(r()-.5)*age*.045],.8+r()*.4);for(const side of [-1,1])if(r()\u003eage*.26){box(id,mat,xx,y+h/2+.34,z+side*d/2,w/count*.94,.48,.22,[0,0,(r()-.5)