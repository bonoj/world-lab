setFromUnitVectors(Z,V(n));if(k%3===0){bpart(m,'detail','frame',p,[.27,.42,.06],q,.85+random()*.25);for(let j=0;j\u003c3;j++)bpart(m,'detail','dark',[p[0]+n[0]*.04,p[1]+n[1]*.04,z+(j-1)*.095],[.18,.035,.035],q);}else if((k+iz)%4===0)bpart(m,'detail','hull',p,[.38,.5,.04],q,.8+random()*.22);}}\n for(const a of [Math.PI*.2,Math.PI*1.2]){const x=Math.sin(a)*(r+.12),y=Math.cos(a)*(r+.12);bundle(m,[x,y,-l*.39],[x,y,l*.39]);for(let k=0;k\u003cbands;k++)bpart(m,'detail','frame',[x+.075,y,-l*.39+k*l*.78/(bands-1)],[.28,.07,.1]);}\n}\nfunction flatDetail(m,w,h,l,glazed){\n const rand=mulberry32(hashSeed(m.id));for(const side of [-1,1]){\n bundle(m,[side*w*.27,h/2+.09,-l*.39],[side*w*.27,h/2+.09,l*.39]);\n for(let j=0;j\u003cMath.max(2,Math.floor(l/.65));j++){const z=-l*.34+j*.65;cabinet(m,[side*w*.27,h/2+.17,z],[.38,.22,.4]);if(!glazed){const q=Q().setFromUnitVectors(Z,new THREE.Vector3(side,0,0));for(const y of [-h*.25,h*.24]){bpart(m,'detail','frame',[side*(w/2+.045),y,z],[.37,.28,.075],q,.8+rand()*.2);for(let k=0;k\u003c3;k++)bpart(m,'detail','dark',[side*(w/2+.09),y+(k-1)*.065,z],[.025,.025,.27]);}}}\n }\n}\nfunction glazedBay(m,w,h,l,kind){\n const roomLamp=new THREE.PointLight(0xffcb89,3.2,Math.max(w,l)*1.4,2);roomLamp.position.set(0,h*.15,0);roomLamp.userData={owner:m.id,role:'interior practical'};m.root.add(roomLamp);\n // A real open-sided shell, opaque floor/roof/rear and transparent glazing; shallow interior survives orbit.\n bpart(m,'form','hull',[0,-h/2,0],[w,.18,l]);bpart(m,'form','hull',[0,h/2,0],[w,.18,l]);for(const z of [-l/2,l/2])bpart(m,'form','hull',[0,0,z],[w,h,.16]);\n for(const side of [-1,1]){bpart(m,'form','glass',[side*w/2,0,0],[.025,h*.84,l*.91]);for(let j=0;j\u003c=4;j++)rod(m,'form','frame',[side*(w/2+.025),-h/2,-l/2+j*l/4],[side*(w/2+.025),h/2,-l/2+j*l/4],.055);for(const y of [-h/2,h/2])rod(m,'form','frame',[side*w/2,y,-l/2],[side*w/2,y,l/2],.07);}\n bpart(m,'form','deck',[0,-h/2+.13,0],[w*.9,.06,l*.92]);\n for(let j=0;j\u003c3;j++){const z=(j-1)*l*.26;if(kind==='garden'){bpart(m,'form','dark',[0,-h/2+.3,z],[w*.68,.2,.55]);for(let k=0;k\u003c5;k++)part(m,'form','sphere','green',[(k-2)*w*.12,-h/2+.52,z],[.18,.3,.18]);}else{bpart(m,'form','frame',[w*.13,-h/2+.48,z],[w*.36,.09,.48]);rod(m,'form','frame',[w*.13,-h/2+.14,z],[w*.13,-h/2+.48,z],.045);bpart(m,'form','orange',[-w*.24,-h/2+.28,z],[.42,.28,.4]);}}\n for(const z of [-l*.3,l*.3])bpart(m,'form','warm',[0,h/2-.13,z],[w*.35,.045,.1]);\n}\nfunction pressureBody(m,s){const r=s.r,l=s.l;\n if(s.family==='habitat'\u0026\u0026['box','window','garden'].includes(s.shape)){\n if(s.shape==='box'){bpart(m,'form','hull',[0,0,0],[r*1.8,r*1.55,l]);for(const x of [-r*.94,r*.94])for(const y of [-r*.8,r*.8])rod(m,'form','frame',[x,y,-l/2],[x,y,l/2],.08);for(let z=-l*.35;z\u003cl*.4;z+=.8){for(const side of [-1,1]){bpart(m,'form','dark',[side*r*.907,.1,z],[.04,.48,.58]);bpart(m,'form','warm',[side*r*.931,.1,z],[.025,.29,.43]);}}for(const side of [-1,1])for(let z=-l*.3;z\u003cl*.4;z+=.7)cabinet(m,[side*r*.72,-r*.3,z],[.4,.32,.2]);}\n else glazedBay(m,r*1.8,r*1.55,l,s.shape);\n }else{if(s.shape==='pod')part(m,'form','sphere','hull',[0,0,0],[r,r,l/2+.24]);else cyl(m,'form','hull',[0,0,0],r,l);for(const z of [-l/2,l/2]){if(s.shape!=='pod')part(m,'form','sphere','hull',[0,0,z],[r,r,.15]);ringPart(m,'form','frame',[0,0,z],[0,0,1],s.shape==='pod'?.6:r*1.01)}if(s.family==='habitat'\u0026\u0026s.shape!=='utility'){for(const a of [.3,1,2.1,3.7,4.7,5.5]){const n=[Math.sin(a),Math.cos(a),0],q=Q().setFromUnitVectors(Z,V(n));bpart(m,'form','dark',[n[0]*(r+.03),n[1]*(r+.03),0],[.5,.62,.06],q);bpart(m,'form','warm',[n[0]*(r+.065),n[1]*(r+.065),0],[.31,.39,.03],q);}}}\n const rect=['box','window','garden'].includes(s.shape);\n if(rect){const x=r*.9+.07,y=r*.775+.07;for(const z of [-l*.35,l*.35]){for(const side of [-1,1]){rod(m,'form','frame',[-x,side*y,z],[x,side*y,z],.055);rod(m,'form','frame',[side*x,-y,z],[side*x,y,z],.055);}}for(const sx of [-1,1])for(const sy of [-1,1])rod(m,'form','orange',[sx*x,sy*y,-l*.46],[sx*x,sy*y,l*.46],.035);flatDetail(m,r*1.8,r*1.55,l,s.shape!=='box');}\n else{for(const z of [-l*.35,l*.35])ringPart(m,'form','frame',[0,0,z],[0,0,1],r+.06);for(const a of [.8,2.34,3.94,5.5])rod(m,'form','orange',[Math.sin(a)*(r+.16),Math.cos(a)*(r+.16),-l*.42],[Math.sin(a)*(r+.16),Math.cos(a)*(r+.16),l*.42],.035);hullDetail(m,r,l);}\n if(s.family==='habitat'){\n // Ladder, service ledge and repeated mounting shoes are one organized access lane.\n const side=-(rect?r*.9:r)-.16;for(const z of [-l*.25,l*.25]){rod(m,'detail','frame',[side,-r*.7,z],[side,r*.7,z],.025);for(let i=0;i\u003c7;i++)rod(m,'detail','frame',[side,-r*.65+i*r*.21,z-.14],[side,-r*.65+i*r*.21,z+.14],.02);}\n bpart(m,'detail','deck',[side,-r*.72,0],[.42,.055,l*.7]);for(let i=0;i\u003c4;i++){const z=-l*.3+i*l*.2;rod(m,'detail','frame',[-r*.86,-r*.6,z],[side-.18,-r*.72,z],.035);}\n if(s.shape==='utility'||s.shape==='box')for(const side of [-1,1]){for(let i=0;i\u003c9;i++)bpart(m,'detail','frame',[side*(r+.32),-r*.16,-l*.27+i*l*.067],[.42,.62,.055]);}\n }\n\n if(s.shape==='utility'){for(const side of [-1,1]){cyl(m,'form','frame',[side*(r+.18),0,0],.23,l*.66);for(const z of [-l*.22,l*.22])ringPart(m,'detail','orange',[side*(r+.18),0,z],[0,0,1],.25);}}\n}\nfunction junctionBody(m,s){const sides=s.id==='octagon'?8:12;part(m,'form',sides===8?'oct':'cyl','hull',[0,0,0],[s.r/Math.cos(Math.PI/sides),s.h,s.r/Math.cos(Math.PI/sides)],Q().setFromAxisAngle(Y,-Math.PI/sides));for(const y of [-s.h/2,s.h/2])ringPart(m,'form','frame',[0,y,0],[0,1,0],s.r+.04);\n for(let i=0;i\u003cs.angles.length;i++){const a=(s.angles[i]+(360/s.angles.length)/2)*Math.PI/180,x=Math.sin(a)*s.r,z=Math.cos(a)*s.r;rod(m,'form','orange',[x,-s.h/2,z],[x,s.h/2,z],.05);const n=[Math.sin(a),0,Math.cos(a)],q=Q().setFromUnitVectors(Z,V(n));for(const y of [-.23,.23])bpart(m,'detail','frame',[x,y,z],[.24,.18,.1],q);}\n for(const x of [-s.r*.5,s.r*.5]){bundle(m,[x,s.h/2+.09,-s.r*.6],[x,s.h/2+.09,s.r*.6]);cabinet(m,[x,s.h/2+.18,0],[.45,.28,.4]);}\n}\nfunction rail(m,a,b){rod(m,'form','frame',a,b,.027);const A=V(a),D=V(b).sub(A),n=Math.ceil(D.length()/.8);for(let i=0;i\u003c=n;i++){const p=A.clone().addScaledVector(D,i/n);rod(m,'form','frame',[p.x,p.y-.55,p.z],p.toArray(),.025)}}\nfunction crane(m,offset=[0,0,0]){const p=(x,y,z)=\u003e[x+offset[0],y+offset[1],z+offset[2]];cyl(m,'form','frame',p(0,.35,0),.48,.7,[0,1,0]);cyl(m,'form','orange',p(0,.75,0),.52,.18,[0,1,0]);bpart(m,'form','hull',p(-.1,1.13,.05),[.75,.65,.75]);bpart(m,'form','glass',p(-.1,1.2,.44),[.52,.34,.025]);\n const a=p(0,1.4,0),b=p(1.1,3.1,-1.9);for(const off of [-.13,.13])rod(m,'form','orange',[a[0]+off,a[1],a[2]],[b[0]+off,b[1],b[2]],.065);for(let i=0;i\u003c9;i++){const t=i/9,u=(i+1)/9;rod(m,'form','orange',[a[0]+(b[0]-a[0])*t-.13,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t],[a[0]+(b[0]-a[0])*u+.13,a[1]+(b[1]-a[1])*u,a[2]+(b[2]-a[2])*u],.024);}rod(m,'form','dark',p(-.6,1.5,.7),b,.018);rod(m,'form','frame',b,[b[0],b[1]-1,b[2]],.022);ringPart(m,'form','orange',[b[0],b[1]-1.06,b[2]],[0,0,1],.12);bpart(m,'form','frame',p(-.6,1.2,.9),[.5,.5,.55]);}\nfunction platformBody(m,s){const {w,h,d,role}=s;truss(m,w-.15,h,d-.15,[0,-h*.08,0]);bpart(m,'form','deck',[0,h/2,0],[w,.12,d]);\n // Port corridors interrupt edge rails and planned equipment zones rather than clipping afterward.\n for(const x of [-w/2,w/2])for(const sign of [-1,1])rail(m,[x,h/2+.66,sign*.8],[x,h/2+.66,sign*d/2]);for(const z of [-d/2,d/2])for(const sign of [-1,1])rail(m,[sign*.8,h/2+.66,z],[sign*w/2,h/2+.66,z]);\n for(const x of [-w*.22,w*.22]){rod(m,'form','frame',[x,h/2+.11,-d*.43],[x,h/2+.11,d*.43],.045);for(let j=0;j\u003c5;j++)bpart(m,'detail','orange',[x,h/2+.15,-d*.36+j*d*.18],[.045,.01,.22]);}\n for(let i=0;i\u003cMath.floor(d/.75);i++){const z=-d*.4+i*.75;for(const side of [-1,1]){cabinet(m,[side*(w/2-.18),-.08,z],[.28,.32,.45]);bpart(m,'detail','orange',[side*(w/2-.1),h/2+.075,z],[.09,.012,.35]);}}\n for(const x of [-w/2+.22,w/2-.22]){bundle(m,[x,-h/2+.04,-d*.4],[x,-h/2+.04,d*.4]);lamp(m,x,h/2,-d/2+.22)}\n if(role==='yard'||role==='cargo'){for(const x of [-w*.3,w*.3])for(const z of [-d*.23,d*.25])cargo(m,[x,h/2+.09,z],role==='yard'?.82:1);}\n if(role==='crane')crane(m,[w*.23,h/2+.06,0]);\n if(role==='service'||role==='equipment'){for(let i=0;i\u003c3;i++){const x=(i-1)*w*.25;cyl(m,'form','hull',[x,h/2+.43,-d*.26],.28,.85,[0,1,0]);cabinet(m,[x,h/2+.4,d*.23],[.65,.6,.45]);bundle(m,[x,-h*.15,-d*.2],[x,-h*.15,d*.23]);}}\n if(role==='receiving'){for(const z of [-d*.25,d*.25])for(const x of [-w*.28,w*.28])bpart(m,'form','orange',[x,h/2+.2,z],[.25,.28,.25]);}\n if(role==='airlock'){bpart(m,'form','hull',[0,h/2+.55,-d*.22],[1.4,1.05,1.1]);bpart(m,'form','dark',[0,h/2+.55,-d*.22+.56],[.6,.8,.03]);for(let i=0;i\u003c4;i++)bpart(m,'form','frame',[0,h/2+.05-i*.1,.4+i*.25],[.9,.12,.27]);}\n}\nfunction endBody(m,s){cyl(m,'form','hull',[0,0,.18],.67,.4);ringPart(m,'form','frame',[0,0,.34],[0,0,1],.65);\n if(s.role==='window'){cyl(m,'form','dark',[0,0,.395],.49,.05);cyl(m,'form','glass',[0,0,.44],.46,.045);bpart(m,'form','warm',[0,-.24,.427],[.47,.06,.02]);}\n if(s.role==='airlock'){cyl(m,'form','hull',[0,0,.62],.63,.7);ringPart(m,'form','orange',[0,0,.98],[0,0,1],.56);bpart(m,'form','dark',[0,0,1],[.65,.83,.04]);rod(m,'form','frame',[-.43,-.48,.65],[-.43,.48,.65],.028);}\n if(s.role==='dock'){for(const a of [0,TAU/3,TAU*2/3]){const x=Math.sin(a),y=Math.cos(a);rod(m,'form','orange',[x*.5,y*.5,.3],[x*.72,y*.72,1],.065);bpart(m,'form','frame',[x*.72,y*.72,1],[.18,.18,.15]);}ringPart(m,'form','frame',[0,0,.78],[0,0,1],.65);}\n if(s.role==='service'){for(const x of [-.35,.35])cyl(m,'form','frame',[x,0,.6],.2,.65);cabinet(m,[0,0,.5],[.45,.55,.3]);}\n if(s.role==='plain')bpart(m,'detail','orange',[0,0,.401],[.4,.08,.02]);\n}\nfunction machineBody(m,s){if(s.role==='crane')crane(m);else if(s.role==='mast'){cyl(m,'form','frame',[0,.08,0],.45,.18,[0,1,0]);rod(m,'form','frame',[0,.1,0],[0,4,0],.095);for(let i=0;i\u003c7;i++){rod(m,'detail','orange',[-.18,.4+i*.45,0],[.18,.4+i*.45,0],.022)}for(const y of [2.6,3.5]){rod(m,'form','frame',[-.7,y,0],[.7,y,0],.04);bpart(m,'form','hull',[.7,y,0],[.32,.22,.4]);}part(m,'form','sphere','hull',[0,4.12,0],[.28,.28,.28]);}else{for(const x of [-1.6,1.6]){rod(m,'form','frame',[x,0,0],[x,2.5,0],.1);rod(m,'form','orange',[0,0,0],[x,.35,0],.08);bpart(m,'form','frame',[x,.1,0],[.5,.2,.9]);}rod(m,'form','frame',[-1.7,2.5,0],[1.7,2.5,0],.15);bpart(m,'form','orange',[.4,2.35,0],[.55,.35,.45]);rod(m,'form','dark',[.4,2.2,0],[.4,1.25,0],.026);ringPart(m,'form','orange',[.4,1.15,0],[0,0,1],.15);}}\nfunction hardware(m,p){const q=frameQ(p),pos=p.p,n=p.n,r=p.size;const at=d=\u003epos.clone().addScaledVector(n,d).toArray();\n if(p.kind==='pressure'){cyl(m,'form','frame',at(-.18),r+.105,.34,n.toArray());ringPart(m,'form','hull',at(-.11),n.toArray(),r+.065);ringPart(m,'form','orange',at(-.045),n.toArray(),r+.035);\n // Built-in isolation valve is module anatomy, never an anonymous endcap module.\n const g=new THREE.Mesh(new THREE.CylinderGeometry(r*.97,r*.97,.035,24),new THREE.MeshStandardMaterial({color:0x667783,metalness:.45,roughness:.5}));g.quaternion.setFromUnitVectors(Y,n);g.position.copy(pos).addScaledVector(n,-.07);g.userData={selectableModule:m.id,role:'isolation hatch',state:'closed'};m.root.add(g);p.gate=g;\n for(let i=0;i\u003c8;i++){const off=new THREE.Vector3(Math.cos(i*TAU/8)*(r+.08),Math.sin(i*TAU/8)*(r+.08),-.025).applyQuaternion(q).add(pos);part(m,'form','cyl','dark',off.toArray(),[.032,.055,.032],Q().setFromUnitVectors(Y,n));}\n }else{bpart(m,'form','frame',at(-.065),[r*2.2,r*2.2,.13],q);for(const x of [-1,1])for(const y of [-1,1]){const v=new THREE.Vector3(x*r*.75,y*r*.75,-.09).applyQuaternion(q).add(pos);bpart(m,'form','orange',v.toArray(),[.13,.13,.16],q);}rod(m,'form','frame',at(-.1),at(-.38),.17);}\n}\nfunction flush(m){window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;const mat4=new THREE.Matrix4(),normalMatrix=new THREE.Matrix3(),v=new THREE.Vector3(),n=new THREE.Vector3();for(const [key,parts] of m.batches){const [layer,kind]=key.split('|'),positions=[],normals=[],colors=[],uvs=[];for(const p of parts){mat4.compose(p.p,p.quat,V(p.size));normalMatrix.getNormalMatrix(mat4);const g=geo[p.shape],a=g.attributes.position,b=g.attributes.normal,uv=g.attributes.uv,idx=g.index;const count=idx?idx.count:a.count;for(let j=0;j\u003ccount;j++){const k=idx?idx.getX(j):j;v.fromBufferAttribute(a,k).applyMatrix4(mat4);n.fromBufferAttribute(b,k).applyNormalMatrix(normalMatrix);positions.push(v.x,v.y,v.z);normals.push(n.x,n.y,n.z);colors.push(p.tint,p.tint,p.tint);uvs.push(uv?uv.getX(k):0,uv?uv.getY(k):0);}}\n const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));g.setAttribute('normal',new THREE.Float32BufferAttribute(normals,3));g.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uvs,2));g.computeBoundingSphere();const mesh=new THREE.Mesh(g,material(kind,m));mesh.castShadow=kind!=='glass';mesh.receiveShadow=kind!=='glass';mesh.userData={selectableModule:m.id,owner:m.id,layer,region:kind};m.root.userData.layers[layer==='detail'?'detail':(['structure','platform','machine'].includes(m.s.family)||['frame','orange','dark'].includes(kind)?'structure':'pressure')].add(mesh);m.triangles+=positions.length/9;}\n m.batches.clear();m.root.userData.layers.detail.visible=detailOn;\n}\nfunction make(id,kind){if(registry.has(id))throw Error('Duplicate module '+id);const s=catalog[kind];if(!s)throw Error('Unknown kind '+kind);const g=moduleRoot(id,kind,root);g.userData.expedition=true;g.userData.layers.frame=g.userData.layers.structure;const m={id,kind,s,root:g,ports:portsFor(s),batches:new Map(),surfaces:[],triangles:0};g.userData.ports=m.ports;registry.set(id,m);\n if(s.family==='pressure'||s.family==='habitat')pressureBody(m,s);else if(s.family==='junction')junctionBody(m,s);else if(s.family==='platform')platformBody(m,s);else if(s.family==='structure'){truss(m,s.w,s.h,s.d);if(kind==='beam')bpart(m,'form','frame',[0,0,0],[.3,.5,s.d]);bundle(m,[-s.w*.3,-s.h*.3,-s.d*.42],[-s.w*.3,-s.h*.3,s.d*.42]);}else if(s.family==='machine')machineBody(m,s);else if(s.family==='termination')endBody(m,s);else if(s.family==='adapter'){cyl(m,'form','hull',[0,0,-.32],.62,.72);cyl(m,'form','hull',[0,0,.34],.9,.72);ringPart(m,'form','frame',[0,0,.1],[0,0,1],.86);}\n for(const p of m.ports)hardware(m,p);flush(m);return m;\n}\nfunction port(m,name){const p=m.ports.find(p=\u003ep.name===name);if(!p)throw Error(m.id+' has no port '+name);return p}\nfunction align(a,ap,b,bp,roll=0){window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;root.updateMatrixWorld(true);const aq=a.root.quaternion.clone().multiply(frameQ(ap)),rq=Q().setFromAxisAngle(Z,roll),flip=Q().setFromAxisAngle(Y,Math.PI);b.root.quaternion.copy(aq.multiply(rq).multiply(flip).multiply(frameQ(bp).invert()));b.root.position.copy(ap.p.clone().applyQuaternion(a.root.quaternion).add(a.root.position)).sub(bp.p.clone().applyQuaternion(b.root.quaternion));b.root.updateMatrixWorld(true);}\nfunction connect(a,an,b,bn,roll=0){\n if(!a||!b||a===b)throw Error('Connection requires two distinct modules');if(links.some(l=\u003el.b===b.id))throw Error('Detach child before reconnecting');\n const descendants=[],walk=id=\u003e{for(const l of links.filter(l=\u003el.a===id)){descendants.push(registry.get(l.b));walk(l.b)}};walk(b.id);if(descendants.includes(a))throw Error('Connection would create a cycle');\n const oldPosition=b.root.position.clone(),oldQ=b.root.quaternion.clone();const ap=port(a,an),bp=port(b,bn);if(ap.occupied||bp.occupied)throw Error('Port occupied');if(ap.kind!==bp.kind||Math.abs(ap.size-bp.size)\u003e.001)throw Error('Incompatible interface: '+ap.kind+' '+ap.size+' / '+bp.kind+' '+bp.size);align(a,ap,b,bp,roll);const deltaQ=b.root.quaternion.clone().multiply(oldQ.invert());for(const child of descendants){child.root.position.sub(oldPosition).applyQuaternion(deltaQ).add(b.root.position);child.root.quaternion.premultiply(deltaQ);}const id=a.id+'.'+an+' \u2194 '+b.id+'.'+bn;ap.occupied=bp.occupied=id;if(ap.gate){ap.gate.userData.state='coupled / isolated';bp.gate.userData.state='coupled / isolated'}links.push({id,a:a.id,ap:an,b:b.id,bp:bn,roll});return b;}\nfunction add(id,kind,parent=null,ap=null,bp=null,roll=0){const m=make(id,kind);if(parent)connect(registry.get(parent),ap,m,bp||m.ports[0].name,roll);return m}\nfunction dispose(){for(const m of registry.values()){m.root.traverse(o=\u003e{if(o.isMesh){o.geometry.dispose();o.material.dispose()}});root.remove(m.root);modules.delete(m.id)}registry.clear();links.length=0;}\nfunction hideLegacy(on){for(const r of legacyRoots)r.visible=on;expeditionFill.visible=!on;sun.position.set(...(on?[7,9,11]:[-22,35,24]));}\nfunction armTo(id,parent,portName,kind,roll=0){add(id+'-arm','long-arm',parent,portName,'aft',roll);const spec=catalog[kind],incoming=spec.family==='junction'?'radial-'+spec.angles.reduce((best,a,i)=\u003eMath.abs(a-180)\u003cMath.abs(spec.angles[best]-180)?i:best,0):'aft';return add(id,kind,id+'-arm','fore',incoming)}\nfunction composition(which){const start=performance.now();if(viewMode==='interior')exitInterior();dispose();chosen=null;selected=null;label.classList.remove('show');solo=false;stats.rejectedDetails=0;current=which;$('xp-compose').value=which;hideLegacy(which==='archive');root.visible=which!=='archive';\n if(which==='habitat'){\n add('commons','octagon');armTo('workshop-east','commons','radial-2','workshop');armTo('garden-west','commons','radial-6','greenhouse');add('scale-neck','adapter','commons','radial-7','aft');add('communal-annex','communal','scale-neck','fore','aft');add('annex-cap','cap','communal-annex','fore','inward');armTo('long-house','commons','radial-0','long-drum');add('long-house-window','window-cap','long-house','fore','inward');add('rise','arm','commons','top','aft');add('sky-room','observation','rise','fore','aft');add('sky-dock','dock-cap','sky-room','fore','inward');armTo('branch','commons','radial-4','tee');armTo('quiet-pod','branch','radial-1','pod');add('pod-cap','cap','quiet-pod','fore','inward');add('terminal','service-cap','branch','radial-0','inward');add('yard-spur','truss','commons','frame','aft');add('small-dock','cargo-dock','yard-spur','fore','aft');add('antenna','mast','small-dock','top','foot');add('garden-end','window-cap','garden-west','fore','inward');add('workshop-airlock','airlock-cap','workshop-east','fore','inward');\n }else if(which==='yard'){\n add('yard-core','yard');add('boom-bay','truss','yard-core','fore','aft');add('receiving-bay','receiving','boom-bay','fore','aft');add('gantry-01','gantry','receiving-bay','top','foot');add('cargo-bay','cargo-dock','yard-core','left','aft');add('service-bay','service-dock','yard-core','right','aft');add('crane-01','crane','yard-core','top','foot');add('tower','pylon','yard-core','bottom','aft');add('tower-node','service-frame','tower','fore','aft');add('tower-mast','mast','tower-node','top','foot');add('workshop','workshop','service-bay','fore','mount');add('airlock','airlock-cap','workshop','aft','inward');add('junction','tee','workshop','fore','radial-2');add('quarters','short-drum','junction','radial-0','aft');add('observation-end','window-cap','quarters','fore','inward');add('utility','utility','junction','radial-1','aft');add('service-end','service-cap','utility','fore','inward');\n }else if(which==='radial'){\n add('radial-core','octagon');for(const [i,kind] of [[0,'tee'],[2,'wye'],[4,'six-axis'],[6,'radial-six']]){const id='node-'+i;armTo(id,'radial-core','radial-'+i,kind);add('tip-'+i,['airlock-cap','window-cap','dock-cap','service-cap'][i/2],id,registry.get(id).ports.find(p=\u003ep.kind==='pressure'\u0026\u0026!p.occupied).name,'inward');}add('vertical-link','arm','radial-core','top','aft');add('upper-cross','cross','vertical-link','fore','radial-2');add('upper-pod','pod','upper-cross','radial-0','aft');add('upper-cap','cap','upper-pod','fore','inward');add('under-link','arm','radial-core','bottom','aft');add('under-elbow','elbow','under-link','fore','radial-0');add('lower-arm','arm','under-elbow','radial-1','aft');add('lower-dock','dock-cap','lower-arm','fore','inward');\n }else if(which==='bench'){add('bench-module',$('xp-kind').value||'observation');}\n if(registry.size)chosen=registry.keys().next().value;stats.buildMS=Math.round(performance.now()-start);sync();highlight();home();return inspect();}\nfunction moveBranch(id,delta){const m=registry.get(id);if(links.some(l=\u003el.b===id))throw Error('Detach the branch root before moving it');const visit=k=\u003e{registry.get(k).root.position.add(delta);for(const l of links.filter(l=\u003el.a===k))visit(l.b)};visit(id);highlight();sync();}\nfunction detach(id){const i=links.findIndex(l=\u003el.b===id);if(i\u003c0)return false;const l=links[i];for(const [id,pn] of [[l.a,l.ap],[l.b,l.bp]]){const p=port(registry.get(id),pn);p.occupied=null;if(p.gate)p.gate.userData.state='closed';}links.splice(i,1);const parent=registry.get(l.a),n=port(parent,l.ap).n.clone().applyQuaternion(parent.root.quaternion);moveBranch(id,n.multiplyScalar(1.6));return true;}\nfunction home(){if(viewMode==='interior')return;const box=new THREE.Box3();if(current==='archive'){target.set(0,0,0);radius=14.2;theta=.68;phi=1.18;cam();return}for(const m of registry.values())if(m.root.visible)box.expandByObject(m.root);if(box.isEmpty())return;box.getCenter(target);theta=.63;phi=1.02;const dir=new THREE.Vector3(Math.sin(phi)*Math.sin(theta),Math.cos(phi),Math.sin(phi)*Math.cos(theta)),right=new THREE.Vector3(Math.cos(theta),0,-Math.sin(theta)),up=new THREE.Vector3().crossVectors(dir,right),t=Math.tan(camera.fov*Math.PI/360);radius=6;for(const owner of registry.values()){if(!owner.root.visible)continue;const tight=new THREE.Box3().setFromObject(owner.root);for(const x of [tight.min.x,tight.max.x])for(const y of [tight.min.y,tight.max.y])for(const z of [tight.min.z,tight.max.z]){const v=new THREE.Vector3(x,y,z).sub(target);radius=Math.max(radius,v.dot(dir)+1.15*Math.max(Math.abs(v.dot(right))/(t*camera.aspect),Math.abs(v.dot(up))/t));}}cam();}\nfunction updatePorts(){window.orbitalDirty=true;for(const o of [...portsGroup.children]){portsGroup.remove(o);o.geometry?.dispose();o.material?.dispose()}if(!portOverlay||viewMode!=='exterior')return;for(const m of registry.values()){if(!m.root.visible)continue;for(const p of m.ports){const marker=new THREE.Mesh(new THREE.TorusGeometry(p.size+.16,.022,5,24),new THREE.MeshBasicMaterial({color:p.occupied?0x72bca7:p.kind==='pressure'?0xdda958:0x80b6db}));marker.quaternion.copy(m.root.quaternion).multiply(frameQ(p));marker.position.copy(p.p).applyQuaternion(m.root.quaternion).add(m.root.position);portsGroup.add(marker)}}}\nfunction highlight(){window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;if(selectionBox){scene.remove(selectionBox);selectionBox.geometry.dispose();selectionBox.material.dispose();selectionBox=null}const m=registry.get(chosen);if(m\u0026\u0026m.root.visible){selectionBox=new THREE.BoxHelper(m.root,0xb6c9cc);selectionBox.material.transparent=true;selectionBox.material.opacity=.35;scene.add(selectionBox)}updatePorts();}\nfunction inspect(){root.updateMatrixWorld(true);const errors=[];let maxGap=0,minFacing=1;for(const l of links){const a=registry.get(l.a),b=registry.get(l.b),ap=port(a,l.ap),bp=port(b,l.bp),aw=ap.p.clone().applyQuaternion(a.root.quaternion).add(a.root.position),bw=bp.p.clone().applyQuaternion(b.root.quaternion).add(b.root.position);maxGap=Math.max(maxGap,aw.distanceTo(bw));const facing=-ap.n.clone().applyQuaternion(a.root.quaternion).dot(bp.n.clone().applyQuaternion(b.root.quaternion));minFacing=Math.min(minFacing,facing);if(facing\u003c.9999)errors.push(l.id+' normals');}\n return{composition:current,modules:registry.size,connections:links.length,catalog:Object.keys(catalog).length,maxGap,minFacing,errors,triangles:[...registry.values()].reduce((n,m)=\u003en+m.triangles,0),rejectedDetails:stats.rejectedDetails,buildMS:stats.buildMS,drawCalls:renderer.info.render.calls,geometries:renderer.info.memory.geometries,camera:{radius,theta,phi,target:target.toArray()},graph:[...registry.values()].map(m=\u003e({id:m.id,kind:m.kind,position:m.root.position.toArray(),quaternion:m.root.quaternion.toArray(),ports:m.ports.map(p=\u003e({name:p.name,kind:p.kind,size:p.size,occupied:p.occupied,local:p.p.toArray(),normal:p.n.toArray(),gate:p.gate?.userData.state}))})),links:links.map(l=\u003e({...l}))};}\nfunction sync(){const own=$('xp-owner');own.innerHTML='';for(const m of registry.values()){const o=document.createElement('option');o.value=m.id;o.textContent=m.id;own.append(o)}own.value=chosen||'';const m=registry.get(chosen),pSel=$('xp-port');pSel.innerHTML='';if(m)for(const p of m.ports){const o=document.createElement('option');o.value=p.name;o.textContent=p.name+' \u00b7 '+p.kind+(p.occupied?' \u00b7 joined':' \u00b7 free');pSel.append(o)}$('xp-readout').textContent=m?catalog[m.kind].label+'\\n'+m.ports.length+' interfaces \u00b7 '+Math.round(m.triangles).toLocaleString()+' triangles\\n'+m.ports.map(p=\u003ep.name+': '+(p.occupied||'free / '+(p.kind==='pressure'?'isolated':'docking plate'))).join('\\n'):'Original V1.65 exterior and interior preserved.';$('xp-status').textContent=registry.size+' modules \u00b7 '+links.length+' joints \u00b7 '+Object.keys(catalog).length+' kinds';$('xp-solo').textContent=solo?'Show assembly':'Isolate';$('xp-detach').disabled=!links.some(l=\u003el.b===chosen);$('xp-nudge').disabled=!m||links.some(l=\u003el.b===chosen);}\nfunction guard(fn){return(...a)=\u003e{try{$('fault').textContent='';$('fault').style.display='none';fn(...a)}catch(e){window.orbitalFail('construction operation',e)}}}\nfor(const [id,s] of Object.entries(catalog)){const o=document.createElement('option');o.value=id;o.textContent=s.label;$('xp-kind').append(o)}$('xp-kind').value='observation';\n$('xp-compose').onchange=guard(()=\u003ecomposition($('xp-compose').value));$('xp-tools').onclick=()=\u003e{$('xp-panel').classList.toggle('open');$('xp-tools').setAttribute('aria-expanded',String($('xp-panel').classList.contains('open')))};\nfunction choose(id){chosen=id;selected=registry.get(chosen)?.root;if(solo)for(const m of registry.values())m.root.visible=m.id===chosen;sync();highlight()}\n$('xp-owner').onchange=guard(()=\u003echoose($('xp-owner').value));$('xp-ports').onclick=guard(()=\u003e{portOverlay=!portOverlay;$('xp-ports').classList.toggle('on',portOverlay);updatePorts()});$('xp-home').onclick=guard(home);\n$('xp-study').onclick=guard(()=\u003e{$('xp-compose').value='bench';composition('bench')});$('xp-solo').onclick=guard(()=\u003e{solo=!solo;for(const m of registry.values())m.root.visible=!solo||m.id===chosen;highlight();sync()});\n$('xp-add').onclick=guard(()=\u003e{const a=registry.get(chosen);if(!a)throw Error('Select an expansion module');const ap=port(a,$('xp-port').value),kind=$('xp-kind').value,s=catalog[kind],candidate=portsFor(s).find(p=\u003ep.kind===ap.kind\u0026\u0026p.size===ap.size);if(ap.occupied)throw Error('Choose a free interface');if(!candidate)throw Error('No matching '+ap.kind+' / '+ap.size+' interface on '+s.label);if(registry.size\u003e=60)throw Error('This pass caps assemblies at 60 modules');const b=add('added-'+(++sequence),kind);connect(a,ap.name,b,candidate.name);chosen=b.id;solo=false;for(const m of registry.values())m.root.visible=true;sync();highlight()});\n$('xp-detach').onclick=guard(()=\u003e{detach(chosen);sync();highlight()});$('xp-nudge').onclick=guard(()=\u003emoveBranch(chosen,new THREE.Vector3(1,0,0)));\n$('xp-roll').onclick=guard(()=\u003e{const l=links.find(l=\u003el.b===chosen);if(!l)throw Error('Select a connected branch to roll');l.roll+=Math.PI/2;const visit=link=\u003e{align(registry.get(link.a),port(registry.get(link.a),link.ap),registry.get(link.b),port(registry.get(link.b),link.bp),link.roll);for(const child of links.filter(k=\u003ek.a===link.b))visit(child)};visit(l);sync();highlight()});\nconst previousDetail=$('greeble').onclick;$('greeble').onclick=()=\u003e{previousDetail();window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;};\nconst originalTexture=setAllTextures;setAllTextures=function(on){window.orbitalDirty=true;originalTexture(on);for(const m of registry.values())for(const u of m.surfaces)u.value=on?1:0};\nconst originalModuleTexture=setModuleTexture;setModuleTexture=function(id,on){window.orbitalDirty=true;if(registry.has(id)){for(const u of registry.get(id).surfaces)u.value=on?1:0}else originalModuleTexture(id,on)};\nconst originalSelect=selectAt;selectAt=function(x,y){originalSelect(x,y);if(selected?.userData.expedition){chosen=selected.name;sync();highlight()}};\nconst originalEnter=enterInterior,originalExit=exitInterior;enterInterior=function(){originalEnter();expeditionFill.visible=false;sun.position.set(7,9,11);portsGroup.visible=false;if(selectionBox)selectionBox.visible=false;$('xp-top').style.display='none';$('xp-panel').classList.remove('open')};exitInterior=function(){originalExit();window.orbitalDirty=true;expeditionFill.visible=current!=='archive';sun.position.set(...(current==='archive'?[7,9,11]:[-22,35,24]));portsGroup.visible=true;if(selectionBox)selectionBox.visible=true;$('xp-top').style.display='flex';onResize()};\nconst originalReset=$('reset').onclick;$('reset').onclick=()=\u003eviewMode==='interior'?originalReset():home();\nfunction onResize(){window.orbitalDirty=true;const rect=$('xp-top').getBoundingClientRect();$('xp-panel').style.top=(rect.bottom+7)+'px';$('xp-panel').style.maxHeight=Math.max(70,innerHeight-rect.bottom-7-$('controls').getBoundingClientRect().height-24)+'px'}addEventListener('resize',onResize);onResize();\nwindow.orbitalSurfaceRecover=()=\u003e{requestAnimationFrame(()=\u003ewindow.orbitalDirty=true);for(const m of registry.values())m.root.traverse(o=\u003e{if(o.isMesh){o.material.onBeforeCompile=()=\u003e{};o.material.customProgramCacheKey=()=\u003e\"surface-fallback\";o.material.needsUpdate=true}})};\ncomposition('habitat');window.orbitalReady=true;clearTimeout(window.orbitalWatch);\nreturn{catalog,registry,links,inspect,composition,make,connect,detach,moveBranch,home,setSelected:choose,get selected(){return chosen}};\n})();\n\nwindow.orbitalExpedition=expedition;\n} catch(e){const partial=station.getObjectByName(\"expedition-architecture\");if(partial)partial.visible=false;for(const child of station.children)if(child!==partial)child.visible=true;window.orbitalReady=true;clearTimeout(window.orbitalWatch);orbitalFail(\"expedition failed; original station available\",e);}\n\nlet animationLast=performance.now()/1000;\nrenderer.setAnimationLoop(()=\u003e{\n  const now=performance.now()/1000;\n  const dt=Math.min(.05,Math.max(0,now-animationLast));animationLast=now;\n  updateBlisterEmitter(dt);\n  updateBlisterFlash(dt);\n  updatePalletLander(dt,now);\n  updateOrrery(dt);\n  updateAlignmentDetector(dt);\n  if(viewMode==='interior'||window.orbitalDirty!==false){renderer.render(scene,camera);window.orbitalDirty=false;}\n});\n\n// Expose semantic handles for future conversational passes.\nwindow.stationToy={\n expedition:window.orbitalExpedition,\n  setTexture:setModuleTexture,\n  setAllTextures,\n  textureRegistry,\n\n modules,\n getModule:id=\u003emodules.get(id),\n selected:()=\u003eselected,\n setDetail:(id,on)=\u003e{window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;const m=modules.get(id);if(m)m.userData.layers.detail.visible=!!on},\n setFrame:(id,on)=\u003e{window.orbitalDirty=true;renderer.shadowMap.needsUpdate=true;const m=modules.get(id);if(m)m.userData.layers.frame.visible=!!on},\n stationRoot:station,\n room001:interiorRoot,\n palletLander,\n palletCargo:cargoGroup,\n orrerySeed,\n requestOrreryCycle,\n orreryState:()=\u003eorreryMotion.state,\n blisterEmitter,\n airBlister,\n setBlisterActive,\n beginEmitterStow,\n beginEmitterDeploy,\n requestLanderCycle,\n landerState:()=\u003elanderFlight.state\n};\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e"},{"id":"six-cities","title":"3D \u00b7 SIX CITIES","kind":"3D Three.js / Semantic-source civilization","source":"\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"utf-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\"\u003e\n\u003ctitle\u003eSix-City Civilization \u2014 Realization R1\u003c/title\u003e\n\u003cstyle\u003e\nhtml,body{\n  margin:0;width:100%;height:100%;overflow:hidden;\n  background:#090b0d;color:#e8e5dc;\n  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n  touch-action:none;\n}\n#stage{display:block;width:100%;height:100%;touch-action:none}\n#status{display:none!important}\n#fault{\n  display:none;position:fixed;z-index:100;left:10px;right:10px;bottom:10px;\n  max-height:45vh;overflow:auto;white-space:pre-wrap;padding:12px;\n  border:2px solid #76261e;border-radius:8px;background:#351717;color:#ffd2c8;\n  font:12px/1.35 ui-monospace,monospace;\n}\n\u003c/style\u003e\n\u003cscript\u003e\n(function(){\n  window.__LAB_FAIL__=(scope,err)=\u003e{\n    const e=document.getElementById('fault');\n    if(!e)return;\n    const m=err\u0026\u0026(err.stack||err.message)?(err.stack||err.message):String(err);\n    e.style.display='block';\n    e.textContent='SIX-CITY CIVILIZATION \u2014 VISIBLE FAILURE\\n['+scope+']\\n'+m;\n  };\n  addEventListener('error',e=\u003ewindow.__LAB_FAIL__('window.error',e.error||e.message));\n  addEventListener('unhandledrejection',e=\u003ewindow.__LAB_FAIL__('unhandledrejection',e.reason));\n})();\n\u003c/script\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003c!--\nPRESENT-TENSE SEMANTIC STATE \u2014 REALIZATION R1.1\n\nIdentity\nThis is a standalone Three.js civilization, built from the supplied S2 contract and\nreference evidence. Three.js 0.180.0 is embedded as data modules; opening the HTML does\nnot fetch a renderer, an image, or a font. The frozen S2 contract is retained below.\nThe historical empty-apparatus description is archaeology, not current application truth.\n\nOwners and invariants\n- `terrain` owns a mutable sampled heightfield, surface support and extraction. Removal\n  lowers the actual rendered/collidable substrate. Removed volume becomes quantified\n  material using seven inventory units per cubic terrain unit. There is a lower bedrock\n  bound. Excavation does not replenish itself.\n- `world.lots` owns every exposed, contained, carried, routed and ballistic material lot.\n  Each lot has quantity by four mineral/aggregate constituents, stage, location/owner,\n  and a set of origin witnesses. A split partitions quantity; combination sums it;\n  separation preserves it. No productive cooldown creates material.\n- Initial inventory + extracted terrain = all extant matter. The ledger reports the\n  residual. Runtime conservation failure stops execution visibly.\n- Inventory, reserved incoming cargo, capacity and compatible processing stages govern\n  acceptance. Materials cannot silently arrive in a full container. Scheduling checks\n  other eligible loads when the first load is blocked.\n- Collector delivery and ring freight are separate layers. Newly collected world matter enters\n  the civilization through Unzip's explicit intake capability; drones do not deposit into generic\n  buffers or downstream consumers merely because they have room.\n- One transport graph belongs to the world. Cities expose interfaces, not pairwise\n  knowledge. Ring freight is hub-mediated: every inter-city freight journey passes through\n  Link City. Processing/storage endpoints never connect directly to one another. Dijkstra\n  still resolves currently available paths, but Link is now required infrastructure rather\n  than an optional express shortcut.\n  Disabling a link causes later loads to seek alternate paths. In-flight loads return\n  to an available adjacent interface, or spill and fall if neither endpoint remains.\n  Terrain clearance, endpoint power, interface availability and link state affect routes.\n- Physics owns gravitational settling for loose lots, launched loads and whole cities.\n  A city rests on the highest of eight footing samples. It does not tilt or fracture.\n  Powered drone flight and ring transport explicitly supply lift. Support is resampled.\n- The observer owns camera, pause/speed and investigation interventions. Selection does\n  not move the camera. Relocation moves a container and its contents; spatial reach changes route\n  availability. Existing cargo recovers along its current edge instead of teleporting\n  when an endpoint moves. Recovery also respects receiving capacity. An undercut is actual terrain extraction and tests support, not an animation.\n\nCapabilities\nLauncher: held packaged material is committed to a ballistic delivery. The rotating\naccelerator's muzzle is the launch origin; elevation is solved from the same gravity\nand flight time as the projectile. It chooses a relatively undersupplied marked ground.\nLanded cargo becomes recoverable raw material with the original constituent amounts.\nThere is no combat model and no resource sink disguised as a delivery.\nDrone: twenty-four maintained collectors claim exposed lots, fly to them, lift actual\ncargo and choose available receiving capabilities. Held cargo stays attached to its drone.\nCollection and receiving capacity are finite. Drones wait when no work or receiver exists.\nUnzip: raw lots are separated into single-constituent lots, shown in four corresponding\narchitectural output bins. Their stored identity drives the classification and colors.\nThumper: available exposed stock regulates excavation. Its swept supported arm and\nreciprocating head act at the same world location as the terrain cut. Work sites progress\nwithin its reachable annulus; bedrock and accumulated stock can stop productive work.\nReservoir: retains constituent amounts and origin witnesses. Its visible fill is a persistent\nspatial witness rather than a frame-by-frame repacking: inventory deltas accrete into\nstrata inside the actual hemispherical containment envelope, and withdrawals peel the\nnewest compatible visible strata first. Internal sorted-to-packed Zip changes packaging\nwithout spatially shuffling unchanged stored composition. A packaging operation combines\nsorted inputs into mixed recoverable loads. Brass capsule bands communicate coherent\npackaging; nothing is homogenized away.\nLink: fast relay interfaces change least-cost paths between freight-participating cities.\nIt can fail or be isolated, but it is transit infrastructure rather than a warehouse; cargo\nmay wait at its interface while traversing a route but does not become Link inventory.\nDrone City and Thumper expose no ring-freight interfaces and own no authoritative material\nstorage. Drone cargo is delivered to actual receiving/processing capabilities; Thumper output\nexists directly as exposed world-space matter. Cityhood itself grants neither storage nor\nfreight connectivity.\n\nRepresentation and extension boundaries\nCities have distinct verb-derived masses: directional bastions, porous fabrication bays,\nbranching separator, heavy gantry, hollow containment ring, sparse relay spires. Brass,\nstone, selected glass, repeated octagons and rectilinear urban density unify them.\nStatic architecture is merged by material within each movable city; trees, buildings,\nring teeth and matter use instancing. Each bead is a sample of an authoritative lot,\nnot an independent rigid body or a promise of a one-bead-to-one-unit ratio. The visible\nreservoir fill derives from inventory through a persistent bounded presentation history;\nit does not create authoritative matter. Moving beads derive from extant cargo only.\nThe matter presentation budget is bounded. The simulation runs at a fixed 30 Hz step.\nNo ecosystem, civilian population or internal building economy is implied by greeble.\nMaterial origin witnesses are sets, not an exact per-origin mass ledger; constituent\nquantities are exact. Forests and decorative rocks are scenery, not collectible stock.\nThe finite surface lots and extracted substrate are the collectible world substance.\nWater and vegetation are scenic approximations; no hydrology, tree collision or erosion\nsimulation is claimed. Drone steering enforces terrain clearance but not full obstacle\npathfinding. Cities are atomic supported bodies rather than simulated district structures.\nThe session starts from a deterministic seed when reopened; there is no persistent save.\n\nTo extend the world, add a capability that consumes/produces existing lots or introduce\nan explicit new world truth. New consumers should declare compatibility and capacity;\nnew terrain causes should call terrain.extract; new vehicles should transfer ownership\nrather than changing counters. Update the audit if a genuine transformation introduces\na new stored/consumed material account. Geometry and labels do not establish a capability.\n\nARCHAEOLOGY / LEARNED EVIDENCE\n- A blocked first eligible lot originally starved other ready cargo. Scheduling now\n  searches eligible outgoing lots; this is a logistics rule, not a named-city exception.\n- Arrival-only capacity checks were insufficient with multiple concurrent carriers.\n  Incoming reservations now participate in acceptance and drone receiver choice.\n- A visually aimed accelerator can disagree with a correct projectile solver. Muzzle\n  position, elevation and ballistic velocity now share the same world-space solution.\n- Unrestricted raw intake could deadlock a full Reservoir against a full separator.\n  Raw intake now has a bounded staging allowance; processed stock retains the space\n  needed to resume circulation after an interruption.\n- Bare shortest-distance routing left fast infrastructure unused. Relay speed now enters\n  both path cost and actual flight time; Link's benefit is measurable rather than decorative.\n- About 1,000 first-pass draw calls were unnecessary. Static geometry merging and instanced\n  ring teeth reduced submission cost without removing the machines or material populations.\n- Human inspection of a nearly full Reservoir exposed a presentation scar: cylindrical\n  fill clipped through the hemispherical glass and frame-by-frame inventory traversal made\n  stored matter appear to churn. The fill witness now conforms to the dome and preserves\n  spatial history. This changed presentation ownership, not conserved inventory semantics.\n- R1.2.2 tested a compact 1.15\u20132.25 second Launcher flight regime after human inspection\n  found the original ballistic delivery perceptually slow. The projectile remained under\n  unchanged 9.8 world gravity, but compressing flight time made the accelerator nearly\n  horizontal and collapsed its ballistic silhouette. The probe was informative but rejected.\n  R1.2.3 restores the prior time-based ballistic solver exactly; no interpolation or trail\n  is added. The unresolved kinetic-readability problem remains explicit rather than hiding\n  it behind a failed tuning change.\n- The original realization autonomously fired packaged matter at three reclamation grounds\n  to close the conserved material loop. Human inspection exposed that this circulation was\n  mechanically coherent but did not establish an earned civilization-level reason to fire.\n  R1.2.3 withdraws autonomous launch demand. Launcher now waits with packaged supply until\n  the observer presses LAUNCH; that commitment provisionally selects one reclamation ground\n  at random, the machine aims, and the existing ballistic consequence proceeds normally.\n  Reclamation grounds remain experimental scaffolding, not asserted world demand.\n- R1.3.14 deliberately removes Unzip as the civilization throughput governor. Human inspection\n  found that its visible verb already reads correctly, while its old 150-unit / 2.1s processing\n  gate and generic 1.5s export cadence made the whole simulation wait on the separator. Unzip now\n  processes up to 360 raw units every 0.35 simulation seconds and receives a 0.28s forwarding\n  cadence while preserving differentiated stock, four visible embedded stock/ring witnesses,\n  one serialized freight output, conserved lots, and ordinary Link transport constraints. This is\n  experiential tuning: Unzip expresses processing but does not own civilization rhythm.\n- R1.3.14 also relocates the western forest reclamation witness to the far arid coastal corner\n  at (122,112). Ballistic target semantics are otherwise unchanged.\n- The original supplied S2 empty apparatus follows as a frozen requirement/reference,\n  along with the current executable. There is no recovered predecessor implementation.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.1 / RESERVOIR CONTAINMENT\nObservation: human inspection after isolating Launcher filled Reservoir to 6,499 / 6,500\nand made two presentation failures legible: matter crossed the dome boundary, and stored\nmatter globally shuffled despite no corresponding authoritative movement.\nInterpretation: inventory truth was sound; its spatial witness was not. Storage should\nretain visible history, and containment geometry should constrain presentation.\nIntervention: preserve authoritative lots and Zip semantics; add a Reservoir-owned\npresentation history derived only from inventory composition deltas. New composition\naccretes at the exposed surface; withdrawals remove newest compatible visible material.\nThe fixed slot field occupies the actual ellipsoidal hemisphere, so full storage remains\ninside glass. Internal packaging with unchanged composition causes no visual rearrangement.\nValidation boundary: this is a presentation witness, not granular rigid-body simulation\nor a new inventory stack rule. Conservation remains owned by world.lots and audit().\n\nARCHAEOLOGY ADDENDUM \u2014 R1.2 / TRANSPORT EXTENT + HALF-DUPLEX CONDUITS\n- R1/R1.1 represented each conserved in-transit lot as one authoritative route point with\n  a compact cloud of sampled beads. Quantity and composition were truthful, but distance\n  collapsed perceptually into moving noise.\n- The compact witness also concealed a simulation abstraction: opposing packets could\n  occupy the same conduit simultaneously and pass through one another.\n- R1.2 preserves lot identity, route choice, nominal edge velocity, capacity, conservation,\n  and arrival semantics. It changes how occupied distance is witnessed and adds only the\n  exclusion needed once that occupied distance becomes visible.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.2 / ELASTIC TRANSPORT\nObservation: the human wanted streams to read as slower and more discrete over distance\nwithout slowing the simulation. Ring conduits are arcs, so matter must inhabit those arcs\nrather than straight noisy chords. Once spatial extent was made explicit, two opposing\npackets crossing inside one conduit became a visible physical contradiction.\nInterpretation: distance can be made legible through elastic spatial extent rather than\nlatency. Spatial extent creates minimal exclusion: a conduit is bidirectional while idle\nbut temporarily one-way while occupied.\nIntervention: keep authoritative packet timing unchanged. Sampled matter now stretches\nalong routePoint() with maximum extent near mid-route and condenses at both interfaces.\nTransverse jitter is small and route-local. Conduits admit same-direction followers only\nafter a small world-space headway; opposing packets wait compactly at interfaces until the\nedge drains. Temporary traffic does not alter Dijkstra topology or trigger rerouting.\nValidation boundary: this is not collision physics, congestion-aware routing, fairness,\nor a general reservation framework. Continuous same-direction traffic may starve the\nopposite direction; that remains observable evidence rather than a pre-solved policy.\n\nPRESENT-TENSE TRANSPORT TRUTH \u2014 R1.2\nA transported lot remains one conserved authoritative packet following its chosen path.\nIts visible matter has route-conforming elastic extent: compact at departure and arrival,\nmost spatially discrete around mid-route. Conduit occupancy is half-duplex. Same-direction\npackets may follow with minimum entry headway; opposing entry waits at the interface until\nthe conduit is free. Occupancy is traffic, not connectivity failure.\n\nCOLLABORATIVE PROBE \u2014 R1.2.5 / BALLISTIC TEMPORAL SCALE\nThe spatial arc and physical aiming are accepted evidence; projectile traversal remains too slow.\nA temporary observer control cycles 1\u00d7, 1.5\u00d7, 2\u00d7, 2.5\u00d7 and 3\u00d7 ballistic temporal scale.\nFor a multiplier m, launch velocity is multiplied by m and projectile-only gravity by m\u00b2,\npreserving the same integrated spatial parabola while changing traversal time. This is an\ninspection probe, not yet promoted civilization truth. World gravity remains unchanged.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.2.4 / PHYSICAL AIMING\nObservation: random manual targets exposed an aiming discontinuity. Yaw already traversed at\nfinite angular speed, while the ballistic elevation solver directly assigned visible barrel\npitch each simulation step, making the accelerator snap vertically between firing solutions.\nInterpretation: numerical solution and machine actuation had accidentally become the same\noperation. A physical accelerator should receive a desired firing orientation, then traverse\nboth axes before it can commit a shot.\nIntervention: preserve the R1.2.3 ballistic timing, 9.8 world gravity, projectile integration,\nand random observer-selected reclamation targets. The ballistic solver now returns a desired\npitch without leaving its temporary numerical samples on visible machinery. Yaw retains its\n0.55 rad/s slew; pitch now has an independent bounded 0.42 rad/s slew. A committed launch\nwaits until both axes are aligned as well as packaged supply being present.\nValidation boundary: this does not repair the known slow ballistic flight, change target\nmeaning, add interpolation, or introduce a general actuator framework. It only makes the\nexisting two-axis Launcher physically continuous and separates solution from actuation.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.2.3 / MANUAL LAUNCH + BALLISTIC REVERT\nObservation: shortening Launcher flight time made firing faster but flattened the accelerator\nand exposed a deeper question: the three reclamation targets existed mainly to keep matter\ncirculating, while drones serviced them without an independently earned demand.\nInterpretation: ballistic tuning and launch purpose are separate questions. A failed kinetic\nprobe should be reverted rather than patched cosmetically, and provisional test destinations\nshould not silently become autonomous civilization intent.\nIntervention: restore R1.2.1 ballistic timing and world gravity unchanged. Remove autonomous\nfire. Add one observer LAUNCH affordance above the World ledger. It is available only with\nat least one standard 75-unit packed shot; pressing it chooses one provisional reclamation\nground randomly, then the existing accelerator aim and physical launch resolve normally.\nValidation boundary: this is not a targeting UI, demand model, launcher cooldown redesign,\nor new ballistic solution. The observer exercises an existing capability while destination\nmeaning and kinetic readability remain open empirical questions.\n\nSUCCESS-CONDITION REVIEW / EXECUTABLE EVIDENCE\n1\u20132. Desktop and portrait renders expose six different function-derived silhouettes,\n     unified by brass/stone, octagonal details, partial glass and urban density.\n3. Excavation changes the heightfield; an undercut test lowered a city's supported\n   elevation by roughly 1.7 world units rather than leaving it suspended.\n4\u20135. Exact constituent amounts survive every transfer. The running test contained both\n     mixed packaged cargo and single-constituent sorted lots. Zip changes packaging,\n     not constituent identity; launched mixed loads can be collected and separated again.\n6\u20137. All displayed cargo samples extant lots. Disabling the direct collection-to-sorter\n     edge changed its path to a route through Link. Unsupported interrupted cargo spills.\n8\u20139. Running counters and owned state show extraction, drone collection, separation,\n     packaging, relay movement and ballistic delivery composing in one shared world.\n10. Tests cover route interruption, isolation, supply exhaustion, reconnection and\n    changed terrain support. Capacity bounds and nonnegative amounts remain intact.\n11. A twenty-minute perturbation run continued circulating matter after recovery.\n    A separate twenty-eight-minute sequence filled the Reservoir to within two units\n    of its 6,500-unit limit, exhausted disconnected launch supply, and then drained\n    the buffer and restarted deliveries after reconnection.\n12. Desktop and 390\u00d7844 portrait layouts were rendered and inspected. Controls fit;\n    orbit was exercised. Portrait framing includes all six cities; pinch permits\n    closer miniature inspection. This is stylized procedural geometry, not photorealism.\n13. Ring and drone batching reduces submission count substantially: a tested late-world\n    frame used 162 draw calls versus about 1,000 in the first pass. Bead sampling adapts\n    to the whole population rather than hiding later lots when a budget is reached.\n    Headless Chromium validation is not a hardware frame-rate guarantee for every phone.\n14\u201315. This semantic state, the original S2 contract, named state owners, inspection API\n       and archaeological findings accompany the executable. Renderer vendor bytes are\n       isolated at the end of the HTML so the civilization source remains readable.\n16. Buffering, starvation, alternate routing, settling and recovery are measured\n    consequences of shared state, not a timeline of six pre-authored demonstrations.\n\nConservation during the long tests remained within approximately 10^-10 units, including\nseparate audits for all four constituents. Browser tests reported no page/runtime errors.\nNo physical mobile device was available for validation. There is no claim of individually\nsimulated bearings, fluid dynamics, general rigid-body contact or strategic city planning.\n\n\n\n\nR1.3.2 ARCHAEOLOGY \u2014 COLLECTION NEEDS AN INTAKE, NOT A NEAREST BUFFER\n\nObservation: after freight topology became truthful, collector drones could still choose among\nmultiple cities that happened to accept raw cargo. In practice this let collection bypass the\nprocessing story and made Reservoir behave like an alternate raw-material intake.\nInterpretation: collection and freight acceptance are different capabilities. A drone carrying\nnewly exposed world matter should not infer a destination from spare capacity or generic buffering.\nIntervention: Unzip now explicitly owns the civilization's current `intake` capability. Collector\ndrones deliver raw cargo only to an enabled intake with available capacity. Reservoir and Launcher\nare downstream freight endpoints, not collection destinations. No additional consumer or processing\neconomy is invented by this correction.\nExpected evidence: every collected ground lot enters Unzip first. If Unzip is disabled or full,\nloaded drones hold cargo rather than bypassing it. Once accepted, material may proceed through the\nexisting Link-mediated logistics chain according to its transformed stage.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.3.2 / UNZIP AS COLLECTION INTAKE\nObservation \u2192 drones were still able to shortcut the semantic pipeline at delivery.\nInterpretation \u2192 the civilization needs an explicit boundary between world collection and ring\nlogistics.\nIntervention \u2192 add an intake capability to Unzip and make drone receiver choice depend on intake,\nnot generic buffer/sort acceptance.\nValidation target \u2192 ground \u2192 drone \u2192 Unzip is the only current collection path; a blocked Unzip\ncreates visible loaded-drone backpressure instead of rerouting raw cargo to Reservoir or Launcher.\n\nR1.3.5 ARCHAEOLOGY \u2014 REJECTED APPROACH-GEOMETRY PATCH\n\nObservation: particular claimed deposits left their assigned drone hovering/wobbling over the\nmaterial forever without pickup. R1.3.5 hypothesized that the cruise-to-descent transition was the\ncause and changed that transition to horizontal proximity.\nResult: the same deterministic deposits still failed. The intervention did not address the failure\nand is withdrawn rather than accumulated as architecture. Temporary DRONES diagnostics were also\nremoved and remain absent.\nLesson: the drone had already done the semantically important work \u2014 it owned an exclusive claim and\nhad visibly reached the claimed patch. Requiring the generic movement helper to report exact arrival\nwas an unnecessarily strict condition for collection in this data-stream visualization.\n\nR1.3.6 ARCHAEOLOGY \u2014 CLAIM PROXIMITY COMPLETES COLLECTION\n\nObservation: broken collectors visibly hovered over their claimed material patches but pickup was\nexecuted only when `moveToward()` reported exact arrival at the lot's mathematical pickup point.\nInterpretation: navigation completion and material collection are separate concerns. Ground matter\nis an aggregated stream witness with a visible footprint, not a precision docking socket. A drone\nthat exclusively owns the claim and has reached that patch has satisfied the collection contract.\nIntervention: restore the pre-R1.3.5 crude approach behavior. Collection now completes when the\nclaiming drone is within 3.5 world units horizontally of the authoritative lot position. Exact\n`moveToward()` completion no longer gates transfer. Claims, 45-unit cargo capacity, conservation,\nand the world \u2192 drone \u2192 Unzip boundary are unchanged. No retries, expiry, pathfinding, terrain\nspecial cases, or additional pile physics are introduced.\nValidation target: the previously deterministic bad piles, including Thumper-side deposits, are\npicked up once their claimant reaches the visible patch; ordinary distant flight remains unchanged.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.3.6 / LET CLAIMS COLLECT\nObservation \u2192 drones visibly reached and hovered over claimed material yet exact navigation arrival\nprevented transfer.\nInterpretation \u2192 for this stream visualization, ownership plus local proximity is the meaningful\npickup condition; mathematical docking is not.\nIntervention \u2192 decouple pickup from `moveToward()` return value and withdraw the failed R1.3.5\napproach patch.\nValidation target \u2192 no permanent claimed piles under hovering drones; no change to material routing,\ncapacity, conservation, or downstream processing.\n\nPresent truth after R1.3.6: a collector exclusively claims exposed ground matter, approaches it with\nthe original crude terrain-clearance flight, and collects once it reaches the claimed patch; newly\ncollected world matter enters the civilization through Unzip.\n\nR1.3.15 PRESENT TRUTH \u2014 LINK OWNS ALLOCATION\n\nObservation: Launcher could sit depleted while Reservoir remained half full. That contradicted the\nintended civilization grammar: Reservoir is overflow, not a mandatory upstream supplier, and no\nprocessing/storage city should decide allocation priority.\nInterpretation: destination choice had accidentally lived in generic source dispatch. Link City is\nthe switchyard and therefore owns the allocation policy. Launcher always has first claim on usable\nprocessed material; Reservoir receives overflow when Launcher cannot accept more. Stored Reservoir\nmaterial may re-enter Link allocation when Launcher has room.\nIntervention: processed sorted or packed freight is allocated Launcher-first, Reservoir-second.\nLauncher can consume processed sorted or packed stock; launch still forms one conserved 75-unit\npacked projectile at commitment. Reservoir sorted stock is eligible to leave when Launcher has\nheadroom instead of being trapped as local processing input. All freight still traverses Link.\nThis is deliberate priority, not fill-ratio fairness.\n\nR1.3.1 ARCHAEOLOGY \u2014 LINK MUST ACTUALLY BE THE NETWORK\n\nObservation: after removing freight interfaces from Drone and Thumper, remaining freight\nendpoints could still route directly to one another. Link was therefore an optional shortcut\nrather than necessary transport infrastructure.\nInterpretation: access to ring freight had been conflated with permission to create peer-to-peer\nconduits. That weakened Link's verb and produced visually noisy, semantically redundant routes.\nIntervention: route construction now creates only endpoint-to-Link spokes. Every inter-city\nring journey is hub-mediated. Link owns no ordinary inventory; material may occupy its interface\nwhile waiting for an outbound conduit without becoming Link stock. Existing half-duplex traffic,\nheadway, waiting, fairness, interruption and conservation semantics remain intact.\nExpected evidence: isolating Link halts all ring freight; Unzip accumulates output, Reservoir can\ncontinue only from material already held, and Launcher eventually starves. No direct bypass route\nappears.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.3.1 / REQUIRED LINK HUB\nObservation \u2192 direct endpoint routes made Link optional and added ring spaghetti.\nInterpretation \u2192 a freight interface means access to a network, not peer-to-peer connectivity.\nIntervention \u2192 star topology centered on Link; no endpoint-to-endpoint ring routes.\nValidation target \u2192 all freight paths between distinct processing/storage cities contain Link,\nand disabling Link visibly partitions the entire ring logistics layer.\n\nPresent truth after R1.3.1: Link City is required mediation for inter-city ring freight.\n\nR1.3 ARCHAEOLOGY \u2014 CITYHOOD IS NOT A FREIGHT INTERFACE\nR1 generated ring routes from spatial proximity between every city and gave every city a\ncapacity. Inspection showed that this generic-city abstraction produced false semantics:\nDrone City accumulated raw material in a buffer with no downstream purpose; Thumper exposed\nmatter directly into world space yet still advertised storage and ring connectivity; Link\nadvertised warehouse capacity despite normal operation never placing material there and no\nlegible storage volume existing in its morphology. These were not repaired by inventing\nmaintenance economies or pairwise route exceptions. The overgeneralization was withdrawn.\n\nPresent truth after R1.3: freight interfaces are explicit capabilities. Launcher, Unzip,\nReservoir and Link participate in the ring network because their current verbs require it.\nDrone City and Thumper do not. Authoritative city inventory exists only where material\ngenuinely resides as part of a simulated verb. Link relays transit without owning ordinary\nwarehouse inventory. Interrupted cargo may recover only into an endpoint that actually has\nstorage; otherwise existing retreat/spill behavior remains the physical consequence.\n\nCOLLABORATIVE TURN RECORD \u2014 R1.3 / MATERIAL + NETWORK ONTOLOGY\nObservation: visually nonsensical ring connections existed; Drone City filled and remained\nfull; Link and Thumper exposed capacities unsupported by their behavior or morphology.\nInterpretation: a generic city abstraction had silently conferred storage and freight\nconnectivity on entities whose verbs did not earn either capability.\nIntervention: removed Drone/Thumper freight participation and generic capacity, removed Link\nwarehouse capacity, restricted route construction to explicit freight interfaces, and made\ninspection UI distinguish transit-only/no-inventory cities from actual containers.\nValidation target: Drone and Thumper have no ring routes; Link still changes network topology\nwithout accumulating inventory; drones deliver collected raw matter only to genuine receiving\ncapabilities; Unzip/Reservoir/Launcher retain bounded material state; conservation and existing\ntransport behavior remain intact.\n\n\nFORWARD ROADMAP \u2014 POST-R1.2.5 / LEGIBILITY + OWNERSHIP PASS\nThis is working intent, not present-tense civilization truth. Execute in order because each\nstep should expose evidence for the next. Do not preserve an implementation merely because\nit already exists. Do not broaden scope unless observation earns it.\n\n1. MATERIAL / NETWORK ONTOLOGY\nCorrect the generic-city overgeneralization before aesthetic cleanup. Cityhood does not\nconfer storage, material ownership, or freight connectivity. Capacity and connectivity are\nindependent capabilities earned by function. Drone City and Thumper should not participate\nin ring freight merely because they are cities. Link remains transport infrastructure but\ndoes not need ordinary warehouse inventory. Preserve authoritative inventories only where\nmatter genuinely resides or waits as part of the verb: Unzip processing, Reservoir storage,\nand Launcher feed/readiness. Remove nonsensical routes as a consequence of truthful\ninterfaces rather than by pairwise exceptions.\n\nObserved scar motivating this pass: Drone City currently fills a generic buffer and then\nremains full; Link exposes capacity it does not normally use and has no legible safe storage\nvolume; Thumper owns capacity despite exposing matter directly into world space. Plausible\nmaintenance economies (drone repair, machine consumables, etc.) are intentionally outside\nthis lab until they earn relevance. The authoritative material simulation tracks material\nwhose movement/transformation matters to this experiment, not every material requirement\nof the implied civilization.\n\n2. DRONE LEGIBILITY\nKeep the existing collection semantics small. Remove misleading reclamation-target witness\ngeometry when that scaffolding is retired. Repair the stereotyped diagonal/fixed-angle flight\nread so drone orientation and approach communicate actual travel and pickup. Collection is\narrival at exposed ground matter, not an invented harvesting timer. Do not add repair\neconomics, elaborate pathfinding, or flocking unless evidence requires them.\n\n3. LAUNCHER DISPERSAL PROBE\nPreserve the accepted physical two-axis aiming behavior. Retire the temporary SHOT temporal\nprobe and continuous coherent ballistic flight. Test Launcher as redistribution by dispersal:\na coherent packed load is committed, the machine deliberately aims, discharge converts that\nload into spatially distributed raw ground matter, and particulate rain creates a broad\nrecoverable field for drones. Conservation and composition remain exact. Packaging is\ndestroyed by dispersal. Distribution footprint should have real downstream collection\nconsequences. Provisional reclamation bullseyes are scaffolding, not earned civilization\ndemand.\n\n4. VISUAL HIERARCHY\nOnly after topology is truthful, tune perceptual hierarchy. Let city structural mass separate\nfrom terrain/ecology; reserve brighter brass/gold emphasis for machinery, interfaces, and\nmeaningful network activity. Matter must remain visibly distinct. Prefer active routes to\nassert themselves over inactive infrastructure. Do not clear forests or delete environmental\ndensity merely to solve palette/attention collisions. Reassess ring count after meaningless\nroutes disappear before making additional reductions.\n\n5. TWO-MINUTE LEGIBILITY PASS\nInspect from a fresh start as a first-time viewer rather than a developer. The artifact should\nbe attractive immediately, yield a crude causal model within roughly a minute, and allow one\nor two genuine interventions to reveal backpressure, transport, processing, storage, or\nredistribution within roughly two minutes. Keep controls as real interventions rather than\nscripted demo buttons. World Ledger remains a deeper inspection hatch. Prefer revelation of\nexisting depth over adding systems.\n\n6. THUMPER \u2014 LAST SUBSTANTIAL EXPEDITION\nDo not redesign Thumper during earlier cleanup. Preserve the earned truth that extraction is\nlocal, persistent, and visibly depletes/scars one bounded place. Later replace the oversized\nstamp/boom morphology with a stationary radial excavation works: lateral reach larger than\nthe city footprint, progressive substrate removal around the installation, an ever-deepening\nlocal pit, and city descent as supporting terrain is removed. Excavated matter remains\nordinary world-space collectible matter. Reconsider the current global loose-stock throttle\nin the context of the local worksite rather than patching it prematurely.\n\nSTOP CONDITION\nAfter these passes, stop unless play exposes another material lie or genuinely new behavior.\nDo not add drone maintenance economies, generalized crafting/resource taxonomies, or more\nsophisticated network scheduling merely because they are plausible. The target is a\ntwo-minute-legible living material-flow lab whose deeper implementation and archaeology reward\ninspection.\n--\u003e\n\n\u003c!--\nARCHIVED APPARATUS DESCRIPTION \u2014 SUPPLIED T0 (NOT CURRENT RUNTIME)\n\nPURPOSE\nA deliberately empty, known-working Three.js laboratory extracted from the Foundry\nexecution environment. This is apparatus, not world implementation.\n\nINHERITED APPARATUS ONLY\n- Three.js 0.180.0 browser module import.\n- WebGL renderer configuration proven in Foundry.\n- Perspective camera and observer-owned orbit/pan/pinch/wheel navigation.\n- Responsive/device-aware rendering.\n- Minimal neutral illumination so future geometry is immediately inspectable.\n- Visible pre-module runtime diagnostics and WebGL context-loss reporting.\n\nABSENT IN THE SUPPLIED T0, NOW REALIZED\nNo terrain.\nNo matter/bearings.\nNo gravity or physics.\nNo entities or ECS.\nNo payloads.\nNo cities.\nNo ports, links, routing, logistics, fabrication, storage, provenance, or resources.\nNo Foundry/WORKS ontology.\nNo procedural geometry or visual grammar.\nNo simulation loop beyond camera + rendering.\nNo application UI or interaction semantics.\n\nHUMAN / MODEL DEVELOPMENT CONTRACT\n\nThis artifact is intended to be developed collaboratively by humans and capable models.\n\nKeep the implementation semantically legible wherever concepts have earned semantic\nidentity. Prefer names and boundaries that expose what the system means and owns rather\nthan merely how its current implementation operates.\n\nSemantic clarity follows semantic truth. Do not create abstractions solely for descriptive\nneatness. Behavior earns architecture. Promote concepts only when executable evidence\nshows that they are genuinely shared, persistent, or independently meaningful.\n\nBefore a meaningful extension, inspect the current executable and its embedded semantic\ndocumentation. Be able to explain the proposed change to a human in terms of existing\nconcepts, affected ownership, expected behavior, and important uncertainties without\nrequiring the human to understand implementation details.\n\nThe human steers intent and may accept, reject, or modify that plan. The implementing\nmodel owns ordinary engineering decisions inside the accepted semantic intent. Surface\ndecisions that would materially change meaning rather than silently choosing them.\n\nPrefer the smallest executable extension capable of producing useful evidence. Test\nbehavior in the running world rather than completing speculative frameworks in\nanticipation of future needs.\n\nA meaningful feature is not finished until the artifact can explain its new meaning.\nWhen evidence establishes or changes a semantic truth, update the artifact's present-tense\nsemantic documentation with the implementation. Preserve useful historical evidence\nseparately as archaeology; do not allow obsolete history to remain presented as current\ntruth.\n\nShared world truths should have legible owners. Prefer composition through those truths\nover special-case relationships between named actors. Worlds own world truth; systems\nmay own genuinely cross-entity rules; entities own reusable capabilities and state;\nindividual things may own behavior that is truly peculiar to them. Presentation may make\ncausality legible without pretending every visible mechanism is simulated literally.\n\nImplementation mechanisms may be sophisticated, optimized, aggregated, or otherwise\nunlike their semantic description. They need only preserve required behavior and remain\ninspectable enough that another capable model can recover the relationship between\nimplementation and meaning.\n\nKeep failure cheap, visible, and diagnostic. A future human/model pair should be able to\ndistinguish an empty result from a broken one.\n\nBuild evidence. Promote what earns meaning. Leave the artifact able to explain itself\nwell enough for the next collaborator to continue.\n\n\n============================================================\nSIX-CITY CIVILIZATION \u2014 SEMANTIC SOURCE S2\n============================================================\n\nSTATUS AND PURPOSE\n\nThis section is the authoritative semantic source for the first realization of the\nSix-City Civilization experiment. It specifies the thing to be built, not the\nimplementation by which it must be built.\n\nThe realization must become a rich, manipulable, browser-resident Three.js world whose\nidentity is preserved by semantics, causality, perceptual evidence, and interaction\nrather than by inheritance from an earlier codebase.\n\nNo previous World Lab, Foundry, WORKS, city-machine, terrain, matter, physics, ECS,\nrouting, drone, or procedural-geometry implementation is supplied or implied by this\ndocument. Do not attempt to reconstruct an unseen prior implementation. Solve the\nrequirements here directly.\n\nThe two supplied raster references are evidence, not textures to paste into the world.\nThey are intentionally information-dense. Read them closely before implementation.\n\nREFERENCE IMAGE A \u2014 CIVILIZATION / WORLD IMPRESSION\nThe broad landscape image establishes the desired perceptual ambition and civilization\nidentity: a vast distant miniature world; dramatic topography; forests, water, cliffs,\nwaterfalls, mountains, dry country and distant horizons; monumental brass-and-glass\ncivilization embedded into rather than replacing the landscape; repeated free-standing\nring infrastructure; visible material or cargo movement through space; and a world that\nfeels substantially larger than the individual simulated actors.\n\nREFERENCE IMAGE B \u2014 SIX-CITY MORPHOLOGY BOARD\nThe labeled board is the more specific authority for the six city roles, their shared\ncivilization language, ring transport grammar, visibly differentiated material flows, and\nrelative semantic scale. Its labels and relationships are intentional semantic evidence. Exact silhouettes,\nornament placement, counts, camera angles, and photoreal surface detail are not mandates.\n\nIf the two images differ, preserve the semantic specificity of Image B and the perceptual\nambition / world impression of Image A. Do not chase photographic reproduction at the\nexpense of an alive executable system.\n\n\nPRIMARY EXPERIENCE\n\nThe user should encounter one coherent miniature civilization operating inside one\ncontinuous physical landscape.\n\nAt first glance the scene should be visually pleasurable and legible at a distant\nminiature scale. Continued observation should reveal that the cities are not static\nlandmarks. Matter originates in terrain, is extracted or collected, remains identifiable,\nmoves through the world, enters infrastructure, may be stored, sorted, routed, consumed,\nor launched, and produces consequences elsewhere.\n\nThe central pleasure is not six demonstrations. It is watching six different\ncapabilities participate in one world strongly enough that their combinations produce\nbehavior that was not individually storyboarded.\n\nThe user is primarily an observer and investigator, not an omnipotent RTS commander.\nCamera movement should support inspection of the civilization and its causal flows\nwithout requiring close first-person asset scrutiny. Interaction added by the realization\nshould favor experimentation, inspection, rearrangement, interruption, and discovery over\nmenus that merely trigger canned demonstrations.\n\nThe scene should be interesting while left alone. Autonomous activity, transport,\ncollection, buffering, sorting, routing, machinery motion, changing terrain, and visible\nmaterial state should provide evidence that the world continues to exist without the\nobserver's attention.\n\n\nWORLD AS SHARED TRUTH\n\nThere is one world, not six isolated city simulations.\n\nSpatial position matters. Terrain matters. Support matters. Distance and connectivity\nmatter. Matter has location and history. City actions create consequences that other\ncapabilities may discover through shared world state.\n\nCommon phenomena must have common semantic owners. A city should not contain private\ncopies of gravity, terrain truth, provenance truth, or network truth merely to make its\nown demo work.\n\nPrefer composable world rules over named pairwise choreography. A Drone City should not\nneed a special case saying \"collect from Thumper City.\" A Reservoir should not need a\nspecial case saying \"send to Launcher City.\" A Link City should not teleport only between\nhard-coded named destinations. Compatible capabilities should meet through shared\nsemantics.\n\nRemoval, movement, depletion, obstruction, changed terrain, unavailable interfaces, or\nchanged supply should be allowed to invalidate or reorganize dependent behavior. The\nworld must not secretly continue a pre-authored sequence after its causes disappear.\n\n\nLANDSCAPE, REGIONS, AND MATERIAL DIFFERENTIATION\n\nBuild a substantial three-dimensional landscape capable of supporting the six-city\ncivilization at miniature scale. It should read as terrain rather than a flat display\nboard.\n\nThe reference world demonstrates useful perceptual ingredients: height variation, cliffs,\nbasins, water, vegetated areas, rocky or mountainous areas, dry/desert areas, wetlands or\nwater-rich lowlands, long sightlines, and enough topographic separation for transport\nroutes to become meaningful. The exact geography is implementation-owned.\n\nThe reference material demonstrates one useful proposition: matter originating from\ndifferent regions can remain distinguishable after leaving the landscape. Forest/green,\ndesert/ochre, mountain/gray, wetland/dark, and mixed populations are visual evidence of\nthat proposition, not a mandatory resource taxonomy or coloring scheme.\n\nThe realization must support materially meaningful differentiation strongly enough for\nsorting, mixing, transport, storage, and recombination to be perceptually legible. The\nbuilder owns the visual/material grammar. Identity may derive from provenance,\ncomposition, morphology, texture, luminosity, particle behavior, packaging, or another\ncoherent mechanism.\n\nWhatever distinctions are chosen must exist in authoritative world state when machines\nact on them. Do not manufacture permanent material classes merely because landscape\nregions look different, and do not paint arbitrary debug colors onto otherwise identical\nmatter solely to satisfy the reference. Preserve provenance when origin is semantically\nconsequential; allow irrelevant provenance to remain irrelevant.\n\nTerrain is mutable world substance. At least one city capability must be able to remove\nor displace it visibly enough that excavation changes the landscape rather than merely\nincrementing a resource counter.\n\nTerrain deformation belongs semantically to the world. Actors own the causes and intents\nof deformation; the terrain/world owns realization of the changed substrate and the\nconsequences of changed support.\n\nThe exact deformation representation is implementation-owned. A density field, height\nrepresentation, mesh reconstruction, voxels, localized patches, hybrid technique, or\nanother solution is acceptable if the observed semantics survive.\n\n\nMATTER\n\nExtracted world substance becomes matter that can participate in the civilization.\n\nMatter must remain:\n\n- causally real;\n- spatially meaningful when in transit or exposed;\n- quantitatively meaningful;\n- capable of carrying provenance or other material identity when that distinction matters;\n- inspectable enough for the observer to understand major flows;\n- compatible with multiple capabilities without being rewritten for every pair of actors.\n\nDo not reduce the civilization to invisible integer resource counters.\n\nEqually, do not require one expensive rendered rigid object for every semantic unit at\npopulations where that representation becomes pathological. Representation may change\nwith scale. Matter may be instanced, batched, clustered, aggregated, represented as\nvisible fill, streams, packets, or other efficient forms while preserving authoritative\nquantity, provenance, location/ownership, and causal continuity.\n\nA useful governing distinction is:\n\nAUTHORITATIVE MATTER STATE answers what exists, how much, what materially consequential\nidentity or composition it has, where it meaningfully is, and what currently owns or\ncontains it.\n\nPRESENTATION answers how that state is made perceptually legible at the current scale.\n\nThose layers may differ. Presentation must not lie about important causality.\n\n\nGRAVITY, SUPPORT, AND PHYSICAL CONSEQUENCE\n\nThe world has coherent gravity.\n\nUnsupported physical entities should fall or settle. Terrain or structural change may\nalter support after an object has already been placed. If a physical object becomes\nunsupported because the world beneath it changes, continued suspension should require an\nexplicit semantic reason rather than being an accidental frozen transform.\n\nNot every visible particle, building, citizen, or decorative object requires rigid-body\nsimulation. Apply physical consequence where it carries meaning.\n\nThe exact gravity integration, collision method, solver, time step, constants, and\nsupport algorithm are implementation-owned.\n\nAvoid visual causality that directly contradicts authoritative state. If a machine fires\nfrom a visible muzzle, the payload should originate there. If a collector carries cargo,\nthe cargo should travel with it or be represented by an equally legible authoritative\ntransfer. If terrain is excavated, the changed landscape should correspond to the\nextraction.\n\n\nSCALE AND REPRESENTATION\n\nEach city is an atomic simulation entity at one level and an implied city at another.\n\nIts miniature footprint should remain comparable to the other city-machines while its\narchitectural detail implies districts, towers, internal industry, population, and a\ngreatly larger semantic scale.\n\nTiny rectilinear structures, windows, ribs, bridges, bays, stacks, frames, towers,\nmachinery, and other greeble may imply a city without simulating every building or\nresident independently.\n\nThis deliberate scale compression is part of the identity of the experiment.\n\nA moving city component can therefore imply district-scale machinery. A drone can imply\nan industrial autonomous vehicle. A hostile or wandering creature, if the implementation\nchooses to include one, may read as kaiju-scale without requiring a different numerical\nworld.\n\nOptimize geometry and detail for the distant miniature resolution band. Spend complexity\nwhere it survives perceptually: silhouette, hierarchy, repetition, motion, contrast,\nmaterial grouping, visible flows, large mechanisms, and architectural density. Do not\nspend the project on invisible close-up craftsmanship.\n\n\nCIVILIZATION FORM LANGUAGE\n\nAll six cities must visibly belong to the same civilization while remaining\nfunctionally distinguishable.\n\nThere is no canonical shared city chassis.\n\nDo not create one generic octagonal city and differentiate the six archetypes primarily\nby bolting a different machine onto it. Primary massing should arise from each city's\nverb and physical function first. Apply the shared civilization grammar to those\nfunction-derived forms second.\n\nShared identity must survive substantial morphological divergence. A Launcher may be\norganized by rotation and directional reach; a Drone City by porous distributed bays; an\nUnzip City by branching flow; a Thumper by low anchored reciprocating mass; a Reservoir\nby containment around a void; a Link City by sparse vertical reach and interfaces.\nThese are semantic pressures on morphology, not templates.\n\nShared visual grammar:\n\n- brass and stone are primary structural materials;\n- partial glass shells reveal selected internal volumes rather than enclosing everything;\n- octagonal geometry is recurrent and recognizable;\n- dense rectilinear urban greeble implies inhabited / industrial city fabric;\n- strong vertical elements provide hierarchy;\n- function-specific machinery changes silhouette and motion;\n- the palette and construction logic remain consistent across city types;\n- forms remain readable at miniature scale.\n\nGlass is containment and revelation, not the universal shape of the civilization.\n\nAvoid six unrelated sci-fi props. Avoid making role differences purely label/color based.\nA viewer should increasingly be able to infer a city's function from its structure,\ninterfaces, motion, and visible material behavior.\n\nProcedural construction is encouraged where it produces coherent families and density,\nbut the implementation must retain enough art direction that cities read as designed\nmembers of one civilization rather than random primitive piles.\n\n\nRING TRANSPORT GRAMMAR\n\nLarge brass ring structures are a recurring transport / network interface.\n\nRings may float freely along routes or occupy space between destinations. They are\nanchored structurally only where a city or other infrastructure actually interfaces with\nthem.\n\nThey should make long-distance movement legible across the landscape.\n\nThe reference images depict matter streams passing through sequences of rings. The\nrealization may use particles, packets, instanced matter, luminous traces, moving cargo,\nor another efficient visual mechanism. What matters is that transport corresponds to\nauthoritative transfer rather than decorative traffic unrelated to world state.\n\nRings are infrastructure, not magic hard-coded scene transitions. Routes should connect\ncompatible interfaces and be capable of changing, becoming unavailable, or being used by\ndifferent compatible flows where the realization supports that behavior.\n\nA Link City is especially important to this grammar, but ring semantics must not be\nprivate to Link City. Other cities can possess ring berths/interfaces.\n\n\nZIP / UNZIP \u2014 VISIBLE DIFFERENTIATION AND RECOMBINATION\n\nZip and Unzip are complementary material operations even though only Unzip is required\nas one of the six named city archetypes.\n\nTheir semantic purpose is not \"colored streams.\" Their purpose is to make heterogeneity,\nseparation, combination, and transport perceptually meaningful.\n\nThe realization must discover an elegant, aesthetically coherent visual/material grammar\nthat lets a human observer perceive when materially distinct things are mixed, separated,\nrouted, stored, and recombined at miniature scale.\n\nThe supplied reference uses biome-coded color as one successful visual proposition. It\nis not the mandated solution. Material identity may instead or additionally be expressed\nthrough provenance, composition, form, texture, luminosity, motion, packing, container\nbehavior, or another coherent mechanism.\n\nUnzip must separate distinctions that actually exist in authoritative matter state.\nA complementary Zip/recombination operation must make disparate inputs become a coherent\ntransported, packaged, blended, assembled, or otherwise combined form whose relationship\nto its inputs remains intelligible. Zip may aggregate or package differentiated matter\nwithout destroying distinctions that a later Unzip operation can recover. Genuine\ntransformation into new material is also permitted when the realization explicitly models\nthat transformation and its consequences. Zip does not require a seventh city; it may\nemerge from transport infrastructure, storage, fabrication, network machinery, or another\nsemantically appropriate owner.\n\nThe result should belong aesthetically to the civilization. Avoid debug-like categorical\ncoloring unless the chosen visual language makes such color feel materially and\narchitecturally intentional.\n\nPreserve differentiation; do not prescribe the historical solution to differentiation.\n\n\nTHE SIX CITY CAPABILITIES\n\n1. LAUNCHER CITY \u2014 DEFENSE + LOGISTICS\n\nIdentity:\nA fortified logistics / defense city organized around a monumental accelerator or\nlaunching mechanism.\n\nRequired morphology:\n- recognizable civilization geometry, including octagonal organization where functionally\n  appropriate;\n- partial glass shell where useful;\n- dense implied city fabric;\n- a dominant accelerator / launch track or comparable directional mechanism;\n- the launching mechanism is mechanically distinct enough from the base to visibly aim,\n  rotate, articulate, or otherwise establish direction;\n- visible ammunition / payload readiness or storage;\n- compatible city interfaces, including ring transport where appropriate.\n\nRequired semantics:\n- accepts compatible supplied matter or payloads whose relevant identity exists in\n  authoritative world state;\n- supplied matter does not simply vanish into an unrelated cooldown;\n- converts or commits supplied matter into a launched physical/logistical consequence;\n- can launch toward a meaningful world-space destination, target, route, or transport\n  interface;\n- lack of supply should matter;\n- launch origin and direction should be visually causal;\n- its defense/logistics behavior should be capable of interacting with world conditions\n  rather than existing solely as a looping animation.\n\nThe implementation may introduce targets, threats, deliveries, construction payloads, or\nother uses if they strengthen composition. Do not let \"defense\" force the entire world\ninto a combat game.\n\n\n2. DRONE CITY \u2014 FABRICATION + COLLECTION\n\nIdentity:\nA dense fabrication city with distributed launch bays and an autonomous working swarm.\n\nRequired morphology:\n- shared civilization base language;\n- especially dense vertical urban interior;\n- multiple visible launch / recovery bays or distributed drone interfaces;\n- visible drone population at a scale sufficient to read as a swarm without overwhelming\n  performance;\n- storage or staging areas that visibly respond to returned material.\n\nRequired semantics:\n- fabricates, releases, or otherwise maintains autonomous collector drones;\n- drones perceive or discover available collectable matter through world state;\n- drones travel through world space;\n- collection requires reaching or otherwise meaningfully interacting with matter;\n- collected matter becomes carried/owned cargo rather than disappearing globally;\n- drones return or deliver cargo to a compatible receiving capability;\n- returned material changes visible/authoritative storage or flow;\n- drones should not contain special-case knowledge of a particular Thumper, Reservoir, or\n  named destination when shared capability semantics can suffice.\n\nThe exact pathfinding, steering, flocking, collision avoidance, drone count, fabrication\neconomy, and representation are implementation-owned.\n\n\n3. UNZIP CITY \u2014 MATERIAL SORTING\n\nIdentity:\nA processing city whose architecture visibly turns incoming mixed flow into separated\noutgoing flows.\n\nRequired morphology:\n- shared octagonal brass/stone/glass civilization language;\n- one or more prominent receiving interfaces;\n- multiple outgoing interfaces / ring berths;\n- a visible processing volume or machinery zone;\n- separated output streams should be visually distinguishable by the material identity\n  the realization has established.\n\nRequired semantics:\n- receives matter from compatible incoming transport or delivery;\n- can accept mixed populations;\n- classifies or separates according to material distinctions that genuinely exist in\n  authoritative world state; provenance may be one such distinction when consequential;\n- maintains quantity through sorting except for explicit, legible loss/transformation;\n- produces multiple usable outgoing populations/streams;\n- downstream consumers are chosen by compatibility/network state rather than because the\n  sorter knows six predetermined scene scripts;\n- processing state should be visible enough to understand that sorting is occurring.\n\n\"Unzip\" is a semantic metaphor for one mixed stream becoming several differentiated\nflows. The exact machinery is implementation-owned.\n\n\n4. THUMPER CITY \u2014 TERRAIN MANIPULATION\n\nIdentity:\nA low, heavy city built around a dominant reciprocating terrain-working apparatus.\n\nRequired morphology:\n- broad, grounded, mechanically massive profile;\n- shared civilization materials and octagonal logic;\n- a large reciprocating, pounding, drilling, pressing, excavating, or comparable mechanism;\n- integrated collection channels or receiving infrastructure around the work zone;\n- significant visible kinetic motion while active.\n\nRequired semantics:\n- acts on actual world terrain;\n- removes, displaces, excavates, shapes, or otherwise changes terrain in a persistent\n  visible way;\n- terrain action creates or exposes matter whose consequential material identity is\n  preserved in authoritative world state and can participate in the rest of the civilization;\n- terrain change is not a cosmetic decal laid over unchanged authoritative ground;\n- the mechanism's working location should correspond to the changed terrain;\n- activity can be supply-, demand-, opportunity-, or state-dependent rather than an\n  eternal decorative loop.\n\nThe Thumper does not need to own the world's terrain algorithm. It owns the intention /\ncause of its terrain work; world terrain owns the resulting substrate change.\n\n\n5. RESERVOIR CITY \u2014 STORAGE + BUFFERING\n\nIdentity:\nA containment city whose stored material is part of its architecture and is visibly\ninspectable.\n\nRequired morphology:\n- recognizable civilization geometry, including octagonal organization where functionally\n  appropriate;\n- large hollow containment volume;\n- partial or substantial glass revealing stored matter;\n- multiple input/output interfaces;\n- visible fill level;\n- visible composition / stratification where materially distinct populations are mixed;\n- enough surrounding city fabric to remain a city rather than merely a tank.\n\nRequired semantics:\n- accepts compatible incoming matter;\n- retains authoritative quantity and consequential material identity while stored;\n- exposes storage state perceptually;\n- can release matter to compatible demand/routes;\n- buffering should decouple production timing from consumption timing;\n- full, empty, mixed, filling, and draining states should have observable consequences;\n- meaningful material distinctions should not be silently homogenized merely because\n  matter shares a container.\n\nThe reservoir may aggregate huge populations for performance. Visible fill can be an\nefficient representation of authoritative inventory rather than thousands of independent\nrigid bodies.\n\n\n6. LINK CITY \u2014 NETWORK + TRANSPORT\n\nIdentity:\nA sparse, strongly vertical regional hub whose architecture is dominated by network\ninterfaces and route anchoring.\n\nRequired morphology:\n- shared civilization materials and recurring octagonal construction logic;\n- strong vertical focus;\n- multiple ring berths / route interfaces;\n- comparatively sparse central massing so network infrastructure reads clearly;\n- visible active/inactive route state where useful.\n\nRequired semantics:\n- establishes, anchors, relays, or reorganizes transport relationships between compatible\n  spatially separated interfaces;\n- routes matter between networks without requiring every producer to know every consumer;\n- route availability depends on current world/network state;\n- unavailable or removed interfaces can invalidate routes;\n- the system should be capable of rerouting or reorganizing where the realized network\n  semantics make that possible;\n- transport state must remain tied to authoritative matter transfer;\n- Link City is infrastructure and mediation, not a named teleport script.\n\nThe exact graph algorithm, routing policy, capacity model, congestion model, scheduling,\nand visual path representation are implementation-owned.\n\n\nEMERGENT COMPOSITION\n\nThe six city contracts describe capabilities, not scenarios.\n\nThe realization should deliberately create enough initial conditions for capabilities to\nmeet one another and reveal composition. The builder may choose placement, starting\ninventories, active routes, matter availability, drone populations, and initial machine\nstate to make the world immediately inspectable, but those conditions must not be the\nonly way the world can function.\n\nExamples of valid composition include, but are not limited to:\n\n- Thumper excavation exposes materially distinct matter; Drone collectors notice and\n  retrieve some of it; a Reservoir buffers it; an Unzip City later separates a mixed\n  delivery; a Link City provides a viable route; a Launcher consumes compatible supply.\n- A route becomes unavailable and material accumulates upstream rather than teleporting\n  to its scripted destination.\n- A Reservoir fills because downstream demand is absent, then drains when a compatible\n  route/consumer appears.\n- Drone behavior changes because nearby collectable matter has been depleted or moved.\n- Terrain excavation changes support or accessibility and thereby changes later behavior.\n- Mixed material identity becomes visually obvious inside storage or transport.\n- A city's removal or disconnection creates a visible logistical consequence elsewhere.\n\nThese are illustrative evidence patterns, not required scripted sequences. Prefer\nsystems capable of producing equivalent surprises from current state.\n\n\nAUTONOMY AND ATTENTION\n\nAutonomous actors should react to the world they currently inhabit.\n\nDo not fake autonomy by cycling through a fixed timeline regardless of world state.\n\nAt minimum, drones and major city machinery should have state that can be inferred from\nbehavior: idle, seeking, acquiring, carrying, waiting, processing, routing, aiming,\nworking, blocked, depleted, full, or comparable states appropriate to the capability.\n\nNot every actor needs a sophisticated AI system. Simple stateful behavior is sufficient\nwhen it responds to real conditions and composes with other systems.\n\nMotion should communicate intention. A machine that has nothing to do may idle, scan,\nwait, or settle rather than perform its productive action meaninglessly.\n\n\nAUTHORITATIVE STATE VS LEGIBLE PRESENTATION\n\nThe implementation is encouraged to cheat visually and computationally where doing so\npreserves semantics.\n\nExamples:\n- a stream can be a modest number of particles representing a much larger authoritative\n  transfer;\n- a Reservoir can render a stratified fill volume while inventory is stored compactly;\n- a city can be one entity while thousands of tiny structures imply urban scale;\n- a network pulse can communicate a logical route without claiming that the pulse itself\n  is cargo;\n- distant forests can use instancing or billboarding;\n- matter populations can change representation with distance or containment.\n\nThe cheat becomes invalid when presentation causes the observer to infer materially\nincorrect world truth. Decorative cargo must not appear to arrive when no transfer\noccurred. A full-looking Reservoir must not be authoritatively empty. A disconnected\nroute should not continue showing successful deliveries unless it has another valid path.\n\n\nINTERACTION AND INSPECTION\n\nPreserve the supplied observer camera as apparatus unless changing it becomes necessary\nfor the experience.\n\nThe realization should remain usable on desktop and touch devices. Existing orbit,\npan/pinch, wheel, responsive canvas behavior, and visible failure handling are known-good\napparatus.\n\nAdd interaction only where it materially improves investigation or experimentation.\n\nUseful interaction directions include selecting/inspecting a city, identifying current\nstate or inventory, observing material identity, composition, or provenance where relevant,\ninterrupting/removing/moving a route or actor,\nor otherwise creating a small perturbation whose consequences can be watched.\n\nDo not bury the world under a conventional game HUD. The world itself should communicate\nas much state as practical through motion, fill, routes, material appearance, machinery,\narchitecture, and consequences.\n\nIf textual diagnostics or inspection panels are added, keep them compact, responsive,\nand subordinate to the miniature world.\n\n\nINITIAL REALIZATION\n\nThe first completed realization should include all six city types in one coherent world.\n\nIt should not stop after creating attractive static architecture.\n\nBefore considering the first build complete, there must be at least one functioning\nclosed or partially closed causal chain involving terrain/matter and multiple city\ncapabilities, plus enough independent behavior that breaking or changing part of the\nchain produces a meaningful consequence.\n\nAll six cities must possess their defining behavior even if some are initially less\ndeeply integrated than others. Prefer one coherent world with unevenly deep but genuine\ncapabilities over six polished disconnected showcases.\n\nThe builder is free to choose a sensible implementation sequence. A good sequence may\nestablish world/terrain/matter truth before city morphology, then progressively connect\ncapabilities. That is guidance, not mandated architecture.\n\n\nPERFORMANCE AND ROBUSTNESS\n\nThe target is an interactive browser experience, including contemporary mobile hardware.\n\nProtect frame rate and stability before maximizing literal object counts.\n\nKNOWN CAPACITY EVIDENCE \u2014 DISCRETE MATTER\n\nPrior executable experimentation in this browser/Three.js environment established that\nball-bearing-scale discrete matter is both perceptually effective and technically viable.\nWith an appropriate high-population rendering strategy, populations on the order of\napproximately 200,000 simultaneously represented matter elements ran comfortably.\n\nThis is evidence about the available design space, not a benchmark, target, minimum, or\nmandated representation. Ball bearings are a proven representation, not the required\nrepresentation.\n\nDiscrete matter proved especially powerful for making quantity, accumulation, pouring,\nflow, transfer, gravity, containment, carrying, spilling, and mechanical causality\nreadable at miniature scale. If the realization chooses a more abstract or aggregated\nrepresentation, preserve those perceptual affordances where they matter.\n\nDo not prematurely impoverish visible material populations because a few hundred or few\nthousand elements seem like an assumed browser limit. Conversely, do not spend\nperformance on 200,000 elements merely to reproduce the old experiment. Spend population\nwhere it creates semantic or perceptual value.\n\nUse instancing, pooled objects, aggregation, level-of-detail, bounded particle counts,\nspatial indexing, simplified distant geometry, or other techniques as appropriate.\nThese mechanisms are implementation-owned.\n\nDo not solve performance by deleting the semantic phenomena that make the world\ninteresting. Prefer changing representation.\n\nAvoid unbounded accumulation of rendered matter, drones, particles, effects, route\nmarkers, or historical objects.\n\nDevice/display behavior should be dynamic rather than tuned to one screenshot size.\n\nMaintain visible error reporting. Startup failures, module failures, WebGL/context\nfailures, and meaningful feature failures should fail diagnostically rather than\nsilently. New systems should not erase the foundation's ability to report breakage.\n\n\nIMPLEMENTATION FRAMEWORK GUIDANCE\n\nThree.js is the required rendering/runtime substrate for this realization.\n\nBeyond the supplied foundation, architecture is implementation-owned.\n\nDo not recreate an earlier framework merely because this project once existed elsewhere.\nDo not assume ECS, a particular physics engine, a particular terrain representation, a\nparticular routing algorithm, or a particular procedural-generation system.\n\nNevertheless, preserve these high-level implementation qualities:\n\n- common truths have common owners;\n- causal state is separable from presentation where useful;\n- capabilities meet through semantic compatibility rather than named special cases;\n- state changes are inspectable enough for another capable model to reason about them;\n- methods, types, modules, and boundaries should use semantic names when those semantics\n  have earned identity;\n- peculiar behavior may remain local instead of being prematurely generalized;\n- systems should be extendable through existing truths when a new actor genuinely shares\n  them;\n- meaningful runtime failures should surface;\n- present-tense semantic documentation evolves with the executable.\n\nA human should be able to ask a capable model, \"How would you add X?\" and receive an\nunderstandable answer describing what concepts would change, what currently owns those\nconcepts, what new semantic truth would be introduced, what existing behavior should\nremain invariant, and what uncertainty requires an executable probe.\n\nAfter human steering, the model should be able to make that extension without first\nperforming archaeology on opaque implementation accidents.\n\n\nSEMANTIC NAMING\n\nPrefer implementation vocabulary such as:\n\nterrain.extract / terrain.deform / matter identity / matter provenance / reservoir inventory /\nroute availability / compatible interface / drone cargo / launcher supply\n\nwhen those concepts genuinely exist.\n\nAvoid generic names such as processThing, updateData, node2, handlerA, or anonymous arrays\nfor important domain state when a stable semantic concept has already earned a name.\n\nDo not force every low-level helper into domain prose. Geometry math, shader code,\nallocation pools, numerical integration, and other implementation mechanisms may remain\nimplementation-shaped. Semantic legibility is required at meaningful boundaries, not as\nceremonial verbosity.\n\n\nDOCUMENTATION AND ARCHAEOLOGY\n\nThis S2 section begins as specification.\n\nAs implementation produces evidence, maintain a concise PRESENT-TENSE SEMANTIC STATE in\nthis HTML describing what is now true of the executable: major capabilities, ownership,\ninvariants, important representation choices where they affect extension, and known\nsemantic limitations.\n\nWhen a semantic statement becomes false, revise present-tense truth.\n\nIf an old approach or failure remains useful to future collaborators, move or summarize\nit under ARCHAEOLOGY / LEARNED EVIDENCE rather than leaving contradictory requirements in\nthe current contract.\n\nDo not turn archaeology into a chronological diary of every edit. Preserve evidence that\nchanges future reasoning.\n\nThe artifact should remain capable of explaining itself.\n\n\nIMPLEMENTATION FREEDOMS \u2014 DELIBERATELY NOT SPECIFIED\n\nThe following are intentionally owned by the builder unless later evidence promotes them\nto semantics:\n\n- terrain data structure and deformation algorithm;\n- mesh generation technique;\n- physics library or custom physical approximations;\n- gravity constants and integration;\n- collision solver;\n- entity/component architecture;\n- object pooling strategy;\n- spatial indexing;\n- routing algorithm;\n- drone steering/pathfinding;\n- exact matter unit size;\n- authoritative numeric capacities and rates;\n- exact city dimensions;\n- exact building counts;\n- procedural generation algorithms;\n- shader implementation;\n- particle implementation;\n- storage data structures;\n- save format;\n- module/file organization;\n- class hierarchy;\n- animation system;\n- exact UI implementation;\n- exact camera starting pose if another pose better reveals the completed world.\n\nDo not ask the human to choose among these merely because multiple solutions are\npossible. Exercise engineering judgment unless the choice would materially alter the\nsemantic experience.\n\n\nNON-GOALS\n\nDo not attempt photorealistic reproduction of the reference images.\n\nDo not build a static diorama.\n\nDo not build six independent buttons that play six animations.\n\nDo not build a conventional resource-management UI whose counters replace visible world\ncausality.\n\nDo not make every city omniscient about every other city.\n\nDo not require every implied citizen/building/material unit to be simulated literally.\n\nDo not overfit the first successful causal chain so tightly that rearrangement becomes\nimpossible.\n\nDo not create a giant speculative framework before executable behavior requires it.\n\nDo not preserve invisible implementation lineage from a previous Foundry or World Lab.\n\nDo not treat the specification as a ceiling. Extensions beyond it are welcome when they\narise coherently from established truths and improve the living world without violating\nits identity.\n\n\nSUCCESS CONDITIONS\n\nThe first realization is successful when a human can inspect the running world and\nreasonably conclude all of the following:\n\n1. This is recognizably the civilization shown by the references even though its assets\n   are procedurally/crudely realized rather than copied.\n2. The six city types visibly belong together yet have distinct functional identities.\n3. Terrain is world substance, not scenery only.\n4. Material distinctions that matter to world behavior survive extraction, transport,\n   storage, sorting, and recombination strongly enough to remain perceptually intelligible.\n5. A human can observe materially differentiated matter become coherently combined or\n   packaged for use or transport and later differentiated again, with the relationship\n   between those states remaining intelligible.\n6. Matter visibly participates in causal flows rather than existing only as counters.\n7. Ring infrastructure communicates real transport/network relationships.\n8. Each city performs its defining capability.\n9. Multiple capabilities compose through shared world truth.\n10. At least some behavior changes when supply, terrain, connectivity, availability, or\n    participants change.\n11. The world continues doing meaningful things without constant user commands.\n12. The miniature remains readable and attractive at its intended viewing scale.\n13. Performance remains practical by changing representation rather than abandoning the\n    semantic world.\n14. A capable model can inspect the artifact and explain to a human how an extension\n    would fit before implementing it.\n15. The HTML contains enough current semantic truth for the next human/model pair to\n    continue without needing the lost predecessor codebase.\n16. The result feels like a living executable civilization, not an illustration of this\n    document.\n\n\nBUILDER MANDATE\n\nStudy the supplied images and this semantic source closely.\n\nThen realize the world.\n\nMake your own implementation decisions inside the semantic contract. Build executable\nevidence instead of speculative completeness. Preserve successful behavior as you extend\nit. Repair material failures you discover. Keep the artifact understandable.\n\nDo not stop merely because every noun in the specification has a mesh.\n\nThe target is the quality of relationship between the nouns.\n\nWhen the world can surprise its builders without ceasing to be intelligible, the\nexperiment has begun to work.\n\n\nEXTENSION CONTRACT\nTreat sceneRoot as the empty realization surface.\nThe camera is observer state, not world state.\nEverything added beyond this apparatus is implementation owned by the extending worker.\nThe apparatus may be revised if the target semantics require it; it is not architecture.\n--\u003e\n\n\u003ccanvas id=\"stage\"\u003e\u003c/canvas\u003e\n\u003cdiv id=\"status\"\u003eSIX-CITY CIVILIZATION \u00b7 loading embedded renderer and world\u003c/div\u003e\n\u003cpre id=\"fault\"\u003e\u003c/pre\u003e\u003cscript\u003esetTimeout(()=\u003e{if(!window.__CIV_READY__)window.__LAB_FAIL__(\"startup watchdog\",\"The civilization module has not started. Inspect module / WebGL support; reload to retry.\");},25000);\u003c/script\u003e\n\n\u003cscript type=\"module\"\u003e\nconst THREE = await import(document.getElementById('embedded-three').textContent.trim());\n\nconst canvas = document.getElementById('stage');\nconst status = document.getElementById('status');\nconst fail = (scope,e)=\u003ewindow.__LAB_FAIL__(scope,e);\nconst clamp = (x,a,b)=\u003eMath.max(a,Math.min(b,x));\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x090b0d);\n\n/* Empty extension surface. */\nconst sceneRoot = new THREE.Group();\nsceneRoot.name = 'REALIZATION_ROOT';\nscene.add(sceneRoot);\n\n/* Neutral inspection light only; it carries no world semantics. */\nscene.add(new THREE.HemisphereLight(0xdde7ee,0x24282c,1.25));\nconst key = new THREE.DirectionalLight(0xffffff,1.6);\nkey.position.set(-40,55,35);\nscene.add(key);\n\nfunction makeRenderer(){\n  const r = new THREE.WebGLRenderer({\n    canvas,\n    antialias:true,\n    powerPreference:'high-performance',\n    alpha:false,\n    depth:true,\n    stencil:false,\n    preserveDrawingBuffer:false\n  });\n  r.outputColorSpace = THREE.SRGBColorSpace;\n  r.toneMapping = THREE.ACESFilmicToneMapping;\n  r.toneMappingExposure = 1.05;\n  r.shadowMap.enabled = false;\n  return r;\n}\n\nlet renderer = makeRenderer();\nconst camera = new THREE.PerspectiveCamera(34,1,.1,600);\n\n/* Foundry's observer-style camera, stripped of all world/tool interactions. */\nconst view = {\n  target:new THREE.Vector3(0,1,0),\n  distance:118,\n  yaw:.72,\n  pitch:.48,\n  pointers:new Map(),\n  pinch:null\n};\n\nfunction applyView(){\n  view.distance = clamp(view.distance,115,360);\n  view.pitch = clamp(view.pitch,.18,1.4);\n  const cp = Math.cos(view.pitch);\n  camera.position.set(\n    view.target.x + view.distance*Math.sin(view.yaw)*cp,\n    view.target.y + view.distance*Math.sin(view.pitch),\n    view.target.z + view.distance*Math.cos(view.yaw)*cp\n  );\n  camera.lookAt(view.target);\n  camera.updateMatrixWorld();\n}\n\nfunction orbit(dx,dy){\n  view.yaw -= dx*.006;\n  view.pitch += dy*.006;\n  applyView();\n}\n\nfunction pan(dx,dy){\n  const scale = view.distance*.0015;\n  const forward = new THREE.Vector3();\n  camera.getWorldDirection(forward);\n  forward.y = 0;\n  if(forward.lengthSq()\u003c1e-8) forward.set(0,0,-1);\n  forward.normalize();\n  const right = new THREE.Vector3().crossVectors(forward,camera.up).normalize();\n  view.target.addScaledVector(right,-dx*scale);\n  view.target.addScaledVector(forward,dy*scale);\n  applyView();\n}\n\nfunction pinchState(){\n  if(view.pointers.size!==2)return null;\n  const a=[...view.pointers.values()];\n  return {\n    d:Math.hypot(a[1].x-a[0].x,a[1].y-a[0].y),\n    cx:(a[0].x+a[1].x)/2,\n    cy:(a[0].y+a[1].y)/2\n  };\n}\n\ncanvas.addEventListener('pointerdown',e=\u003e{\n  canvas.setPointerCapture?.(e.pointerId);\n  view.pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});\n  view.pinch=pinchState();\n});\n\ncanvas.addEventListener('pointermove',e=\u003e{\n  const p=view.pointers.get(e.pointerId);\n  if(!p)return;\n  view.pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});\n\n  if(view.pointers.size===1){\n    if(e.shiftKey||e.buttons===2)pan(e.clientX-p.x,e.clientY-p.y);else orbit(e.clientX-p.x,e.clientY-p.y);\n  }else if(view.pointers.size===2){\n    const n=pinchState();\n    if(view.pinch\u0026\u0026n){\n      view.distance*=view.pinch.d/Math.max(1,n.d);\n      pan(n.cx-view.pinch.cx,n.cy-view.pinch.cy);\n      applyView();\n    }\n    view.pinch=n;\n  }\n});\n\nconst endPointer=e=\u003e{\n  view.pointers.delete(e.pointerId);\n  view.pinch=pinchState();\n};\ncanvas.addEventListener('pointerup',endPointer);\ncanvas.addEventListener('pointercancel',endPointer);\n\ncanvas.addEventListener('wheel',e=\u003e{\n  e.preventDefault();\n  view.distance*=Math.exp(e.deltaY*.0012);\n  applyView();\n},{passive:false});\n\ncanvas.addEventListener('contextmenu',e=\u003ee.preventDefault());\n\nfunction resize(){\n  renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.15));\n  renderer.setSize(innerWidth,innerHeight,false);\n  camera.aspect=innerWidth/innerHeight; camera.fov=2*Math.atan(Math.tan(17*Math.PI/180)/Math.min(1,camera.aspect))*180/Math.PI;\n  camera.updateProjectionMatrix();\n  applyView();\n}\naddEventListener('resize',resize,{passive:true});\n\nlet rendering=true;\nfunction startRendering(){\n  if(rendering)return;\n  rendering=true;\n  renderer.setAnimationLoop(animate);\n}\nfunction stopRendering(){\n  rendering=false;\n  renderer?.setAnimationLoop(null);\n}\n\ncanvas.addEventListener('webglcontextlost',e=\u003e{\n  e.preventDefault();\n  stopRendering();\n  fail('webglcontextlost',\n    'GPU/WebGL context was lost. Authoritative world state is retained; rendering is paused until restore.');\n},false);\n\ncanvas.addEventListener('webglcontextrestored',()=\u003e{\n  document.getElementById('fault').style.display='none';\n  resize();\n  startRendering();\n},false);\n\napplyView();\nresize();\n/* Runtime installs its simulation loop below. */\n\n/* Minimal extension handles. Nothing here defines world ontology. */\nwindow.sixCityApparatus = { THREE, scene, sceneRoot, camera, renderer, view, applyView };\n\n// Six-City Civilization. State owns causality; meshes are witnesses.\nconst TAU = Math.PI * 2,\n  V = (x = 0, y = 0, z = 0) =\u003e new THREE.Vector3(x, y, z);\nlet seed = 68217;\nfunction random() {\n  seed = (Math.imul(1664525, seed) + 1013904223) \u003e\u003e\u003e 0;\n  return seed / 4294967296;\n}\nconst materials = [\n  {\n    name: \"Verdant aggregate\",\n    short: \"verdant\",\n    color: 0x65864a,\n    density: 1.2,\n  },\n  { name: \"Amber sandstone\", short: \"amber\", color: 0xc49551, density: 1.7 },\n  { name: \"Pale granite\", short: \"granite\", color: 0xc6ccd0, density: 2.7 },\n  { name: \"Peat ironstone\", short: \"ironstone\", color: 0x505f61, density: 3.1 },\n];\nconst qty = (c) =\u003e c.reduce((a, b) =\u003e a + b, 0),\n  composition = () =\u003e [0, 0, 0, 0];\nconst world = {\n  time: 0,\n  paused: false,\n  speed: 1,\n  lots: [],\n  cities: [],\n  drones: [],\n  routes: [],\n  events: [],\n  nextId: 1,\n  extracted: 0,\n  initial: 0,\n  shots: 0,\n  sorted: 0,\n  zipped: 0,\n  delivered: 0,\n  excavations: 0,\n  routeRevision: 0,\n  initialComposition: [0, 0, 0, 0],\n  extractedComposition: [0, 0, 0, 0],\n};\nfunction event(text) {\n  world.events.unshift({ time: world.time, text });\n  world.events.length = Math.min(30, world.events.length);\n}\nfunction lot(comp, owner, pos, stage = \"raw\", origins = []) {\n  const l = {\n    id: world.nextId++,\n    comp: [...comp],\n    owner,\n    pos: pos.clone(),\n    stage,\n    createdAt: world.time,\n    origins: [...origins],\n    velocity: V(),\n    claim: null,\n  };\n  world.lots.push(l);\n  return l;\n}\nfunction inventory(city) {\n  return world.lots.filter((l) =\u003e l.owner === city);\n}\nfunction amount(city) {\n  return inventory(city).reduce((s, l) =\u003e s + qty(l.comp), 0);\n}\nfunction removeLot(l) {\n  const i = world.lots.indexOf(l);\n  if (i \u003e= 0) world.lots.splice(i, 1);\n}\nfunction combine(lots, owner, pos, stage) {\n  const c = composition(),\n    origins = new Set();\n  for (const l of lots) {\n    l.comp.forEach((v, k) =\u003e (c[k] += v));\n    l.origins.forEach((o) =\u003e origins.add(o));\n    removeLot(l);\n  }\n  return lot(c, owner, pos, stage, [...origins]);\n}\nfunction take(l, n) {\n  n = Math.min(n, qty(l.comp));\n  const total = qty(l.comp),\n    c = l.comp.map((x) =\u003e (x * n) / total);\n  l.comp = l.comp.map((x, k) =\u003e Math.max(0, x - c[k]));\n  return lot(c, l.owner, l.pos, l.stage, l.origins);\n}\nconst terrain = {\n  size: 290,\n  n: 180,\n  heights: null,\n  mesh: null,\n  revision: 0,\n  dirty: false,\n};\nfunction noise(x, z) {\n  return (\n    Math.sin(x * 0.053 + Math.cos(z * 0.043) * 2) * Math.cos(z * 0.047) +\n    0.47 * Math.sin(x * 0.14 + z * 0.083) +\n    0.21 * Math.cos(z * 0.31 - x * 0.22)\n  );\n}\nfunction baseHeight(x, z) {\n  const mountain =\n    58 *\n    Math.exp(-((x + 75) ** 2 / 4200 + (z + 91) ** 2 / 1150)) *\n    (0.55 + 0.45 * Math.abs(Math.sin(x * 0.12 + z * 0.08)));\n  const ridge =\n    48 *\n    Math.exp(-((x - 56) ** 2 / 3500 + (z + 115) ** 2 / 1000)) *\n    (0.55 + 0.45 * Math.abs(Math.cos(x * 0.09 - z * 0.11)));\n  const hill = 8 * Math.exp(-((x + 42) ** 2 + (z - 4) ** 2) / 2000);\n  const river =\n    10 * Math.exp(-((x - 12 - 12 * Math.sin(z * 0.025)) ** 2) / 220);\n  const lake = 6 * Math.exp(-((x - 12) ** 2 / 1000 + (z + 30) ** 2 / 800));\n  const shelf =\n    (8 / (1 + Math.exp((x + 13) / 2))) * Math.exp(-((z + 3) ** 2) / 4000);\n  const coast =\n    18 *\n    Math.pow(clamp((Math.max(Math.abs(x), Math.abs(z)) - 117) / 28, 0, 1), 2);\n  return (\n    4.4 +\n    noise(x, z) * 3.4 +\n    mountain +\n    ridge +\n    hill +\n    shelf -\n    river -\n    lake -\n    coast\n  );\n}\nconst sites = [\n  {\n    name: \"Launcher\",\n    verb: \"Aim \u00b7 commit \u00b7 deliver\",\n    x: -65,\n    z: -22,\n    caps: [\"launch\"],\n    capacity: 1300,\n  },\n  {\n    name: \"Drone\",\n    verb: \"Discover \u00b7 collect \u00b7 carry\",\n    x: -21,\n    z: -37,\n    caps: [\"collect\"],\n    capacity: null,\n  },\n  {\n    name: \"Unzip\",\n    verb: \"Receive \u00b7 separate \u00b7 release\",\n    x: 41,\n    z: -32,\n    caps: [\"intake\", \"sort\"],\n    capacity: 2000,\n  },\n  {\n    name: \"Thumper\",\n    verb: \"Work \u00b7 fracture \u00b7 expose\",\n    x: -47,\n    z: 24,\n    caps: [\"extract\"],\n    capacity: null,\n  },\n  {\n    name: \"Reservoir\",\n    verb: \"Retain \u00b7 assemble \u00b7 buffer\",\n    x: 20,\n    z: 32,\n    caps: [\"buffer\", \"zip\"],\n    capacity: 6500,\n  },\n  {\n    name: \"Link\",\n    verb: \"Anchor \u00b7 relay \u00b7 reorganize\",\n    x: 66,\n    z: 16,\n    caps: [\"relay\"],\n    capacity: null,\n  },\n];\nterrain.heights = new Float32Array((terrain.n + 1) ** 2);\nfor (let j = 0; j \u003c= terrain.n; j++)\n  for (let i = 0; i \u003c= terrain.n; i++) {\n    const x = (i / terrain.n - 0.5) * terrain.size,\n      z = (j / terrain.n - 0.5) * terrain.size;\n    let h = baseHeight(x, z);\n    for (const s of sites) {\n      const d = Math.hypot(x - s.x, z - s.z),\n        level = Math.max(4.5, baseHeight(s.x, s.z));\n      const a = 1 - clamp((d - 11) / 8, 0, 1);\n      h = h * (1 - a) + level * a;\n    }\n    terrain.heights[j * (terrain.n + 1) + i] = h;\n  }\nterrain.height = (x, z) =\u003e {\n  const u = clamp((x / terrain.size + 0.5) * terrain.n, 0, terrain.n - 0.001),\n    v = clamp((z / terrain.size + 0.5) * terrain.n, 0, terrain.n - 0.001),\n    i = Math.floor(u),\n    j = Math.floor(v),\n    a = u - i,\n    b = v - j,\n    N = terrain.n + 1;\n  return (\n    (terrain.heights[j * N + i] * (1 - a) +\n      terrain.heights[j * N + i + 1] * a) *\n      (1 - b) +\n    (terrain.heights[(j + 1) * N + i] * (1 - a) +\n      terrain.heights[(j + 1) * N + i + 1] * a) *\n      b\n  );\n};\nfunction substrate(x, z, depth = 0) {\n  const h = terrain.height(x, z),\n    m = composition();\n  if (x \u003e 35) m[1] = 0.7;\n  else if (z \u003c -53 || h \u003e 15) m[2] = 0.72;\n  else if (h \u003c 4 || z \u003e 40) m[3] = 0.65;\n  else m[0] = 0.65;\n  m[2] += 0.15 + Math.min(0.2, depth * 0.035);\n  m[3] += 0.1;\n  m[1] += 0.1;\n  const n = qty(m);\n  return m.map((v) =\u003e v / n);\n}\nterrain.extract = (x, z, r, depth) =\u003e {\n  let volume = 0;\n  const cell = terrain.size / terrain.n,\n    N = terrain.n + 1;\n  for (\n    let j = Math.max(0, Math.floor((z - r + terrain.size / 2) / cell));\n    j \u003c= Math.min(terrain.n, Math.ceil((z + r + terrain.size / 2) / cell));\n    j++\n  )\n    for (\n      let i = Math.max(0, Math.floor((x - r + terrain.size / 2) / cell));\n      i \u003c= Math.min(terrain.n, Math.ceil((x + r + terrain.size / 2) / cell));\n      i++\n    ) {\n      const d = Math.hypot(\n        i * cell - terrain.size / 2 - x,\n        j * cell - terrain.size / 2 - z,\n      );\n      if (d \u003c r) {\n        const k = j * N + i,\n          cut = Math.min(\n            depth * (1 - d / r),\n            Math.max(0, terrain.heights[k] + 7),\n          );\n        terrain.heights[k] -= cut;\n        volume += cut * cell * cell;\n      }\n    }\n  if (volume \u003c 0.01) return null;\n  terrain.revision++;\n  terrain.dirty = true;\n  const n = volume * 7,\n    comp = substrate(x, z, terrain.revision * 0.01).map((v) =\u003e v * n),\n    p = V(x, terrain.height(x, z) + 2, z);\n  world.extracted += n;\n  comp.forEach((v, k) =\u003e (world.extractedComposition[k] += v));\n  world.excavations++;\n  const l = lot(comp, \"ground\", p, \"raw\", [\n    `stratum ${Math.round(x)},${Math.round(z)}`,\n  ]);\n  l.velocity.set((random() - 0.5) * 3, 5, (random() - 0.5) * 3);\n  return l;\n};\n// Materials share construction grammar, never a generic city chassis.\nconst brass = new THREE.MeshStandardMaterial({\n  color: 0xb89352,\n  metalness: 0.72,\n  roughness: 0.4,\n});\nconst gold = new THREE.MeshStandardMaterial({\n  color: 0xe1bf71,\n  metalness: 0.72,\n  roughness: 0.32,\n});\nconst stone = new THREE.MeshStandardMaterial({\n  color: 0x777363,\n  roughness: 0.96,\n});\nconst dark = new THREE.MeshStandardMaterial({\n  color: 0x343e3d,\n  metalness: 0.48,\n  roughness: 0.55,\n});\nconst glass = new THREE.MeshPhysicalMaterial({\n  color: 0xa5d5df,\n  metalness: 0.02,\n  roughness: 0.1,\n  transparent: true,\n  opacity: 0.2,\n  depthWrite: false,\n  side: THREE.DoubleSide,\n});\nconst lightMat = new THREE.MeshBasicMaterial({ color: 0xf5d48b });\nconst unitBox = new THREE.BoxGeometry(1, 1, 1),\n  cylinder = new THREE.CylinderGeometry(1, 1, 1, 8),\n  sphere = new THREE.IcosahedronGeometry(1, 1);\nconst batches = new Map();\nfunction instance(geometry, material, pos, scale, rotation = 0) {\n  const key = geometry.uuid + material.uuid;\n  if (!batches.has(key)) batches.set(key, { geometry, material, items: [] });\n  batches\n    .get(key)\n    .items.push({ pos: pos.clone(), scale: scale.clone(), rotation });\n}\nfunction flushBatches() {\n  for (const b of batches.values()) {\n    const mesh = new THREE.InstancedMesh(\n      b.geometry,\n      b.material,\n      b.items.length,\n    );\n    const d = new THREE.Object3D();\n    b.items.forEach((v, i) =\u003e {\n      d.position.copy(v.pos);\n      d.scale.copy(v.scale);\n      d.rotation.set(0, v.rotation, 0);\n      d.updateMatrix();\n      mesh.setMatrixAt(i, d.matrix);\n    });\n    sceneRoot.add(mesh);\n  }\n  batches.clear();\n}\nfunction mesh(g, m, parent, pos = V(), scale = V(1, 1, 1)) {\n  const a = new THREE.Mesh(g, m);\n  a.position.copy(pos);\n  a.scale.copy(scale);\n  parent.add(a);\n  return a;\n}\nfunction box(p, m, pos, scale) {\n  return mesh(unitBox, m, p, pos, scale);\n}\nfunction cyl(p, m, pos, r, h, r2 = r) {\n  return mesh(new THREE.CylinderGeometry(r2, r, h, 8), m, p, pos);\n}\nfunction beam(p, a, b, r = 0.1, m = brass) {\n  const d = b.clone().sub(a);\n  const o = mesh(\n    new THREE.CylinderGeometry(r, r, d.length(), 6),\n    m,\n    p,\n    a.clone().add(b).multiplyScalar(0.5),\n  );\n  o.quaternion.setFromUnitVectors(V(0, 1, 0), d.normalize());\n  return o;\n}\nfunction ring(p, pos, r = 2, normal = V(0, 0, 1), mat = brass) {\n  const g = new THREE.Group();\n  g.position.copy(pos);\n  g.quaternion.setFromUnitVectors(V(0, 0, 1), normal.clone().normalize());\n  p.add(g);\n  mesh(new THREE.TorusGeometry(r, 0.16, 6, 32), mat, g);\n  mesh(new THREE.TorusGeometry(r - 0.27, 0.04, 4, 32), gold, g);\n  const teeth = new THREE.InstancedMesh(unitBox, gold, 8),\n    d = new THREE.Object3D();\n  for (let i = 0; i \u003c 8; i++) {\n    const a = (i / 8) * TAU;\n    d.position.set(Math.cos(a) * r, Math.sin(a) * r, 0);\n    d.scale.set(0.32, 0.32, 0.38);\n    d.updateMatrix();\n    teeth.setMatrixAt(i, d.matrix);\n  }\n  g.add(teeth);\n  return g;\n}\nfunction shell(p, pos, r, h = r) {\n  mesh(\n    new THREE.SphereGeometry(r, 28, 14, 0, TAU, 0, Math.PI * 0.49),\n    glass,\n    p,\n    pos,\n    V(1, h / r, 1),\n  );\n  for (let k = 0; k \u003c 8; k++) {\n    const a = (k * TAU) / 8,\n      pts = [];\n    for (let j = 0; j \u003c= 16; j++) {\n      const t = ((j / 16) * Math.PI) / 2;\n      pts.push(\n        V(\n          Math.cos(a) * r * Math.sin(t),\n          h * Math.cos(t),\n          Math.sin(a) * r * Math.sin(t),\n        ).add(pos),\n      );\n    }\n    const curve = new THREE.CatmullRomCurve3(pts);\n    mesh(new THREE.TubeGeometry(curve, 16, 0.065, 4, false), brass, p);\n  }\n}\nfunction district(p, cx, cz, r, count, height = 5) {\n  const list = [];\n  for (let k = 0; k \u003c count; k++) {\n    const a = random() * TAU,\n      d = Math.sqrt(random()) * r,\n      x = cx + Math.cos(a) * d,\n      z = cz + Math.sin(a) * d,\n      w = 0.4 + random() * 0.8,\n      h = 0.8 + Math.pow(random(), 2) * height;\n    list.push({ x, z, w, h });\n  }\n  const ms = new THREE.InstancedMesh(unitBox, brass, count),\n    trim = new THREE.InstancedMesh(unitBox, lightMat, count);\n  const d = new THREE.Object3D();\n  list.forEach((a, i) =\u003e {\n    d.position.set(a.x, 1.1 + a.h / 2, a.z);\n    d.scale.set(a.w, a.h, a.w * 0.75);\n    d.rotation.y = 0;\n    d.updateMatrix();\n    ms.setMatrixAt(i, d.matrix);\n    d.position.y = 1.3 + a.h * 0.63;\n    d.scale.set(a.w * 1.03, 0.09, a.w * 0.8);\n    d.updateMatrix();\n    trim.setMatrixAt(i, d.matrix);\n  });\n  p.add(ms, trim);\n}\nfunction tower(p, x, z, h) {\n  cyl(p, stone, V(x, h * 0.24, z), 0.85, h * 0.48);\n  cyl(p, brass, V(x, h * 0.66, z), 0.48, h * 0.4, 0.28);\n  cyl(p, gold, V(x, h * 0.92, z), 0.2, h * 0.18, 0.04);\n}\nfunction platform(p, x, z, r, h = 1.3) {\n  cyl(p, stone, V(x, h / 2, z), r, h);\n  cyl(p, brass, V(x, h + 0.12, z), r + 0.1, 0.24);\n}\nfunction makeCity(s, i) {\n  const c = {\n    ...s,\n    id: i,\n    enabled: true,\n    connected: true,\n    pos: V(s.x, terrain.height(s.x, s.z), s.z),\n    velocity: 0,\n    state: \"ready\",\n    timer: i * 0.7,\n    aim: 0,\n    workIndex: 0,\n    mesh: new THREE.Group(),\n    parts: {},\n    lastAction: 0,\n  };\n  c.mesh.position.copy(c.pos);\n  c.mesh.scale.setScalar(1.2);\n  sceneRoot.add(c.mesh);\n  world.cities.push(c);\n  const p = c.mesh;\n  if (c.caps.includes(\"launch\")) {\n    platform(p, 0, 0, 8);\n    for (let k = 0; k \u003c 8; k++) {\n      let a = (k / 8) * TAU;\n      platform(p, Math.cos(a) * 7, Math.sin(a) * 7, 1.65, 2);\n      district(p, Math.cos(a) * 5.8, Math.sin(a) * 5.8, 1.4, 14, 3);\n    }\n    // R1.3.11: Launcher visual datum is the accelerator axis.\n    // Keep the dome and vertical landmark centered on the same city/aim origin so\n    // yaw rotation reads as a deliberate machine rather than an eccentric assembly.\n    shell(p, V(0, 1.6, 0), 5.7, 6);\n    tower(p, 0, 0, 11);\n    c.parts.aim = new THREE.Group();\n    c.parts.aim.position.set(0, 5, 0);\n    p.add(c.parts.aim);\n    c.parts.barrel = new THREE.Group();\n    c.parts.aim.add(c.parts.barrel);\n    for (const side of [-1, 1]) {\n      box(c.parts.barrel, brass, V(side * 0.65, 0, -3.9), V(0.45, 0.65, 16));\n      box(c.parts.barrel, dark, V(side * 0.65, 0.4, -3.9), V(0.23, 0.15, 16));\n    }\n    for (let k = 0; k \u003c 9; k++) {\n      box(c.parts.barrel, gold, V(0, -0.38, 3 - k * 1.8), V(1.8, 0.24, 0.32));\n    }\n    ring(c.parts.barrel, V(0, 0, -11.7), 1.3);\n    c.parts.barrel.rotation.x = 0.2;\n  }\n  if (c.caps.includes(\"collect\")) {\n    for (let k = 0; k \u003c 8; k++) {\n      const a = (k / 8) * TAU,\n        x = Math.cos(a) * 6,\n        z = Math.sin(a) * 6;\n      platform(p, x, z, 2.5, 1.3);\n      district(p, x, z, 1.7, 25, 5);\n      box(p, dark, V(Math.cos(a) * 8, 1.6, Math.sin(a) * 8), V(3, 0.25, 2));\n    }\n    platform(p, 0, 0, 4, 2);\n    district(p, 0, 0, 3.6, 80, 8);\n    shell(p, V(0, 2, 0), 4.5, 8);\n    tower(p, 0, 0, 13);\n  }\n  if (c.caps.includes(\"sort\")) {\n    platform(p, 0, 0, 4.4, 1.2);\n    box(p, stone, V(0, 1, -5), V(4, 2, 8));\n    shell(p, V(0, 1.4, 0), 4, 5);\n    for (let k = 0; k \u003c 4; k++) {\n      const a = (k / 3 - 0.5) * Math.PI * 0.95,\n        x = Math.sin(a) * 7,\n        z = Math.cos(a) * 7;\n      beam(p, V(0, 1.5, 0), V(x, 1.5, z), 0.65, stone);\n      platform(p, x, z, 2.1, 1.3);\n      ring(p, V(x, 3, z), 1.6, V(x, 0, z));\n      district(p, x, z, 1.5, 22, 3);\n    }\n    tower(p, -3, -3, 10);\n    tower(p, 3, -3, 8);\n    c.parts.sorter = ring(p, V(0, 3, 0), 2.9, V(0, 1, 0));\n  }\n  if (c.caps.includes(\"extract\")) {\n    for (const x of [-5, 5])\n      for (const z of [-3, 3]) {\n        platform(p, x, z, 3, 1.7);\n        district(p, x, z, 2, 35, 3.2);\n      }\n    box(p, stone, V(0, 1, -3), V(12, 2, 4));\n    for (const x of [-3, 3]) {\n      box(p, brass, V(x, 5, 2), V(1, 9, 1.2));\n      box(p, gold, V(x, 5, 2.8), V(0.25, 8, 0.25));\n    }\n    box(p, brass, V(0, 9, 2), V(8, 1.1, 2.6));\n    c.parts.work = new THREE.Group();\n    p.add(c.parts.work);\n    c.parts.arm = box(c.parts.work, brass, V(0, 9, 4), V(1, 1, 8));\n    c.parts.ram = cyl(c.parts.work, gold, V(0, 6, 8), 0.35, 6);\n    c.parts.hammer = cyl(c.parts.work, dark, V(0, 4, 8), 2.5, 3, 1.6);\n    cyl(c.parts.hammer, brass, V(0, 2, 0), 0.6, 3);\n    for (const x of [-3.5, 3.5]) beam(p, V(x, 2, 1), V(x, 2, 9), 0.25);\n    tower(p, -5, -3, 7);\n  }\n  if (c.caps.includes(\"zip\")) {\n    for (let k = 0; k \u003c 8; k++) {\n      const a = (k / 8) * TAU,\n        x = Math.cos(a) * 8,\n        z = Math.sin(a) * 8;\n      platform(p, x, z, 2.1, 2.5);\n      district(p, x, z, 1.45, 17, 3.7);\n      beam(\n        p,\n        V(x, 3, z),\n        V(Math.cos(a + TAU / 8) * 8, 3, Math.sin(a + TAU / 8) * 8),\n        0.4,\n      );\n    }\n    cyl(p, stone, V(0, 0.6, 0), 7, 1.2);\n    shell(p, V(0, 1.3, 0), 7.2, 8);\n    tower(p, -7, 0, 10);\n    tower(p, 7, 0, 8);\n    c.parts.zip = ring(p, V(0, 2, 0), 3.4, V(0, 1, 0));\n  }\n  if (c.caps.includes(\"relay\")) {\n    platform(p, 0, 0, 3, 1.2);\n    tower(p, 0, 0, 17);\n    tower(p, 2, -1, 11);\n    for (let k = 0; k \u003c 4; k++) {\n      const a = (k / 4) * TAU,\n        x = Math.cos(a) * 7,\n        z = Math.sin(a) * 7;\n      beam(p, V(0, 1, 0), V(x, 1, z), 0.65, stone);\n      platform(p, x, z, 1.8, 1);\n      ring(p, V(x, 4, z), 2.6, V(x, 0, z));\n      district(p, x, z, 1.2, 10, 2);\n      beam(p, V(0, 10, 0), V(x, 3, z), 0.08);\n    }\n  }\n  // Persistent visible interfaces and inventory presentation.\n  c.port = V(0, 3.5, 0);\n  c.parts.fill = new THREE.Group();\n  p.add(c.parts.fill);\n  c.pick = mesh(\n    new THREE.CylinderGeometry(9, 9, 12, 12),\n    new THREE.MeshBasicMaterial({ visible: false }),\n    p,\n    V(0, 4, 0),\n  );\n  c.pick.userData.city = c;\n  return c;\n}\nfor (let i = 0; i \u003c sites.length; i++) makeCity(sites[i], i);\n// Flatten static architecture by material wit